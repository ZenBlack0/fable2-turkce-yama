  "forms_of_address": {
    "system_and_ui": "Görev, ipucu ve sistem metinlerinde '-iniz / -ınız' emir kipi KULLANILMAZ. Standart '-in / -ın' kipi kullanılır (örn: 'Seçin', 'Basın', 'takip edin', 'öldürün', 'gidin', 'alın', 'kazanın').",
    "npc_to_hero": {
      "citizens_respectful": "Halk ünlü kahramana saygıyla 'siz' veya 'Efendim / Kahramanım' der.",
      "citizens_fearful": "Kötü ve yozlaşmış kahramana korkuyla ve yalvararak hitap ederler.",
      "bandits_and_villains": "Düşmanlar, haydutlar ve alaycı karakterler aşağılayıcı 'sen' kipi kullanır.",
      "theresa": "Theresa kahramanın manevi rehberi olarak gizemli, kadim ve bilge bir üslupla 'sen' kipiyle hitap eder.",
      "reaver": "Reaver kibirli, iğneleyici, züppe ve alaycı aristokrat üslubunu korur."
    }
  },
