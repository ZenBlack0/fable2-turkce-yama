  "language_register": {
    "rule": "Karakter ve metin türüne göre dil kaydı (register) ayrımı uygulanır.",
    "formal_and_archaic": "Lucien'ın günlükleri, kitaplar, tarih metinleri, soylular, Reaver: ağdalı/eski kelimeler (ehemmiyet, bilahare, mesul, vazife, istifade) kullanılabilir.",
    "vernacular_and_common": "Köylüler, kasabalılar, meyhane müdavimleri, eşler, çocuklar, haydutlar, dedikodular: SADE günlük Türkçe kullanılır. 'mesul' yerine 'sorumlu/geldiği', 'işittim' yerine 'duydum', 'vazife' yerine 'iş/görev', 'ehemmiyet' yerine 'önem', 'istifade' yerine 'fayda/yarar' kullanılır."
  },
