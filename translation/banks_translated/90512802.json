    {
      "id": "604ba394",
      "bank_id": "90512802",
      "text": "Senin gibi bir maceracının böyle işe yaramaz bir silahla ne işi var?"
    },
    {
      "id": "604ba395",
      "bank_id": "90512802",
      "text": "Senin gibi birinin bundan daha iyi bir silahı olmalıydı."
