    {
      "id": "2a8d26da",
      "bank_id": "90512802",
      "text": "Senin gibi biri için amma yaman bir silah."
    },
    {
      "id": "2a8d26db",
      "bank_id": "90512802",
      "text": "Elindeki ne biçim bir silah öyle! Yarışmada filan mı kazandın?"
