      "id": "9321841a",
      "bank_id": "90512802",
      "text": "Onunla kimseye saldırmayacaksın değil mi?"
    },
    {
      "id": "9321841b",
      "bank_id": "90512802",
      "text": "O şey birini öldürebilir, biliyorsun değil mi."
    },
    {
      "id": "9321841c",
      "bank_id": "90512802",
      "text": "Silahını kaldır. Birini öldürmeyi planlamıyorsan tabii."
    },
    {
      "id": "9321841d",
      "bank_id": "90512802",
      "text": "Hey, birinin kellesi kopmadan önce kaldır şu silahı!"
    },
    {
      "id": "96b86878",
      "bank_id": "90512802",
      "text": "Silahını kaldırmanı öneririm. Hemen."
    },
    {
      "id": "96b8687b",
      "bank_id": "90512802",
      "text": "O silah hiç tekin değil!"
    },
    {
      "id": "9908c140",
      "bank_id": "90512802",
      "text": "Bak buraya, o silahı kullanmayı planlamıyorsan iyi edersin."
    },
    {
      "id": "9908c143",
      "bank_id": "90512802",
      "text": "Önüne bak vatandaş. O silah birini incitebilir."
    },
    {
      "id": "9b0bf75b",
      "bank_id": "90512802",
      "text": "Çöpün tekisin!"
    },
    {
      "id": "9c71614c",
      "bank_id": "90512802",
      "text": "Lütfen silahını kaldır. Oyuncak gibi muamele edilemeyecek kadar tehlikeli bir şey o."
    },
    {
      "id": "9c71614f",
      "bank_id": "90512802",
      "text": "O silah ciddi yaralanmalara yol açabilir."
    },
    {
      "id": "a41226c1",
      "bank_id": "90512802",
      "text": "Şey, özgün bir silah, hakkını vermek lazım."
    },
    {
      "id": "a41226c2",
      "bank_id": "90512802",
      "text": "Haha! Hayatımda gördüğüm en aptalca silah bu!"
    },
    {
      "id": "a41226c3",
      "bank_id": "90512802",
      "text": "O saçma sapan silahla şiddetin mantıksız doğasına dair bir mesaj mı vermeye çalışıyorsun?"
    },
    {
      "id": "a41226c4",
      "bank_id": "90512802",
      "text": "Haha! Nereden buldun o salakça silahı?"
    },
    {
      "id": "a41226c5",
      "bank_id": "90512802",
      "text": "Hehe! Buna silah mı diyorsun sen?! Gülünç resmen!"
    },
    {
      "id": "a8b58188",
      "bank_id": "90512802",
      "text": "Senin gibi serserilere ayıracak vaktim yok benim."
    },
    {
      "id": "a8b5818b",
      "bank_id": "90512802",
      "text": "Bir gün boylayacaksın parmaklıkların ardını, adım gibi eminim."
    },
    {
      "id": "acf1d5e4",
      "bank_id": "90512802",
      "text": "Böyle devam edersen sonun çok kötü olacak."
    },
    {
      "id": "acf1d5e5",
      "bank_id": "90512802",
      "text": "Senin gibi çocuklar midemi bulandırıyor."
    },
    {
      "id": "acf1d5e7",
      "bank_id": "90512802",
      "text": "Senin gibi veletlere tahammülüm yok."
    },
    {
      "id": "af123870",
      "bank_id": "90512802",
      "text": "Ne biçim bir silah bu böyle?! Haha!"
    },
    {
      "id": "af123872",
      "bank_id": "90512802",
      "text": "Ömrümde gördüğüm en gülünç silah bu."
    },
    {
      "id": "af123873",
      "bank_id": "90512802",
      "text": "Hihi! Buna silah mı diyorsun?! Çok komik."
    },
    {
      "id": "af123874",
      "bank_id": "90512802",
      "text": "Haha, ne, haha, bu ne be?!"
    },
    {
      "id": "af123875",
      "bank_id": "90512802",
      "text": "Haha! Silah değil ki bu! Lanet olası bir oyuncak!"
    },
    {
      "id": "b3f1e0e8",
      "bank_id": "90512802",
      "text": "Yolumdan çekil seni sokak sıçanı."
    },
    {
      "id": "b3f1e0e9",
      "bank_id": "90512802",
      "text": "Seni küçük velet."
    },
    {
      "id": "b3f1e0ea",
      "bank_id": "90512802",
      "text": "Seni mendebur çocuk."
    },
    {
      "id": "b750a9f8",
      "bank_id": "90512802",
      "text": "Pöh! Ölmek istemiyorsan daha iyi bir silaha ihtiyacın olacak!"
    },
    {
      "id": "b8225728",
      "bank_id": "90512802",
      "text": "Başkasına ateş et! Bana değil!"
    },
    {
      "id": "bb345ee1",
      "bank_id": "90512802",
      "text": "Ateş etmeyeceksin değil mi?"
    },
    {
      "id": "bc50b199",
      "bank_id": "90512802",
      "text": "Ha! Ne diyorsun sen buna?!! Ne berbat bir silah!"
    },
    {
      "id": "bd225ec9",
      "bank_id": "90512802",
      "text": "Oh, vurma beni!"
    },
    {
      "id": "c6347010",
      "bank_id": "90512802",
      "text": "Vurma beni!"
    },
    {
      "id": "d2d3a061",
      "bank_id": "90512802",
      "text": "Lütfen o silahı ait olduğu yere geri koy."
    },
    {
      "id": "d2d3a062",
      "bank_id": "90512802",
      "text": "Burası silah sallanacak yer değil. Birini incitebilirsin vatandaş."
    },
    {
      "id": "df0c7392",
      "bank_id": "90512802",
      "text": "Haha! Onu kullanamazsın ki! Herkes sana güler!"
    },
    {
      "id": "e0c944c1",
      "bank_id": "90512802",
      "text": "Geri bas orada oğlum! Senin gibilere hiç güvenmem."
    },
    {
      "id": "e0c944ca",
      "bank_id": "90512802",
      "text": "Geri bas orada kızım! Senin gibilere hiç güvenmem."
    },
    {
      "id": "e2cd87fe",
      "bank_id": "90512802",
      "text": "Birinin canını yakacaksın."
    },
    {
      "id": "e5358728",
      "bank_id": "90512802",
      "text": "Onu başka bir yere doğrultsan iyi edersin. Bir kaza çok ciddi sonuçlar doğurur."
    },
    {
      "id": "e535872b",
      "bank_id": "90512802",
      "text": "Bir kanun adamına ateş etmek intihardır. İndir şunu."
    },
    {
      "id": "e80c81ff",
      "bank_id": "90512802",
      "text": "Hihi. Şimdiye kadarki en şapşal silah bu!"
    },
    {
      "id": "ebcd95cb",
      "bank_id": "90512802",
      "text": "Hey, bu tehlikeli bir şey biliyorsun değil mi."
    },
    {
      "id": "ed194a31",
      "bank_id": "90512802",
      "text": "Lütfen vurma bana!"
    },
    {
      "id": "ed194a32",
      "bank_id": "90512802",
      "text": "Hey, o şeyi bana doğru sallama! Ben bir şey yapmadım!"
    },
    {
      "id": "ed194a33",
      "bank_id": "90512802",
      "text": "Neden onu bana doğrultuyorsun?"
    },
    {
      "id": "ed194a34",
      "bank_id": "90512802",
      "text": "Ne diye o şeyi bana doğru sallıyorsun?"
    },
    {
      "id": "ed194a35",
      "bank_id": "90512802",
      "text": "Bana vurmayı aklından bile geçirmesen iyi edersin."
    },
    {
      "id": "ef92da0d",
      "bank_id": "90512802",
      "text": "Vay canına! Harika bir silah! Dokunabilir miyim, kullanabilir miyim, lütfen lütfen?"
    },
    {
      "id": "f33d4e54",
      "bank_id": "90512802",
      "text": "Suçlu olma yolunda ilerliyorsun anlaşılan."
    },
    {
      "id": "f33d4e55",
      "bank_id": "90512802",
      "text": "Pislik küçük bir çocuksun sen."
    },
    {
      "id": "f33d4e57",
      "bank_id": "90512802",
      "text": "Küçük bir haydutsun sen sadece."
    },
    {
      "id": "f8195b60",
      "bank_id": "90512802",
      "text": "Vurma bana! Vurma bana!"
    },
    {
      "id": "f8195b62",
      "bank_id": "90512802",
      "text": "Lütfen! Vurma bana!"
    },
    {
      "id": "f8195b63",
      "bank_id": "90512802",
      "text": "Ne? Bana vurmayacaksın değil mi??"
    },
    {
      "id": "f8195b64",
      "bank_id": "90512802",
      "text": "O şeyi başkasının suratına salla, olur mu?"
    },
    {
      "id": "f8195b65",
      "bank_id": "90512802",
      "text": "Bana vurmayacaksın değil mi?"
    },
    {
      "id": "fa3d5958",
      "bank_id": "90512802",
      "text": "Ne kadar berbat bir çocuksun sen."
    },
    {
      "id": "fa3d5959",
      "bank_id": "90512802",
      "text": "Seni pislik şey!"
    },
    {
      "id": "fa3d595a",
      "bank_id": "90512802",
      "text": "Korkunç bir veletsin sen."
    },
    {
      "id": "fa92ebbc",
      "bank_id": "90512802",
      "text": "Ooo, bu kadar iyi bir silahı nasıl buldun?"
    },
    {
      "id": "fdd9c485",
      "bank_id": "90512802",
      "text": "O şeyle birini yaralayacak olursan hesabını bana verirsin."
    },
    {
      "id": "fdd9c486",
      "bank_id": "90512802",
      "text": "Burası silah kullanma yeri değil. Seni uyarıyorum."
    }
  ]
}