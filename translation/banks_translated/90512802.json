    {
      "id": "27d271ae",
      "bank_id": "90512802",
      "text": "Önüne bak! Birini öldüreceksin!"
    },
    {
      "id": "27d271af",
      "bank_id": "90512802",
      "text": "Bu gidişle kesin birinin canı yanacak."
