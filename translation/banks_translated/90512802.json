  "strings": [
    {
      "id": "09aa2da2",
      "bank_id": "90512802",
      "text": "Bir ara oynamalıyız."
    },
    {
      "id": "1c248e7a",
      "bank_id": "90512802",
      "text": "Zorda kaldığında o silah işini görüyor olmalı. Yoksa hâlâ hayatta olamazdın."
    },
    {
      "id": "1c248e7b",
      "bank_id": "90512802",
      "text": "O silahla bir sürü şey öldürdün mü?"
    },
    {
      "id": "1c248e7c",
      "bank_id": "90512802",
      "text": "O silahla çoğu düşmanın hakkından gelebiliyor olmalısın."
    },
    {
      "id": "1c248e7d",
      "bank_id": "90512802",
      "text": "Fena bir silah değil. Sırtın duvara dayandığında iş görür diye düşünüyorum."
    },
    {
      "id": "1c248e7e",
      "bank_id": "90512802",
      "text": "Silahın uzun zamandır sende mi?"
    },
    {
      "id": "1ec9e260",
      "bank_id": "90512802",
      "text": "O silahla kötü bir niyetin olmadığını umuyorum. Kaldır şunu."
    },
    {
      "id": "1ec9e263",
      "bank_id": "90512802",
      "text": "Silahını başka bir yere doğrultmanı tavsiye ederim."
    },
    {
      "id": "2232fe98",
      "bank_id": "90512802",
      "text": "Ölmek istemiyorum!"
    },
    {
      "id": "2232fe9a",
      "bank_id": "90512802",
      "text": "Dikkat etmezsen birini öldüreceksin."
    },
    {
      "id": "2232fe9b",
      "bank_id": "90512802",
      "text": "Aaa! Hayır, öldürme bizi!"
    },
    {
      "id": "2232fe9c",
      "bank_id": "90512802",
      "text": "Birinin ölümüne sebep olacaksın seni deli. O kişi ben olmasam iyi edersin."
    },
    {
      "id": "2232fe9d",
      "bank_id": "90512802",
      "text": "Birinin canı yanacak."
    },
    {
      "id": "25249c48",
      "bank_id": "90512802",
      "text": "O silah kiminle dövüşüyorsan onu alt etmeye yeter sanırım."
    },
    {
      "id": "25249c49",
      "bank_id": "90512802",
      "text": "O silahla bir sürü canavar avlamışsındır kesin."
    },
    {
      "id": "25249c4b",
      "bank_id": "90512802",
      "text": "O silahla çok canavar öldürdün mü?"
    },
    {
      "id": "25249c4e",
      "bank_id": "90512802",
      "text": "Onunla kaç kişi öldürdün?"
    },
    {
      "id": "25249c4f",
      "bank_id": "90512802",
      "text": "Evet, o silah iyi görünüyor."
    },
    {
      "id": "273306b9",
      "bank_id": "90512802",
      "text": "O silahı öylece açıkta tutmanın ne kadar tehlikeli olduğunun farkında mısın?"
    },
    {
      "id": "273306ba",
      "bank_id": "90512802",
      "text": "Ne yapıyorsun sen?! Kaldır şu silahı!"
    },
    {
      "id": "273306bb",
      "bank_id": "90512802",
      "text": "Birinin canı fena yanmadan önce kaldır şunu ortalıktan."
    },
    {
      "id": "273306bc",
      "bank_id": "90512802",
      "text": "Onunla birini yaralaman umurumda değil. Yeter ki bana dokunma, tamam mı?"
    },
    {
      "id": "273306bd",
      "bank_id": "90512802",
      "text": "O silah hiç tekin değil!"
    },
    {
      "id": "27d271a8",
      "bank_id": "90512802",
      "text": "Birini öldürtmeye mi çalışıyorsun sen?"
    },
    {
      "id": "27d271a9",
      "bank_id": "90512802",
      "text": "Dikkat et orada!"
    },
    {
      "id": "27d271aa",
      "bank_id": "90512802",
      "text": "Oh, dikkatli ol lütfen, o şey birini fena yaralayabilir."
    },
    {
      "id": "27d271ab",
      "bank_id": "90512802",
      "text": "Onunla birini sakatlayabilirsin valla."
    },
    {
      "id": "27d271ad",
      "bank_id": "90512802",
      "text": "Dikkat et! Onunla birini öldürebilirsin!"
