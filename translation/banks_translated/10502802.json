  "strings": [
    {
      "id": "02984600",
      "bank_id": "10502802",
      "text": "Hayatımızı kahkahayla dolduruyorsun canım."
    },
    {
      "id": "02984602",
      "bank_id": "10502802",
      "text": "Böyle komik biriyle evleneceğimi biliyordum zaten."
    },
    {
      "id": "02984603",
      "bank_id": "10502802",
      "text": "Böyle bir soytarıyla evlenmenin hayatı ilginç kılacağını biliyordum! Haha!"
    },
    {
      "id": "02984604",
      "bank_id": "10502802",
      "text": "Hayatı kesinlikle eğlenceli kılıyorsun canım."
    },
    {
      "id": "02984605",
      "bank_id": "10502802",
      "text": "Sen bir insanın evlenebileceği en komik kişisin."
    },
    {
      "id": "11cd2b40",
      "bank_id": "10502802",
      "text": "Senden daha az güzel biriyle asla evlenmemeliymişim."
    },
    {
      "id": "11cd2b41",
      "bank_id": "10502802",
      "text": "Yüzün her geçen gün daha da güzelleşiyor canım."
    },
    {
      "id": "11cd2b42",
      "bank_id": "10502802",
      "text": "Seni bir dikişte denizci romu gibi içebilirim!"
    },
    {
      "id": "11cd2b43",
      "bank_id": "10502802",
      "text": "Yakışıklının dibisin sen canım!"
    },
    {
      "id": "11cd2b44",
      "bank_id": "10502802",
      "text": "Şu gözlere bütün gün bakabilirim."
    },
    {
      "id": "11cd2b45",
      "bank_id": "10502802",
      "text": "Seni kaşıkla yiyebilirim!"
    },
    {
      "id": "11cd2b47",
      "bank_id": "10502802",
      "text": "Gerçekten harika görünüyorsun canım."
    },
    {
      "id": "18cd3648",
      "bank_id": "10502802",
      "text": "Ellerimi üzerinden güçlükle çekiyorum sevgilim. Hav!"
    },
    {
      "id": "18cd3649",
      "bank_id": "10502802",
      "text": "Her geçen gün daha da ateşli oluyorsun sevgilim."
    },
    {
      "id": "18cd364a",
      "bank_id": "10502802",
      "text": "Kelimelerle anlatılamayacak kadar yakışıklısın tatlım."
    },
    {
      "id": "18cd364c",
      "bank_id": "10502802",
      "text": "Yakışıklılığın beni şaşırtmaktan hiç geri kalmıyor canım."
    },
    {
      "id": "18cd364d",
      "bank_id": "10502802",
      "text": "Kesinlikle bir kadının umut edebileceği en yakışıklı eşsin."
    },
    {
      "id": "18cd364e",
      "bank_id": "10502802",
      "text": "Ne leziz bir şeftali böyle! Ham hum! Seni yiyebilirim!"
    },
    {
      "id": "18cd364f",
      "bank_id": "10502802",
      "text": "Aman tanrım, şuna bir bak! Taş gibi taş!"
    },
    {
      "id": "1c3f6960",
      "bank_id": "10502802",
      "text": "Böyle, şey, böyle saygıdeğer bir Kahramanla evli olmak ha-harika bir duygu."
    },
    {
      "id": "1c3f6961",
      "bank_id": "10502802",
      "text": "Seni kızdıracak hiçbir şey yapmam canım, valla yapmam."
    },
    {
      "id": "1c3f6963",
      "bank_id": "10502802",
      "text": "Şey, her şey yolunda mı canım? Güzel, güzel..."
    },
    {
      "id": "1c3f6964",
      "bank_id": "10502802",
      "text": "Kız-kızma lütfen canım."
    },
    {
      "id": "1c3f6965",
      "bank_id": "10502802",
      "text": "Hadi ama kız-kızma canım."
    },
    {
      "id": "1c3f6966",
      "bank_id": "10502802",
      "text": "Her... her istediğin var mı canım?"
    },
    {
      "id": "1c3f6967",
      "bank_id": "10502802",
      "text": "Kızma... lütfen... kızma canım."
    },
    {
