    {
      "id": "2ee46cb8",
      "bank_id": "10502802",
      "text": "Hayatımda güneş gibi doğuyorsun."
    },
    {
      "id": "2ee46cba",
      "bank_id": "10502802",
      "text": "Seni canımı yakacak kadar çok seviyorum."
    },
    {
      "id": "2ee46cbb",
      "bank_id": "10502802",
      "text": "Sen burada yokken hiçbir şey doğru gitmiyor."
    },
    {
      "id": "2ee46cbc",
      "bank_id": "10502802",
      "text": "Birini bu kadar sevebileceğimi hiç düşünmezdim."
    },
    {
      "id": "2ee46cbd",
      "bank_id": "10502802",
      "text": "Sana sırılsıklam aşığım."
    },
    {
      "id": "33e47459",
      "bank_id": "10502802",
      "text": "Seni patlayacak kadar çok seviyorum."
    },
    {
      "id": "33e4745a",
      "bank_id": "10502802",
      "text": "Sensiz hiçbir şeyin anlamı yok."
    },
    {
      "id": "33e4745b",
      "bank_id": "10502802",
      "text": "Sensiz hayatımın hiçbir anlamı kalmaz."
    },
    {
      "id": "33e4745c",
      "bank_id": "10502802",
      "text": "Aşkınla başımı döndürüyorsun!"
    },
    {
      "id": "33e4745d",
      "bank_id": "10502802",
      "text": "Aşkın olmadan ben bir hiçim."
    },
    {
      "id": "36a8dfd0",
      "bank_id": "10502802",
      "text": "Oh! İyisin değil mi, se-sevgilim?"
