    {
      "id": "233f7466",
      "bank_id": "10502802",
      "text": "Oh, sev-sevgilim, seni üzecek bir şey yapmamaya çalışırım."
    },
    {
      "id": "2595b152",
      "bank_id": "10502802",
      "text": "Keşke seninle hiç tanışmasaydım!"
