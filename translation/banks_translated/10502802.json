      "text": "Keşke seninle hiç tanışmasaydım!"
    },
    {
      "id": "2595b154",
      "bank_id": "10502802",
      "text": "Zamanı geri alıp seninle hiç tanışmamış olmayı öyle çok isterdim ki!"
    },
    {
      "id": "2595b155",
      "bank_id": "10502802",
      "text": "Keşke hiç karşılaşmasaydık!"
