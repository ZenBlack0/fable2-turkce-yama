    },
    {
      "id": "40a67f08",
      "bank_id": "10502802",
      "text": "Daha komik biriyle evlenemezdim, bundan eminim."
    },
    {
      "id": "40a67f09",
      "bank_id": "10502802",
      "text": "İlahi, tam bir şapşalsın aşkım."
    },
    {
      "id": "40a67f0a",
      "bank_id": "10502802",
      "text": "Eskiden hayatın çok ciddi olduğunu düşünürdüm ama sen fikrimi değiştirdin canım."
    },
    {
      "id": "40a67f0b",
      "bank_id": "10502802",
      "text": "Sevgilim, seninle bu evde kahkaha hiç eksik olmuyor."
    },
    {
      "id": "40a67f0d",
      "bank_id": "10502802",
      "text": "Umarım her zaman şimdiki kadar gülebiliriz."
    },
    {
      "id": "40a67f0e",
      "bank_id": "10502802",
      "text": "Evliliğin bu kadar eğlenceli olabileceğini kimse söylememişti."
    },
    {
      "id": "40a67f0f",
      "bank_id": "10502802",
      "text": "Yanımda sen varken yüzümde bir tebessümle yaşlanabilirim."
    },
    {
      "id": "4266a4c8",
      "bank_id": "10502802",
      "text": "Ah aşkım, ben seninim."
    },
    {
      "id": "4266a4c9",
      "bank_id": "10502802",
      "text": "Senin için can alırım."
    },
    {
      "id": "4266a4cd",
      "bank_id": "10502802",
      "text": "Sensiz yaşamaktansa ölmeyi yeğlerim."
    },
    {
      "id": "4266a4ce",
      "bank_id": "10502802",
      "text": "Bana o kadar çok iyi geliyorsun ki."
    },
    {
      "id": "4266a4cf",
      "bank_id": "10502802",
      "text": "Sonsuza dek seninim!"
    },
    {
      "id": "4ba690b8",
      "bank_id": "10502802",
      "text": "Şu şapşallığına bayılıyorum canım."
    },
    {
      "id": "4ba690b9",
      "bank_id": "10502802",
      "text": "Doğrusu, bu kadar kahkaha yüzünden bir gün dişlerim dökülecek canım."
    },
    {
      "id": "4ba690ba",
      "bank_id": "10502802",
      "text": "Hiçbir evlilik neşeyle bu kadar kutsanmamıştır."
    },
    {
      "id": "4ba690bb",
      "bank_id": "10502802",
      "text": "Evimizi kahkahalarla dolduruyorsun sevgilim."
    },
    {
      "id": "4ba690bc",
      "bank_id": "10502802",
      "text": "Senin gibi biriyle evliyken hayat asla sıkıcı olmuyor."
    },
    {
      "id": "4ba690be",
      "bank_id": "10502802",
      "text": "Ciddi biriyle kim evlenmek ister ki? Sen tam bana göresin!"
    },
    {
      "id": "4ba690bf",
      "bank_id": "10502802",
      "text": "Daha komik biriyle evlenemezdim, orası kesin."
    },
    {
      "id": "4d66b678",
      "bank_id": "10502802",
      "text": "Ruhumu tamamlıyorsun!"
    },
    {
      "id": "4d66b679",
      "bank_id": "10502802",
      "text": "Sana deliler gibi tutkunum bebeğim."
    },
    {
      "id": "4d66b67c",
      "bank_id": "10502802",
      "text": "Sonsuza dek seninim!"
    },
    {
      "id": "4d66b67e",
      "bank_id": "10502802",
      "text": "Benim her şeyimsin."
    },
    {
      "id": "4d66b67f",
      "bank_id": "10502802",
      "text": "Hayatımı güzelleştirdin."
    },
    {
      "id": "56910590",
      "bank_id": "10502802",
      "text": "Seninle evlenmek hayatımın en büyük hatasıydı!"
    },
    {
      "id": "56910591",
      "bank_id": "10502802",
      "text": "Şu lağım işçisiyle evlenseydim keşke!"
    },
    {
      "id": "56910593",
      "bank_id": "10502802",
      "text": "Seninle hiç evlenmemeliydim!"
    },
    {
      "id": "56910594",
      "bank_id": "10502802",
      "text": "Seni nasıl sevebildim ben ya?!"
    },
    {
      "id": "56910595",
      "bank_id": "10502802",
      "text": "Ciddi ciddi boşanmayı düşünüyordum..."
    },
    {
      "id": "56910596",
      "bank_id": "10502802",
      "text": "Nasıl oldu da senin gibi bir pislikle evlendim ben?"
    },
    {
      "id": "56910597",
      "bank_id": "10502802",
      "text": "Seninle evlenirken kafam güzeldi herhalde!"
    },
    {
      "id": "56d9dcb2",
      "bank_id": "10502802",
      "text": "Lavdan daha ateşlisin tatlım."
    },
    {
      "id": "56d9dcb3",
      "bank_id": "10502802",
      "text": "Dünyanın en yakışıklı perisi bile yanında çirkin kalırdı!"
    },
    {
      "id": "56d9dcb4",
      "bank_id": "10502802",
      "text": "Dünyanın en yakışıklı perisi bile yanında çirkin kalırdı!"
    },
    {
      "id": "56d9dcb5",
      "bank_id": "10502802",
      "text": "Bu kadar yakışıklı biriyle nasıl birlikte oldum ben?"
    },
    {
      "id": "56d9dcb7",
      "bank_id": "10502802",
      "text": "Tam bir afetle evlenmişim."
    },
    {
      "id": "5d911090",
      "bank_id": "10502802",
      "text": "Her geçen gün senden daha çok iğreniyorum."
    },
    {
      "id": "5d911091",
      "bank_id": "10502802",
      "text": "Yüzünü görmekten bıktım artık!"
    },
    {
      "id": "5d911092",
      "bank_id": "10502802",
      "text": "Sonra da ne diye kafayı çekip sarhoş oluyorum diye soruyorsun... Pöh!"
    },
    {
      "id": "5d911093",
      "bank_id": "10502802",
      "text": "Seninle nikâh kıymak için kafayı yemiş olmalıydım!"
    },
    {
      "id": "5d911094",
      "bank_id": "10502802",
      "text": "Ne diye evlendim ki seninle?"
    },
    {
      "id": "5d911095",
      "bank_id": "10502802",
      "text": "Ah, keşke yeniden bekâr olsaydım!"
    },
    {
      "id": "5d911096",
      "bank_id": "10502802",
      "text": "Seni gördüğüm güne lanet olsun!"
    },
    {
      "id": "5dd9e7b8",
      "bank_id": "10502802",
      "text": "Tam bir afetle evlenmişim."
    },
    {
      "id": "5dd9e7b9",
      "bank_id": "10502802",
      "text": "Dünyanın en güzel perisi bile yanında çirkin kalırdı!"
    },
    {
      "id": "5dd9e7ba",
      "bank_id": "10502802",
      "text": "Seninle güzelliğin için evlenmedim ama fena da olmadı hani!"
    },
    {
      "id": "5dd9e7be",
      "bank_id": "10502802",
      "text": "Dünyanın en güzel perisi bile yanında çirkin kalırdı!"
    },
    {
      "id": "5dd9e7bf",
      "bank_id": "10502802",
      "text": "Böyle taş gibi biriyle evlendiğime inanamıyorum."
    },
    {
      "id": "76ef9028",
      "bank_id": "10502802",
      "text": "Tek ihtiyacımız birbirimiziz."
    },
    {
      "id": "76ef9029",
      "bank_id": "10502802",
      "text": "Ömrümün geri kalanını seninle geçirmek istiyorum."
    },
    {
      "id": "76ef902a",
      "bank_id": "10502802",
      "text": "Sensiz hayatımın hiçbir anlamı kalmazdı."
    },
    {
      "id": "76ef902b",
      "bank_id": "10502802",
      "text": "Hiç kimseye karşı böyle hissetmemiştim."
    },
    {
      "id": "76ef902c",
      "bank_id": "10502802",
      "text": "Benim için soluduğum havadan bile daha önemlisin."
    },
    {
      "id": "76ef902d",
      "bank_id": "10502802",
      "text": "Senin için canımı veririm."
    },
    {
      "id": "76ef902e",
      "bank_id": "10502802",
      "text": "Seni sevdiğim gibi kimseyi sevmeyeceğim."
    },
    {
      "id": "7e6e77b0",
      "bank_id": "10502802",
      "text": "Şu gözlere bütün gün bakabilirim."
    },
    {
      "id": "7e6e77b1",
