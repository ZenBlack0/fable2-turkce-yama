    {
      "id": "df4a38e1",
      "bank_id": "10502802",
      "text": "Ciddi ciddi boşanmayı düşünüyordum..."
    },
    {
      "id": "df4a38e2",
      "bank_id": "10502802",
      "text": "Nasıl oldu da senin gibi bir pislikle evlendim ben?"
    },
    {
      "id": "df4a38e3",
      "bank_id": "10502802",
      "text": "Seninle evlenirken kafam güzeldi herhalde!"
    },
    {
      "id": "df4a38e4",
      "bank_id": "10502802",
      "text": "Seninle evlenmek hayatımın en büyük hatasıydı!"
    },
    {
      "id": "df4a38e5",
      "bank_id": "10502802",
      "text": "Şu lağım işçisiyle evlenseydim keşke!"
    },
    {
      "id": "df4a38e7",
      "bank_id": "10502802",
      "text": "Seninle hiç evlenmemeliydim!"
    },
    {
      "id": "e64a43e8",
      "bank_id": "10502802",
      "text": "Ne diye evlendim ki seninle?"
    },
    {
      "id": "e64a43e9",
      "bank_id": "10502802",
      "text": "Ah, keşke yeniden bekâr olsaydım!"
    },
    {
      "id": "e64a43ea",
      "bank_id": "10502802",
      "text": "Seni gördüğüm güne lanet olsun!"
    },
    {
      "id": "e64a43ec",
      "bank_id": "10502802",
      "text": "Her geçen gün senden daha çok iğreniyorum."
    },
    {
      "id": "e64a43ed",
      "bank_id": "10502802",
      "text": "Yüzünü görmekten bıktım artık!"
    },
    {
      "id": "e64a43ee",
      "bank_id": "10502802",
      "text": "Sonra da ne diye kafayı çekip sarhoş oluyorum diye soruyorsun... Pöh!"
    },
    {
      "id": "e64a43ef",
      "bank_id": "10502802",
      "text": "Seninle nikâh kıymak için kafayı yemiş olmalıydım!"
    },
    {
      "id": "eafff1d8",
      "bank_id": "10502802",
      "text": "Ayıkken bile seviyorum seni. Buna ne dersin?"
    },
    {
      "id": "eafff1d9",
      "bank_id": "10502802",
      "text": "Benim aradığım insan sensin! Oh evet."
    },
    {
      "id": "eafff1da",
      "bank_id": "10502802",
      "text": "Para pul iyi hoş da, seninle paylaştığımız şey... o çok daha güzel."
    },
    {
      "id": "eafff1db",
      "bank_id": "10502802",
      "text": "Nereden geldiğin umurumda bile değil. Önemli olan tek şey aşkımız."
    },
    {
      "id": "eafff1dd",
      "bank_id": "10502802",
      "text": "Hayatımdaki en önemli şey sensin."
    },
    {
      "id": "eafff1de",
      "bank_id": "10502802",
      "text": "Sensiz ne yapardım hiç bilmiyorum."
    },
    {
      "id": "eafff1df",
      "bank_id": "10502802",
      "text": "Sana tek kelimeyle bayılıyorum bebeğim."
    },
    {
      "id": "f6000308",
      "bank_id": "10502802",
      "text": "Aşk dedikleri böyle bir şey mi? Yoksa sadece sarhoş muyum?"
    },
    {
      "id": "f6000309",
      "bank_id": "10502802",
      "text": "Birine karşı böyle hissedeceğimi hiç düşünmezdim."
    },
    {
      "id": "f600030a",
      "bank_id": "10502802",
      "text": "O buzdan zırhımı birinin delebileceğini hiç sanmazdım. Ama sen başardın işte."
    },
    {
      "id": "f600030b",
      "bank_id": "10502802",
      "text": "Hayatıma yepyeni bir anlam kattın!"
    },
    {
      "id": "f600030c",
      "bank_id": "10502802",
      "text": "İçimi kıpır kıpır ediyorsun!"
    },
    {
      "id": "f600030e",
      "bank_id": "10502802",
      "text": "Seni bulduğum için o kadar mutluyum ki aşkım!"
    },
    {
      "id": "f600030f",
      "bank_id": "10502802",
      "text": "Tek bir kelime etmen yeter, seninim."
    },
    {
      "id": "f79834d1",
      "bank_id": "10502802",
      "text": "Hayatımızı kahkahayla dolduruyorsun canım."
    },
    {
      "id": "f79834d2",
      "bank_id": "10502802",
      "text": "Böyle bir soytarıyla evlenmenin hayatı ilginç kılacağını biliyordum! Haha!"
    },
    {
      "id": "f79834d3",
      "bank_id": "10502802",
      "text": "Şu şapşallığına bayılıyorum canım."
