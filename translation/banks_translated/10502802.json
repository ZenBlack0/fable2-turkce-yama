      "id": "7fef9e78",
      "bank_id": "10502802",
      "text": "Sensiz ölürüm."
    },
    {
      "id": "7fef9e79",
      "bank_id": "10502802",
      "text": "Hiç kimseyi bu kadar sevmemiştim."
    },
    {
      "id": "7fef9e7b",
      "bank_id": "10502802",
      "text": "Sen benim her şeyimsin."
    },
    {
      "id": "7fef9e7c",
      "bank_id": "10502802",
      "text": "Bu dünyadaki bütün güzelliklerin toplamısın sen."
    },
    {
      "id": "7fef9e7d",
      "bank_id": "10502802",
      "text": "Sana olan aşkımdan çatlayacak gibiyim."
    },
    {
      "id": "7fef9e7e",
      "bank_id": "10502802",
      "text": "Senden önce hayatım bir çöplüktü."
    },
    {
      "id": "7fef9e7f",
      "bank_id": "10502802",
      "text": "Benim her şeyimsin."
    },
    {
      "id": "856e82b0",
      "bank_id": "10502802",
      "text": "Güzelliğin beni şaşırtmaktan hiç geri kalmıyor canım."
    },
    {
      "id": "856e82b1",
      "bank_id": "10502802",
      "text": "Kesinlikle bir erkeğin umut edebileceği en güzel eşsin."
    },
    {
      "id": "856e82b2",
      "bank_id": "10502802",
      "text": "Ne leziz bir şeftali böyle! Ham hum! Seni yiyebilirim!"
    },
    {
      "id": "856e82b3",
      "bank_id": "10502802",
      "text": "Aman tanrım, şuna bir bak! Taş gibi taş!"
    },
    {
      "id": "856e82b4",
      "bank_id": "10502802",
      "text": "Ellerimi üzerinden güçlükle çekiyorum sevgilim. Hav!"
    },
    {
      "id": "856e82b5",
      "bank_id": "10502802",
      "text": "Her geçen gün daha da ateşli oluyorsun sevgilim."
    },
    {
      "id": "856e82b6",
      "bank_id": "10502802",
      "text": "Kelimelerle anlatılamayacak kadar güzelsin tatlım."
    },
    {
      "id": "8a5c6422",
      "bank_id": "10502802",
      "text": "Kalbimi söküp çıkarabilseydim, fiyonk yapıp sana verirdim."
    },
    {
      "id": "8a5c6423",
      "bank_id": "10502802",
      "text": "Sonsuza dek seninim."
    },
    {
      "id": "8a5c6424",
      "bank_id": "10502802",
      "text": "Aklıma senden başka kimse gelmiyor. Beni tamamlıyorsun."
    },
    {
      "id": "8a5c6425",
      "bank_id": "10502802",
      "text": "Tepeden tırnağa seninim."
    },
    {
      "id": "8a5c6427",
      "bank_id": "10502802",
      "text": "Kalbim yalnızca sana ait!"
    },
    {
      "id": "915c6f28",
      "bank_id": "10502802",
      "text": "Kalbimdeki tek kişi sensin."
    },
    {
      "id": "915c6f29",
      "bank_id": "10502802",
      "text": "Kalbimi çaldın."
    },
    {
      "id": "915c6f2a",
      "bank_id": "10502802",
      "text": "Seninim."
    },
    {
      "id": "915c6f2e",
      "bank_id": "10502802",
      "text": "Tepeden tırnağa seninim."
    },
    {
      "id": "915c6f2f",
      "bank_id": "10502802",
      "text": "Sonsuza dek seninim."
    },
    {
      "id": "b8ecf2b1",
      "bank_id": "10502802",
      "text": "Şey, her şey yolunda mı canım?"
    },
    {
      "id": "b8ecf2b2",
      "bank_id": "10502802",
      "text": "Rahatın yerinde değil mi sevgilim?"
    },
    {
      "id": "b8ecf2b3",
      "bank_id": "10502802",
      "text": "Hadi ama korkutma beni."
    },
    {
      "id": "b8ecf2b4",
      "bank_id": "10502802",
      "text": "Korkutma beni canım."
    },
    {
      "id": "b8ecf2b5",
      "bank_id": "10502802",
      "text": "Ters damarın tutmasın şimdi yine."
    },
    {
      "id": "b8ecf2b6",
      "bank_id": "10502802",
      "text": "Her şey, şey, yolunda mı aşkım?"
    },
    {
      "id": "b8ecf2b7",
      "bank_id": "10502802",
      "text": "Umarım her şey gönlüncedir aşkım."
    },
    {
      "id": "c3ed03e0",
