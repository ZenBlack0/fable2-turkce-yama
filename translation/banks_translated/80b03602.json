    },
    {
      "id": "ab0705a8",
      "bank_id": "80b03602",
      "text": "Ritüeller benim için çok önemlidir. Bir de \"sandalet giyme\" ritüelimi görmelisin."
    },
    {
      "id": "ab0705a9",
      "bank_id": "80b03602",
      "text": "Hayat pek heyecan verici sayılmaz ama geçinmek için çalışmaktan iyidir."
    },
    {
      "id": "ab0705ab",
      "bank_id": "80b03602",
      "text": "Eskiden kumar oynar ve başka nahoş işlere bulaşırdım. Sonra Işığı gördüm ve temelli değiştim."
    },
    {
      "id": "c60a0e4d",
      "bank_id": "80b03602",
      "text": "İstediğim hiçbir şey olmuyor! Hiç adil değil!"
    },
    {
      "id": "d0cf43bd",
      "bank_id": "80b03602",
      "text": "Oyun ustasını fena ezmiş diyorlar. Yığınla da para kazanmış."
    },
    {
      "id": "d10a1ffc",
      "bank_id": "80b03602",
      "text": "Bu kasaba berbat! Bıktım artık buradan!"
    },
    {
      "id": "d715227c",
      "bank_id": "80b03602",
      "text": "Karanlıkta kaç kişi kayboldu acaba? Kaybolan her bir ruha yardım etmek istiyorum."
    },
    {
      "id": "d715227d",
      "bank_id": "80b03602",
      "text": "Tüm o zavallı insanların ıssız gölgelerde hayat sürdüğünü düşünmek..."
    },
    {
      "id": "d715227e",
      "bank_id": "80b03602",
      "text": "Oakfield'de sadece hasada rehberlik etmiyoruz. İnsanların daha iyi hayatlar yaşamasına yardım ediyoruz."
    },
    {
      "id": "e8eaa770",
      "bank_id": "80b03602",
      "text": "Skorm ve Avo artık modası geçmiş kavramlar. Var olan tek şey Işık."
    },
    {
      "id": "e8eaa772",
      "bank_id": "80b03602",
      "text": "Gökyüzünde asılı duran güneş, Işığın hepimize bir armağanıdır."
    },
    {
      "id": "e8eaa773",
      "bank_id": "80b03602",
      "text": "İnsanların vaktiyle Avo'ya dua ettiğini düşünmek bile ne aptalca! Işığa hamdolsun!"
    },
    {
      "id": "e96b1004",
      "bank_id": "80b03602",
      "text": "Keşiş olmanın tek kötü yanı yemekler. Hafif yememiz öğütleniyor."
    },
    {
      "id": "e96b1006",
      "bank_id": "80b03602",
      "text": "İtiraf etmeliyim ki bütün o gece lambalarıyla uykuya dalmak bazen epey zor oluyor."
    },
    {
      "id": "e96b1007",
      "bank_id": "80b03602",
      "text": "Yeni bir mantra bulmalıyım. Yeni bir mantra bulmalıyım. Yeni bir mantra bulmalıyım. Yeni bir mantra bulmalıyım."
    },
    {
      "id": "ed05ce80",
      "bank_id": "80b03602",
      "text": "Katlanmak zorunda kaldığım şeylere inanamıyorum!"
    },
    {
      "id": "ed05ce81",
      "bank_id": "80b03602",
      "text": "Yetti artık! Yetti!"
    },
    {
      "id": "ed05ce82",
      "bank_id": "80b03602",
      "text": "Her şeyden nefret ediyorum!"
    },
    {
      "id": "ed05ce84",
      "bank_id": "80b03602",
      "text": "Bazen hayat öyle... öyle çıldırtıcı olabiliyor ki!"
    },
    {
      "id": "ed05ce85",
      "bank_id": "80b03602",
      "text": "Söylemekten çekinmiyorum, aşırı derecede öfkeliyim!"
    },
    {
      "id": "ed05ce86",
      "bank_id": "80b03602",
      "text": "Hobbe aşkına! Yetti artık!"
    },
    {
      "id": "ed05ce87",
      "bank_id": "80b03602",
      "text": "Bir eniği tekmeleyebilirim şu an! Gah!"
    },
    {
      "id": "ed4ce585",
      "bank_id": "80b03602",
      "text": "Tapınağımızın müjdesini tüm dünyaya yaymak istiyorum. Yoksa küp mü demeliydim?"
    },
    {
      "id": "ed4ce586",
      "bank_id": "80b03602",
      "text": "İyi haberi duydun mu? Işık her şeyi kucaklıyor! Gerçi pek yeni bir haber sayılmaz bu..."
    },
    {
      "id": "ed4ce587",
      "bank_id": "80b03602",
      "text": "Biz keşişlere çikolata yasaktır. Çok karanlık ve Işıktan çok uzak. Belki günün birinde beyaz çikolatayı icat ederiz."
    },
    {
      "id": "f605dce8",
      "bank_id": "80b03602",
      "text": "Birinin gözlerini oymaya hazırım şu an!"
    },
    {
      "id": "f605dce9",
      "bank_id": "80b03602",
      "text": "Öyle kızgınım ki anlatamam!"
    },
    {
      "id": "f605dcea",
      "bank_id": "80b03602",
      "text": "Bıktım usandım. Bana kalsa hepsi hobbe'lerin eline düşsün!"
    },
    {
      "id": "f605dceb",
      "bank_id": "80b03602",
      "text": "Neden her şey bu kadar berbat?!"
    },
    {
      "id": "f605dcec",
      "bank_id": "80b03602",
      "text": "Buna daha ne kadar katlanabilirim bilmiyorum. Gerçekten bilmiyorum!"
    },
    {
      "id": "f605dced",
      "bank_id": "80b03602",
      "text": "Burası beni delirtiyor!"
    },
    {
      "id": "f605dcef",
      "bank_id": "80b03602",
      "text": "Her gün aynı lanet şey yahu!"
    }
