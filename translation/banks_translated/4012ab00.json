{
  "bank_id": "4012ab00",
  "total_strings": 221,
  "strings": [
    {
      "id": "0471c678",
      "bank_id": "4012ab00",
      "text": "Bazen çok tatlı olabiliyorsun."
    },
    {
      "id": "0471c679",
      "bank_id": "4012ab00",
      "text": "Hâlâ önemsediğini görmek güzel."
    },
    {
      "id": "0471c67a",
      "bank_id": "4012ab00",
      "text": "Evliliğimizin ateşini nasıl canlı tutacağını kesinlikle biliyorsun."
    },
    {
      "id": "0471c67b",
      "bank_id": "4012ab00",
      "text": "Çok tatlısın sevgilim."
    },
    {
      "id": "0471c67c",
      "bank_id": "4012ab00",
      "text": "Çok incesin hayatım."
    },
    {
      "id": "0471c67e",
      "bank_id": "4012ab00",
      "text": "Çok tatlısın canım."
    },
    {
      "id": "0471c67f",
      "bank_id": "4012ab00",
      "text": "Ne kadar düşüncelisin canım."
    },
    {
      "id": "0744b010",
      "bank_id": "4012ab00",
      "text": "Çok güzel!"
    },
    {
      "id": "0744b011",
      "bank_id": "4012ab00",
      "text": "Ne kadar da tatlısın sen öyle?"
    },
    {
      "id": "0744b012",
      "bank_id": "4012ab00",
      "text": "Çok naziksin."
    },
    {
      "id": "0744b013",
      "bank_id": "4012ab00",
      "text": "Yastığımın altında saklayacağım bunu."
    },
    {
      "id": "0744b014",
      "bank_id": "4012ab00",
      "text": "Bana mı? Çok güzel!"
    },
    {
      "id": "0744b016",
      "bank_id": "4012ab00",
      "text": "Ne tatlısın."
    },
    {
      "id": "0744b017",
      "bank_id": "4012ab00",
      "text": "Çok romantiksin."
    },
    {
      "id": "0985f56d",
      "bank_id": "4012ab00",
      "text": "Pekâlâ, bunu al da bir şeyler ye."
    },
    {
      "id": "0c44b830",
      "bank_id": "4012ab00",
      "text": "Hediye almaya pek alışkın değilim..."
    },
    {
      "id": "0c44b831",
      "bank_id": "4012ab00",
      "text": "Sen bir hazinesin vallahi."
    },
    {
      "id": "0c44b832",
      "bank_id": "4012ab00",
      "text": "Bu gerçekten çok dokunaklı, teşekkür ederim."
    },
    {
      "id": "0c44b833",
      "bank_id": "4012ab00",
      "text": "Ne kadar dokunaklı!"
    },
    {
      "id": "0c44b835",
      "bank_id": "4012ab00",
      "text": "Çok sevdim! Teşekkürler."
    },
    {
      "id": "0c44b836",
      "bank_id": "4012ab00",
      "text": "Bunu sonsuza dek saklayacağım."
    },
    {
      "id": "0c44b837",
      "bank_id": "4012ab00",
      "text": "Teşekkür ederim. Çok tatlısın."
    },
    {
      "id": "1486069c",
      "bank_id": "4012ab00",
      "text": "Pekâlâ öyleyse ama boşa harcama."
    },
    {
      "id": "1996db11",
      "bank_id": "4012ab00",
      "text": "Ooooo!"
    },
    {
      "id": "1de30cd4",
      "bank_id": "4012ab00",
      "text": "Benim altınıma ihtiyacın yok senin, yalancı."
    },
    {
      "id": "22e314f5",
      "bank_id": "4012ab00",
      "text": "Çocuklardan para dilenilmez."
    },
    {
      "id": "23cdf8f0",
      "bank_id": "4012ab00",
      "text": "Şansına küs. Ha ha."
    },
    {
      "id": "23cdf8f1",
      "bank_id": "4012ab00",
      "text": "Benden bir şey alacağını sanıyorsan fena halde yanılıyorsun."
    },
    {
      "id": "23cdf8f4",
      "bank_id": "4012ab00",
      "text": "Dilencilere asla para vermemek gibi bir ilkem var."
    },
    {
      "id": "23cdf8f6",
      "bank_id": "4012ab00",
      "text": "Beni yalnız bırak."
    },
    {
      "id": "23cdf8f7",
      "bank_id": "4012ab00",
      "text": "Sana hiçbir şey vermiyorum. Hadi kış kış!"
    },
    {
      "id": "2496ec40",
      "bank_id": "4012ab00",
      "text": "Voooo!"
    },
    {
      "id": "28ce0090",
      "bank_id": "4012ab00",
      "text": "Bazılarımız altınımızı kazanmak için çalışmak zorundayız, biliyorsun değil mi?"
    },
    {
      "id": "28ce0091",
      "bank_id": "4012ab00",
      "text": "Şu an hiç hayırsever havamda değilim."
    },
    {
      "id": "28ce0095",
      "bank_id": "4012ab00",
      "text": "Bu da bir tür köşeyi dönme numarası mı?"
    },
    {
      "id": "28ce0096",
      "bank_id": "4012ab00",
      "text": "Şu an hiç hayırsever havamda değilim, tamam mı?"
    },
    {
      "id": "28ce0097",
      "bank_id": "4012ab00",
      "text": "Bunun yerine bir işe girmeyi denesene."
    },
    {
      "id": "3ebe8a78",
      "bank_id": "4012ab00",
      "text": "Vay canına! Senden bir hediye ha!"
    },
    {
      "id": "3ebe8a79",
      "bank_id": "4012ab00",
      "text": "Sen mi?? Bunu *bana* mı vermek istiyorsun?? Altıma kaçıracağım galiba."
    },
    {
      "id": "3ebe8a7a",
      "bank_id": "4012ab00",
      "text": "Ne-- sen mi? Ne-- ben mi? Bu olağanüstülük karşısında patlayabilirim! Teşekkür ederim!"
    },
    {
      "id": "3ebe8a7b",
      "bank_id": "4012ab00",
      "text": "Aman tanrım. Çocuklar bunu duyana kadar bekleyin!"
    },
    {
      "id": "3ebe8a7d",
      "bank_id": "4012ab00",
      "text": "Bana mı? Gerçekten mi? Bu... bu... harika!"
    },
    {
      "id": "3ebe8a7e",
      "bank_id": "4012ab00",
      "text": "İnanamıyorum! Gerçekten böyle mi hissediyorsun? Vay canına!"
    },
    {
      "id": "3ebe8a7f",
      "bank_id": "4012ab00",
      "text": "Diyecek söz bulamıyorum! Vay be. Sen! Bana! Bunu veriyorsun!"
    },
    {
      "id": "46ded070",
      "bank_id": "4012ab00",
      "text": "Üzerimde hiç bozukluk yok. Kusura bakma."
    },
    {
      "id": "46ded071",
      "bank_id": "4012ab00",
      "text": "Dürüst insanlardan para koparmaya çalıştığın için kendinden utanmalısın."
    },
    {
      "id": "46ded073",
      "bank_id": "4012ab00",
      "text": "Altınımı almanın imkânı yok."
    },
    {
      "id": "46ded074",
      "bank_id": "4012ab00",
      "text": "Sadakamı gerçekten ihtiyacı olanlara saklarım."
    },
    {
      "id": "46ded075",
      "bank_id": "4012ab00",
      "text": "Bazı insanların başkalarından para sızdırmak için yaptıkları tam bir rezillik."
    },
    {
      "id": "46ded076",
      "bank_id": "4012ab00",
      "text": "Verecek tek bir kuruşum bile yok."
    },
    {
      "id": "46ded077",
      "bank_id": "4012ab00",
      "text": "Senin gibilere verecek hiçbir şeyim yok."
    },
    {
      "id": "49be9ba8",
      "bank_id": "4012ab00",
      "text": "Sen mi?? Bunu *bana* mı vermek istiyorsun?? Sanırım küçük bir kaza geçireceğim..."
    },
    {
      "id": "49be9ba9",
      "bank_id": "4012ab00",
      "text": "Hadi canım! Peşimde bir şöhret olacağı hiç aklıma gelmezdi! Çok minnettarım!"
    },
    {
      "id": "49be9baa",
      "bank_id": "4012ab00",
      "text": "Bu görülmemiş bir şey! Ben... ne diyeceğimi bilemiyorum!"
    },
    {
      "id": "49be9bab",
      "bank_id": "4012ab00",
      "text": "Ne- sen- ne- ah! Bu olağanüstülük karşısında patlayabilirim! Teşekkürler!"
    },
    {
      "id": "49be9bac",
      "bank_id": "4012ab00",
      "text": "Bana mı? Gerçekten mi? Harika bir şey bu!"
    },
    {
      "id": "49be9bae",
      "bank_id": "4012ab00",
      "text": "Çok özel birinden çok özel bir hediye..."
    },
    {
      "id": "49be9baf",
      "bank_id": "4012ab00",
      "text": "Bunu bana mı veriyorsun?! Beni utandıracaksın!"
    },
    {
      "id": "4ddedb70",
      "bank_id": "4012ab00",
      "text": "Senden çok daha muhtaç durumda olanlar var."
    },
    {
      "id": "4ddedb71",
      "bank_id": "4012ab00",
      "text": "Gerçek bir dilenci olduğuna bir an bile inanmıyorum."
    },
    {
      "id": "4ddedb72",
      "bank_id": "4012ab00",
      "text": "Beni kandıramazsın."
    },
    {
      "id": "4ddedb73",
      "bank_id": "4012ab00",
      "text": "Ne? Benim altına ihtiyacım yok mu sanki?"
    },
    {
      "id": "4ddedb74",
      "bank_id": "4012ab00",
      "text": "Sen gerçek bir dilenci değilsin."
    },
    {
      "id": "4ddedb75",
      "bank_id": "4012ab00",
      "text": "Kimi dolandırmaya çalışıyorsun sen?? Git başımdan."
    },
    {
      "id": "4ddedb76",
      "bank_id": "4012ab00",
      "text": "Sana verecek hiçbir şeyim yok."
    },
    {
      "id": "625264f0",
      "bank_id": "4012ab00",
      "text": "Ne harika. Teşekkür ederim!"
    },
    {
      "id": "625264f1",
      "bank_id": "4012ab00",
      "text": "Pek harika bir şeymiş bu. Sağ ol!"
    },
    {
      "id": "625264f3",
      "bank_id": "4012ab00",
      "text": "Ne harika. Sağ ol!"
    },
    {
      "id": "625264f4",
      "bank_id": "4012ab00",
      "text": "Çok romantiksin. Teşekkürler!"
    },
    {
      "id": "625264f5",
      "bank_id": "4012ab00",
      "text": "Ne hoş, ne romantik bir jest. Teşekkür ederim!"
    },
    {
      "id": "625264f6",
      "bank_id": "4012ab00",
      "text": "Pek romantiksin vallahi. Sağ olasın!"
    },
    {
      "id": "625264f7",
      "bank_id": "4012ab00",
      "text": "Romantik havada mısın bakalım? Sağ ol!"
    },
    {
      "id": "63a1c2b9",
      "bank_id": "4012ab00",
      "text": "Aslında yapmamamız gerek ama peki öyleyse."
    },
    {
      "id": "63a1c2ba",
      "bank_id": "4012ab00",
      "text": "Bir muhafız zor durumdaki vatandaşa her zaman yardım eder."
    },
    {
      "id": "69526ff0",
      "bank_id": "4012ab00",
      "text": "Çok ama çok romantik. Teşekkürler!"
    },
    {
      "id": "69526ff1",
      "bank_id": "4012ab00",
      "text": "Çok ama çok romantik. Teşekkürler!"
    },
    {
      "id": "69526ff2",
      "bank_id": "4012ab00",
      "text": "Pek bir romantik bu. Sağ olasın!"
    },
    {
      "id": "69526ff3",
      "bank_id": "4012ab00",
      "text": "İşte buna romantik denir. Sağ ol!"
    },
    {
      "id": "69526ff4",
      "bank_id": "4012ab00",
      "text": "Çok düşüncelisin. Sağ ol!"
    },
    {
      "id": "69526ff5",
      "bank_id": "4012ab00",
      "text": "Gerçekten pek hoş bir şey bu. Teşekkürler."
    },
    {
      "id": "69526ff6",
      "bank_id": "4012ab00",
      "text": "Ne harika. Teşekkürler!"
    },
    {
      "id": "7262a039",
      "bank_id": "4012ab00",
      "text": "Yalan yere dilendiğin için seni zindana atmadığıma dua et."
    },
    {
      "id": "7262a03a",
      "bank_id": "4012ab00",
      "text": "Bu bir şaka mı? Seni tutuklamam gerekir aslında."
    },
    {
      "id": "7c8cdf40",
      "bank_id": "4012ab00",
      "text": "İş bulamadın mı? Al bakalım, şu artıkları al."
    },
    {
      "id": "7c8cdf41",
      "bank_id": "4012ab00",
      "text": "Sokaklarda yaşamak kolay değil. Al bakalım."
    },
    {
      "id": "7c8cdf44",
      "bank_id": "4012ab00",
      "text": "Birazcık ayırabilirim sanırım."
    },
    {
      "id": "7c8cdf46",
      "bank_id": "4012ab00",
      "text": "Düşkünleri her zaman gözetmeliyiz."
    },
    {
      "id": "7c8cdf47",
      "bank_id": "4012ab00",
      "text": "Bunu al ama daha fazlası için dilenmeye kalkma."
    },
    {
      "id": "7dce0aa0",
      "bank_id": "4012ab00",
      "text": "Ne diyeceğimi bilemiyorum! Sizin gibi yüce birinden gelmesi öyle beklenmedik ki."
    },
    {
      "id": "7dce0aa1",
      "bank_id": "4012ab00",
      "text": "Ne diyeceğimi bilemiyorum! Milyonlarca kez teşekkürler."
    },
    {
      "id": "7dce0aa2",
      "bank_id": "4012ab00",
      "text": "Vay canına! Gerçekten mi? Vay be!"
    },
    {
      "id": "7dce0aa3",
      "bank_id": "4012ab00",
      "text": "Bana mı?! Gerçekten mi? Sizin gibi birinin benim gibi birini fark edeceğini hiç düşünmezdim."
    },
    {
      "id": "7dce0aa4",
      "bank_id": "4012ab00",
      "text": "Dondum kaldım resmen! Benim gibi birine bir hediye ha?!"
    },
    {
      "id": "7dce0aa5",
      "bank_id": "4012ab00",
      "text": "Vay canına! Diyecek söz bulamıyorum. Teşekkür ederim!"
    },
    {
      "id": "7dce0aa7",
      "bank_id": "4012ab00",
      "text": "Sizin gibi ünlü birinin benim gibi bir hiç kimseyi fark edeceğine inanamıyorum."
    },
    {
      "id": "818ce765",
      "bank_id": "4012ab00",
      "text": "Beni kandırmaya çalışmıyorsun, değil mi? Tamam öyleyse."
    },
    {
      "id": "84ce15a8",
      "bank_id": "4012ab00",
      "text": "Ünlü birinin bana böyle bir şey vereceğine inanamıyorum!"
    },
    {
      "id": "84ce15a9",
      "bank_id": "4012ab00",
      "text": "B... b... bana mı?! İnanamıyorum!"
    },
    {
      "id": "84ce15aa",
      "bank_id": "4012ab00",
      "text": "Vay... tek kelimeyle harika! Teşekkürler!"
    },
    {
      "id": "84ce15ad",
      "bank_id": "4012ab00",
      "text": "Diyecek söz bulamıyorum! Tek kelime bile!"
    },
    {
      "id": "84ce15ae",
      "bank_id": "4012ab00",
      "text": "Ünlü biri bana kur yapıyor. İnanamıyorum!"
    },
    {
      "id": "a75f15e4",
      "bank_id": "4012ab00",
      "text": "Bunu her zaman saklayacağım."
    },
    {
      "id": "a75f15e5",
      "bank_id": "4012ab00",
      "text": "Bana mı? Çok tatlısın."
    },
    {
      "id": "a75f15e6",
      "bank_id": "4012ab00",
      "text": "Pek de güzelmiş. Hi hi!"
    },
    {
      "id": "a75f15e7",
      "bank_id": "4012ab00",
      "text": "Beni utandıracaksın vallahi."
    },
    {
      "id": "a8c0f3a1",
      "bank_id": "4012ab00",
      "text": "Daha tatlı olabilir miydin acaba?"
    },
    {
      "id": "a8c0f3a2",
      "bank_id": "4012ab00",
      "text": "Çok tatlısın!"
    },
    {
      "id": "a8c0f3a3",
      "bank_id": "4012ab00",
      "text": "Bu çok ama çok tatlı!"
    },
    {
      "id": "a8c0f3a4",
      "bank_id": "4012ab00",
      "text": "Ne tatlı!"
    },
    {
      "id": "a8c0f3a5",
      "bank_id": "4012ab00",
      "text": "Çok tatlı!"
    },
    {
      "id": "a8c0f3a6",
      "bank_id": "4012ab00",
      "text": "Ne tatlı bir sevgilisin sen!"
    },
    {
      "id": "a8c0f3a7",
      "bank_id": "4012ab00",
      "text": "Bu çok ama çok tatlı!"
    },
    {
      "id": "ae5f20e0",
      "bank_id": "4012ab00",
      "text": "Bana daima seni hatırlatacak. Teşekkürler."
    },
    {
      "id": "ae5f20e1",
      "bank_id": "4012ab00",
      "text": "Bu hediyeyle ruhuma dokundun."
    },
    {
      "id": "ae5f20e2",
      "bank_id": "4012ab00",
      "text": "Bunu cebimden hiç çıkarmayacağım!"
    },
    {
      "id": "ae5f20e3",
      "bank_id": "4012ab00",
      "text": "Pek de hoş bir şeymiş bu."
    },
    {
      "id": "ae5f20e4",
      "bank_id": "4012ab00",
      "text": "Çok hoş, teşekkürler."
    },
    {
      "id": "ae5f20e5",
      "bank_id": "4012ab00",
      "text": "Bir erkeğin kalbine nasıl girileceğini gerçekten biliyorsun."
    },
    {
      "id": "ae5f20e6",
      "bank_id": "4012ab00",
      "text": "Çok duygulandım!"
    },
    {
      "id": "b080ec20",
      "bank_id": "4012ab00",
      "text": "Zavallıcık. Aç kalmanın ne demek olduğunu bilirim."
    },
    {
      "id": "b080ec21",
      "bank_id": "4012ab00",
      "text": "Pekâlâ öyleyse, al bunu ama beni yalnız bırak, tamam mı?"
    },
    {
      "id": "b080ec22",
      "bank_id": "4012ab00",
      "text": "Pekâlâ öyleyse, al bunu ama beni yalnız bırak, anlaştık mı?"
    },
    {
      "id": "b080ec24",
      "bank_id": "4012ab00",
      "text": "Elbette seni zavallı yaratık."
    },
    {
      "id": "b080ec25",
      "bank_id": "4012ab00",
      "text": "İnsan daima hayırsever olmalı."
    },
    {
      "id": "b080ec26",
      "bank_id": "4012ab00",
      "text": "Ben de vaktiyle az dilenmedim, birazını geri vereyim bari."
    },
    {
      "id": "b080ec27",
      "bank_id": "4012ab00",
      "text": "Verecek pek bir şeyim yok ama al bakalım."
    },
    {
      "id": "b3c104d0",
      "bank_id": "4012ab00",
      "text": "Çok romantiksin."
    },
    {
      "id": "b3c104d2",
      "bank_id": "4012ab00",
      "text": "Ne kadar da romantiksin!"
    },
    {
      "id": "b3c104d3",
      "bank_id": "4012ab00",
      "text": "Pek romantik bir jest doğrusu."
    },
    {
      "id": "b3c104d4",
      "bank_id": "4012ab00",
      "text": "Pek tatlı birisin doğrusu."
    },
    {
      "id": "b3c104d5",
      "bank_id": "4012ab00",
      "text": "Pek tatlı birisin sen, değil mi?"
    },
    {
      "id": "b3c104d6",
      "bank_id": "4012ab00",
      "text": "Daha tatlı bir şey görmemiştim!"
    },
    {
      "id": "b3c104d7",
      "bank_id": "4012ab00",
      "text": "Bu çok ama çok tatlı!"
    },
    {
      "id": "b980fa08",
      "bank_id": "4012ab00",
      "text": "Zavallı dilenci. Al, biraz altın al."
    },
    {
      "id": "b980fa09",
      "bank_id": "4012ab00",
      "text": "Kimse aç kalmamalı. Al bakalım."
    },
    {
      "id": "b980fa0a",
      "bank_id": "4012ab00",
