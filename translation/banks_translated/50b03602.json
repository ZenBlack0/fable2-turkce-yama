  "strings": [
    {
      "id": "01089db9",
      "bank_id": "50b03602",
      "text": "Hiç bu kadar iyi olmamıştım!"
    },
    {
      "id": "01089dba",
      "bank_id": "50b03602",
      "text": "Ah, şu an her şey öyle harika ki."
    },
    {
      "id": "01089dbb",
      "bank_id": "50b03602",
      "text": "İşler benim için bayağı iyi gidiyor, sağ olasın."
    },
    {
      "id": "01089dbc",
      "bank_id": "50b03602",
      "text": "Hayatımda ilk defa cidden mutluyum."
    },
    {
      "id": "01089dbd",
      "bank_id": "50b03602",
      "text": "Kader son zamanlarda yüzüme gülüyor."
    },
    {
      "id": "0f11293c",
      "bank_id": "50b03602",
      "text": "Hayatımın en güzel gününü yaşıyorum!"
    },
    {
      "id": "12ac215e",
      "bank_id": "50b03602",
      "text": "Vaaaaaah."
    },
    {
      "id": "12ac215f",
      "bank_id": "50b03602",
      "text": "Vaaaaaah."
    },
    {
      "id": "23462a3d",
      "bank_id": "50b03602",
      "text": "Ben... ben eve gitmek istiyorum..."
    },
    {
      "id": "2628f211",
      "bank_id": "50b03602",
      "text": "Ohh, *iç çeker*"
    },
    {
      "id": "2628f212",
      "bank_id": "50b03602",
      "text": "Ohh, *iç çeker*"
    },
    {
      "id": "2628f213",
      "bank_id": "50b03602",
      "text": "Ohh, *iç çeker*"
    },
    {
      "id": "2628f214",
      "bank_id": "50b03602",
      "text": "Ohh, *iç çeker*"
    },
    {
      "id": "2628f215",
      "bank_id": "50b03602",
      "text": "Ohh, *iç çeker*"
    },
    {
      "id": "2628f216",
      "bank_id": "50b03602",
      "text": "Ohh, *iç çeker*"
    },
    {
      "id": "2628f217",
      "bank_id": "50b03602",
      "text": "Ohh, *iç çeker*"
    },
    {
      "id": "2acf7490",
      "bank_id": "50b03602",
      "text": "Hiçbir şey keyfimi kaçıramaz."
    },
    {
      "id": "2acf7491",
      "bank_id": "50b03602",
      "text": "Her gün bayram gibi geçiyor, değil mi?"
    },
    {
      "id": "2acf7494",
      "bank_id": "50b03602",
      "text": "Her şey çok güzel!"
    },
    {
      "id": "2acf7496",
      "bank_id": "50b03602",
      "text": "İnsanın şarkılara başlayıp dans edesi gelmiyor mu sence de?"
    },
    {
      "id": "2acf7497",
      "bank_id": "50b03602",
      "text": "Ah, fevkalade bir gün daha."
    },
    {
      "id": "2e463b6c",
      "bank_id": "50b03602",
      "text": "Annemi istiyorum..."
    },
    {
      "id": "2fcf7cb0",
      "bank_id": "50b03602",
      "text": "Şu an o kadar mutluyum ki bir hobbe'yi bile öpebilirim."
    },
    {
      "id": "2fcf7cb1",
      "bank_id": "50b03602",
      "text": "Ahhh, pislik içindeki bir hobbe kadar mutluyum."
    },
    {
      "id": "2fcf7cb5",
      "bank_id": "50b03602",
      "text": "Dünya harika bir yer."
    },
    {
      "id": "2fcf7cb6",
      "bank_id": "50b03602",
      "text": "Ahhh, gülümsemekten kendimi alamıyorum! Belli olmasa bile!"
    },
    {
      "id": "2fcf7cb7",
      "bank_id": "50b03602",
      "text": "Hayat bundan daha güzel olamazdı."
    },
    {
      "id": "31290340",
      "bank_id": "50b03602",
      "text": "<sighs>"
    },
    {
      "id": "31290342",
      "bank_id": "50b03602",
      "text": "Ohh, *iç çeker*"
    },
    {
      "id": "31290343",
      "bank_id": "50b03602",
      "text": "Ohh, *iç çeker*"
    },
    {
      "id": "31290344",
      "bank_id": "50b03602",
      "text": "Ohh, *iç çeker*"
    },
    {
      "id": "31290345",
      "bank_id": "50b03602",
      "text": "Ohh, *iç çeker*"
    },
    {
      "id": "31290346",
      "bank_id": "50b03602",
      "text": "Ohh, *iç çeker*"
    },
    {
      "id": "31290347",
      "bank_id": "50b03602",
      "text": "Ohh, *iç çeker*"
    },
    {
      "id": "35b6ce60",
      "bank_id": "50b03602",
      "text": "Daha iyi günlerim olmuştu doğrusu."
    },
    {
      "id": "35b6ce61",
      "bank_id": "50b03602",
      "text": "Nasıl hissettiğim kimin umurunda ki?"
    },
    {
      "id": "35b6ce62",
      "bank_id": "50b03602",
      "text": "Hüzün ruhumu karanlık, koca bir girdap gibi dolduruyor."
    },
    {
      "id": "35b6ce63",
      "bank_id": "50b03602",
      "text": "Ah, elimden geldiğince dayanmaya çalışıyorum."
    },
    {
      "id": "35b6ce64",
      "bank_id": "50b03602",
      "text": "Dürüst olmak gerekirse hiç iyi değilim. Hem de hiç."
    },
    {
      "id": "35b6ce66",
      "bank_id": "50b03602",
      "text": "Çoğu gece ağlayarak uyuyakalıyorum, sorunun cevabı buysa eğer."
    },
    {
      "id": "35b6ce67",
      "bank_id": "50b03602",
      "text": "*iç çeker* Cidden umurunda olur muydu ki? Sırf nezaketen soruyorsun işte."
    },
    {
      "id": "3ab6d600",
      "bank_id": "50b03602",
      "text": "Sabahları yataktan zor çıkıyorum."
    },
    {
      "id": "3ab6d601",
      "bank_id": "50b03602",
      "text": "Ah, beni yalnız bırakın..."
    },
    {
      "id": "3ab6d602",
      "bank_id": "50b03602",
      "text": "Çaresizliğin en dipsiz kuyularındayım."
    },
    {
      "id": "3ab6d603",
      "bank_id": "50b03602",
      "text": "Keder içindeyim."
    },
    {
      "id": "3ab6d605",
      "bank_id": "50b03602",
      "text": "Hiçbir şeyin ne anlamı var ki? Yani gerçekten."
    },
    {
      "id": "3ab6d606",
      "bank_id": "50b03602",
      "text": "Her şey o kadar anlamsız geliyor ki. *iç çeker*"
    },
    {
      "id": "3ab6d607",
      "bank_id": "50b03602",
      "text": "İnsanın oturup ağlayası gelmiyor mu?"
    },
    {
      "id": "3b1eda41",
      "bank_id": "50b03602",
      "text": "*burnunu çeker* Hayat hiç adil değil."
    },
    {
      "id": "3ba7e4f7",
      "bank_id": "50b03602",
      "text": "<whimper>"
    },
    {
      "id": "3ffbf390",
      "bank_id": "50b03602",
      "text": "Diri diri diri."
    },
    {
      "id": "3ffbf391",
      "bank_id": "50b03602",
      "text": "Diri diri diri."
    },
    {
      "id": "3ffbf393",
      "bank_id": "50b03602",
      "text": "<whistles>"
    },
    {
      "id": "3ffbf396",
      "bank_id": "50b03602",
      "text": "Diri diri diri."
    },
    {
      "id": "3ffbf397",
      "bank_id": "50b03602",
      "text": "Diri diri diri."
    },
    {
      "id": "42a7effa",
      "bank_id": "50b03602",
      "text": "Vaaaaaah."
    },
    {
      "id": "437b7f21",
      "bank_id": "50b03602",
      "text": "Doğruyu söylemek gerekirse bazen öyle korkuyorum ki yatağın altına saklanmak istiyorum."
    },
    {
      "id": "437b7f22",
      "bank_id": "50b03602",
      "text": "Endişeliyim, dürüst olmak gerekirse çok endişeliyim."
    },
    {
      "id": "437b7f23",
      "bank_id": "50b03602",
      "text": "Küçük bir çocuk gibi korkuyorum."
    },
    {
      "id": "437b7f24",
      "bank_id": "50b03602",
      "text": "Şey, son zamanlarda çok don değiştirir oldum."
    },
    {
      "id": "437b7f25",
      "bank_id": "50b03602",
      "text": "Neden soruyorsun? Bir şey mi biliyorsun yoksa? Söyle bana!"
    },
    {
      "id": "437b7f26",
      "bank_id": "50b03602",
      "text": "Boynumun üstünde bir balta sallansaydı bile bundan daha fazla dehşete kapılamazdım."
    },
    {
      "id": "437b7f27",
      "bank_id": "50b03602",
      "text": "Daha fazla kaygılı olamazdım herhalde."
    },
    {
      "id": "45cb5827",
      "bank_id": "50b03602",
      "text": "Vaaaaaah."
    },
    {
      "id": "461eebf0",
      "bank_id": "50b03602",
      "text": "*burnunu çeker* Neden? Neden?"
    },
    {
      "id": "46fbfe92",
      "bank_id": "50b03602",
      "text": "Diri diri diri."
    },
    {
      "id": "46fbfe93",
      "bank_id": "50b03602",
      "text": "Diri diri diri."
    },
    {
      "id": "46fbfe94",
      "bank_id": "50b03602",
      "text": "Diri diri diri."
    },
    {
      "id": "46fbfe95",
      "bank_id": "50b03602",
      "text": "Diri diri diri."
    },
    {
      "id": "46fbfe96",
      "bank_id": "50b03602",
      "text": "Diri diri diri."
    },
    {
      "id": "4ccb632a",
      "bank_id": "50b03602",
      "text": "Vaaaaaah."
    },
    {
      "id": "4e7b9050",
      "bank_id": "50b03602",
      "text": "Dehşet içindeyim, kesinlikle dehşet içindeyim."
    },
    {
      "id": "4e7b9052",
      "bank_id": "50b03602",
      "text": "Hayatımda hiç olmadığım kadar korkuyorum."
    },
    {
      "id": "4e7b9053",
      "bank_id": "50b03602",
      "text": "Keşke her şey bitseydi artık. Bütün bunlar... çok fazla geliyor."
    },
    {
      "id": "4e7b9054",
      "bank_id": "50b03602",
      "text": "Açıkçası biraz korkuyorum."
    },
    {
      "id": "4e7b9055",
      "bank_id": "50b03602",
      "text": "Korkudan taş kesildim."
    },
    {
      "id": "4e7b9056",
      "bank_id": "50b03602",
      "text": "Ah, hiç bu kadar ürktüğümü hatırlamıyorum."
    },
    {
      "id": "4e7b9057",
      "bank_id": "50b03602",
      "text": "Hiç bu kadar korkmamıştım."
    },
    {
      "id": "523826e1",
      "bank_id": "50b03602",
      "text": "Ah, her zamanki gibi."
    },
    {
      "id": "523826e2",
      "bank_id": "50b03602",
      "text": "Şikâyet edemem. Sızlanmamak gerek."
    },
    {
      "id": "523826e3",
      "bank_id": "50b03602",
      "text": "Eh, fena değil herhalde."
    },
    {
      "id": "523826e4",
      "bank_id": "50b03602",
      "text": "İyiyim sanırım."
    },
    {
      "id": "523826e5",
      "bank_id": "50b03602",
      "text": "Fena değil."
    },
    {
      "id": "5d383810",
      "bank_id": "50b03602",
      "text": "İyiyim."
    },
    {
      "id": "5d383812",
      "bank_id": "50b03602",
      "text": "İyiyim, teşekkürler."
    },
    {
      "id": "5d383813",
      "bank_id": "50b03602",
      "text": "Ah, iyiyim sağ olasın."
    },
    {
      "id": "5d383814",
      "bank_id": "50b03602",
      "text": "Tamam."
    },
    {
      "id": "5d383815",
      "bank_id": "50b03602",
      "text": "İdare eder herhalde."
    },
    {
      "id": "5e407688",
      "bank_id": "50b03602",
      "text": "Bir... bir korumaya ihtiyacım var..."
    },
    {
      "id": "5e407689",
      "bank_id": "50b03602",
      "text": "Ne gördüğümü biliyorum... ama gerçek değildi. Hayır. Olamazdı..."
    },
    {
      "id": "5e40768a",
      "bank_id": "50b03602",
      "text": "Evden hiç çıkmamalıydım..."
    },
    {
      "id": "5e40768b",
      "bank_id": "50b03602",
      "text": "O ses de neydi öyle?!"
    },
    {
      "id": "5e40768c",
      "bank_id": "50b03602",
      "text": "Sadece bir rüya. Hepsi bu..."
    },
    {
      "id": "5e40768d",
      "bank_id": "50b03602",
      "text": "Bir ses duydum. Duydum işte biliyorum."
    },
    {
      "id": "5e40768e",
      "bank_id": "50b03602",
      "text": "Ölmek istemiyorum... Ölmek istemiyorum..."
    },
    {
      "id": "60ed8690",
      "bank_id": "50b03602",
      "text": "*burnunu çeker*"
    },
    {
      "id": "60ed8691",
      "bank_id": "50b03602",
      "text": "*burnunu çeker*"
    },
    {
      "id": "60ed8693",
      "bank_id": "50b03602",
      "text": "*burnunu çeker*"
    },
    {
      "id": "60ed8696",
      "bank_id": "50b03602",
      "text": "*burnunu çeker*"
    },
    {
      "id": "60ed8697",
      "bank_id": "50b03602",
      "text": "*burnunu çeker*"
    },
    {
      "id": "674084d8",
      "bank_id": "50b03602",
      "text": "Korkulacak tek şey... her şey..."
    },
    {
      "id": "674084d9",
      "bank_id": "50b03602",
      "text": "Her şey yolunda, her şey yoluna girecek..."
    },
    {
      "id": "674084db",
      "bank_id": "50b03602",
      "text": "Dikkatli olmalıyım, dikkatli olmalıyım..."
    },
    {
      "id": "674084dc",
      "bank_id": "50b03602",
      "text": "Bir şey olmadan eve varmalıyım..."
    },
    {
      "id": "674084dd",
      "bank_id": "50b03602",
      "text": "Bir şey bana saldıracak, hissediyorum..."
    },
    {
      "id": "674084de",
      "bank_id": "50b03602",
      "text": "Biri beni mi takip ediyor??"
    },
    {
      "id": "674084df",
      "bank_id": "50b03602",
      "text": "Ben mi? Korkmak mı? Ha! Agh! O da neydi?!"
    },
    {
      "id": "67ed9192",
      "bank_id": "50b03602",
      "text": "*burnunu çeker*"
    },
    {
      "id": "67ed9193",
      "bank_id": "50b03602",
      "text": "*burnunu çeker*"
    },
    {
      "id": "67ed9194",
      "bank_id": "50b03602",
      "text": "*burnunu çeker*"
    },
    {
      "id": "67ed9195",
      "bank_id": "50b03602",
      "text": "*burnunu çeker*"
    },
    {
      "id": "67ed9196",
      "bank_id": "50b03602",
      "text": "<sighs>"
    },
    {
      "id": "6c2543c0",
      "bank_id": "50b03602",
      "text": "İlla bilmek istiyorsan son zamanlarda biraz depresif hissediyorum."
    },
    {
      "id": "6c2543c1",
      "bank_id": "50b03602",
      "text": "Eh, yani dürüst olmak gerekirse daha iyi günlerim olmuştu."
    },
    {
      "id": "6c2543c2",
      "bank_id": "50b03602",
      "text": "Aslında kendimi moralim bozuk hissediyorum."
    },
    {
      "id": "6c2543c6",
      "bank_id": "50b03602",
      "text": "Hayat anlamsız. Bu sorunun cevabı oldu mu?"
    },
    {
      "id": "6c2543c7",
      "bank_id": "50b03602",
      "text": "Söylerdim ama kim benim sızlanmalarımı dinlemek ister ki?"
    },
    {
      "id": "7525522a",
      "bank_id": "50b03602",
      "text": "Cevap vermenin ne anlamı var? Hiçbir şeyin ne anlamı var?"
    },
    {
      "id": "7525522b",
      "bank_id": "50b03602",
      "text": "Ah, şu sıralar işler pek iyi gitmiyor."
    },
    {
      "id": "7525522c",
      "bank_id": "50b03602",
      "text": "Yataktan hiç çıkmamış olmayı dilediğin günlerden biri işte."
    },
    {
      "id": "7525522d",
      "bank_id": "50b03602",
      "text": "Kendimi bayağı çökkün hissediyorum."
    },
    {
      "id": "7525522f",
      "bank_id": "50b03602",
      "text": "Aslında biraz depresyondayım."
    },
    {
      "id": "76192710",
      "bank_id": "50b03602",
      "text": "Elimde değil, bugün kendimi çok hüzünlü hissediyorum."
    },
    {
      "id": "76192711",
      "bank_id": "50b03602",
      "text": "Hayat bundan mı ibaret yani?"
    },
    {
      "id": "76192712",
      "bank_id": "50b03602",
      "text": "Kendimi öyle çökkün hissediyorum ki..."
    },
    {
      "id": "76192714",
      "bank_id": "50b03602",
      "text": "Yazıklar olsun bana."
    },
    {
      "id": "76192715",
      "bank_id": "50b03602",
      "text": "Ah acı melankoli, gölgeni üzerime düşürdün."
    },
    {
      "id": "76192716",
      "bank_id": "50b03602",
      "text": "Bu pislik yuvasında geçen bir gün daha..."
    },
    {
      "id": "76192717",
      "bank_id": "50b03602",
      "text": "Neden? Neden her şey böyle olmak zorundaydı?"
    },
    {
      "id": "7c2ea4e0",
      "bank_id": "50b03602",
      "text": "Kendimi hüzünlü hissediyorum doğrusu."
    },
    {
      "id": "7c2ea4e1",
      "bank_id": "50b03602",
      "text": "Ağlamamak için kendimi zor tutuyorum."
    },
    {
      "id": "7c2ea4e2",
      "bank_id": "50b03602",
      "text": "Çaresizlikten patlamak üzereyim."
    },
    {
      "id": "7c2ea4e6",
      "bank_id": "50b03602",
      "text": "Hüngür hüngür ağlamaya başlamak üzereyim."
    },
    {
      "id": "7c2ea4e7",
      "bank_id": "50b03602",
      "text": "O kadar üzgünüm ki ağlayabilirim."
    },
    {
      "id": "7ca595a0",
      "bank_id": "50b03602",
      "text": "Bayağı harikayım valla."
    },
    {
      "id": "7ca595a1",
      "bank_id": "50b03602",
      "text": "İşler hiç bu kadar iyi olmamıştı."
    },
    {
      "id": "7ca595a4",
      "bank_id": "50b03602",
      "text": "Fevkaladeyim!"
    },
    {
      "id": "7ca595a6",
      "bank_id": "50b03602",
      "text": "Neşeden havalara uçuyorum."
    },
    {
      "id": "7ca595a7",
      "bank_id": "50b03602",
      "text": "İşler bayağı iyi aslında."
    },
    {
      "id": "7f193578",
      "bank_id": "50b03602",
      "text": "Ohh, her şeyin getirdiği bu çaresizlik..."
    },
    {
      "id": "7f193579",
      "bank_id": "50b03602",
      "text": "Bugün kalbimde koca bir ağırlıkla yürüyorum..."
    },
    {
      "id": "7f19357a",
      "bank_id": "50b03602",
      "text": "Ahh, her şey öyle anlamsız ki."
    },
    {
      "id": "7f19357b",
      "bank_id": "50b03602",
      "text": "Hayatımı boşa harcadım..."
    },
    {
      "id": "7f19357c",
      "bank_id": "50b03602",
      "text": "Ohh, her şey öyle... *iç çeker*"
    },
    {
      "id": "7f19357d",
      "bank_id": "50b03602",
      "text": "Hayatımı böyle hayal etmemiştim..."
