    {
      "id": "da1ecee1",
      "bank_id": "e0f19600",
      "text": "Talih Kulesi oynamak ister misiniz?"
    },
    {
      "id": "db5d80ca",
      "bank_id": "e0f19600",
      "text": "Görünüm:"
    },
    {
