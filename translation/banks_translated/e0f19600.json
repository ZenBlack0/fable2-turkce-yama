      "text": "Kazı Noktası"
    },
    {
      "id": "c44cff92",
      "bank_id": "e0f19600",
      "text": "Dövmeleri Çıkar"
    },
    {
      "id": "c5250c82",
      "bank_id": "e0f19600",
      "text": "Korku"
    },
    {
      "id": "c58c4c55",
      "bank_id": "e0f19600",
      "text": "Kabul etmek için basılı tutun"
