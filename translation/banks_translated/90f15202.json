{
  "bank_id": "90f15202",
  "total_strings": 213,
  "strings": [
    {
      "id": "098f0f67",
      "bank_id": "90f15202",
      "text": "Bırak şu numaraları da erkek gibi dövüş!"
    },
    {
      "id": "098f0f6c",
      "bank_id": "90f15202",
      "text": "Bırak şu numaraları da adam gibi dövüş! Ya da kadın gibi!"
    },
    {
      "id": "0acdf5e1",
      "bank_id": "90f15202",
      "text": "Çadırına ben çöktüm! Artık ona ihtiyacı kalmadı."
    },
    {
      "id": "0acdf5e2",
      "bank_id": "90f15202",
      "text": "Karısı ve çocukları vardı biliyor musun! Sanırım artık bana kaldılar."
    },
    {
      "id": "0acdf5e3",
      "bank_id": "90f15202",
      "text": "Hayır! Ölmüş olamazsın! O kadar çok planımız vardı ki!"
    },
    {
      "id": "105a9078",
      "bank_id": "90f15202",
      "text": "Haydut gibi göğüsle ve karşılık ver!"
    },
    {
      "id": "105a907a",
      "bank_id": "90f15202",
      "text": "Hey, dikkat et orada!"
    },
    {
      "id": "105a907b",
      "bank_id": "90f15202",
      "text": "Öyle dikilip darbe alıp durma!"
    },
    {
      "id": "1d9e48b0",
      "bank_id": "90f15202",
      "text": "Karısına ve çocuklarına ne diyeceğim şimdi ben?"
    },
    {
      "id": "1d9e48b2",
      "bank_id": "90f15202",
      "text": "Dostlarımı öylece katledebileceğini mi sanıyorsun!"
    },
    {
      "id": "1d9e48b3",
      "bank_id": "90f15202",
      "text": "Seni çabucak öldürecektim ama bundan sonra canını yavaş yavaş alacağım."
    },
    {
      "id": "20115380",
      "bank_id": "90f15202",
      "text": "Bu bir tür kâbus gibi."
    },
    {
      "id": "20115381",
      "bank_id": "90f15202",
      "text": "Buradan hemen toz olmalıyız!"
    },
    {
      "id": "20115382",
      "bank_id": "90f15202",
      "text": "Hobbe aşkına bu da ne?! Hiç şansımız yok!"
    },
    {
      "id": "266f474c",
      "bank_id": "90f15202",
      "text": "Sana KENDİ büyümü göstereyim. Adı da \"uçuşan bağırsaklar\"!"
    },
    {
      "id": "271faed5",
      "bank_id": "90f15202",
      "text": "Onu öldürdün! Üstelik bana borcu da vardı!"
    },
    {
      "id": "271faed6",
      "bank_id": "90f15202",
      "text": "Hiç kimse bir haydutu öldürüp bunu anlatacak kadar yaşayamaz."
    },
    {
      "id": "271faed7",
      "bank_id": "90f15202",
      "text": "İşi kişiselleştirdin şimdi!"
    },
    {
      "id": "27a58188",
      "bank_id": "90f15202",
      "text": "Dikkat et orada!"
    },
    {
      "id": "27a58189",
      "bank_id": "90f15202",
      "text": "Hemen deşilme öyle!"
    },
    {
      "id": "27a5818a",
      "bank_id": "90f15202",
      "text": "O alçağın hakkından geleceğiz, merak etme."
    },
    {
      "id": "2cb9257d",
      "bank_id": "90f15202",
      "text": "Lanet olsun! Aynısını bana yapamayacaksın!"
    },
    {
      "id": "2cb9257e",
      "bank_id": "90f15202",
      "text": "BUNUNLA nasıl savaşmamız bekleniyor ki?!"
    },
    {
      "id": "2cb9257f",
      "bank_id": "90f15202",
      "text": "Tek hamlede öldürdü!"
    },
    {
      "id": "323d6964",
      "bank_id": "90f15202",
      "text": "Bir saniye önce hayattaydı... Az önce ne oldu öyle lan?!"
    },
    {
      "id": "323d6966",
      "bank_id": "90f15202",
      "text": "Yolkesenler bile bu kadar iyi değildir!"
    },
    {
      "id": "323d6967",
      "bank_id": "90f15202",
      "text": "İnanılmazdı! Bunu nasıl yaptın?!"
    },
    {
      "id": "329142f4",
      "bank_id": "90f15202",
      "text": "Lanet büyücülük!"
    },
    {
      "id": "329142f5",
      "bank_id": "90f15202",
      "text": "Nefret ettiğim bir şey varsa o da İrade kullananlardır!"
    },
    {
      "id": "329142f6",
      "bank_id": "90f15202",
      "text": "Hobbe aşkına neydi o öyle?!"
    },
    {
      "id": "336c0331",
      "bank_id": "90f15202",
      "text": "Evet, ben şurada dikilirken vur onu."
    },
    {
      "id": "336c0332",
      "bank_id": "90f15202",
      "text": "Aynen öyle. İçine çek o mermileri."
    },
    {
      "id": "336c0333",
      "bank_id": "90f15202",
      "text": "Bu fena acıtacak!"
    },
    {
      "id": "337451b0",
      "bank_id": "90f15202",
      "text": "Hey, dostumu rahat bırak!"
    },
    {
      "id": "337451b1",
      "bank_id": "90f15202",
      "text": "Nesin sen, iğne yastığı mı?"
    },
    {
      "id": "337451b3",
      "bank_id": "90f15202",
      "text": "Acıttı mı dostum?"
    },
    {
      "id": "3d883d2c",
      "bank_id": "90f15202",
      "text": "Dikkat, ateş altındayız!"
    },
    {
      "id": "3d883d2d",
      "bank_id": "90f15202",
      "text": "Hemen siper bulun, çabuk!"
    },
    {
      "id": "3d883d2f",
      "bank_id": "90f15202",
      "text": "Ateş altındayız!"
    },
    {
      "id": "42cc2f8a",
      "bank_id": "90f15202",
      "text": "İyi misin dostum? Ne tuhaf bir şey bu."
    },
    {
      "id": "451c8096",
      "bank_id": "90f15202",
      "text": "Şu lanet İrade zımbırtısını kullanıyor! Durdurun şunu!"
    },
    {
      "id": "451c809d",
      "bank_id": "90f15202",
      "text": "Şu lanet İrade zımbırtısını kullanıyor! Durdurun şunu!"
    },
    {
      "id": "48ac57c1",
      "bank_id": "90f15202",
      "text": "Böyle mi hayatta kalıyorsun yani, ilacını alarak. Peh!"
    },
    {
      "id": "48ac57c2",
      "bank_id": "90f15202",
      "text": "Hey, performans artırıcı maddeler almak hiledir!"
    },
    {
      "id": "48ac57c3",
      "bank_id": "90f15202",
      "text": "Adil dövüşe inanmam ama iyi niyetimizi suistimal ediyorsun. Şunu içmeyi kes!"
    },
    {
      "id": "48d9f871",
      "bank_id": "90f15202",
      "text": "Bu herifin paçasında birkaç numara olduğunu söylemiştim."
    },
    {
      "id": "48d9f87a",
      "bank_id": "90f15202",
      "text": "Bu kadının paçasında birkaç numara olduğunu söylemiştim."
    },
    {
      "id": "49f16280",
      "bank_id": "90f15202",
      "text": "Beni bir fareye falan dönüştürmeyi planlamıyorsan iyi edersin."
    },
    {
      "id": "49f16281",
      "bank_id": "90f15202",
      "text": "Şu büyü zırvalarıyla bizden üstün olduğunu mu sanıyorsun?"
    },
    {
      "id": "49f16282",
      "bank_id": "90f15202",
      "text": "Ah kokuşmuş hobbe'ler aşkına, neydi o?!"
    },
    {
      "id": "4edc9211",
      "bank_id": "90f15202",
      "text": "Ganimeti paylaşacak daha az kişi kaldı sanırım..."
    },
    {
      "id": "4edc9212",
      "bank_id": "90f15202",
      "text": "Eh, geri kalanımıza daha çok altın düşer."
    },
    {
      "id": "4edc9213",
      "bank_id": "90f15202",
      "text": "Seni alçak! Sigortası bile yoktu!"
    },
    {
      "id": "5227c6d0",
      "bank_id": "90f15202",
      "text": "Ateş altındasın."
    },
    {
      "id": "5227c6d1",
      "bank_id": "90f15202",
      "text": "Bir siper bul!"
    },
    {
      "id": "5227c6d2",
      "bank_id": "90f15202",
      "text": "Siper al!"
    },
    {
      "id": "55abb9b8",
      "bank_id": "90f15202",
      "text": "Öylece dikilme! Siper al!"
    },
    {
      "id": "55abb9b9",
      "bank_id": "90f15202",
      "text": "Kıçına hedef tahtası çizsen de olurmuş yani!"
    },
    {
      "id": "55abb9bb",
      "bank_id": "90f15202",
      "text": "Sipere atlasana be artık!"
    },
    {
      "id": "5a9b7698",
      "bank_id": "90f15202",
      "text": "Ayağa kalkın! Başımızda bir savaş var!"
    },
    {
      "id": "5a9b7699",
      "bank_id": "90f15202",
      "text": "Bu fena morartacak!"
    },
    {
      "id": "5a9b769b",
      "bank_id": "90f15202",
      "text": "Böyle hırpalanmaktan hiç hoşlanmayız."
    },
    {
      "id": "5c1d7864",
      "bank_id": "90f15202",
      "text": "Ah kahretsin, şimdi ne var?!"
    },
    {
      "id": "5c1d7866",
      "bank_id": "90f15202",
      "text": "Hobbe hatrına, bir balta falan kullanamaz mısın sen?"
    },
    {
      "id": "5c1d7867",
      "bank_id": "90f15202",
      "text": "Asma köprüdeki şişman troller aşkına! Neydi o?!"
    },
    {
      "id": "65a7ec02",
      "bank_id": "90f15202",
      "text": "Seni hobbe dölü! Gelecek hafta tam haydut emekliliğiyle emekli olacaktı!"
    },
    {
      "id": "65a7ec09",
      "bank_id": "90f15202",
      "text": "Seni hobbe dölü! Gelecek hafta tam haydut emekliliğiyle emekli olacaktı!"
    },
    {
      "id": "6a3d3ec9",
      "bank_id": "90f15202",
      "text": "Üstünü silkele ve devam et."
    },
    {
      "id": "6a3d3eca",
      "bank_id": "90f15202",
      "text": "İyi misin orada? Bunun fena hareketleri var."
    },
    {
      "id": "6a3d3ecb",
      "bank_id": "90f15202",
      "text": "Ayağa kalk ve karşılık ver!"
    },
    {
      "id": "6f125dcc",
      "bank_id": "90f15202",
      "text": "İyi misin orada?"
    },
    {
      "id": "6f125dcd",
      "bank_id": "90f15202",
      "text": "Vay canına! Az kalsın uçuyordun dostum!"
    },
    {
      "id": "6f125dce",
      "bank_id": "90f15202",
      "text": "Güzel iniş, seni sersem."
    },
    {
      "id": "72731c34",
      "bank_id": "90f15202",
      "text": "Onu pek sevmezdim ama yine de bedelini ödeyeceksin."
    },
    {
      "id": "72731c35",
      "bank_id": "90f15202",
      "text": "Hepimizi asla öldüremezsin."
    },
    {
      "id": "72731c36",
      "bank_id": "90f15202",
      "text": "Henüz hepimizi öldürmüş sayılmazsın."
    },
    {
      "id": "7488454d",
      "bank_id": "90f15202",
      "text": "Karşılık ver!"
    },
    {
      "id": "7488454e",
      "bank_id": "90f15202",
      "text": "Merak etme, sadece bir çizik."
    },
    {
      "id": "7488454f",
      "bank_id": "90f15202",
      "text": "Karşılık versene be?"
    },
    {
      "id": "7a37766d",
      "bank_id": "90f15202",
      "text": "Ağlamayı kes. Kalk ve bize yardım et."
    },
    {
      "id": "7a37766e",
      "bank_id": "90f15202",
      "text": "Kaldır şu kıçını!"
    },
    {
      "id": "7a37766f",
      "bank_id": "90f15202",
      "text": "Dostlarımı oradan oraya fırlatabileceğini mi sanıyorsun ha?"
    },
    {
      "id": "7bd7c86c",
      "bank_id": "90f15202",
      "text": "Yoldan çekil!"
    },
    {
      "id": "7bd7c86d",
      "bank_id": "90f15202",
      "text": "Kolay bir hedef oluyorsun seni aptal herif!"
    },
    {
      "id": "7bd7c86e",
      "bank_id": "90f15202",
      "text": "Açık hedefsin resmen!"
    },
    {
      "id": "817878e8",
      "bank_id": "90f15202",
      "text": "Bu tuhaf bir hobbe numarası. Ve hiç ama hiç hoşuma gitmedi!"
    },
    {
      "id": "817878e9",
      "bank_id": "90f15202",
      "text": "Tatlı hobbe'ler aşkına! O ben olabilirdim!"
    },
    {
      "id": "817878ea",
      "bank_id": "90f15202",
      "text": "Aynısını bana yaparsan pişman olursun."
    },
    {
      "id": "820d2c2c",
      "bank_id": "90f15202",
      "text": "Ah, çok fena!"
    },
    {
      "id": "820d2c2e",
      "bank_id": "90f15202",
      "text": "Buna katlanmak zorunda değilsin!"
    },
    {
      "id": "820d2c2f",
      "bank_id": "90f15202",
      "text": "Bloklamayı dene seni sümsük!"
    },
    {
      "id": "85fe9c98",
      "bank_id": "90f15202",
      "text": "Bunun için kelleni koparacağım!"
    },
    {
      "id": "85fe9c99",
      "bank_id": "90f15202",
      "text": "Kendine yavaş ve acı verici bir ölüm kazandın."
    },
    {
      "id": "85fe9c9b",
      "bank_id": "90f15202",
      "text": "Hayır! O benim en iyi dostumdu. Küçüklüğümüzden beri tanırdım onu!"
    },
    {
      "id": "8637ff44",
      "bank_id": "90f15202",
      "text": "Merhametli kasık zırhı aşkına! Bunu nasıl yaptın?!"
    },
    {
      "id": "8637ff45",
      "bank_id": "90f15202",
      "text": "Bu da ne?! Gördünüz mü şunu?!"
    },
    {
      "id": "8637ff46",
      "bank_id": "90f15202",
      "text": "Kahretsin! Gördün mü şunu?!"
    },
    {
      "id": "8f203b30",
      "bank_id": "90f15202",
      "text": "Bu kadarı yetti!"
    },
    {
      "id": "8f203b31",
      "bank_id": "90f15202",
      "text": "Zaten onu hiç sevmezdim."
    },
    {
      "id": "8f203b32",
      "bank_id": "90f15202",
      "text": "Eh, zaten onu hiç sevmezdim."
    },
    {
      "id": "97a9ccd8",
      "bank_id": "90f15202",
      "text": "Hayatımda gördüğüm en tuhaf şey bu!"
    },
    {
      "id": "97a9ccda",
      "bank_id": "90f15202",
      "text": "Bu doğaya aykırı, biliyorsun değil mi!"
    },
    {
      "id": "97a9ccdb",
      "bank_id": "90f15202",
      "text": "Bunun gibisini hiç görmemiştim!"
    },
    {
      "id": "9abfc9a0",
      "bank_id": "90f15202",
      "text": "Ne aldın kız kılıklı ahbap, ahududu aromalı mı?"
    },
    {
      "id": "9abfc9a1",
      "bank_id": "90f15202",
      "text": "Canın mı azaldı? Hiçbir iksir seni kurtaramaz."
    },
    {
      "id": "9abfc9a2",
      "bank_id": "90f15202",
      "text": "Kahretsin, iksirlerim bitti."
    },
    {
      "id": "9ea8c4dc",
      "bank_id": "90f15202",
      "text": "İyi misin ahbap?"
    },
    {
      "id": "9ea8c4dd",
      "bank_id": "90f15202",
      "text": "Yaralanmadın ya, değil mi?"
    },
    {
      "id": "9ea8c4de",
      "bank_id": "90f15202",
      "text": "Şu bağırsakları içeri tık ve savaşmaya devam et!"
    },
    {
      "id": "9f200aec",
      "bank_id": "90f15202",
      "text": "Sopayı yiyorsun!"
    },
    {
      "id": "9f200aed",
      "bank_id": "90f15202",
      "text": "Blokla!"
    },
    {
      "id": "9f200aef",
      "bank_id": "90f15202",
      "text": "Uff! Hadi ama ahbap!"
    },
    {
      "id": "9fb30985",
      "bank_id": "90f15202",
      "text": "Seni lanet hilekâr! Şunu diklemeyi kes!"
    },
    {
      "id": "9fb30986",
      "bank_id": "90f15202",
      "text": "Ne oldu, yardım olmadan savaşamayacak kadar zayıf mısın?"
    },
    {
      "id": "9fb30987",
      "bank_id": "90f15202",
      "text": "Hey, iksir içeceksen en azından herkese yetecek kadar getir."
    },
    {
      "id": "a100cf44",
      "bank_id": "90f15202",
      "text": "Beni öyle kolay yere seremezsin!"
    },
    {
      "id": "a100cf45",
      "bank_id": "90f15202",
      "text": "Öylece yatıp durma!"
    },
    {
      "id": "a100cf47",
      "bank_id": "90f15202",
      "text": "Ayağa kalk ve erkek ol biraz, olur mu?"
    },
    {
      "id": "a9e38694",
      "bank_id": "90f15202",
      "text": "İyi olacaksın, sadece karşılık ver."
    },
    {
      "id": "a9e38695",
      "bank_id": "90f15202",
      "text": "Haydutlar sert hamurdan yoğrulmuştur."
    },
    {
      "id": "a9e38697",
      "bank_id": "90f15202",
      "text": "Neredeyse hiç çizmedi bile."
    },
    {
      "id": "ab658428",
      "bank_id": "90f15202",
      "text": "Ayağa kalk haydut!"
    },
    {
      "id": "ab658429",
      "bank_id": "90f15202",
      "text": "Öyle kıçının üstünde oturma!"
    },
    {
      "id": "ab65842a",
      "bank_id": "90f15202",
      "text": "Çok geç olmadan kalk."
    },
    {
      "id": "ac49ecb8",
      "bank_id": "90f15202",
      "text": "Vuruluyorsun seni sersem!"
    },
    {
      "id": "ac49ecba",
      "bank_id": "90f15202",
      "text": "Öylece dikilme!"
    },
    {
      "id": "ac49ecbb",
      "bank_id": "90f15202",
      "text": "Eğil seni aptal!"
    },
    {
      "id": "ac8f7174",
      "bank_id": "90f15202",
      "text": "Umarım kalın bir yelek giyiyorsundur ahbap."
    },
    {
      "id": "ac8f7176",
      "bank_id": "90f15202",
      "text": "Et yarası mı o ahbap?"
    },
    {
      "id": "ac8f7177",
      "bank_id": "90f15202",
      "text": "Hey, ben olacağıma sen ol daha iyi ahbap."
    },
    {
      "id": "b5e7fc54",
      "bank_id": "90f15202",
      "text": "Bizi oyuncak bebek gibi oraya buraya fırlatabileceğini mi sanıyorsun?"
    },
    {
      "id": "b5e7fc56",
      "bank_id": "90f15202",
      "text": "Kendinden utanmalısın! Kalk ayağa!"
    },
    {
      "id": "b5e7fc57",
      "bank_id": "90f15202",
      "text": "Bizi hırpalamana izin vermeyeceğiz!"
    },
    {
      "id": "b7dcc6a1",
      "bank_id": "90f15202",
      "text": "Bir tür dövüş iblisiyle karşı karşıyayız!"
    },
    {
      "id": "b7dcc6a2",
      "bank_id": "90f15202",
      "text": "Az önce ne oldu? Gözümü kırptım ve kaçırdım!"
    },
    {
      "id": "b7dcc6a3",
      "bank_id": "90f15202",
      "text": "Ha?! Az önce ne oldu onu bile bilmiyorum!"
    },
    {
      "id": "b9244bd0",
      "bank_id": "90f15202",
      "text": "Kalk ayağa seni çıtkırıldım!"
    },
    {
      "id": "b9244bd1",
      "bank_id": "90f15202",
      "text": "Ayağa kalk!"
    },
    {
      "id": "b9244bd3",
      "bank_id": "90f15202",
      "text": "Öylece yatma seni koca korkak!"
    },
    {
      "id": "b9bdd09c",
      "bank_id": "90f15202",
      "text": "Vay canına! Belki de tabanları yağlamalıyım."
    },
    {
      "id": "b9bdd09d",
      "bank_id": "90f15202",
      "text": "Fena havalı hareketlerdi doğrusu!"
    },
    {
      "id": "b9bdd09f",
      "bank_id": "90f15202",
      "text": "Bunun gibisini hiç görmemiştim!"
    },
    {
      "id": "bb1f4b12",
      "bank_id": "90f15202",
      "text": "Kendi ölüm fermanını imzaladın seni pislik."
    },
    {
      "id": "bb1f4b19",
      "bank_id": "90f15202",
      "text": "Kendi ölüm fermanını imzaladın seni sürtük."
    },
    {
      "id": "be408418",
      "bank_id": "90f15202",
      "text": "Haydutlarla ne alıp veremediğin var senin?!"
    },
    {
      "id": "be40841a",
      "bank_id": "90f15202",
      "text": "Dostumu öldürdün!"
    },
    {
      "id": "be40841b",
      "bank_id": "90f15202",
      "text": "Hey, iyi bir arkadaşımdı o benim!"
    },
    {
      "id": "c1ce3304",
      "bank_id": "90f15202",
      "text": "İyileşmeyi kes!"
    },
    {
      "id": "c1ce3306",
      "bank_id": "90f15202",
      "text": "Hey, bu haksızlık!"
    },
    {
      "id": "c1ce3307",
      "bank_id": "90f15202",
      "text": "Alkol problemin mi var nesin sen?"
    },
    {
      "id": "c1f7dad8",
      "bank_id": "90f15202",
      "text": "Sadece şanslı bir itişti o."
    },
    {
      "id": "c1f7dad9",
      "bank_id": "90f15202",
      "text": "Kendi boyunda biriyle kapış!"
    },
    {
      "id": "c1f7dada",
      "bank_id": "90f15202",
      "text": "Bileğinin hakkıyla yere serildin."
    },
    {
      "id": "c3a45c68",
      "bank_id": "90f15202",
      "text": "Bu canavarı asla yenemeyeceğiz!"
    },
    {
      "id": "c3a45c69",
      "bank_id": "90f15202",
      "text": "Ayvayı yedik. Resmen ve tamamen ayvayı yedik."
    },
    {
      "id": "c3a45c6b",
      "bank_id": "90f15202",
      "text": "Bence bir adım geri çekilsek iyi olur beyler."
    },
    {
      "id": "cab8cba4",
      "bank_id": "90f15202",
      "text": "Ah, bunu yapmamış olmayı dileyeceksin."
    },
    {
      "id": "cab8cba6",
      "bank_id": "90f15202",
      "text": "Hayııııır! Bunun için canını alacağım!"
    },
    {
      "id": "cab8cba7",
      "bank_id": "90f15202",
      "text": "Şimdi gerçekten canına okuyacağım senin!"
    },
    {
      "id": "cc63f544",
      "bank_id": "90f15202",
      "text": "Bu eski usul bir haydut intikamı gerektirir."
    },
    {
      "id": "cc63f545",
      "bank_id": "90f15202",
      "text": "Haydut katili!"
    },
    {
      "id": "cc63f547",
      "bank_id": "90f15202",
      "text": "Hey, cenazesinin parasını ödesen iyi edersin. Çünkü ben ödemeyeceğim."
    },
    {
      "id": "cd1cf379",
      "bank_id": "90f15202",
      "text": "Ayağa kalk seni pis hobbe!"
    },
    {
      "id": "cd1cf37a",
      "bank_id": "90f15202",
      "text": "Vay be, ne darbeydi ama."
    },
    {
      "id": "cd1cf37b",
      "bank_id": "90f15202",
      "text": "Seni yere sermelerine izin verme seni ahmak."
    },
    {
      "id": "d9d7aba9",
      "bank_id": "90f15202",
      "text": "Ganimetten payını bu şekilde kazanamazsın!"
    },
    {
      "id": "d9d7abaa",
      "bank_id": "90f15202",
      "text": "Karşılık vermen gerekiyordu seni aptal!"
    },
    {
      "id": "d9d7abab",
      "bank_id": "90f15202",
      "text": "Bu fena acıtmış olmalı."
    },
    {
      "id": "df6eecbc",
      "bank_id": "90f15202",
      "text": "Gerçek bir dövüşçünün iksire ihtiyacı olmaz."
    },
    {
      "id": "df6eecbd",
      "bank_id": "90f15202",
      "text": "Demek iksir ha? İlla ki iksirleri olacak! Alçak."
    },
    {
      "id": "df6eecbf",
      "bank_id": "90f15202",
      "text": "Bu hilekârlık seni pislik!"
    },
    {
      "id": "dfe9ff2c",
      "bank_id": "90f15202",
      "text": "İyi olacaksın."
    },
    {
      "id": "dfe9ff2d",
      "bank_id": "90f15202",
      "text": "Dikkatli olun beyler!"
    },
    {
      "id": "dfe9ff2e",
      "bank_id": "90f15202",
      "text": "İyi misin ahbap?"
    },
    {
      "id": "dffbb27d",
      "bank_id": "90f15202",
      "text": "Hâlâ ayaktaysan iyisin demektir!"
    },
    {
      "id": "dffbb27e",
      "bank_id": "90f15202",
      "text": "İyi misin ahbap?"
    },
    {
      "id": "dffbb27f",
      "bank_id": "90f15202",
      "text": "Bir kere de savuşturmayı denesene?"
    },
    {
      "id": "e14b2254",
      "bank_id": "90f15202",
      "text": "Bir haydutu öldürdün. Sonuçlarına katlan."
    },
    {
      "id": "e14b2256",
      "bank_id": "90f15202",
      "text": "Hayır! Bu hafta sonu içkileri ısmarlama sırası ondaydı!"
    },
    {
      "id": "e14b2257",
      "bank_id": "90f15202",
      "text": "Arkadaşlarımı öldürüp bundan paçayı kurtarabileceğini mi sanıyorsun?"
    },
    {
      "id": "e57bffc0",
      "bank_id": "90f15202",
      "text": "Merak etme dostum. Sadece kalk ve karşılık ver."
    },
    {
      "id": "e57bffc1",
      "bank_id": "90f15202",
      "text": "Şekerleme yapmanın zamanı değil!"
    },
    {
      "id": "e57bffc3",
      "bank_id": "90f15202",
      "text": "Ha, bugün yıkılmayacağını söylememiş miydin sen?"
    },
    {
      "id": "eb6637dc",
      "bank_id": "90f15202",
      "text": "Onu bu kadar çabuk nasıl öldürebildin?!"
    },
    {
      "id": "eb6637dd",
      "bank_id": "90f15202",
      "text": "Bu insanca bile değildi!"
    },
    {
      "id": "eb6637de",
      "bank_id": "90f15202",
      "text": "Böyle bir şey mümkün bile olmamalı!"
    },
    {
      "id": "ed846b68",
      "bank_id": "90f15202",
      "text": "Adil oynamıyorsun!"
    },
    {
      "id": "ed846b69",
      "bank_id": "90f15202",
      "text": "Lanet büyücü tipler! Varsa yoksa İrade, büyü. Biz bununla nasıl savaşacağız ki?!"
    },
    {
      "id": "ed846b6b",
      "bank_id": "90f15202",
      "text": "İşte böyle şeyler yüzünden keşke çiftçi olsaydım diyorum."
    },
    {
      "id": "f0cfbec4",
      "bank_id": "90f15202",
      "text": "Seni hobbe ineği! Seni öldürmeye çalışması dışında sana ne yaptı ki?"
    },
    {
      "id": "f0cfbecf",
      "bank_id": "90f15202",
      "text": "Seni hobbe dölü! Seni öldürmeye çalışması dışında sana ne yaptı ki?"
    },
    {
      "id": "f23b22b0",
      "bank_id": "90f15202",
      "text": "Merak etme, hepimiz arada sırada kıçımızın üstüne otururuz."
    },
    {
      "id": "f23b22b2",
      "bank_id": "90f15202",
      "text": "Kaldır şu kıçını da dövüş!"
    },
    {
      "id": "f23b22b3",
      "bank_id": "90f15202",
      "text": "Ayağa kalk ve dövüş!"
    },
    {
      "id": "f38d4ca8",
      "bank_id": "90f15202",
      "text": "Bunu nasıl yapabildin?! Kimse bu kadar yetenekli olamaz!"
    },
    {
      "id": "f38d4caa",
      "bank_id": "90f15202",
      "text": "Balverine'in pijaması hakkı için! Harikaydı bu!"
    },
    {
      "id": "f38d4cab",
      "bank_id": "90f15202",
      "text": "Kahretsin! Az kalsın altıma ediyordum."
    },
    {
      "id": "f7b68348",
      "bank_id": "90f15202",
      "text": "Bu alçaklar kendilerini çok çetin sanır ama baksana, küçük bir kız gibi iksir dikliyor."
    },
    {
      "id": "f7b6834a",
      "bank_id": "90f15202",
      "text": "Ne kadar da hilekârsın!"
    },
    {
      "id": "f7b6834b",
      "bank_id": "90f15202",
      "text": "Hey, şundan bana da bir yudum versene?"
    },
    {
      "id": "fa7bb3a4",
      "bank_id": "90f15202",
      "text": "Dikkat et!"
    },
    {
      "id": "fa7bb3a5",
      "bank_id": "90f15202",
      "text": "Dikkat et!"
    },
    {
      "id": "fa7bb3a7",
      "bank_id": "90f15202",
      "text": "Sakin!"
    },
    {
      "id": "fd4c6d20",
      "bank_id": "90f15202",
      "text": "Seni büyülemesine izin verme!"
    },
    {
      "id": "fd4c6d2b",
      "bank_id": "90f15202",
      "text": "Seni büyülemesine izin verme!"
    },
    {
      "id": "fd85458d",
      "bank_id": "90f15202",
      "text": "Merak etme, ölümcül görünmüyor."
    },
    {
      "id": "fd85458e",
      "bank_id": "90f15202",
      "text": "Fark ettin mi bilmiyorum ahbap ama vuruluyorsun."
    },
    {
      "id": "fdcc5a75",
      "bank_id": "90f15202",
      "text": "Ateş hattından çekil!"
    },
    {
      "id": "fdcc5a76",
      "bank_id": "90f15202",
      "text": "Şu mermilere dikkat edin!"
    },
    {
      "id": "fdcc5a77",
      "bank_id": "90f15202",
      "text": "Siper al!"
    },
    {
      "id": "fe102195",
      "bank_id": "90f15202",
      "text": "Büyü kullanmak adil değil!"
    },
    {
      "id": "fe102196",
      "bank_id": "90f15202",
      "text": "O lanet büyünü benim üzerimde kullanamayacaksın!"
    },
    {
      "id": "fe102197",
      "bank_id": "90f15202",
      "text": "Büyücülere ne yaptığımızı sana göstereceğim!"
    }
  ]
}