      "text": "İyi bir darbe."
    },
    {
      "id": "d3ca4a35",
      "bank_id": "70b7b600",
      "text": "Şu kılıcı bitirecek kadar vaktin var, hepsi bu."
    },
    {
      "id": "d7f079a2",
      "bank_id": "70b7b600",
      "text": "İyi bir iş çıkarıyorsun."
    },
    {
      "id": "d84ce0c4",
      "bank_id": "70b7b600",
      "text": "Dövmek için <a_img> tuşuna dokunun. İşten çıkmak için <b_img> tuşuna basın."
    },
    {
      "id": "d9c37bca",
      "bank_id": "70b7b600",
      "text": "En yüksek seri:"
    },
    {
      "id": "dc9c3562",
      "bank_id": "70b7b600",
      "text": "İşi alın"
