    {
      "id": "0ac8bc02",
      "bank_id": "d0bab600",
      "text": "Ah Susannah, sen bir dehasın."
    },
    {
      "id": "0bc8bdf5",
      "bank_id": "d0bab600",
      "text": "Hadi heykel, orada olduğunu biliyorum. Göster kendini."
    },
    {
      "id": "0c595603",
      "bank_id": "d0bab600",
      "text": "Ahh, bana yeniden modellik mi yapmak istiyorsun?"
    },
    {
      "id": "0e03d506",
      "bank_id": "d0bab600",
      "text": "Henüz bulunamadı."
    },
    {
      "id": "13b8f8ac",
      "bank_id": "d0bab600",
      "text": "Heykeltıraş"
    },
    {
      "id": "17b6f761",
      "bank_id": "d0bab600",
      "text": "Şunun için heykel yaptırın:"
    },
    {
      "id": "1d428468",
      "bank_id": "d0bab600",
      "text": "Boş bir heykel kaidesi buldunuz. Keşke buraya konacak bir heykelinizi yapabilecek bir heykeltıraş olsaydı..."
    },
    {
      "id": "1ee422ef",
      "bank_id": "d0bab600",
      "text": "Brightwood. Ücret: 75 Altın"
    },
    {
      "id": "20428921",
      "bank_id": "d0bab600",
      "text": "Boş bir heykel kaidesi buldunuz. Oakfield heykeltıraşına buraya konmak üzere bir heykelinizi sipariş edebilirsiniz."
    },
    {
      "id": "20ca9d93",
      "bank_id": "d0bab600",
      "text": "Seni çevreleyen alanın kendine has bir enerjisi var; ontolojik huzursuzluğun yarı somut bir temsili. Hadi ama poz vermeye başla!"
    },
    {
      "id": "216461df",
      "bank_id": "d0bab600",
      "text": "Ah, zamandan bir anı koparıp kendine mal ettin. Şimdi ben de onu kendime mal edeceğim."
    },
    {
      "id": "21ca9f06",
      "bank_id": "d0bab600",
      "text": "Bana poz vermediğin sürece maceracı ruhunu bağlama oturtamam!"
    },
    {
      "id": "22caa0f9",
      "bank_id": "d0bab600",
      "text": "İçe kapanıklık bir seçenek değil. Her şeyi dışa vur! Her şeyi sergile!"
    },
    {
      "id": "2e88d390",
      "bank_id": "d0bab600",
      "text": "Vay canına! Ne olağanüstü bir dönüşüm! Kusursuzluğun dağlarına tırmandın resmen."
    },
    {
      "id": "3188d869",
      "bank_id": "d0bab600",
      "text": "Sesimdeki alayı fark ettiğine şüphe yok. Daha çok çabala. Soyut bir çalışma yapmıyorum."
    },
    {
      "id": "319c9a06",
      "bank_id": "d0bab600",
      "text": "Bir heykel siparişi verilsin mi?"
    },
    {
      "id": "327ce1ed",
      "bank_id": "d0bab600",
      "text": "Ne bekliyorsunuz?"
    },
    {
      "id": "329c9bf9",
      "bank_id": "d0bab600",
      "text": "Susannah ile konuşun."
    },
    {
      "id": "339c9d6c",
      "bank_id": "d0bab600",
      "text": "İfadeyi serbest bırakın."
    },
    {
      "id": "33e1cedf",
      "bank_id": "d0bab600",
      "text": "Ne yapacağını biliyorsun. Poz vermeye başla!"
    },
    {
      "id": "349c9edf",
      "bank_id": "d0bab600",
      "text": "Bir ifade gerçekleştirin ve basılı tutun."
    },
    {
      "id": "34e1d0b2",
      "bank_id": "d0bab600",
      "text": "İstediğin herhangi bir şey ama ben bitir diyene kadar pozu koru."
    },
    {
      "id": "359ca0b2",
      "bank_id": "d0bab600",
      "text": "Heykeltıraşa modellik yapılsın mı?"
    },
