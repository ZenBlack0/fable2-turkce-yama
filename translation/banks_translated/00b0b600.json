    },
    {
      "id": "ada0a8c0",
      "bank_id": "00b0b600",
      "text": "Hepsi senin suçun. Klasik. Tam bir klasik!"
    },
    {
      "id": "ae80b179",
      "bank_id": "00b0b600",
      "text": "<mutters>"
    },
    {
      "id": "af797ef5",
      "bank_id": "00b0b600",
      "text": "Kule'den kaçabilmek için önce bir gemi bulmalısınız!"
    },
    {
      "id": "b056c0e4",
      "bank_id": "00b0b600",
      "text": "<sighs>"
    },
    {
      "id": "b1d6bf79",
      "bank_id": "00b0b600",
      "text": "Cullis Geçidi devre dışı. Kuzeye geri dönüş yolu yok."
    },
    {
      "id": "b3435740",
      "bank_id": "00b0b600",
      "text": "Etrafım aptallarla çevrili."
    },
    {
      "id": "b528db9c",
      "bank_id": "00b0b600",
      "text": "Tanrı aşkına! O korkunç şeyler içeride bütün mallarımı yiyor. Yani o şeyler oradayken nasıl geçineceğim ben? İçerideki o iğrenç küçük kara şeyler bütün mallarımı yiyor."
    },
    {
      "id": "b5435aa6",
      "bank_id": "00b0b600",
      "text": "Bana bir tatil lazım. Belki Westcliff? Bloodstone'a giden bir gemi bulabilir miyim acaba..."
    },
    {
      "id": "b6435c19",
      "bank_id": "00b0b600",
      "text": "Lanet çiftçi. Neden bizim için işleri kolaylaştırmıyor sanki?"
    },
    {
      "id": "b728dee2",
      "bank_id": "00b0b600",
      "text": "Küçük bir çocukken annem üstümü örterdi... Pijamamın altında bir şeylerin süründüğünü hissederdim... ve işte oradaydı! İğrenç küçük bir böcek!"
    },
    {
      "id": "b7435d8c",
      "bank_id": "00b0b600",
      "text": "Bizim çocuklardan bazılarını Çile'ye satabilir miyim acaba. Sürekli hayduta ihtiyaç duyuyorlar."
    },
    {
      "id": "b828e055",
      "bank_id": "00b0b600",
      "text": "O böcekleri dışarı çıkarmalıyım."
    },
    {
      "id": "b8435f7f",
      "bank_id": "00b0b600",
      "text": "Birine ibretlik bir ceza vermenin vakti geldi galiba. Sayıların hepsi de Ethan'da."
    },
    {
      "id": "b94360d2",
      "bank_id": "00b0b600",
      "text": "Şu lanet Giles'ın eski muhafız olduğuna kalıbımı basarım. Onu öldürmek için yeterli bir sebep."
    },
    {
      "id": "ba436245",
      "bank_id": "00b0b600",
      "text": "Dört aydır yıkanmadım. Lider gibi kokuyorum."
