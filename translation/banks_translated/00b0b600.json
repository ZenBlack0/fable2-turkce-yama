{
  "bank_id": "00b0b600",
  "total_strings": 281,
  "strings": [
    {
      "id": "00f44a38",
      "bank_id": "00b0b600",
      "text": "Lanet rüzgâr esintisi. Esip durmak için bir dakika daha bekleyemez miydi sanki?"
    },
    {
      "id": "01f44bab",
      "bank_id": "00b0b600",
      "text": "Şu yakalama emirlerini öğrenirlerse bütün muhafızların alay konusu olurum."
    },
    {
      "id": "0251ea1a",
      "bank_id": "00b0b600",
      "text": "<harrumphs>"
    },
    {
      "id": "0351eb8d",
      "bank_id": "00b0b600",
      "text": "<mutters>"
    },
    {
      "id": "03599d59",
      "bank_id": "00b0b600",
      "text": "Bütün çiftçilerin ve rahiplerin işini bitirmeden ayrılamazsınız!"
    },
    {
      "id": "03f44ef1",
      "bank_id": "00b0b600",
      "text": "Ah, bu duyulursa asla şerif olamayacağım."
    },
    {
      "id": "06f4534a",
      "bank_id": "00b0b600",
      "text": "En azından ortalık sakin ve huzurlu. Etrafta suçlu falan yok."
    },
    {
      "id": "12110bc6",
      "bank_id": "00b0b600",
      "text": "Bu mağaradan çıkmak için başka bir yol bulmalısınız!"
    },
    {
      "id": "156327bd",
      "bank_id": "00b0b600",
      "text": "Mezar bekçisinin deneyini tamamlamasına yardım etmelisiniz."
    },
    {
      "id": "15c1da80",
      "bank_id": "00b0b600",
      "text": "<harrumphs>"
    },
    {
      "id": "166b5022",
      "bank_id": "00b0b600",
      "text": "T.O.B.Y. ile olan meseleyi çözmeden ayrılamazsınız."
    },
    {
      "id": "16c37be8",
      "bank_id": "00b0b600",
      "text": "Onu bulmalıyız, ah zavallı yavrum benim."
    },
    {
      "id": "17c37d5b",
      "bank_id": "00b0b600",
      "text": "Bu başımıza nasıl geldi...?"
    },
    {
      "id": "1839f832",
      "bank_id": "00b0b600",
      "text": "<mutters>"
    },
    {
      "id": "18c37ece",
      "bank_id": "00b0b600",
      "text": "Ah, zavallı oğlum, zavallı oğlum benim..."
    },
    {
      "id": "1a39fb18",
      "bank_id": "00b0b600",
      "text": "<mutters>"
    },
    {
      "id": "1ab84c30",
      "bank_id": "00b0b600",
      "text": "Şey, az önceki karnım mıydı? Bayağı acıktım galiba."
    },
    {
      "id": "1ac1e2bf",
      "bank_id": "00b0b600",
      "text": "<mutters>"
    },
    {
      "id": "1b328198",
      "bank_id": "00b0b600",
      "text": "<mutters>"
    },
    {
      "id": "1b39fc8b",
      "bank_id": "00b0b600",
      "text": "<mutters>"
    },
    {
      "id": "1b84cc3b",
      "bank_id": "00b0b600",
      "text": "Max ve Sam şüphesiz tehlikede. Onları öylece bırakamazsınız!"
    },
    {
      "id": "1bb84da3",
      "bank_id": "00b0b600",
      "text": "Ah, günahkâr biri değilimdir ama şu an bir içkiye fena halde ihtiyacım var..."
    },
    {
      "id": "1bc1e412",
      "bank_id": "00b0b600",
      "text": "<hums>"
    },
    {
      "id": "1c39fe7e",
      "bank_id": "00b0b600",
      "text": "<hums>"
    },
    {
      "id": "1cc1e585",
      "bank_id": "00b0b600",
      "text": "<sighs>"
    },
    {
      "id": "1cd1cd98",
      "bank_id": "00b0b600",
      "text": "Bu zindanı temizlemezseniz o hırsızların ardı arkası asla kesilmez!"
    },
    {
      "id": "1d3284fe",
      "bank_id": "00b0b600",
      "text": "<harrumphs>"
    },
    {
      "id": "1d39ffd1",
      "bank_id": "00b0b600",
      "text": "<harrumphs>"
    },
    {
      "id": "1db85089",
      "bank_id": "00b0b600",
      "text": "<hums>"
    },
    {
      "id": "1dc386ed",
      "bank_id": "00b0b600",
      "text": "Çok şükür bana yardım edecek bu cesur insanlar var."
    },
    {
      "id": "1e328651",
      "bank_id": "00b0b600",
      "text": "<mutters>"
    },
    {
      "id": "1e3a0144",
      "bank_id": "00b0b600",
      "text": "<hums>"
    },
    {
      "id": "1f3287c4",
      "bank_id": "00b0b600",
      "text": "<hums>"
    },
    {
      "id": "1f3a0337",
      "bank_id": "00b0b600",
      "text": "<hums>"
    },
    {
      "id": "203289b7",
      "bank_id": "00b0b600",
      "text": "<sighs>"
    },
    {
      "id": "213a061d",
      "bank_id": "00b0b600",
      "text": "<hums>"
    },
    {
      "id": "22328c9d",
      "bank_id": "00b0b600",
      "text": "<mutters>"
    },
    {
      "id": "249f1e69",
      "bank_id": "00b0b600",
      "text": "Bloodstone'daki herkesi öldürmeden önce banshee'yi yenmelisiniz!"
    },
    {
      "id": "29083f18",
      "bank_id": "00b0b600",
      "text": "Hadi, acele et!"
    },
    {
      "id": "2c0843d1",
      "bank_id": "00b0b600",
      "text": "Yetişsene, ne duruyorsun?"
    },
    {
      "id": "2cc222a3",
      "bank_id": "00b0b600",
      "text": "Beni bekle!"
    },
    {
      "id": "2dc22416",
      "bank_id": "00b0b600",
      "text": "O kadar hızlı gitme, lanet olsun!"
    },
    {
      "id": "336d48c0",
      "bank_id": "00b0b600",
      "text": "Garanti mi?! Hadi oradan be."
    },
    {
      "id": "343bd2aa",
      "bank_id": "00b0b600",
      "text": "Hadi o zaman."
    },
    {
      "id": "346d4ab3",
      "bank_id": "00b0b600",
      "text": "Toz su! Toz su almak isteyen var mı? Sadece... şey, su ekleyin yeter."
    },
    {
      "id": "356d4c26",
      "bank_id": "00b0b600",
      "text": "Ah, zevk sahibi bir müşteri."
    },
    {
      "id": "366d4d99",
      "bank_id": "00b0b600",
      "text": "Cam çekiç isteyen var mı? Ekose boya... Ayakta dikilmece... Solak tornavidası... Hepsi burada."
    },
    {
      "id": "376d4f0c",
      "bank_id": "00b0b600",
      "text": "Sihirli saç fırçaları! Sihirli saç fırçalarınız burada! Taradıkça daha çok saç çıkarır."
    },
    {
      "id": "386d50ff",
      "bank_id": "00b0b600",
      "text": "<burps>"
    },
    {
      "id": "3a6d53c5",
      "bank_id": "00b0b600",
      "text": "<mutters>"
    },
    {
      "id": "3d1ebd8e",
      "bank_id": "00b0b600",
      "text": "<sighs>"
    },
    {
      "id": "3d2db3b8",
      "bank_id": "00b0b600",
      "text": "Ah evet, bu sefer işler çok iyi gidiyor. Biliyordum. Bu sabah uyandığımda biliyordum."
    },
    {
      "id": "3e2db52b",
      "bank_id": "00b0b600",
      "text": "Ahhh..."
    },
    {
      "id": "3f1ec0d4",
      "bank_id": "00b0b600",
      "text": "<sighs>"
    },
    {
      "id": "401ec247",
      "bank_id": "00b0b600",
      "text": "<sighs>"
    },
    {
      "id": "40ee4326",
      "bank_id": "00b0b600",
      "text": "<mutters>"
    },
    {
      "id": "412db9e4",
      "bank_id": "00b0b600",
      "text": "<hums>"
    },
    {
      "id": "41ee4499",
      "bank_id": "00b0b600",
      "text": "<harrumphs>"
    },
    {
      "id": "421ec5ad",
      "bank_id": "00b0b600",
      "text": "<mutters>"
    },
    {
      "id": "42ee460c",
      "bank_id": "00b0b600",
      "text": "<sighs>"
    },
    {
      "id": "432dbcca",
      "bank_id": "00b0b600",
      "text": "Mmmm."
    },
    {
      "id": "43ee47ff",
      "bank_id": "00b0b600",
      "text": "<hums>"
    },
    {
      "id": "442dbebd",
      "bank_id": "00b0b600",
      "text": "<hums>"
    },
    {
      "id": "44ee4952",
      "bank_id": "00b0b600",
      "text": "<mutters>"
    },
    {
      "id": "46140248",
      "bank_id": "00b0b600",
      "text": "<mutters>"
    },
    {
      "id": "481405ae",
      "bank_id": "00b0b600",
      "text": "<mutters>"
    },
    {
      "id": "49140701",
      "bank_id": "00b0b600",
      "text": "<harrumphs>"
    },
    {
      "id": "4a1408f4",
      "bank_id": "00b0b600",
      "text": "<hums>"
    },
    {
      "id": "4b140a67",
      "bank_id": "00b0b600",
      "text": "<mutters>"
    },
    {
      "id": "4bf4d943",
      "bank_id": "00b0b600",
      "text": "Davetsiz misafirleri alt etmelisiniz yoksa her şeyi çalacaklar!"
    },
    {
      "id": "4d140d4d",
      "bank_id": "00b0b600",
      "text": "<hums>"
    },
    {
      "id": "4d4bea63",
      "bank_id": "00b0b600",
      "text": "Yakında yiyecek bir şeyler bulmalıyız."
    },
    {
      "id": "4d540cf2",
      "bank_id": "00b0b600",
      "text": "Tommy bütün hobbe'leri temizlemeniz için size güveniyor!"
    },
    {
      "id": "4d84faa1",
      "bank_id": "00b0b600",
      "text": "Charlie'yi kurtarmadan nasıl gidebilirsiniz?!"
    },
    {
      "id": "4e4bebd6",
      "bank_id": "00b0b600",
      "text": "Arfur gibi tipler olmasaydı bu kasaba çok daha güzel bir yer olurdu."
    },
    {
      "id": "4e7908f3",
      "bank_id": "00b0b600",
      "text": "<sighs>"
    },
    {
      "id": "4f40b41b",
      "bank_id": "00b0b600",
      "text": "Cemiyet için yeni üyeler bulmalıyım..."
    },
    {
      "id": "4f4bed49",
      "bank_id": "00b0b600",
      "text": "Şu an kalede ne yapıyorlar acaba merak ediyorum."
    },
    {
      "id": "4f790a66",
      "bank_id": "00b0b600",
      "text": "<hums>"
    },
    {
      "id": "5040b58e",
      "bank_id": "00b0b600",
      "text": "Güzel, temiz bir ölümü gerçekten severim."
    },
    {
      "id": "504bef3c",
      "bank_id": "00b0b600",
      "text": "Belki havalar güzelleşince Bower Gölü'ne gideriz. Orada güzel bir kamp yeri var. Evet."
    },
    {
      "id": "505e0979",
      "bank_id": "00b0b600",
      "text": "Hadi o zaman."
    },
    {
      "id": "50790bd9",
      "bank_id": "00b0b600",
      "text": "Hımm..."
    },
    {
      "id": "50c2b5e1",
      "bank_id": "00b0b600",
      "text": "<mutters>"
    },
    {
      "id": "514bf0af",
      "bank_id": "00b0b600",
      "text": "Altın kazanmanın başka yollarını bulmalıyız. Mecburuz."
    },
    {
      "id": "51c2b754",
      "bank_id": "00b0b600",
      "text": "<mutters>"
    },
    {
      "id": "524bf202",
      "bank_id": "00b0b600",
      "text": "Daha sıcak tutan giysiler fena olmazdı hani."
    },
    {
      "id": "5289bef3",
      "bank_id": "00b0b600",
      "text": "Ahhh."
    },
    {
      "id": "52c2b8c7",
      "bank_id": "00b0b600",
      "text": "<mutters>"
    },
    {
      "id": "534bf3f5",
      "bank_id": "00b0b600",
      "text": "Bahse girerim Lucien çocukları seviyordur. Belki birkaç tanesini evlat edinmek ister. Kalede tek başına yalnız kalıyor olmalı."
    },
    {
      "id": "5389c066",
      "bank_id": "00b0b600",
      "text": "Hımm."
    },
    {
      "id": "53c2baba",
      "bank_id": "00b0b600",
      "text": "<mutters>"
    },
    {
      "id": "5489c1d9",
      "bank_id": "00b0b600",
      "text": "Aha..."
    },
    {
      "id": "5589c34c",
      "bank_id": "00b0b600",
      "text": "<coughs>"
    },
    {
      "id": "5a0ba600",
      "bank_id": "00b0b600",
      "text": "Şimdi durma."
    },
    {
      "id": "5d0baad9",
      "bank_id": "00b0b600",
      "text": "Neden duruyorsun?"
    },
    {
      "id": "5edc2cc8",
      "bank_id": "00b0b600",
      "text": "Bir gün bu çeteyi ben yöneteceğim. Evet yöneteceğim."
    },
    {
      "id": "5eefe7dc",
      "bank_id": "00b0b600",
      "text": "Hadi gidelim!"
    },
    {
      "id": "5f701a13",
      "bank_id": "00b0b600",
      "text": "<yawns>"
    },
    {
      "id": "60701b86",
      "bank_id": "00b0b600",
      "text": "<yawns>"
    },
    {
      "id": "60dc302e",
      "bank_id": "00b0b600",
      "text": "Artık daha fazla kimsenin emri altında kalmayacağım."
    },
    {
      "id": "61701d79",
      "bank_id": "00b0b600",
      "text": "<yawns>"
    },
    {
      "id": "61dc3181",
      "bank_id": "00b0b600",
      "text": "Bu güruh benim ne kadar gaddar olabileceğimi bilmiyor daha. Öğrenecekler."
    },
    {
      "id": "6235d3b8",
      "bank_id": "00b0b600",
      "text": "Hımm, evet..."
    },
    {
      "id": "62701eec",
      "bank_id": "00b0b600",
      "text": "<yawns>"
    },
    {
      "id": "6370205f",
      "bank_id": "00b0b600",
      "text": "<tuts>"
    },
    {
      "id": "637ae181",
      "bank_id": "00b0b600",
      "text": "Doğru yol burası, kesinlikle."
    },
    {
      "id": "63b86c18",
      "bank_id": "00b0b600",
      "text": "Şimdi durmanın sırası değil."
    },
    {
      "id": "63dc34e7",
      "bank_id": "00b0b600",
      "text": "Canım fena halde adam öldürmek istiyor."
    },
    {
      "id": "6435d69e",
      "bank_id": "00b0b600",
      "text": "<hums>"
    },
    {
      "id": "64702232",
      "bank_id": "00b0b600",
      "text": "<whistles>"
    },
    {
      "id": "6535d871",
      "bank_id": "00b0b600",
      "text": "<hums>"
    },
    {
      "id": "657023a5",
      "bank_id": "00b0b600",
      "text": "<hums>"
    },
    {
      "id": "657ab118",
      "bank_id": "00b0b600",
      "text": "Hımm, hafta sonumu nereye koydum ben...? Yine kaybettim değil mi?"
    },
    {
      "id": "66702518",
      "bank_id": "00b0b600",
      "text": "<sighs>"
    },
    {
      "id": "667ab28b",
      "bank_id": "00b0b600",
      "text": "Şu Saksağan yok mu. Ah, boynunu bir güzel kırmak isterdim vallahi."
    },
    {
      "id": "66b870d1",
      "bank_id": "00b0b600",
      "text": "Devam etmeliyiz."
    },
    {
      "id": "6735db57",
      "bank_id": "00b0b600",
      "text": "<hums>"
    },
    {
      "id": "6770268b",
      "bank_id": "00b0b600",
      "text": "<sniffs>"
    },
    {
      "id": "677ab47e",
      "bank_id": "00b0b600",
      "text": "Kurudum resmen. Boğazım kurudu."
    },
    {
      "id": "6c7abc1d",
      "bank_id": "00b0b600",
      "text": "Hımm, şu pembe fil hep orada mıydı acaba?"
    },
    {
      "id": "6d5f68bb",
      "bank_id": "00b0b600",
      "text": "Güzel bir sürpriz için mağaradan dışarı adım atın!"
    },
    {
      "id": "6e509abc",
      "bank_id": "00b0b600",
      "text": "Çocuğunuzu geride bırakamazsınız!"
    },
    {
      "id": "71304aa8",
      "bank_id": "00b0b600",
      "text": "Onları bir elime geçireyim de görsünler..."
    },
    {
      "id": "72304c1b",
      "bank_id": "00b0b600",
      "text": "Geçen seferkiyle aynı, yine aynısı olacak... Ahhh!"
    },
    {
      "id": "73a9c5df",
      "bank_id": "00b0b600",
      "text": "Ayak uydurmaya çalış."
    },
    {
      "id": "74304f61",
      "bank_id": "00b0b600",
      "text": "Ah, bu çok can sıkıcı. Yine mi..."
    },
    {
      "id": "74a9c7b2",
      "bank_id": "00b0b600",
      "text": "Oyalanma."
    },
    {
      "id": "7730543a",
      "bank_id": "00b0b600",
      "text": "Ah çocuklar! Canlarım! Keşke zamanı geri alabilseydim."
    },
    {
      "id": "78a6fe34",
      "bank_id": "00b0b600",
      "text": "Belinda! Haha. Belinda, Belinda, Belinda, Belinda! Haha."
    },
    {
      "id": "79a6ffa7",
      "bank_id": "00b0b600",
      "text": "<sighs>"
    },
    {
      "id": "7aa7011a",
      "bank_id": "00b0b600",
      "text": "<sighs>"
    },
    {
      "id": "7af3dcc8",
      "bank_id": "00b0b600",
      "text": "<mutters>"
    },
    {
      "id": "7bf3debb",
      "bank_id": "00b0b600",
      "text": "<harrumphs>"
    },
    {
      "id": "7bf7c91b",
      "bank_id": "00b0b600",
      "text": "Hadi gidelim!"
    },
    {
      "id": "7df3e181",
      "bank_id": "00b0b600",
      "text": "<mutters>"
    },
    {
      "id": "7ec01e80",
