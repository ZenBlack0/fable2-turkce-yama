    },
    {
      "id": "7fc02073",
      "bank_id": "00b0b600",
      "text": "<mutters>"
    },
    {
      "id": "80f3e65a",
      "bank_id": "00b0b600",
      "text": "<sighs>"
    },
    {
      "id": "8196ad12",
      "bank_id": "00b0b600",
      "text": "Hadi o zaman."
    },
    {
      "id": "81f3e7cd",
      "bank_id": "00b0b600",
      "text": "<hums>"
    },
    {
      "id": "83c026bf",
      "bank_id": "00b0b600",
      "text": "<mutters>"
    },
    {
      "id": "84c02812",
      "bank_id": "00b0b600",
      "text": "<hums>"
    },
    {
      "id": "852e4a00",
      "bank_id": "00b0b600",
      "text": "Bu yılki hasat iyi olsa bari. İyi olsa çok iyi olur..."
    },
    {
      "id": "85c02985",
      "bank_id": "00b0b600",
      "text": "<sighs>"
    },
    {
      "id": "872e4d66",
      "bank_id": "00b0b600",
      "text": "Umarım her şey yolunda gider."
    },
    {
      "id": "882e4ed9",
      "bank_id": "00b0b600",
      "text": "Ayin nasıldı sahi? 'Yeni hayat yükselir', evet öyleydi."
    },
    {
      "id": "8852b7bc",
      "bank_id": "00b0b600",
      "text": "Beni bekle!"
    },
    {
      "id": "889f7398",
      "bank_id": "00b0b600",
      "text": "<giggles> Ah evet, ona bunu söyletebilirim. Ne kadar da şahane bir saçmalık."
    },
    {
      "id": "892e504c",
      "bank_id": "00b0b600",
      "text": "Işık bana güç versin."
    },
    {
      "id": "8a2e523f",
      "bank_id": "00b0b600",
      "text": "Birini mağaraya tek başına gönderme fikri, yani tek kelimeyle akıl almaz."
    },
    {
      "id": "8a9f76fe",
      "bank_id": "00b0b600",
      "text": "Hımm, hobbe'lere karşı en etkili büyünün hangisi olacağını merak ediyorum..."
    },
    {
      "id": "8b2e5392",
      "bank_id": "00b0b600",
      "text": "Oakfield için harika bir gün olacak. Hepimiz için."
    },
    {
      "id": "8b52bc75",
      "bank_id": "00b0b600",
      "text": "O kadar hızlı değil!"
    },
    {
      "id": "8b9f7851",
      "bank_id": "00b0b600",
      "text": "Büyü güçlerime odaklanmalıyım. İçerisi tehlikeli olacak."
    },
    {
      "id": "8c2e5505",
      "bank_id": "00b0b600",
      "text": "Ağaç yükselecek ve her şey düzelecek."
    },
    {
      "id": "8c900e0f",
      "bank_id": "00b0b600",
      "text": "Çiftçiye gizlice yaklaşmalısınız."
    },
    {
      "id": "8d9f7bb7",
      "bank_id": "00b0b600",
      "text": "<giggles> Murray'nin yorumlarıyla epey eğleneceğim."
    },
    {
      "id": "8de0afbd",
      "bank_id": "00b0b600",
      "text": "Kuleye dikkatlice yaklaşmalısınız."
    },
    {
      "id": "937ed020",
      "bank_id": "00b0b600",
      "text": "Acele et."
    },
    {
      "id": "9517e680",
      "bank_id": "00b0b600",
      "text": "<mutters>"
    },
    {
      "id": "9538c658",
      "bank_id": "00b0b600",
      "text": "<sighs>"
    },
    {
      "id": "9617e873",
      "bank_id": "00b0b600",
      "text": "<harrumphs>"
    },
    {
      "id": "9638c7cb",
      "bank_id": "00b0b600",
      "text": "Ona ne diyeceğim ben...? Asla anlamayacak, biliyorum."
    },
    {
      "id": "967ed4f9",
      "bank_id": "00b0b600",
      "text": "Ayak uydurman gerek."
    },
    {
      "id": "9817eb59",
      "bank_id": "00b0b600",
      "text": "<mutters>"
    },
    {
      "id": "9838cb11",
      "bank_id": "00b0b600",
      "text": "<sighs>"
    },
    {
      "id": "9917eccc",
      "bank_id": "00b0b600",
      "text": "<mutters>"
    },
    {
      "id": "995e1830",
      "bank_id": "00b0b600",
      "text": "Parayı bulmalıyım. Parayı bulmalıyım. O parayı mutlaka almalıyım."
    },
    {
      "id": "9b17f012",
      "bank_id": "00b0b600",
      "text": "<sighs>"
    },
    {
      "id": "9b38cfea",
      "bank_id": "00b0b600",
      "text": "<sighs> Bıktım artık buradan..."
    },
    {
      "id": "9b4c2878",
      "bank_id": "00b0b600",
      "text": "<mutters>"
    },
    {
      "id": "9c17f185",
      "bank_id": "00b0b600",
      "text": "<hums>"
    },
    {
      "id": "9c38d15d",
      "bank_id": "00b0b600",
      "text": "Şehirde olsaydı böyle olmazdı..."
    },
    {
      "id": "9c5e1c89",
      "bank_id": "00b0b600",
      "text": "Şu Denzil pisliğin teki. Bana hiç iyi davranmıyor."
    },
    {
      "id": "9d4c2b5e",
      "bank_id": "00b0b600",
      "text": "<harrumphs>"
    },
    {
      "id": "9e4c2d31",
      "bank_id": "00b0b600",
      "text": "<mutters>"
    },
    {
      "id": "9eaf26f0",
      "bank_id": "00b0b600",
      "text": "<sighs> Ayaklarım koptu. Bir dahaki sefere masa başı iş bulacağım."
    },
    {
      "id": "9f4c2ea4",
      "bank_id": "00b0b600",
      "text": "<hums>"
    },
    {
      "id": "9faf2863",
      "bank_id": "00b0b600",
      "text": "Patates almayı unutmamalıyım."
    },
    {
      "id": "a04c3017",
      "bank_id": "00b0b600",
      "text": "<sighs>"
    },
    {
      "id": "a0af29d6",
      "bank_id": "00b0b600",
      "text": "Hayatımda kazandığım en kolay para bu..."
    },
    {
      "id": "a12c2a2a",
      "bank_id": "00b0b600",
      "text": "Bu mağaranın gizemleri gün yüzüne çıkarılmalı!"
    },
    {
      "id": "a1af2b49",
      "bank_id": "00b0b600",
      "text": "O kotayı doldurmalıyım yoksa öldüm ben, evet..."
    },
    {
      "id": "a24c337d",
      "bank_id": "00b0b600",
      "text": "<mutters>"
    },
    {
      "id": "a2af2d3c",
      "bank_id": "00b0b600",
      "text": "Benim işimi yapacak birkaç enayi daha bulmam gerek..."
    },
    {
      "id": "a393061d",
      "bank_id": "00b0b600",
      "text": "Bu yolkesenlerin icabına şimdi bakmazsanız onları bir daha asla bulamayabilirsiniz!"
    },
    {
      "id": "a3fcbc43",
      "bank_id": "00b0b600",
      "text": "Şimdi ayrılamazsınız yoksa çocuğunuz bu korkunç hobbe'lerin elinde can verir!"
    },
    {
      "id": "a456adc0",
      "bank_id": "00b0b600",
      "text": "<harrumphs>"
    },
    {
      "id": "a45be590",
      "bank_id": "00b0b600",
      "text": "Geldik işte!"
    },
    {
      "id": "a4af3002",
      "bank_id": "00b0b600",
      "text": "Lanet kıllı bacaklarım yine kaşınmaya başladı..."
    },
    {
      "id": "a556afb3",
      "bank_id": "00b0b600",
      "text": "<mutters>"
    },
    {
      "id": "a5af31f5",
      "bank_id": "00b0b600",
      "text": "Bakalım... Bu ay kaç tane aldık...? Ha evet, doğru."
    },
    {
      "id": "a5e1568d",
      "bank_id": "00b0b600",
      "text": "Altın: %1 / %2"
