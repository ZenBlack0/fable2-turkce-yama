  "strings": [
    {
      "id": "02728698",
      "bank_id": "20ad3602",
      "text": "Ooo! Bir ünlü bana asılıyor! Oooohh!!!!"
    },
    {
      "id": "02728699",
      "bank_id": "20ad3602",
      "text": "Neeeeee? Beeen miii? Ooooh! Hihihi!"
    },
    {
      "id": "0272869b",
      "bank_id": "20ad3602",
      "text": "Ooooh! Vay canına! Ama sen çok ünlüsün! Bense değilim!"
    },
    {
      "id": "0272869c",
      "bank_id": "20ad3602",
      "text": "Ah! Görevlerin herkesçe biliniyor, şimdi de romantik meyillerin!"
    },
    {
      "id": "0272869d",
      "bank_id": "20ad3602",
      "text": "Amanın! Ay! Şey... amanın! Hihihi!"
    },
    {
      "id": "0272869e",
      "bank_id": "20ad3602",
      "text": "Bu banaaa mıydııı??? Vay be! Şöhreti ve talihi nasıl kendime çekeceğimi iyi biliyorum, değil mi?!"
    },
    {
      "id": "0272869f",
      "bank_id": "20ad3602",
      "text": "Sen ve ben mi??? Hobbe aşkına inanılmaz!"
    },
    {
      "id": "0f4d225d",
      "bank_id": "20ad3602",
      "text": "Ne yapıyorsun sen?!"
    },
    {
      "id": "1a4d338c",
      "bank_id": "20ad3602",
      "text": "Ne yapıyorsun sen?!"
    },
    {
      "id": "1dd81b58",
      "bank_id": "20ad3602",
      "text": "Aradığın kişinin ben olduğunu sanmıyorum. Olmasa iyi edersin."
    },
    {
      "id": "1dd81b59",
      "bank_id": "20ad3602",
      "text": "Doğru kişiyi bulduğundan emin misin?! Domuz aşkına..."
    },
    {
      "id": "1dd81b5a",
      "bank_id": "20ad3602",
      "text": "Doğru kişiye hitap ettiğinize inanmıyorum."
    },
    {
      "id": "1dd81b5b",
      "bank_id": "20ad3602",
      "text": "Muhakkak başka birini arıyor olmalısın."
    },
    {
      "id": "1dd81b5d",
      "bank_id": "20ad3602",
      "text": "Bu pek, şey, pek uygun kaçmadı, hani yani."
    },
    {
      "id": "1dd81b5e",
      "bank_id": "20ad3602",
      "text": "Hmm, sanırım yanlış kişiye denk geldin."
    },
    {
      "id": "1dd81b5f",
      "bank_id": "20ad3602",
      "text": "Hey, beni kim zannediyorsun sen?!"
    },
    {
      "id": "2767abc6",
      "bank_id": "20ad3602",
      "text": "Gerçekten senin ilgine layık mıyım? Ne kadar da heyecan verici."
    },
    {
      "id": "288574c8",
      "bank_id": "20ad3602",
      "text": "İnsanı büyüleyen bir havan var."
    },
    {
      "id": "288574c9",
      "bank_id": "20ad3602",
      "text": "Bu çok romantik."
    },
    {
      "id": "288574ca",
      "bank_id": "20ad3602",
      "text": "Beni nasıl çileden çıkaracağını iyi biliyorsun."
    },
    {
      "id": "288574cb",
      "bank_id": "20ad3602",
      "text": "Çok tatlı numaralar bunlar."
    },
    {
      "id": "288574cc",
      "bank_id": "20ad3602",
      "text": "Ne kadar da romantik."
    },
    {
      "id": "288574cd",
      "bank_id": "20ad3602",
      "text": "Ah, bu beni resmen eritiyor."
    },
    {
      "id": "288574ce",
      "bank_id": "20ad3602",
      "text": "Ah, harika."
    },
    {
      "id": "28d82c88",
      "bank_id": "20ad3602",
      "text": "Beni kim sanıyorsun ki sen?"
    },
    {
      "id": "28d82c89",
      "bank_id": "20ad3602",
      "text": "Ben mi?! Aptal olma!"
    },
    {
      "id": "28d82c8a",
      "bank_id": "20ad3602",
      "text": "Lütfen ilginizi daha münasip birine yöneltin."
    },
    {
      "id": "28d82c8b",
      "bank_id": "20ad3602",
      "text": "Korkarım fena halde yanılıyorsunuz."
    },
    {
      "id": "28d82c8c",
      "bank_id": "20ad3602",
      "text": "Şey, sanırım beni başka biriyle karıştırdın..."
    },
    {
      "id": "28d82c8e",
      "bank_id": "20ad3602",
      "text": "Lütfen ama! Git başka birini bul!"
    },
    {
      "id": "28d82c8f",
      "bank_id": "20ad3602",
      "text": "Mmm, aradığın kişinin ben olduğunu hiç sanmıyorum."
    },
    {
      "id": "31858318",
      "bank_id": "20ad3602",
      "text": "Rüyalarımda seni göreceğim."
    },
    {
      "id": "31858319",
      "bank_id": "20ad3602",
      "text": "Nasıl romantik olunacağını bilen pek az insan var."
    },
    {
      "id": "3185831b",
      "bank_id": "20ad3602",
      "text": "Bayağı ustaca bir kur yapma şekli."
    },
    {
      "id": "3185831c",
      "bank_id": "20ad3602",
      "text": "Tam bir aşk cambazısın sen."
    },
    {
      "id": "3185831d",
      "bank_id": "20ad3602",
      "text": "Rüyalarımda seni göreceğim."
    },
    {
      "id": "3185831e",
      "bank_id": "20ad3602",
      "text": "Görünüşe göre romantizm henüz ölmemiş."
    },
    {
      "id": "3185831f",
      "bank_id": "20ad3602",
      "text": "İçimi pamuk gibi yapıyorsun."
    },
