    {
      "id": "7c40a5d8",
      "bank_id": "20ad3602",
      "text": "Erkek olduğum için gurur duymamı sağlıyorsun."
    },
    {
      "id": "7c40a5da",
      "bank_id": "20ad3602",
      "text": "Seni düşünüyordum ben de."
    },
    {
      "id": "7c40a5db",
      "bank_id": "20ad3602",
      "text": "Daha sonra boş musun?"
    },
    {
      "id": "7c40a5dc",
      "bank_id": "20ad3602",
      "text": "İçimi kıpır kıpır ediyorsun."
    },
    {
      "id": "7c40a5dd",
      "bank_id": "20ad3602",
      "text": "Rüyalarıma girdin."
    },
    {
      "id": "7c40a5de",
      "bank_id": "20ad3602",
      "text": "Seni görmekten asla bıkmıyorum."
    },
    {
      "id": "7c40a5df",
      "bank_id": "20ad3602",
      "text": "Sırılsıklam aşık oldum!"
    },
    {
      "id": "7d815500",
      "bank_id": "20ad3602",
      "text": "Bayağı berbat bir şey."
    },
    {
      "id": "7d815502",
      "bank_id": "20ad3602",
      "text": "Bence çirkinliğin tanımı tam olarak bu."
    },
    {
      "id": "7d815503",
      "bank_id": "20ad3602",
      "text": "Sanırım bu mahalledeki evlerin fiyatı az önce düştü."
    },
    {
      "id": "7d815504",
      "bank_id": "20ad3602",
      "text": "Hepimizi hasta etmene hiç lüzum yok."
    },
    {
      "id": "7d815505",
      "bank_id": "20ad3602",
      "text": "\"Çirkinlik\" konusunda üstüne yok doğrusu."
    },
    {
      "id": "8140adf9",
      "bank_id": "20ad3602",
      "text": "Kadın olduğum için gurur duymamı sağlıyorsun."
    },
    {
      "id": "8140adfa",
      "bank_id": "20ad3602",
      "text": "Bugün seni görmeyi umuyordum."
    },
    {
      "id": "8140adfb",
      "bank_id": "20ad3602",
      "text": "Cidden bir harikasın."
    },
    {
      "id": "8140adfc",
      "bank_id": "20ad3602",
      "text": "Seni görmeyi umut ediyordum ben de."
    },
    {
      "id": "8140adfd",
      "bank_id": "20ad3602",
      "text": "Daha sonra boş musun?"
    },
    {
      "id": "8140adfe",
      "bank_id": "20ad3602",
      "text": "Kendimi öyle kadınsı hissettiriyorsun ki."
    },
    {
      "id": "8140adff",
      "bank_id": "20ad3602",
      "text": "İtiraf etmeliyim ki vuruldum sana."
    },
    {
      "id": "81e018e8",
      "bank_id": "20ad3602",
      "text": "Pek bir cazibelisin sen öyle değil mi?"
    },
    {
      "id": "81e018e9",
      "bank_id": "20ad3602",
      "text": "Bayağı bir hoşsun hani?"
    },
    {
      "id": "81e018ea",
      "bank_id": "20ad3602",
      "text": "Ah, ne kadar da şeytani bir harikalık."
    },
    {
      "id": "81e018eb",
      "bank_id": "20ad3602",
      "text": "Bir erkeğin kalbini nasıl çalacağını gerçekten çok iyi biliyorsun."
    },
    {
      "id": "81e018ed",
      "bank_id": "20ad3602",
      "text": "Ayy, çok tatlısın sen."
    },
    {
      "id": "81e018ee",
      "bank_id": "20ad3602",
      "text": "Hihihi. Tam bir cilvelisin sen."
    },
    {
      "id": "81e018ef",
      "bank_id": "20ad3602",
      "text": "Ooo, tam bir cazibe abidesisin."
    },
    {
      "id": "8ce02a18",
      "bank_id": "20ad3602",
      "text": "Her geçen gün senden biraz daha hoşlanıyorum."
    },
    {
      "id": "8ce02a19",
      "bank_id": "20ad3602",
      "text": "Ayy, çok romantiksin!"
    },
    {
      "id": "8ce02a1a",
      "bank_id": "20ad3602",
      "text": "Ne büyük bir baştan çıkarma! Kalbim duracak!"
    },
    {
      "id": "8ce02a1b",
      "bank_id": "20ad3602",
      "text": "Büyülendim resmen!"
    },
    {
      "id": "8ce02a1c",
      "bank_id": "20ad3602",
      "text": "Ah, tam bir baştan çıkarıcısın."
    },
    {
      "id": "8ce02a1e",
      "bank_id": "20ad3602",
      "text": "Lokum gibisin sen lokum. Tatlı mı tatlı bir lokum."
    },
    {
      "id": "8ce02a1f",
      "bank_id": "20ad3602",
      "text": "İçimi sıcacık yapıyorsun."
    },
    {
      "id": "a0a73632",
      "bank_id": "20ad3602",
      "text": "Kalp hırsızı olarak ün salmış değilsin herhalde, değil mi?"
    },
    {
      "id": "a0a73633",
      "bank_id": "20ad3602",
      "text": "Ah, bir ünlü benden hoşlanıyor! Bu inanılmaz."
    },
    {
      "id": "a0a73634",
      "bank_id": "20ad3602",
      "text": "Senin gibi ünlü birinin benim gibi sıradan biriyle ilgilenebileceğine inanamıyorum!"
    },
    {
      "id": "a0a73635",
