    {
      "id": "7e0def54",
      "bank_id": "40339601",
      "text": "Sızlanmayı kes! Hâlâ hayatta olduğuna şükretmelisin."
    },
    {
      "id": "7e0def57",
      "bank_id": "40339601",
      "text": "Gözüm üzerinde. Daha sıkı çalışmaya başlamazsan kendini surların ötesinde bulabilirsin."
    },
    {
      "id": "836e03b0",
