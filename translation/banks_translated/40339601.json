    {
      "id": "836e03b2",
      "bank_id": "40339601",
      "text": "Hop. Hayır. Bu taraftan."
    },
    {
      "id": "836e03b3",
      "bank_id": "40339601",
      "text": "O doğru yol değil."
    },
    {
      "id": "836e03b4",
      "bank_id": "40339601",
      "text": "Bu yanlış yol. Eminim."
    },
    {
      "id": "836e03b5",
      "bank_id": "40339601",
      "text": "Bunun yanlış yol olduğuna yemin edebilirim."
    },
    {
      "id": "836e03b7",
      "bank_id": "40339601",
      "text": "O taraftan değil. Bu taraftan."
    },
    {
      "id": "8910ea20",
      "bank_id": "40339601",
      "text": "Acele et lütfen. Vakit kayboluyor."
    },
    {
      "id": "8910ea21",
      "bank_id": "40339601",
      "text": "Geç kalma havasında değilim."
    },
    {
      "id": "8910ea22",
      "bank_id": "40339601",
      "text": "Daha hızlı!"
    },
    {
      "id": "8910ea23",
      "bank_id": "40339601",
      "text": "Gitmek için can atıyorum."
    },
    {
      "id": "8910ea24",
      "bank_id": "40339601",
      "text": "Hadi biraz hızlanalım, olmaz mı?"
    },
    {
      "id": "8910ea25",
      "bank_id": "40339601",
      "text": "Çabuk çabuk çabuk!"
    },
    {
      "id": "8910ea27",
      "bank_id": "40339601",
      "text": "Acele edelim."
    },
    {
      "id": "8a6e0eb8",
      "bank_id": "40339601",
      "text": "O taraftan değil. Cık."
    },
    {
      "id": "8a6e0eb9",
      "bank_id": "40339601",
      "text": "Hayır, o taraftan değil."
    },
    {
      "id": "8a6e0eba",
      "bank_id": "40339601",
      "text": "Cık. Yanlış yol."
    },
    {
      "id": "8a6e0ebc",
      "bank_id": "40339601",
      "text": "Hayır, yanlış yoldan gidiyorsun."
    },
    {
      "id": "8a6e0ebd",
      "bank_id": "40339601",
      "text": "Doğru yol bu değil."
    },
    {
      "id": "8a6e0ebe",
      "bank_id": "40339601",
      "text": "O taraftan değil."
    },
    {
      "id": "8a6e0ebf",
      "bank_id": "40339601",
      "text": "Bu yanlış yol. Bilmem gerekir."
    },
    {
      "id": "8a72a5dd",
      "bank_id": "40339601",
      "text": "O taraftan gidelim!"
    },
    {
      "id": "9010f528",
      "bank_id": "40339601",
      "text": "Acele et o zaman!"
    },
    {
      "id": "9010f529",
      "bank_id": "40339601",
      "text": "Hadi gidelim artık."
    },
    {
      "id": "9010f52a",
      "bank_id": "40339601",
      "text": "Hey. Acele et hadi."
    },
    {
      "id": "9010f52c",
      "bank_id": "40339601",
      "text": "Yavaş gitmek fukaralara göredir. Vakit nakittir."
    },
    {
      "id": "9010f52d",
      "bank_id": "40339601",
      "text": "Hadi acele edelim."
    },
    {
      "id": "9010f52e",
      "bank_id": "40339601",
      "text": "Acele et!"
    },
    {
      "id": "9010f52f",
      "bank_id": "40339601",
      "text": "Kaybedecek vaktim yok. Hadi gidelim."
    },
    {
      "id": "9572b70c",
      "bank_id": "40339601",
      "text": "O taraftan gidelim!"
    },
    {
      "id": "9939cd71",
      "bank_id": "40339601",
      "text": "Bu yerde bir terslik var. Duvarların ne kadar soğuk olduğunu hiç fark ettin mi?"
    },
    {
      "id": "9939cd72",
      "bank_id": "40339601",
      "text": "Bazen her gün verdikleri o yemeğin neyden yapıldığını merak ediyorum. Daha önce yediğim hiçbir şeye benzemiyor."
    },
    {
      "id": "a707fc5d",
      "bank_id": "40339601",
      "text": "Buraya bayılıyorum."
    },
    {
      "id": "b2080d8c",
      "bank_id": "40339601",
      "text": "Burası harika!"
    },
    {
      "id": "bbb439c8",
      "bank_id": "40339601",
      "text": "Olmayı isteyeceğim başka hiçbir yer yok."
    },
    {
      "id": "bbb439c9",
      "bank_id": "40339601",
      "text": "Burayı gerçekten çok seviyorum."
    },
    {
      "id": "bbb439ca",
      "bank_id": "40339601",
      "text": "İnsan böyle bir yerde hayatın tadını çıkarabilir."
    },
    {
      "id": "bbb439cb",
      "bank_id": "40339601",
      "text": "Buraya karşı ayrı bir sempatim var."
    },
    {
      "id": "bbb439cd",
      "bank_id": "40339601",
      "text": "Burayı çok seviyorum."
    },
    {
      "id": "bbb439ce",
      "bank_id": "40339601",
      "text": "Burası harika değil mi?"
    },
    {
      "id": "bbb439cf",
      "bank_id": "40339601",
      "text": "Burası dünyanın en güzel yeri."
    },
    {
      "id": "bfe723b0",
      "bank_id": "40339601",
      "text": "Hiç tuhaf rüyalar gördüğün olur mu? Ben sürekli görüyorum. Dostum, neler neler görüyorum bir bilsen..."
    },
    {
      "id": "bfe723b3",
      "bank_id": "40339601",
      "text": "Bay L'nin bütün bu zavallılara ne yapacağını hiç merak ettiğin oluyor mu?"
    },
    {
      "id": "c6b44b78",
      "bank_id": "40339601",
      "text": "Bana sorarsan birinci sınıf bir yer."
    },
    {
      "id": "c6b44b79",
      "bank_id": "40339601",
      "text": "Ne harika bir yer burası."
    },
    {
      "id": "c6b44b7a",
      "bank_id": "40339601",
      "text": "Ne muazzam bir yer burası."
    },
    {
      "id": "c6b44b7b",
      "bank_id": "40339601",
      "text": "Burada vakit geçirmekten öyle keyif alıyorum ki."
    },
    {
      "id": "c6b44b7c",
      "bank_id": "40339601",
      "text": "Burayı epey seviyorum."
    },
    {
      "id": "c6b44b7e",
      "bank_id": "40339601",
      "text": "Bulunmak için harika bir yer değil mi?"
    },
    {
      "id": "c6b44b7f",
      "bank_id": "40339601",
      "text": "Burası harika!"
    },
    {
      "id": "c9296fd1",
      "bank_id": "40339601",
      "text": "Gitme vakti."
    },
    {
      "id": "c9296fd2",
      "bank_id": "40339601",
      "text": "Başlayalım, ne dersin?"
    },
    {
      "id": "c9296fd3",
      "bank_id": "40339601",
      "text": "Gitmeye hazırım."
    },
    {
      "id": "c9296fd4",
      "bank_id": "40339601",
      "text": "Ah, sabırsızlanıyorum. Hadi gidelim."
    },
    {
      "id": "c9296fd5",
      "bank_id": "40339601",
      "text": "Hadi gidelim."
    },
    {
      "id": "c9296fd6",
      "bank_id": "40339601",
      "text": "Gidiyoruz o zaman."
    },
    {
      "id": "c9296fd7",
      "bank_id": "40339601",
      "text": "Hadi yola koyulalım."
    },
    {
      "id": "cdcf1759",
      "bank_id": "40339601",
      "text": "Belki kıçına bir tekme yesen daha rahat ederdin."
    },
    {
      "id": "cdcf175a",
      "bank_id": "40339601",
      "text": "Kendine bir iyilik yap ve damarıma basma."
    },
    {
      "id": "d4298100",
      "bank_id": "40339601",
      "text": "Sen hazır olduğunda ben de hazırım."
    },
    {
      "id": "d4298102",
      "bank_id": "40339601",
      "text": "Ben hazırım. Ya sen?"
    },
    {
      "id": "d4298103",
      "bank_id": "40339601",
      "text": "Gidelim o zaman."
    },
    {
      "id": "d4298104",
      "bank_id": "40339601",
      "text": "Ah, gitmeye hazır mısın?"
    },
    {
      "id": "d4298105",
      "bank_id": "40339601",
      "text": "Hadi, yola koyulalım."
    },
    {
      "id": "d4298106",
      "bank_id": "40339601",
      "text": "Neyi bekliyoruz? Başlayalım."
    },
    {
      "id": "d4298107",
      "bank_id": "40339601",
      "text": "Acil bir durum yoksa yola çıkalım derim."
    },
    {
      "id": "d6388aa6",
      "bank_id": "40339601",
      "text": "Ha ha ha."
    },
    {
      "id": "d937aae8",
      "bank_id": "40339601",
      "text": "Ah, en iyi yol buradan."
    },
    {
      "id": "d937aaec",
      "bank_id": "40339601",
      "text": "Doğru yol bu."
    },
    {
      "id": "d937aaed",
      "bank_id": "40339601",
      "text": "Uzun zamandır bu yoldan gitmemiştim ama yolun bu olduğunu biliyorum."
    },
    {
      "id": "d937aaee",
      "bank_id": "40339601",
      "text": "Doğru yol bu. Annemin üstüne bahse girerim."
    },
    {
      "id": "d937aaef",
      "bank_id": "40339601",
      "text": "Evet, kesinlikle yol bu."
    },
    {
      "id": "da1e7ab8",
      "bank_id": "40339601",
      "text": "Artık bundan gına geldi."
    },
    {
      "id": "db1e7c2b",
      "bank_id": "40339601",
      "text": "Beni iğrendiriyorsun."
    },
    {
      "id": "e01e83ca",
      "bank_id": "40339601",
      "text": "Beni daha fazla sinirlendirme!"
    },
    {
      "id": "e11e85bd",
      "bank_id": "40339601",
      "text": "Sabrımı zorlama."
    },
    {
      "id": "e2affa02",
      "bank_id": "40339601",
      "text": "Keşke sonsuza kadar burada kalabilsem."
    },
    {
      "id": "eb219870",
      "bank_id": "40339601",
      "text": "Neden bu kadar oyalanıyorsun?"
    },
    {
      "id": "eb219871",
      "bank_id": "40339601",
      "text": "Neden gecikiyorsun?"
    },
    {
      "id": "eb219872",
      "bank_id": "40339601",
      "text": "Neden durdun ki?"
    },
    {
      "id": "eb219873",
      "bank_id": "40339601",
      "text": "Neden duruyorsun?"
    },
    {
      "id": "eb219874",
      "bank_id": "40339601",
      "text": "Hey. Hadi devam edelim."
    },
    {
      "id": "eb219875",
      "bank_id": "40339601",
      "text": "Durmak mı? Burada mı?"
    },
    {
      "id": "eb219877",
      "bank_id": "40339601",
      "text": "Bekle. Neden durdun?"
    },
    {
      "id": "ebb0086f",
      "bank_id": "40339601",
      "text": "Buradan hiç ayrılmak istemiyorum."
    },
    {
      "id": "f006c63e",
      "bank_id": "40339601",
      "text": "Burayı sevmedim."
    },
    {
      "id": "f221a378",
      "bank_id": "40339601",
      "text": "Ayakların mı ağrıyor?"
    },
    {
      "id": "f221a379",
      "bank_id": "40339601",
      "text": "Durmak mı? Neden şimdi?"
    },
    {
      "id": "f221a37a",
      "bank_id": "40339601",
      "text": "Durmak da neyin nesi?"
    },
    {
      "id": "f221a37c",
      "bank_id": "40339601",
      "text": "Sana durmanı söylemedim."
    },
    {
      "id": "f221a37d",
      "bank_id": "40339601",
      "text": "Durabileceğini kim söyledi şimdi?"
    },
    {
      "id": "f221a37e",
      "bank_id": "40339601",
      "text": "Durma!"
    },
    {
      "id": "f221a37f",
      "bank_id": "40339601",
      "text": "Şimdi durma. Neredeyse vardık."
    },
    {
      "id": "f906d40b",
      "bank_id": "40339601",
      "text": "Bu yerden nefret ediyorum."
    },
    {
      "id": "fd77fd30",
      "bank_id": "40339601",
      "text": "O taraftan gidelim!"
    },
    {
      "id": "fd77fd31",
      "bank_id": "40339601",
      "text": "O taraftan gidelim!"
    },
    {
      "id": "fd77fd32",
      "bank_id": "40339601",
      "text": "O taraftan gidelim!"
    },
    {
      "id": "fd77fd33",
      "bank_id": "40339601",
      "text": "O taraftan gidelim!"
    },
    {
      "id": "fd77fd34",
      "bank_id": "40339601",
      "text": "O taraftan gidelim!"
    },
    {
      "id": "fd77fd36",
      "bank_id": "40339601",
      "text": "O taraftan gidelim!"
    },
    {
      "id": "fd77fd37",
      "bank_id": "40339601",
      "text": "O taraftan gidelim!"
    }
  ]
}