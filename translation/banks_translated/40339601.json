      "text": "Buraya bayılmıyor musun resmen?"
    },
    {
      "id": "72a78296",
      "bank_id": "40339601",
      "text": "Ne fantastik bir yer burası."
    },
    {
      "id": "72a78297",
      "bank_id": "40339601",
      "text": "Bunun gibisi başka hiçbir yerde yok."
