    },
    {
      "id": "04fba4fd",
      "bank_id": "40339601",
      "text": "Karanlık heybetli gölgeler, kucaklıyorum sizi. Karanlık heybetli gölgeler, kucaklıyorum sizi."
    },
    {
      "id": "1f508ad0",
      "bank_id": "40339601",
      "text": "Sessiz ol mahkûm!"
    },
    {
      "id": "1f508ad3",
      "bank_id": "40339601",
      "text": "Beni oraya sokturma!"
    },
    {
      "id": "2673c053",
      "bank_id": "40339601",
      "text": "Hadi, şuraya gidelim."
    },
    {
      "id": "2d73cb56",
      "bank_id": "40339601",
      "text": "Neden şuraya gitmiyoruz?"
    },
    {
      "id": "2da298e2",
      "bank_id": "40339601",
      "text": "Burası çok sevimli değil mi?"
    },
    {
      "id": "2f6c3cd8",
      "bank_id": "40339601",
      "text": "Burayı gerçekten hiç sevmedim."
    },
    {
      "id": "2f6c3cda",
      "bank_id": "40339601",
      "text": "Burası olabilecek en kötü yer."
    },
    {
      "id": "2f6c3cdb",
      "bank_id": "40339601",
      "text": "Burayı gerçekten hiç sevmedim."
    },
    {
      "id": "2f6c3cdc",
      "bank_id": "40339601",
      "text": "Buradan gerçekten ama gerçekten nefret ediyorum."
    },
    {
      "id": "2f6c3cdd",
      "bank_id": "40339601",
      "text": "Burayı gerçekten hiç sevmedim."
    },
    {
      "id": "2f6c3cde",
      "bank_id": "40339601",
      "text": "Buradan gerçekten tiksiniyorum."
    },
    {
      "id": "2f6c3cdf",
      "bank_id": "40339601",
      "text": "Buranın ne kadar korkunç olduğunu anlatamam."
    },
    {
      "id": "3067fb10",
      "bank_id": "40339601",
      "text": "Beni daha fazla öfkelendirme!"
    },
    {
      "id": "30973383",
      "bank_id": "40339601",
      "text": "Şuraya gidebilir miyiz?"
    },
    {
      "id": "3367ffe9",
      "bank_id": "40339601",
      "text": "Buna pişman olacaksın!"
    },
    {
      "id": "346c44f9",
      "bank_id": "40339601",
      "text": "Buradan nefret ediyorum."
    },
    {
      "id": "346c44fa",
      "bank_id": "40339601",
      "text": "Burayı gerçekten hiç sevmedim."
    },
    {
      "id": "346c44fb",
      "bank_id": "40339601",
      "text": "Burası korkunç bir yer."
    },
    {
      "id": "346c44fc",
      "bank_id": "40339601",
      "text": "Burası olabilecek en kötü yer."
    },
    {
      "id": "346c44fd",
      "bank_id": "40339601",
      "text": "Buradan gerçekten nefret ediyorum biliyor musun."
    },
    {
      "id": "346c44fe",
      "bank_id": "40339601",
      "text": "Buraya pek bayılmadım."
    },
    {
      "id": "346c44ff",
      "bank_id": "40339601",
      "text": "Ah, bu mekân tek kelimeyle berbat."
    },
    {
      "id": "350bafe8",
      "bank_id": "40339601",
      "text": "Ne iğrenç bir çöplük burası."
    },
    {
      "id": "350bafe9",
      "bank_id": "40339601",
      "text": "Daha az bulunmak isteyeceğim başka bir yer düşünemiyorum."
    },
    {
      "id": "350bafea",
      "bank_id": "40339601",
      "text": "Ayak bastığım en berbat yer burası."
    },
    {
      "id": "350bafeb",
      "bank_id": "40339601",
      "text": "Burası gerçekten rezalet derecede kötü bir yer."
    },
    {
      "id": "350bafed",
      "bank_id": "40339601",
      "text": "Dünyadaki en sevmediğim yer burasıdır işte."
    },
    {
      "id": "350bafee",
      "bank_id": "40339601",
      "text": "Ah, burası tek kelimeyle berbat!"
    },
    {
      "id": "350bafef",
      "bank_id": "40339601",
      "text": "Ne mezbelelik ama."
    },
    {
      "id": "35e1ce38",
      "bank_id": "40339601",
      "text": "Kiminle konuştuğunun farkındasındır umarım."
    },
    {
      "id": "36a2a6cf",
      "bank_id": "40339601",
      "text": "Burası gelmiş geçmiş en iyi yer."
    },
    {
      "id": "36a93000",
      "bank_id": "40339601",
      "text": "Burası hiç de fena değil!"
    },
    {
      "id": "36a93001",
      "bank_id": "40339601",
      "text": "Burada kalalım. Çok güzel!"
    },
    {
      "id": "36a93002",
      "bank_id": "40339601",
      "text": "Ah, burayı sevdim!"
    },
    {
      "id": "36a93004",
      "bank_id": "40339601",
      "text": "Ahh, insan burada pek çok mutlu an geçirdiğini hayal edebiliyor."
    },
    {
      "id": "36a93005",
      "bank_id": "40339601",
      "text": "Evet, bu mekân gayet hoş."
    },
    {
      "id": "36a93006",
      "bank_id": "40339601",
      "text": "Burası çok hoş değil mi?"
    },
    {
      "id": "36a93007",
      "bank_id": "40339601",
      "text": "Ahh, burayı sevdim!"
    },
    {
      "id": "36e1cfab",
      "bank_id": "40339601",
      "text": "Bunun ne yeri ne de zamanı."
    },
    {
      "id": "37973e86",
      "bank_id": "40339601",
      "text": "Onun yerine şuraya gidelim."
    },
    {
      "id": "37e1d11e",
      "bank_id": "40339601",
      "text": "Reddetmek zorundayım."
    },
    {
      "id": "39a0950b",
      "bank_id": "40339601",
      "text": "Çok güzel."
    },
    {
      "id": "3d07cee8",
      "bank_id": "40339601",
      "text": "Evde olmayı tercih ederdim. Hatta bir lav çukurunda olmayı bile tercih ederdim."
    },
    {
      "id": "3d07cee9",
      "bank_id": "40339601",
      "text": "Bu cehennem çukurunda bir dakika daha geçirmemi gerçekten bekliyor musun?"
    },
    {
      "id": "3d07ceea",
      "bank_id": "40339601",
      "text": "Öff! Buradan nefret ediyorum. Başka bir yere gidelim."
    },
    {
      "id": "3d07ceeb",
      "bank_id": "40339601",
      "text": "Burası tam bir bataklık! Defolup gidelim buradan."
    },
    {
      "id": "3d07ceec",
      "bank_id": "40339601",
      "text": "Iyy. Daha az berbat bir yere gidelim."
    },
    {
      "id": "3d07ceed",
      "bank_id": "40339601",
      "text": "Vaktimizi geçirecek buradan daha iyi yerler olmalı."
    },
    {
      "id": "3d07ceee",
      "bank_id": "40339601",
      "text": "Bu yerden nefret ediyorum. Başka bir yere gidemez miyiz?"
    },
    {
      "id": "3da09bb7",
      "bank_id": "40339601",
      "text": "Ne kadar da hoş."
    },
    {
      "id": "3fa93e68",
      "bank_id": "40339601",
      "text": "Ooh, burası öyle güzel ki, sence de öyle değil mi?"
    },
    {
      "id": "3fa93e69",
      "bank_id": "40339601",
      "text": "Hmm, evet, burası gayet makul bir yer."
    },
    {
      "id": "3fa93e6a",
      "bank_id": "40339601",
      "text": "Buraya bayılıyorum. Sen de öyle değil misin?"
    },
    {
      "id": "3fa93e6b",
      "bank_id": "40339601",
      "text": "Evet, burası harika bir yer!"
    },
    {
      "id": "3fa93e6c",
      "bank_id": "40339601",
      "text": "Burada biraz daha kalmaya hiç itirazım olmaz."
    },
    {
      "id": "3fa93e6d",
      "bank_id": "40339601",
      "text": "Burayı oldum olası çok sevmişimdir."
    },
    {
      "id": "3fa93e6f",
      "bank_id": "40339601",
      "text": "Ahh, vakit geçirmek için gayet güzel bir yer!"
    },
    {
      "id": "400bc118",
      "bank_id": "40339601",
      "text": "Burada daha fazla kalmaktansa ölmeyi tercih ederim."
    },
    {
      "id": "400bc119",
      "bank_id": "40339601",
      "text": "Dünyanın en berbat yeri."
    },
    {
      "id": "400bc11a",
      "bank_id": "40339601",
      "text": "Albion'da bundan daha kötü bir yer olamaz."
    },
    {
      "id": "400bc11b",
      "bank_id": "40339601",
      "text": "Tek kelimeyle tam bir çöplük."
    },
    {
      "id": "400bc11c",
      "bank_id": "40339601",
      "text": "Ne korkunç bir yer."
    },
    {
      "id": "400bc11e",
      "bank_id": "40339601",
      "text": "Ne kadar berbat bir yer burası."
    },
    {
      "id": "400bc11f",
      "bank_id": "40339601",
      "text": "Bir insan neden kendi isteğiyle burada olur ki?!"
    },
    {
      "id": "4607dd38",
      "bank_id": "40339601",
      "text": "Geleceğim yerin burası olduğunu bilseydim evde otururdum."
    },
    {
      "id": "4607dd39",
      "bank_id": "40339601",
      "text": "Burası tam bir çöplük. Hadi gidelim buradan."
    },
    {
      "id": "4607dd3b",
      "bank_id": "40339601",
      "text": "Hadi ama, buradan daha güzel yerler var!"
    },
    {
      "id": "4607dd3c",
      "bank_id": "40339601",
      "text": "Bu mekân duygularımı incitiyor."
    },
    {
      "id": "4607dd3d",
      "bank_id": "40339601",
      "text": "Buradan daha güzel yerler gördüm. Mesela kanalizasyonlar."
    },
    {
      "id": "4607dd3e",
      "bank_id": "40339601",
      "text": "Bu yere katlanamıyorum. Hadi hareket edelim."
    },
    {
      "id": "4607dd3f",
      "bank_id": "40339601",
      "text": "Burada kalmak zorunda mıyız? Tam bir delik burası."
    },
    {
      "id": "48492604",
      "bank_id": "40339601",
      "text": "*kötü kahkaha*"
    },
    {
      "id": "4b492add",
      "bank_id": "40339601",
      "text": "*kötü kahkaha*"
    },
    {
      "id": "52a1a1f5",
      "bank_id": "40339601",
      "text": "Geçen hafta işkence nöbetindeydim. Başta kötü hissediyorsun ama sonra... ne bileyim, alışıyorsun."
    },
    {
      "id": "52a1a1f6",
      "bank_id": "40339601",
      "text": "Emekli olunca onca mangırla ne yapmayı planlıyorsun?"
    },
    {
      "id": "5b67deb9",
      "bank_id": "40339601",
      "text": "İşkence masama şöyle bir uzanmak ister misin bakalım?"
    },
    {
      "id": "5b67deba",
      "bank_id": "40339601",
      "text": "Ya çeneni kapat ya da ben kapatmasını bilirim!"
    },
    {
      "id": "5d55ea49",
      "bank_id": "40339601",
      "text": "Bizi o karanlık dokunaçlarınla sar, ey Gölge!"
    },
    {
      "id": "6010b8fd",
      "bank_id": "40339601",
      "text": "Gözünü şu heriften ayırma! Çok sinsi biridir!"
    },
    {
      "id": "6010b8fe",
      "bank_id": "40339601",
      "text": "Şu eğitim seanslarından beri kolum hâlâ fena ağrıyor."
    },
    {
      "id": "64315b11",
      "bank_id": "40339601",
      "text": "Neden şuraya gitmiyoruz?"
    },
    {
      "id": "64315b12",
      "bank_id": "40339601",
      "text": "Sıradaki gidilecek yer olarak orası iyi görünüyor."
    },
    {
      "id": "64315b13",
      "bank_id": "40339601",
      "text": "Hey, bakalım orada neler oluyor."
    },
    {
      "id": "64315b14",
      "bank_id": "40339601",
      "text": "Şu tarafa doğru yönelmeliyiz."
