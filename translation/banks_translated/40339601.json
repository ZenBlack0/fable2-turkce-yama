    {
      "id": "6f316c46",
      "bank_id": "40339601",
      "text": "Neden şuraya doğru sallanmıyoruz?"
    },
    {
      "id": "6f316c47",
      "bank_id": "40339601",
      "text": "Bakar mısın, değişiklik olsun diye şu tarafa doğru gezinsek harika olmaz mıydı?"
    },
    {
      "id": "709c1591",
      "bank_id": "40339601",
      "text": "Şurası eğlenceli görünüyor."
