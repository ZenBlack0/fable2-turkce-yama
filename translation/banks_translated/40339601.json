    {
      "id": "64315b16",
      "bank_id": "40339601",
      "text": "Orası kesinlikle daha iyi bir yer olurdu değil mi?"
    },
    {
      "id": "64315b17",
      "bank_id": "40339601",
      "text": "Orada ne olduğunu görmeyi pek isterim."
    },
    {
      "id": "6b681e1e",
      "bank_id": "40339601",
      "text": "Bu korkunç yerden defolup gitmem gerek."
    },
    {
      "id": "6c689788",
      "bank_id": "40339601",
      "text": "Ah! Ayaklarım kopuyor resmen. Sıradaki çay molamız ne zaman?"
    },
    {
      "id": "6c68978b",
      "bank_id": "40339601",
      "text": "Bu sabah tuhaf bir şey oldu. Memleketimin adını unuttum. İnanabiliyor musun?"
    },
    {
      "id": "6f316c40",
      "bank_id": "40339601",
      "text": "Orası oldukça ilginç görünüyor."
    },
    {
      "id": "6f316c42",
      "bank_id": "40339601",
      "text": "Şuraya bir göz atmaya ne dersin?"
    },
    {
      "id": "6f316c43",
      "bank_id": "40339601",
      "text": "Bakalım orası biraz daha güzel miymiş."
    },
    {
      "id": "6f316c44",
      "bank_id": "40339601",
      "text": "Hadi gel, oranın nasıl bir yer olduğunu görelim."
