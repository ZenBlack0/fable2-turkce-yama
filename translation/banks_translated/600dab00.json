    {
      "id": "37338e38",
      "bank_id": "600dab00",
      "text": "Muhafızları üstüne salarım bak! Çık dışarı!"
    },
    {
      "id": "37338e39",
      "bank_id": "600dab00",
      "text": "Evime girmeye ne hakla cüret ediyorsun! Muhafızları çağıracağım!"
    },
    {
      "id": "37338e3a",
      "bank_id": "600dab00",
      "text": "HEMEN çekip gitsen iyi edersin!"
