    {
      "id": "08fc66c3",
      "bank_id": "c0b0b600",
      "text": "Oakfield heykeltıraşı kahraman modellere fena halde muhtaç."
    },
    {
      "id": "090beeed",
      "bank_id": "c0b0b600",
      "text": "Katil doğanız size Kasap unvanını kazandırdı. Bu unvan artık tüm Tellallardan ücretsiz."
    },
    {
      "id": "0afa2bb2",
      "bank_id": "c0b0b600",
      "text": "Gölgeler Tapınağı, Işık takipçilerinden temelli kurtulmaya karar verdi."
    },
    {
      "id": "0afea880",
      "bank_id": "c0b0b600",
      "text": "Eve dönmelisiniz. Korkunç bir şey oldu!"
    },
    {
      "id": "0b9073af",
      "bank_id": "c0b0b600",
      "text": "Barmen Kız"
    },
    {
      "id": "0bfa2d25",
      "bank_id": "c0b0b600",
      "text": "Gölge takipçilerinin Işık Tapınağı'nı ve tüm rahiplerini yok etmeye hazırlandığına dair söylentiler var."
    },
    {
      "id": "0cefa179",
      "bank_id": "c0b0b600",
      "text": "Bowerstone Mezarlığı Konağı satın alınabilir durumda. Yeni sahibine hangi sırları açacak acaba?"
    },
    {
      "id": "0cfeabe6",
      "bank_id": "c0b0b600",
      "text": "Görünüşe göre birisi sizin kellenize ödül koymuş."
    },
    {
      "id": "0d0ae578",
      "bank_id": "c0b0b600",
      "text": "Kuyumcu"
    },
    {
      "id": "0defa2ef",
      "bank_id": "c0b0b600",
      "text": "Albion'un en görkemli mülkü olan Fairfax Kalesi satın alınabilir durumda."
    },
    {
      "id": "0dfead59",
      "bank_id": "c0b0b600",
      "text": "Rookridge'de bir hayaletin görüldüğüne dair raporlar var. Belki birisi onun huzur... ya da intikam bulmasına yardım etmelidir."
    },
    {
      "id": "0ecf8beb",
      "bank_id": "c0b0b600",
      "text": "Dangalak olarak çağrılmayı hak edecek kadar çok insanı sinir ettiniz. Bu unvan artık tüm Tellallardan ücretsiz."
    },
    {
      "id": "0ede8374",
      "bank_id": "c0b0b600",
      "text": "Oyun Ustası"
    },
    {
      "id": "0efeaec9",
      "bank_id": "c0b0b600",
      "text": "Gölgeler Tapınağı'ndaki Talihsizlik Çarkı yeni kurbanlar için susadı."
    },
    {
      "id": "0f9134e0",
      "bank_id": "c0b0b600",
      "text": "Ölüler Salonu"
    },
    {
      "id": "0fae414b",
      "bank_id": "c0b0b600",
      "text": "Çekicilik:"
    },
    {
      "id": "0fd72a5e",
      "bank_id": "c0b0b600",
      "text": "Mobilya Satıcısı"
    },
    {
      "id": "0ffeb0ba",
      "bank_id": "c0b0b600",
      "text": "Oakfield'deki iyi işlerini sürdürebilmek için Işık Tapınağı'nın bağışlara ihtiyacı var. Kim bilir, belki bizzat Işığın kendisi hayırseverliğinizi ödüllendirir."
    },
    {
      "id": "1000ef16",
      "bank_id": "c0b0b600",
      "text": "Çile kalabalığı geri dönmeniz için tezahürat yapıyor. Hayranlarınızı gerçekten hayal kırıklığına uğratabilir misiniz?"
    },
    {
      "id": "10282cc2",
      "bank_id": "c0b0b600",
      "text": "Eşinizin sizin için bir hediyesi var."
