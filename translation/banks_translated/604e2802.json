{
  "bank_id": "604e2802",
  "total_strings": 238,
  "strings": [
    {
      "id": "0e7b2410",
      "bank_id": "604e2802",
      "text": "Yine karşılaştık."
    },
    {
      "id": "0e7b2411",
      "bank_id": "604e2802",
      "text": "Yine merhaba demeye mi geldin?"
    },
    {
      "id": "0e7b2415",
      "bank_id": "604e2802",
      "text": "Son karşılaşmamızdan bu yana epey oldu."
    },
    {
      "id": "0e7b2416",
      "bank_id": "604e2802",
      "text": "Seni epeydir görmemiştim."
    },
    {
      "id": "157b2f11",
      "bank_id": "604e2802",
      "text": "Demek geri döndün."
    },
    {
      "id": "157b2f12",
      "bank_id": "604e2802",
      "text": "Uzak kalamıyorsun, değil mi?"
    },
    {
      "id": "157b2f15",
      "bank_id": "604e2802",
      "text": "Aa merhaba, döndüğünü görüyorum."
    },
    {
      "id": "157b2f16",
      "bank_id": "604e2802",
      "text": "Yine mi sen? Merhaba."
    },
    {
      "id": "16401313",
      "bank_id": "604e2802",
      "text": "Bana zarar vermeyeceksin, değil mi?"
    },
    {
      "id": "1c7442a0",
      "bank_id": "604e2802",
      "text": "Ah, şey. Gitmem gerek!"
    },
    {
      "id": "1c7442a1",
      "bank_id": "604e2802",
      "text": "Ah.. hayır!"
    },
    {
      "id": "1c7442a3",
      "bank_id": "604e2802",
      "text": "İiiii! Kaçın!"
    },
    {
      "id": "1c7442a4",
      "bank_id": "604e2802",
      "text": "Aman tanrım!"
    },
    {
      "id": "1c7442a5",
      "bank_id": "604e2802",
      "text": "Aman yarabbi!"
    },
    {
      "id": "1c7442a6",
      "bank_id": "604e2802",
      "text": "Oooff... hayııır!"
    },
    {
      "id": "1c7442a7",
      "bank_id": "604e2802",
      "text": "Hayır! Hayır! Hayııır!"
    },
    {
      "id": "1d401e16",
      "bank_id": "604e2802",
      "text": "Bana zarar verme, ben sadece küçük bir kızım."
    },
    {
      "id": "22ddef43",
      "bank_id": "604e2802",
      "text": "<yelps>"
    },
    {
      "id": "23744da0",
      "bank_id": "604e2802",
      "text": "Korkunç!"
    },
    {
      "id": "23744da1",
      "bank_id": "604e2802",
      "text": "Aman tanrım! Kalbim yerinden fırlayacak!"
    },
    {
      "id": "23744da2",
      "bank_id": "604e2802",
      "text": "<whimpers>"
    },
    {
      "id": "23744da3",
      "bank_id": "604e2802",
      "text": "*nefesi kesilir* Aaaaa!"
    },
    {
      "id": "23744da4",
      "bank_id": "604e2802",
      "text": "Gaaah!"
    },
    {
      "id": "23744da5",
      "bank_id": "604e2802",
      "text": "Şey, ah, seninle konuşmak güzeldi!"
    },
    {
      "id": "23744da6",
      "bank_id": "604e2802",
      "text": "Hayıııır!"
    },
    {
      "id": "29ddfa46",
      "bank_id": "604e2802",
      "text": "<yelps>"
    },
    {
      "id": "472a36f8",
      "bank_id": "604e2802",
      "text": "Ziyaretinizle bir kez daha onur duydum."
    },
    {
      "id": "472a36f9",
      "bank_id": "604e2802",
      "text": "Varlığınızla beni bir kez daha onurlandırdınız."
    },
    {
      "id": "472a36fa",
      "bank_id": "604e2802",
      "text": "Yeniden merhaba. Gittikçe daha da ünlü oluyorsun ha?"
    },
    {
      "id": "472a36fb",
      "bank_id": "604e2802",
      "text": "Ahh, ünlü birinden bir ziyaret!"
    },
    {
      "id": "472a36fc",
      "bank_id": "604e2802",
      "text": "Artık o kadar ünlüsün ki beni tamamen unutursun sanmıştım."
    },
    {
      "id": "472a36fd",
      "bank_id": "604e2802",
      "text": "Benimle her konuştuğunda kendimi çok özel hissediyorum. O kadar ünlüsün ki!"
    },
    {
      "id": "472a36fe",
      "bank_id": "604e2802",
      "text": "Vay canına, bu kadar ünlü birinin benimle konuşup durmak istemesine inanamıyorum."
    },
    {
      "id": "4e38c8d8",
      "bank_id": "604e2802",
      "text": "Şey, hava da ne, ımm, güzel değil mi? Evet?"
    },
    {
      "id": "4e38c8da",
      "bank_id": "604e2802",
      "text": "Ah, bağışlayın beni güçlü kişi."
    },
    {
      "id": "4e38c8db",
      "bank_id": "604e2802",
      "text": "Şey, ben, ee, hiçbir şey."
    },
    {
      "id": "4e38c8dc",
      "bank_id": "604e2802",
      "text": "Anlıyorum, anlıyorum!"
    },
    {
      "id": "4e38c8dd",
      "bank_id": "604e2802",
      "text": "Ah, çok güzel, evet, çok güzel."
    },
    {
      "id": "4e38c8de",
      "bank_id": "604e2802",
      "text": "Lütfen bana zarar vermeyin. Ben narin biriyim!"
    },
    {
      "id": "4e38c8df",
      "bank_id": "604e2802",
      "text": "Şey, içtenlikle umarım ki... Ah, sanırım uşaklarım çağırıyor..."
    },
    {
      "id": "502a44c8",
      "bank_id": "604e2802",
      "text": "Buradasın işte! Arkadaşlarımın hiçbiri ünlü birini tanıdığıma inanmıyor!"
    },
    {
      "id": "502a44c9",
      "bank_id": "604e2802",
      "text": "Bu kadar ünlü olmana rağmen hâlâ beni ziyaret ediyorsun."
    },
    {
      "id": "502a44cb",
      "bank_id": "604e2802",
      "text": "Beni hatırlamana o kadar sevindim ki."
    },
    {
      "id": "502a44cc",
      "bank_id": "604e2802",
      "text": "Ahh, seni her gördüğümde daha da büyük bir üne sahip görünüyorsun."
    },
    {
      "id": "502a44cd",
      "bank_id": "604e2802",
      "text": "Ünlülerle konuşurken görülmek insana hiç zarar vermez. Beni çok popüler yaptın söyleyeyim."
    },
    {
      "id": "502a44ce",
      "bank_id": "604e2802",
      "text": "Yeniden merhaba, büyük Kahraman."
    },
    {
      "id": "502a44cf",
      "bank_id": "604e2802",
      "text": "Döndün ha? Hâlâ sıradan insanlarla konuşmaya vakit ayırıyorsun."
    },
    {
      "id": "5338d0f9",
      "bank_id": "604e2802",
      "text": "Umarım tüm maceracılığın harika gidiyordur, ey yüce kişi."
    },
    {
      "id": "5338d0fa",
      "bank_id": "604e2802",
      "text": "Iıı... Şeyinizin büyük bir hayranıyım, ımm, ah bakın mimari ne hoş değil mi."
    },
    {
      "id": "5338d0fb",
      "bank_id": "604e2802",
      "text": "Dinle, ben bela falan istemiyorum."
    },
    {
      "id": "5338d0fc",
      "bank_id": "604e2802",
      "text": "Bela istemiyorum ben!"
    },
    {
      "id": "5338d0fd",
      "bank_id": "604e2802",
      "text": "Ben sadece şuradan geçiyordum!"
    },
    {
      "id": "5338d0fe",
      "bank_id": "604e2802",
      "text": "Evet, hmm, belaya hiç gerek yok, ha ha. Aynen öyle."
    },
    {
      "id": "5338d0ff",
      "bank_id": "604e2802",
      "text": "Ben sadece kendi yoluma gideceğim. *öksürür*"
    },
    {
      "id": "538a0738",
      "bank_id": "604e2802",
      "text": "Ey kötücül ululuk sahibi!"
    },
    {
      "id": "538a0739",
      "bank_id": "604e2802",
      "text": "Bana zarar verme ulu kişi!"
    },
    {
      "id": "538a073a",
      "bank_id": "604e2802",
      "text": "Sen gelmiş geçmiş en büyük, en kötü zorbasın!"
    },
    {
      "id": "538a073b",
      "bank_id": "604e2802",
      "text": "Tüm dünya önünde eğiliyor, karanlık maceracı!"
    },
    {
      "id": "538a073d",
      "bank_id": "604e2802",
      "text": "Beni öldürme, ey ulu kalpsiz kişi."
    },
    {
      "id": "538a073e",
      "bank_id": "604e2802",
      "text": "Ah! Yüceliğiniz. Her şey... her şey yolunda mı?"
    },
    {
      "id": "538a073f",
      "bank_id": "604e2802",
      "text": "Ey haşmetli karanlık!"
    },
    {
      "id": "5c24a7c1",
      "bank_id": "604e2802",
      "text": "Beni yine güldürecek misin?"
    },
    {
      "id": "5e8a1868",
      "bank_id": "604e2802",
      "text": "Lütfen, ölmek istemiyorum yüceliğiniz."
    },
    {
      "id": "5e8a1869",
      "bank_id": "604e2802",
      "text": "Beni öldürme, ey ulu kişi."
    },
    {
      "id": "5e8a186a",
      "bank_id": "604e2802",
      "text": "Emrettiğin gibi yapacağım ulu kişi."
    },
    {
      "id": "5e8a186b",
      "bank_id": "604e2802",
      "text": "Emrindeyim ey kötü kişi."
    },
    {
      "id": "5e8a186c",
      "bank_id": "604e2802",
      "text": "Ah, şey... Karanlık haşmetiniz."
    },
    {
      "id": "5e8a186e",
      "bank_id": "604e2802",
      "text": "Ey ulu, kötü kişi."
    },
    {
      "id": "5e8a186f",
      "bank_id": "604e2802",
      "text": "Sen... Sen tüm diyardaki en... en iyisisin."
    },
    {
      "id": "62e2d151",
      "bank_id": "604e2802",
      "text": "Ah!"
    },
    {
      "id": "62e2d152",
      "bank_id": "604e2802",
      "text": "Yeter ki beni öldürme! Yani, merhaba, nasılsın?"
    },
    {
      "id": "62e2d153",
      "bank_id": "604e2802",
      "text": "Ne? Ah!"
    },
    {
      "id": "62e2d154",
      "bank_id": "604e2802",
      "text": "İiiiiii!"
    },
    {
      "id": "62e2d155",
      "bank_id": "604e2802",
      "text": "<yelps>"
    },
    {
      "id": "6724b970",
      "bank_id": "604e2802",
      "text": "Yaptığın şu şakalardan birini yapsana. Lütfeeeen?"
    },
    {
      "id": "6de2e280",
      "bank_id": "604e2802",
      "text": "İiiik!"
    },
    {
      "id": "6de2e282",
      "bank_id": "604e2802",
      "text": "*nefesi kesilir* Yine mi."
    },
    {
      "id": "6de2e283",
      "bank_id": "604e2802",
      "text": "Bana-bana zarar vermeyeceksin, değil mi?"
    },
    {
      "id": "6de2e284",
      "bank_id": "604e2802",
      "text": "Vooov... hayır!"
    },
    {
      "id": "6de2e285",
      "bank_id": "604e2802",
      "text": "Koş!"
    },
    {
      "id": "7142aaf4",
      "bank_id": "604e2802",
      "text": "Hey, merhaba! Ben de tam dostumun ne yaptığını merak ediyordum ve buradasın işte!"
    },
    {
      "id": "7642b295",
      "bank_id": "604e2802",
      "text": "Selam! Nasıl gidiyor?"
    },
    {
      "id": "77348c77",
      "bank_id": "604e2802",
      "text": "Lütfen bana zarar verme."
    },
    {
      "id": "7dad9650",
      "bank_id": "604e2802",
      "text": "Ha, kendi özel soytarımız varmış gibi."
    },
    {
      "id": "7dad9651",
      "bank_id": "604e2802",
      "text": "Beni nasıl güldüreceğini gerçekten iyi biliyorsun, hi hi."
    },
    {
      "id": "7dad9652",
      "bank_id": "604e2802",
      "text": "Ahh, Kahraman giysileri içinde bir maskara."
    },
    {
      "id": "7dad9653",
      "bank_id": "604e2802",
      "text": "Ah, ne kadar da harika bir biçimde saçma."
    },
    {
      "id": "7dad9654",
      "bank_id": "604e2802",
      "text": "Bugün bizim için iyi şakaların var mı?"
    },
    {
      "id": "7dad9656",
      "bank_id": "604e2802",
      "text": "Tam bir palyaçosun doğrusu."
    },
    {
      "id": "7dad9657",
      "bank_id": "604e2802",
      "text": "Umarım komedyen olmaya çalışıyorsundur."
    },
    {
      "id": "7e34977a",
      "bank_id": "604e2802",
      "text": "Bana zarar verme!"
    },
    {
      "id": "82ad9e70",
      "bank_id": "604e2802",
      "text": "Ha ha! Hadi ama! Güldür bizi yine!"
    },
    {
      "id": "82ad9e71",
      "bank_id": "604e2802",
      "text": "Çok komiksin ya!"
    },
    {
      "id": "82ad9e72",
      "bank_id": "604e2802",
      "text": "Komedi zamanlaman efsanevi!"
    },
    {
      "id": "82ad9e73",
      "bank_id": "604e2802",
      "text": "Diyara neşe saçmaktan keyif aldığını söylediler."
    },
    {
      "id": "82ad9e75",
      "bank_id": "604e2802",
      "text": "Keşke herkes senin mizah anlayışına sahip olsaydı, dünya daha güzel bir yer olurdu."
    },
    {
      "id": "82ad9e76",
      "bank_id": "604e2802",
      "text": "Gerçekten oldukça şebeksin."
    },
    {
      "id": "82ad9e77",
      "bank_id": "604e2802",
      "text": "Ha ha! Hadi ama! Komik bir şey yap!"
    },
    {
      "id": "8b2f1f38",
      "bank_id": "604e2802",
      "text": "Vay canına! Bir süper kahramanla arkadaş olduğuma hâlâ inanamıyorum!"
    },
    {
      "id": "902f26d9",
      "bank_id": "604e2802",
      "text": "Selam! Seni tanıdığımı söylediğimde okuldaki kimse inanmıyor. Ama umurumda değil."
    },
    {
      "id": "9606169d",
      "bank_id": "604e2802",
      "text": "Aman!"
    },
    {
      "id": "96b79698",
      "bank_id": "604e2802",
      "text": "Nasıl gidiyor ahbap?"
    },
    {
      "id": "96b7969b",
      "bank_id": "604e2802",
      "text": "Seni yeniden görmek her zamanki gibi harika."
    },
    {
      "id": "96b7969e",
      "bank_id": "604e2802",
      "text": "Ahh, benim can dostum..."
    },
    {
      "id": "96b7969f",
      "bank_id": "604e2802",
      "text": "Selamlar eski dostum."
    },
    {
      "id": "971ef490",
      "bank_id": "604e2802",
      "text": "Her zaman hazır bir şakan var, değil mi?"
    },
    {
      "id": "971ef491",
      "bank_id": "604e2802",
      "text": "Hepimizi güldürmeye devam et. Buna ihtiyacımız var!"
    },
    {
      "id": "971ef492",
      "bank_id": "604e2802",
      "text": "Hi hi, maskaralıklarınla günüme neşe katıyorsun vallahi."
    },
    {
      "id": "971ef494",
      "bank_id": "604e2802",
      "text": "Komedi tamamen zamanlamadır ve sen kahkahanın saat mekânizmasısın."
    },
    {
      "id": "971ef495",
      "bank_id": "604e2802",
      "text": "Kimse neşeye senin kadar hükmedemez."
    },
    {
      "id": "971ef496",
      "bank_id": "604e2802",
      "text": "Sen kahkahanın kahramanısın doğrusu."
    },
    {
      "id": "971ef497",
      "bank_id": "604e2802",
      "text": "Sen komik olmak için doğmuşsun."
    },
    {
      "id": "9b2e8fd0",
      "bank_id": "604e2802",
      "text": "Ben de tam başka bir yere gidiyordum. Evet, çok çok uzaklara."
    },
    {
      "id": "9b2e8fd1",
      "bank_id": "604e2802",
      "text": "Ben sadece önünden çekileyim, olur mu?"
    },
    {
      "id": "9b2e8fd3",
      "bank_id": "604e2802",
      "text": "Vay canına, şu ağaçlar ne kadar da güzel ve yapraklı değil mi."
    },
    {
      "id": "9b2e8fd4",
      "bank_id": "604e2802",
      "text": "Ben de tam eve gidiyordum!"
    },
    {
      "id": "9b2e8fd5",
      "bank_id": "604e2802",
      "text": "Sizi oyalamayayım!"
    },
    {
      "id": "9b2e8fd6",
      "bank_id": "604e2802",
      "text": "Bela aramıyorum ey ulu kişi."
    },
    {
      "id": "9b2e8fd7",
      "bank_id": "604e2802",
      "text": "Aaa, saat kaç olmuş öyle?!"
    },
    {
      "id": "a01f02f8",
      "bank_id": "604e2802",
      "text": "Bizim için yeni numaraların var mı ey ulu soytarı?"
    },
    {
      "id": "a01f02f9",
      "bank_id": "604e2802",
      "text": "Ha ha! O eğlenceli numaralarından birini en son yaptığından beri hâlâ gülüyorum."
    },
    {
      "id": "a01f02fa",
      "bank_id": "604e2802",
      "text": "Stand-up yapıyor musun? Kırıp geçirirdin ortalığı."
    },
    {
      "id": "a01f02fb",
      "bank_id": "604e2802",
      "text": "Kimse beni senin gibi güldüremez."
    },
    {
      "id": "a01f02fc",
      "bank_id": "604e2802",
      "text": "Tam bir komiksin doğrusu!"
    },
    {
      "id": "a01f02fd",
      "bank_id": "604e2802",
      "text": "Bahse girerim komiklik yaparak geçimini sağlayabilirdin."
    },
    {
      "id": "a01f02ff",
      "bank_id": "604e2802",
      "text": "Senden daha komik biri olduğunu sanmıyorum."
    },
    {
      "id": "a10627cc",
      "bank_id": "604e2802",
      "text": "Aman!"
    },
    {
      "id": "a1b7a7c8",
      "bank_id": "604e2802",
      "text": "Nasıl gidiyor ahbap?"
    },
    {
      "id": "a1b7a7cb",
      "bank_id": "604e2802",
      "text": "Seni yeniden görmek her zamanki gibi harika."
    },
    {
      "id": "a1b7a7cc",
      "bank_id": "604e2802",
      "text": "Ahh, benim iyi ahbabım..."
    },
    {
      "id": "a1b7a7cf",
      "bank_id": "604e2802",
      "text": "Selamlar eski dostum."
    },
    {
      "id": "a22e9ad0",
      "bank_id": "604e2802",
      "text": "Dünya haberleri... Ne kadar da ilginç değil mi?"
    },
    {
      "id": "a22e9ad1",
      "bank_id": "604e2802",
      "text": "Yok, burada hiç bela yok, ha ha."
    },
    {
      "id": "a22e9ad2",
      "bank_id": "604e2802",
      "text": "Sizin için yapabileceğim bir şey var mı ey ulu kişi?"
    },
    {
      "id": "a22e9ad3",
      "bank_id": "604e2802",
      "text": "Ben gerçekten artık gitsem iyi olur. Hemen şimdi yani."
    },
    {
      "id": "a22e9ad4",
      "bank_id": "604e2802",
      "text": "Şey, karım mı çağırıyor ne. Evet, gitmem gerek!"
    },
    {
      "id": "a22e9ad5",
      "bank_id": "604e2802",
      "text": "Bizim gibilerle hiç zahmete girmek istemezsiniz. Değersiziz biz. Değersizden de öte."
    },
    {
      "id": "a22e9ad6",
      "bank_id": "604e2802",
      "text": "Size tuhaf tuhaf bakmıyordum. Valla bak! Gözlerim şaşı sadece!"
    },
    {
      "id": "a63cee30",
      "bank_id": "604e2802",
      "text": "Seni yeniden gördüğüme çok sevindim, can dostum."
    },
    {
      "id": "a63cee31",
      "bank_id": "604e2802",
      "text": "Ahh, selamlar. Küçük sohbetlerimizi özlemiştim."
    },
    {
      "id": "a63cee32",
      "bank_id": "604e2802",
      "text": "Seni görmek her zaman güzel. Neler yapıyorsun bakalım?"
    },
    {
      "id": "a63cee33",
      "bank_id": "604e2802",
      "text": "Ahh, eski dostum. Nasıl gidiyor?"
    },
    {
      "id": "a63cee34",
      "bank_id": "604e2802",
      "text": "Yeniden merhaba! Son zamanlarda neler yapıyorsun?"
    },
    {
      "id": "a63cee35",
      "bank_id": "604e2802",
      "text": "Buradasın işte! Ben de tam seni düşünüyordum."
    },
    {
      "id": "a63cee37",
      "bank_id": "604e2802",
      "text": "Ahh, benim iyi dostum. Nasıl gidiyor her şey?"
    },
    {
      "id": "a66e93fd",
      "bank_id": "604e2802",
      "text": "Çok komiksin."
    },
    {
      "id": "a6a959f3",
      "bank_id": "604e2802",
      "text": "En komiğin sen olduğunu herkes bilir."
    },
    {
      "id": "ad3cf938",
      "bank_id": "604e2802",
      "text": "Yine ne zaman uğrayacaksın diye merak ediyordum. Nasılsın?"
    },
    {
      "id": "ad3cf939",
      "bank_id": "604e2802",
      "text": "Seni yeniden görmek ne güzel! Her şey yolundadır umarım?"
