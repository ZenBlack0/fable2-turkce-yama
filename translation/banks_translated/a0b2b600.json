{
  "bank_id": "a0b2b600",
  "total_strings": 200,
  "strings": [
    {
      "id": "04a84893",
      "bank_id": "a0b2b600",
      "text": "Ve üç altın sikke oldu bile. Sadece iki tane daha ve müzik kutusunu alabiliriz."
    },
    {
      "id": "06a3ded3",
      "bank_id": "a0b2b600",
      "text": "Nerede o!?"
    },
    {
      "id": "0891335b",
      "bank_id": "a0b2b600",
      "text": "Ben parayı alana kadar orada bekleyin."
    },
    {
      "id": "099134ce",
      "bank_id": "a0b2b600",
      "text": "Ve sakın hiçbir şeye dokunmayın!"
    },
    {
      "id": "0a9136a1",
      "bank_id": "a0b2b600",
      "text": "Şey... Monty mektubu anneye vermememizi söyledi ama burada beklersek kadın bize para verecek."
    },
    {
      "id": "0b913814",
      "bank_id": "a0b2b600",
      "text": "Ama yukarı çıkıp Belinda'ya verirsek belki birlikte kaçabilirler."
    },
    {
      "id": "0ba3e6f2",
      "bank_id": "a0b2b600",
      "text": "Cesedimi çiğnemeniz gerekir!"
    },
    {
      "id": "0ca3e865",
      "bank_id": "a0b2b600",
      "text": "Kızımla evlenmek mi?"
    },
    {
      "id": "11764510",
      "bank_id": "a0b2b600",
      "text": "Olmaz öyle şey, o züğürdün teki!"
    },
    {
      "id": "12764683",
      "bank_id": "a0b2b600",
      "text": "Oh anne, tam bir huysuz cadısın. Babamın seni terk etmesi ve başka koca bulamaman bu yüzden işte."
    },
    {
      "id": "147649e9",
      "bank_id": "a0b2b600",
      "text": "Oh Monty! Seviyorum seni."
    },
    {
      "id": "15764b5c",
      "bank_id": "a0b2b600",
      "text": "Ne? Hayır!"
    },
    {
      "id": "16764ccf",
      "bank_id": "a0b2b600",
      "text": "Belki de onun yerine sen evlenmelisin!"
    },
    {
      "id": "17764ea2",
      "bank_id": "a0b2b600",
      "text": "Belinda, annenle böyle konuşmamalısın."
    },
    {
      "id": "18765015",
      "bank_id": "a0b2b600",
      "text": "Oh, şimdi de onun tarafını mı tutuyorsun?!"
    },
    {
      "id": "1b7654ee",
      "bank_id": "a0b2b600",
      "text": "Ama sen benim tek gerçek aşkımsın. Sensiz gece göğümde ne yıldızlar var ne ay, yalnızca yokluğunun o soğuk, ezici karanlığı. Şey, benim küçük kumrum."
    },
    {
      "id": "1c7b6bc3",
      "bank_id": "a0b2b600",
      "text": "Aşk Mektubu"
    },
    {
      "id": "1c8c0d92",
      "bank_id": "a0b2b600",
      "text": "Hey! Bu acıttı!"
    },
    {
      "id": "1d8c0f05",
      "bank_id": "a0b2b600",
      "text": "Ah! Şimdi öldün sen!"
    },
    {
      "id": "1e8c10f8",
      "bank_id": "a0b2b600",
      "text": "Ah! Bunun hesabını soracağım senden!"
    },
    {
      "id": "1f62ffac",
      "bank_id": "a0b2b600",
      "text": "Mektubu Monty'nin sevgilisine ulaştırın."
    },
    {
      "id": "1f8c126b",
      "bank_id": "a0b2b600",
      "text": "Ah! Kes şunu!"
    },
    {
      "id": "208c13de",
      "bank_id": "a0b2b600",
      "text": "Ah!"
    },
    {
      "id": "20bae146",
      "bank_id": "a0b2b600",
      "text": "İçeri gelin."
    },
    {
      "id": "218c15b1",
      "bank_id": "a0b2b600",
      "text": "Ah! Kes şunu!"
    },
    {
      "id": "228c1724",
      "bank_id": "a0b2b600",
      "text": "Aagh!"
    },
    {
      "id": "22bae4ac",
      "bank_id": "a0b2b600",
      "text": "Şey. Şey... Bir... bir mektubumuz var... Posta ücreti için bir altına ihtiyacımız var."
    },
    {
      "id": "238c1897",
      "bank_id": "a0b2b600",
      "text": "Ah!"
    },
    {
      "id": "23bae61f",
      "bank_id": "a0b2b600",
      "text": "Oh, madem öyle, neden baştan söylemediniz ki."
    },
    {
      "id": "258c1bfd",
      "bank_id": "a0b2b600",
      "text": "Öff!"
    },
    {
      "id": "25bae965",
      "bank_id": "a0b2b600",
      "text": "Ne istiyorsun?"
    },
    {
      "id": "25c248e7",
      "bank_id": "a0b2b600",
      "text": "Belinda..."
    },
    {
      "id": "26695338",
      "bank_id": "a0b2b600",
      "text": "Şu lanet sokak sıçanları! Hep sorun çıkarıyorlar!"
    },
    {
      "id": "26c24a5a",
      "bank_id": "a0b2b600",
      "text": "Oh Monty."
    },
    {
      "id": "26f5ac80",
      "bank_id": "a0b2b600",
      "text": "Pis burnunu sokağımıza sokmak neymiş gör bakalım!"
    },
    {
      "id": "276954ab",
      "bank_id": "a0b2b600",
      "text": "Çabuk aşağı inin buraya!"
    },
    {
      "id": "27f5ae73",
      "bank_id": "a0b2b600",
      "text": "Hahaha! Evet, göster gününü Rex! Hahaha!"
    },
    {
      "id": "2869561e",
      "bank_id": "a0b2b600",
      "text": "Hey! Nereye gittiğinizi sanıyorsunuz siz?"
    },
    {
      "id": "29f5b159",
      "bank_id": "a0b2b600",
      "text": "Rex, işin bitince biraz da bana bırak!"
    },
    {
      "id": "2af5b2cc",
      "bank_id": "a0b2b600",
      "text": "Hadi, bir tane daha patlat!"
    },
    {
      "id": "2bf5b4bf",
      "bank_id": "a0b2b600",
      "text": "Bizim sokağa geldiğine pişman olmuştur kesin!"
    },
    {
      "id": "2cf5b612",
      "bank_id": "a0b2b600",
      "text": "Aptal köpek! İşin bitince ben de bir tane vurabilir miyim Rex?"
    },
    {
      "id": "2df5b785",
      "bank_id": "a0b2b600",
      "text": "Bakın! Kuyruğunu bacaklarının arasına kıstırmış!"
    },
    {
      "id": "300c0e78",
      "bank_id": "a0b2b600",
      "text": "Hiçbir şeye dokunmamış olsanız iyi edersiniz!"
    },
    {
      "id": "307fcebb",
      "bank_id": "a0b2b600",
      "text": "Kızıma evlenme teklif etmeye nasıl cüret edersin!"
    },
    {
      "id": "30f5bc5e",
      "bank_id": "a0b2b600",
      "text": "Şimdi kuyruk sallayamıyorsun değil mi köpecik?"
    },
    {
      "id": "317fd02e",
      "bank_id": "a0b2b600",
      "text": "Muhafızlar! Bir sapığı ihbar etmek istiyorum!"
    },
    {
      "id": "31f5be31",
      "bank_id": "a0b2b600",
      "text": "Pireli kırma! İyice bir benzet şunu!"
    },
    {
      "id": "327fd181",
      "bank_id": "a0b2b600",
      "text": "Şey, düşündüğün gibi değil! Ben, şey... Mektubu senin için yazdım."
    },
    {
      "id": "337fd374",
      "bank_id": "a0b2b600",
      "text": "Ne?"
    },
    {
      "id": "347fd4e7",
      "bank_id": "a0b2b600",
      "text": "Evet! Duygularımı -- artık gizleyemedim."
    },
    {
      "id": "34c719c0",
      "bank_id": "a0b2b600",
      "text": "Mektup Belinda'ya verilsin mi?"
    },
    {
      "id": "37c71e99",
      "bank_id": "a0b2b600",
      "text": "Mektup Belinda'nın annesine verilsin mi?"
    },
    {
      "id": "3cb09adc",
      "bank_id": "a0b2b600",
      "text": "Bu harika!"
    },
    {
      "id": "3d4a2261",
      "bank_id": "a0b2b600",
      "text": "Ve ilk altın sikkeyi kaptık!"
    },
    {
      "id": "3eb09e22",
      "bank_id": "a0b2b600",
      "text": "Oh Monty... Benim küçük kumrum!"
    },
    {
      "id": "3fb09f95",
      "bank_id": "a0b2b600",
      "text": "Zahmetiniz için şurada biraz bir şey var."
    },
    {
      "id": "41315b7c",
      "bank_id": "a0b2b600",
      "text": "<sighs>"
    },
    {
      "id": "43315e42",
      "bank_id": "a0b2b600",
      "text": "Monty, Monty, Monty."
    },
    {
      "id": "44316035",
      "bank_id": "a0b2b600",
      "text": "Oh Monty."
    },
    {
      "id": "4a248166",
      "bank_id": "a0b2b600",
      "text": "Oldu üç altın. İki tane daha bulursak müzik kutusunu alabiliriz!"
    },
    {
      "id": "4c67c164",
      "bank_id": "a0b2b600",
      "text": "Ne yapacağım ben?"
    },
    {
      "id": "4d67c2d7",
      "bank_id": "a0b2b600",
      "text": "İçerideler, kıpırdaşıp duruyorlar... ve sinsi planlar yapıyorlar..."
    },
    {
      "id": "4e67c44a",
      "bank_id": "a0b2b600",
      "text": "İğrenç böcekler, nefret ediyorum onlardan."
    },
    {
      "id": "4fe29469",
      "bank_id": "a0b2b600",
      "text": "Yukarı çıkıp böcekleri öldürün ya da aşağı kattaki malları parçalayın."
    },
    {
      "id": "50d8b890",
      "bank_id": "a0b2b600",
      "text": "Oh Monty. Seninle normal ses tonunda, özgürce konuşabilmek için her şeyi verirdim."
    },
    {
      "id": "51d8ba03",
      "bank_id": "a0b2b600",
      "text": "Oh, benim küçük kumrum, içinde senin olduğun her ortama kurban olurum."
    },
    {
      "id": "52d8bbf6",
      "bank_id": "a0b2b600",
      "text": "Özür dilerim aşkım, bundan daha sessiz olmalısın. Bir orta yol bulamaz mısın?"
    },
    {
      "id": "5393887b",
      "bank_id": "a0b2b600",
      "text": "Yumruk at!"
    },
    {
      "id": "53d4a424",
      "bank_id": "a0b2b600",
      "text": "O mektubu doğruca Belinda'ya götür -- sakın annesinin eline geçmesin."
    },
    {
      "id": "53d8bd69",
      "bank_id": "a0b2b600",
      "text": "Hayır, tellaldı sadece anneciğim."
    },
    {
      "id": "549389ee",
      "bank_id": "a0b2b600",
      "text": "Evet!"
    },
    {
      "id": "54d8bedc",
      "bank_id": "a0b2b600",
      "text": "Bir şey mi dedin Belinda?"
    },
    {
      "id": "55938b41",
      "bank_id": "a0b2b600",
      "text": "Tekme atmayı unutma!"
    },
    {
      "id": "55d8c04f",
      "bank_id": "a0b2b600",
      "text": "ANNEN LANET BİR İNEK DEDİM!"
    },
    {
      "id": "56be8208",
      "bank_id": "a0b2b600",
      "text": "Gidiyorum anne, sevdiğim adamla evleneceğim."
    },
    {
      "id": "56d4a8fd",
      "bank_id": "a0b2b600",
      "text": "Biraz abartılı olmuş, değil mi?"
    },
    {
      "id": "56d8c222",
      "bank_id": "a0b2b600",
      "text": "Ne? Duyamadım seni."
    },
    {
      "id": "573b64f2",
      "bank_id": "a0b2b600",
      "text": "Dök şu dişlerini! Dök şu dişlerini!"
    },
    {
      "id": "57be83fb",
      "bank_id": "a0b2b600",
      "text": "Ne?!"
    },
    {
      "id": "57d8c395",
      "bank_id": "a0b2b600",
      "text": "Annen lanet bir inek."
    },
    {
      "id": "583b6665",
      "bank_id": "a0b2b600",
      "text": "Kavga! Kavga!"
    },
    {
      "id": "593b67d8",
      "bank_id": "a0b2b600",
      "text": "Hadi!"
    },
    {
      "id": "5960326b",
      "bank_id": "a0b2b600",
      "text": "Ne yaparsan yap mektubu SAKIN Belinda'nın annesine verme."
    },
    {
      "id": "59be86c1",
      "bank_id": "a0b2b600",
      "text": "Belinda, ne yapıyorsun sen? Çabuk eve dön."
    },
    {
      "id": "5a3b694b",
      "bank_id": "a0b2b600",
      "text": "Vurmaya devam et!"
    },
    {
      "id": "5a5cb510",
      "bank_id": "a0b2b600",
      "text": "Yardımın için sağ ol. Gerçi hakkından gelebilirdim ama."
    },
    {
      "id": "5a6033de",
      "bank_id": "a0b2b600",
      "text": "Belinda'yı annesinin evinde bulabilirsin."
    },
    {
      "id": "5aa3682e",
      "bank_id": "a0b2b600",
      "text": "Ama Belinda güvenilirdir. Mektubumu alınca size kesin para verecektir."
    },
    {
      "id": "5b3b6b3e",
      "bank_id": "a0b2b600",
      "text": "Burnu kanıyor! Burnu kanıyor! Burnu kanıyor!"
    },
    {
      "id": "5b6035b1",
      "bank_id": "a0b2b600",
      "text": "Annesine dikkat et, biraz korkutucudur."
    },
    {
      "id": "5bdb08b8",
      "bank_id": "a0b2b600",
      "text": "Oh, şey, bana dilediğin her şeyi AÇABİLİRSİN. Aklına gelen her şeyi."
    },
    {
      "id": "5c3b6c91",
      "bank_id": "a0b2b600",
      "text": "Oh, bu fena acıtmış olmalı!"
    },
    {
      "id": "5cdb0a2b",
      "bank_id": "a0b2b600",
      "text": "Ah Monty... Bir kızın kalbini nasıl çarptıracağını çok iyi biliyorsun."
    },
    {
      "id": "5d3b6e04",
      "bank_id": "a0b2b600",
      "text": "Hadi ama!"
    },
    {
      "id": "5d5cb9e9",
      "bank_id": "a0b2b600",
      "text": "Ah. Gördün mü? Şu deli kafama öyle bir geçirdi ki."
    },
    {
      "id": "5ddb0b9e",
      "bank_id": "a0b2b600",
      "text": "Bana dilediğin her şeyi pişirebilirsin."
    },
    {
      "id": "5e3b6ff7",
      "bank_id": "a0b2b600",
      "text": "Devam et! Daha sert!"
    },
    {
      "id": "5ed8ce9a",
      "bank_id": "a0b2b600",
      "text": "Sana senin için nasıl YANDIĞIMI söylerdim."
    },
    {
      "id": "5edb0d71",
      "bank_id": "a0b2b600",
      "text": "Hayır, senin için YANIYORUM dedim."
    },
    {
      "id": "5f3b716a",
      "bank_id": "a0b2b600",
      "text": "Burası bizim mahallemiz! Göster gününü şunlara!"
    },
    {
      "id": "5fd8d00d",
      "bank_id": "a0b2b600",
      "text": "Ve sen, en kıymetli sevgilim, bana ne söylerdin peki?"
    },
    {
      "id": "5fdb0ee4",
      "bank_id": "a0b2b600",
      "text": "İşkence gibi! Bedenimin yavaşça testereyle ikiye biçilmesi gibi, bıçağın kasıklarımdan başlayıp boğazıma kadar ileri geri yarıp geçmesi gibi."
    },
    {
      "id": "61db11ca",
      "bank_id": "a0b2b600",
      "text": "Keşke daha yüksek sesle söyleyebilseydim. Ya da birbirimize daha yakın olsaydık."
    },
    {
      "id": "62db13bd",
      "bank_id": "a0b2b600",
      "text": "Ama şimdilik bu gizli fısıltılarla kendimize işkence etmek zorundayız."
    },
    {
      "id": "65eb7051",
      "bank_id": "a0b2b600",
      "text": "Siz tam bir katilsiniz, değil mi? Doğuştan böcek katilisiniz."
    },
    {
      "id": "66a93bb7",
      "bank_id": "a0b2b600",
      "text": "Böcek Avı"
    },
    {
      "id": "66c62f2b",
      "bank_id": "a0b2b600",
      "text": "Durma, hâlâ kıpırdıyor! Haha."
    },
    {
      "id": "6bd05994",
      "bank_id": "a0b2b600",
      "text": "Annem seni burada bulursa çok kızar."
    },
    {
      "id": "6cd05b07",
      "bank_id": "a0b2b600",
      "text": "Lütfen, gitmek zorundasın."
    },
    {
      "id": "6dd05cfa",
      "bank_id": "a0b2b600",
      "text": "Burada olmaman gerek, annem seni bulursa..."
    },
    {
      "id": "70ab3ebc",
      "bank_id": "a0b2b600",
      "text": "Lütfen, sana yalvarıyorum."
    },
    {
      "id": "72ab4182",
      "bank_id": "a0b2b600",
      "text": "Siz yapabilirsiniz çocuklar, biliyorum yaparsınız."
    },
    {
      "id": "73ab4375",
      "bank_id": "a0b2b600",
      "text": "Gerçek aşk olmadan bu dünyada elimizde ne kalır ki?"
    },
    {
      "id": "7b44f340",
      "bank_id": "a0b2b600",
      "text": "Ve bir altın sikke daha aldık. Gerçekten başarıyoruz!"
    },
    {
      "id": "7dc6008b",
      "bank_id": "a0b2b600",
      "text": "Muhafızları çağırmadan önce defol git buradan seni hayvan!"
    },
    {
      "id": "7e8ae41c",
      "bank_id": "a0b2b600",
      "text": "Ver hadi o zaman!"
    },
    {
      "id": "808ae762",
      "bank_id": "a0b2b600",
      "text": "Siz veletler vaktimi mi çalmaya çalışıyorsunuz yoksa?!"
    },
    {
      "id": "80c60544",
      "bank_id": "a0b2b600",
      "text": "Şşt! Sanırım annem bizi duydu!"
    },
    {
      "id": "818ae8d5",
      "bank_id": "a0b2b600",
      "text": "E nerede bu mektup o zaman?"
    },
    {
      "id": "82c608aa",
      "bank_id": "a0b2b600",
      "text": "Kızımın etrafında fır dönmeni istemiyorum."
    },
    {
      "id": "82e2153a",
      "bank_id": "a0b2b600",
      "text": "Mektubu o harika Belinda'ma mı götüreceksin? Oh, teşekkür ederim!"
    },
    {
      "id": "83064dd8",
      "bank_id": "a0b2b600",
      "text": "Çok komikti değil mi? Eşyaları kırıp dökmek için para almak yani."
    },
    {
      "id": "83c60a1d",
      "bank_id": "a0b2b600",
      "text": "Yine mi sen!"
    },
    {
      "id": "86065291",
      "bank_id": "a0b2b600",
      "text": "Vay canına, dövüşte bu kadar iyi olduğunu bilmiyordum."
    },
    {
      "id": "8d98b4f4",
      "bank_id": "a0b2b600",
      "text": "Dört altın sikke! Sadece bir tane daha lazım."
    },
    {
      "id": "9226f293",
      "bank_id": "a0b2b600",
      "text": "Başardık! Artık müzik kutusunu alabiliriz!"
    },
    {
      "id": "99aa40f1",
      "bank_id": "a0b2b600",
      "text": "Dört altın sikke! Sadece bir tane daha lazım."
    },
    {
      "id": "99e82370",
      "bank_id": "a0b2b600",
      "text": "Köpeciği kurtardığın iyi oldu."
    },
    {
      "id": "9ab35f1b",
      "bank_id": "a0b2b600",
      "text": "Bir kıza vurdu!"
    },
    {
      "id": "9ae824e3",
      "bank_id": "a0b2b600",
      "text": "Zaten Rex'i hiç sevmezdim."
    },
    {
      "id": "9b1b57fc",
      "bank_id": "a0b2b600",
      "text": "Zorba"
    },
    {
      "id": "9b54682e",
      "bank_id": "a0b2b600",
      "text": "Ha!"
    },
    {
      "id": "9bb3608e",
      "bank_id": "a0b2b600",
      "text": "Evet -- şimdi bir başkasına daha vuracağım."
    },
    {
      "id": "9ce827c9",
      "bank_id": "a0b2b600",
      "text": "Ona iyi bir ders verdin valla. Başından beri seni tutuyordum ben."
    },
    {
      "id": "9d546b74",
      "bank_id": "a0b2b600",
      "text": "Al bakalım!"
    },
    {
      "id": "9de829bc",
      "bank_id": "a0b2b600",
      "text": "Güzel dövüştün!"
    },
    {
      "id": "9e197015",
      "bank_id": "a0b2b600",
      "text": "Ve bir altın sikke daha aldık. Gerçekten başarıyoruz!"
    },
    {
      "id": "9e546ce7",
      "bank_id": "a0b2b600",
      "text": "Gör gününü şimdi!"
    },
    {
      "id": "9ee82b2f",
      "bank_id": "a0b2b600",
      "text": "Köpeği sahiplenecek misin yani?"
    },
    {
      "id": "9fe82c82",
      "bank_id": "a0b2b600",
      "text": "Rex bize hep kötü davranırdı, iyi yaptın ona."
    },
    {
      "id": "a0546fcd",
      "bank_id": "a0b2b600",
      "text": "Pöh!"
    },
    {
      "id": "a0e82e75",
      "bank_id": "a0b2b600",
      "text": "Aferin!"
    },
    {
      "id": "a3e832ce",
      "bank_id": "a0b2b600",
      "text": "Harika bir dövüştü."
    },
    {
      "id": "a4e834a1",
      "bank_id": "a0b2b600",
      "text": "Tıpkı bir Kahraman gibi dövüşüyorsun."
    },
    {
      "id": "a51c876c",
      "bank_id": "a0b2b600",
      "text": "Gitme..."
    },
    {
      "id": "b07de3ad",
      "bank_id": "a0b2b600",
      "text": "Ah! Kes şunu. Yalnız bırak beni seni deli."
    },
    {
      "id": "b2e4011e",
      "bank_id": "a0b2b600",
      "text": "Mektubu ulaştırın."
    },
    {
      "id": "b3576635",
      "bank_id": "a0b2b600",
      "text": "Hayır, gitme!"
    },
    {
      "id": "b4e40464",
      "bank_id": "a0b2b600",
      "text": "Kapıyı çalın."
    },
    {
      "id": "b5e405d7",
      "bank_id": "a0b2b600",
      "text": "Eve girin."
    },
    {
      "id": "b7e4093d",
      "bank_id": "a0b2b600",
      "text": "Monty ile konuşun."
    },
    {
      "id": "bff4c598",
      "bank_id": "a0b2b600",
      "text": "Hadi gel küçük Sparrow, gidelim."
    },
    {
      "id": "c1847780",
      "bank_id": "a0b2b600",
      "text": "Gel buraya oğlum, sana güzel bir ödülüm var..."
    },
    {
      "id": "c1f4c8fe",
      "bank_id": "a0b2b600",
      "text": "Ohh, sana bakamayız -- kendimize yetecek kadar bile yiyeceğimiz yok."
    },
    {
      "id": "c2847973",
      "bank_id": "a0b2b600",
      "text": "Oyy, ne oldu kuçucuk, canın mı yandı?"
    },
    {
      "id": "c2f4ca51",
      "bank_id": "a0b2b600",
      "text": "Şey, üzgünüm ama yapamayız. Şimdi dinlen sen."
    },
    {
      "id": "c33351bf",
      "bank_id": "a0b2b600",
      "text": "Gelin çabuk, Rex bir köpek yakalamış, canına okuyacak!"
    },
    {
      "id": "c3847ae6",
      "bank_id": "a0b2b600",
      "text": "Haha! Hoşuna gitti mi seni aptal it?"
    },
    {
      "id": "c3f4cbc4",
      "bank_id": "a0b2b600",
      "text": "Korkma, sana zarar vermeyeceğim."
    },
    {
      "id": "c4f4cdb7",
      "bank_id": "a0b2b600",
      "text": "Sana gereken şey sana iyi bakacak biri."
    },
    {
      "id": "c6f4d09d",
      "bank_id": "a0b2b600",
      "text": "Ah zavallı şey. Korkunç anlar yaşamışsın."
    },
    {
      "id": "c9769fe8",
      "bank_id": "a0b2b600",
      "text": "Şu Rex'i patakladığına çok sevindim. Hak etmişti."
    },
    {
      "id": "ca76a15b",
      "bank_id": "a0b2b600",
      "text": "Ömrümde gördüğüm en iyi kavgaydı!"
    },
    {
      "id": "cc18fe67",
      "bank_id": "a0b2b600",
      "text": "Ahh, buradaymış işte."
    },
    {
      "id": "cd18ffda",
      "bank_id": "a0b2b600",
      "text": "Şimdi ver o mektubu bana."
    },
    {
      "id": "ce19014d",
      "bank_id": "a0b2b600",
      "text": "Karar verme vakti!"
    },
    {
      "id": "d051fece",
      "bank_id": "a0b2b600",
      "text": "Bilemiyorum ki! Bu şeyleri kimse bulamasın diye öyle bir yere saklıyorsun ki sonra kendin de bulamıyorsun."
    },
    {
      "id": "d15200a1",
      "bank_id": "a0b2b600",
      "text": "Nerede bu?! Şu Belinda dokunmamış olsa bari!"
    },
    {
      "id": "d157cda6",
      "bank_id": "a0b2b600",
      "text": "Teşekkür ederim postacı çocuk."
    },
    {
      "id": "d157cdad",
      "bank_id": "a0b2b600",
      "text": "Teşekkür ederim postacı kız."
    },
    {
      "id": "d2520214",
      "bank_id": "a0b2b600",
      "text": "Yaramazlık yapmayın sakın çocuklar!"
    },
    {
      "id": "d3520387",
      "bank_id": "a0b2b600",
      "text": "Buralarda bir yere bıraktığıma eminim..."
    },
    {
      "id": "d452057a",
      "bank_id": "a0b2b600",
      "text": "Nereye gitti o para?"
    },
    {
      "id": "d7a32b66",
      "bank_id": "a0b2b600",
      "text": "Başardık! Artık müzik kutusunu alabiliriz!"
    },
    {
      "id": "d88a6472",
      "bank_id": "a0b2b600",
      "text": "Kader zalim ve kaypak bir sevgilidir. Belinda'nın annesi de öyle."
    },
    {
      "id": "e16a1ad9",
      "bank_id": "a0b2b600",
      "text": "Bowerstone'un en büyük zorbasının hakkından gelin."
    },
    {
      "id": "e5deaec1",
      "bank_id": "a0b2b600",
      "text": "Pekala, hadi gidelim küçük Sparrow!"
    },
    {
      "id": "e888b6a2",
      "bank_id": "a0b2b600",
      "text": "Rex'i yenin."
    },
    {
      "id": "e8dff5b2",
      "bank_id": "a0b2b600",
      "text": "Ah -- oh -- ben, şey... şu anda biraz sıkışığım doğrusu."
    },
    {
      "id": "e9dff725",
      "bank_id": "a0b2b600",
      "text": "Bir altın sikke karşılığında yaparız."
    },
    {
      "id": "eab02e10",
      "bank_id": "a0b2b600",
      "text": "Ve şu yerleri temizle, şu hayırsız serseri Monty kadar kirlenmişler!"
    },
    {
      "id": "ebdffa0b",
      "bank_id": "a0b2b600",
      "text": "Ah! Evet! Evlilik teklifi mektubumu o güzel kıza sen götürebilirsin! Oh, bir umut var! Kalbim göğsümde tıpkı... tıpkı..."
    },
    {
      "id": "ecdffbfe",
      "bank_id": "a0b2b600",
      "text": "Belki biz sana yardım edebiliriz."
    },
    {
      "id": "ed26bfe2",
      "bank_id": "a0b2b600",
      "text": "Öffff!"
    },
    {
      "id": "edb032e9",
      "bank_id": "a0b2b600",
      "text": "Çabuk eve gir Belinda!"
    },
    {
      "id": "eddffd51",
      "bank_id": "a0b2b600",
      "text": "Şey... sanırım işin özü bu. Neden sordun o zaman?"
    },
    {
      "id": "eedffec4",
      "bank_id": "a0b2b600",
      "text": "Bana kalırsa orada yaşayan kızı seviyorsun ama annesi senin bir işe yaramaz olduğunu düşünüp kızı içeri kilitlemiş."
    },
    {
      "id": "efe000b7",
      "bank_id": "a0b2b600",
      "text": "Ah küçükler... Durumum dayanılmaz halde. Kelimeler anlatmaya yetmez."
    },
    {
      "id": "f0e0022a",
      "bank_id": "a0b2b600",
      "text": "Neyin var senin?"
    },
    {
      "id": "f225b444",
      "bank_id": "a0b2b600",
      "text": "Ve ilk altın sikkeyi kaptık!"
    },
    {
      "id": "f5abe2a0",
      "bank_id": "a0b2b600",
      "text": "Hey, ne halt ettiğinizi sanıyorsunuz siz?"
    },
    {
      "id": "f70e2788",
      "bank_id": "a0b2b600",
      "text": "Daha ne bekliyoruz ki? Hadi kaçalım... hemen şimdi!"
    },
    {
      "id": "f80e297b",
      "bank_id": "a0b2b600",
      "text": "[Gergin bir şekilde güler]"
    },
    {
      "id": "f8abe779",
      "bank_id": "a0b2b600",
      "text": "Biraz eğleniyoruz, sana ne bundan?"
    },
    {
      "id": "f90e2aee",
      "bank_id": "a0b2b600",
      "text": "Sana hayvan dediğimde ima ettiğimi anlayacağını biliyordum. Şimdi bir hayvan olduğunu göster bana!"
    },
    {
      "id": "fb0e2e34",
      "bank_id": "a0b2b600",
      "text": "Balayımızı Bower Gölü'nde yaparız, sonra da annem yanımıza taşınır. Onu öylece bırakamam ya -- çok hasta kadıncağız, bütün gece öksürük krizlerine giriyor. Bir de beslenmesi gereken o on dört evlatlık kedi var..."
    },
    {
      "id": "fc0e2fa7",
      "bank_id": "a0b2b600",
      "text": "Kızım yakında evlenip gidecek ve ben daha çok çocuk istiyorum. Hemen şimdi başlayalım."
    },
    {
      "id": "fd0e311a",
      "bank_id": "a0b2b600",
      "text": "Çok hızlı gitmek istemeyiz."
    },
    {
      "id": "fe0e328d",
      "bank_id": "a0b2b600",
      "text": "Şey, bu acele de ne?"
    }
  ]
}