    {
      "id": "ece76949",
      "bank_id": "100fab00",
      "text": "Seni zorba. Al, tepe tepe kullan."
    },
    {
      "id": "ece7694c",
      "bank_id": "100fab00",
      "text": "Yeter ki yaşamama izin ver."
