    },
    {
      "id": "381d44f3",
      "bank_id": "100fab00",
      "text": "Bu çılgınlık!"
    },
    {
      "id": "381d44f5",
      "bank_id": "100fab00",
      "text": "Olamaz! Saldırı!"
    },
    {
      "id": "381d44f6",
