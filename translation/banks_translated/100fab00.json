    {
      "id": "edb0be50",
      "bank_id": "100fab00",
      "text": "O kamu hizmetini bitirene kadar gözüm üzerinde olacak."
    },
    {
      "id": "edb0be53",
      "bank_id": "100fab00",
      "text": "Şartlı tahliyeni ihlal etmenin yanına kâr kalacağını sanma. İzliyorum."
    },
    {
      "id": "edcdf8a1",
      "bank_id": "100fab00",
      "text": "Ödemeniz sizi akladı. Ama bir daha yaptığınızı görmeyeyim."
    },
    {
      "id": "edcdf8a2",
      "bank_id": "100fab00",
      "text": "Cezanız ödendi ama bir daha yapmayın."
    },
    {
      "id": "f16cafb0",
      "bank_id": "100fab00",
      "text": "Ah, elbette, buyurun."
    },
    {
      "id": "f16cafb1",
      "bank_id": "100fab00",
      "text": "Çok ikna edicisiniz."
    },
    {
      "id": "f16cafb2",
      "bank_id": "100fab00",
      "text": "Tamam, tamam, bela istemiyorum."
    },
    {
      "id": "f16cafb3",
      "bank_id": "100fab00",
      "text": "Şey, madem öyle diyorsunuz."
