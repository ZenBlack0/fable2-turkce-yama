    {
      "id": "f16cafb7",
      "bank_id": "100fab00",
      "text": "A, şey, pekala... buyurun."
    },
    {
      "id": "f86cbab8",
      "bank_id": "100fab00",
      "text": "Evet, her neyse, ne istersen."
