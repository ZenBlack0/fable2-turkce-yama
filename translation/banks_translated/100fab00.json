    {
      "id": "ece7694e",
      "bank_id": "100fab00",
      "text": "Çok bir şeyim yok ama hepsi senin olsun."
    },
    {
      "id": "ece7694f",
      "bank_id": "100fab00",
      "text": "Benden uzak durmanı sağlayacaksa buna değer."
