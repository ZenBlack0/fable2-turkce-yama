    {
      "id": "4fa5e070",
      "bank_id": "100fab00",
      "text": "İstediğin kadar özür dile. Hiçbir işe yaramaz."
    },
    {
      "id": "4fa5e071",
      "bank_id": "100fab00",
      "text": "Beni aptal sanıyorsun herhalde. Muhafızlar hakkından gelecek."
    },
    {
      "id": "4fa5e072",
      "bank_id": "100fab00",
      "text": "Sanmıyorum."
    },
    {
      "id": "4fa5e074",
      "bank_id": "100fab00",
      "text": "Suç teşkil eden davranışlara asla göz yummam, şimdi de başlayacak değilim."
    },
    {
      "id": "4fa5e075",
      "bank_id": "100fab00",
      "text": "Diğer tüm vatandaşlar gibi sen de suçlarının cezasını ödeyeceksin."
    },
    {
      "id": "4fa5e076",
      "bank_id": "100fab00",
      "text": "Kimseyi inandıramazsın."
    },
    {
      "id": "4fa5e077",
      "bank_id": "100fab00",
      "text": "\"Özür dilerim\" demek kurtarmaz."
    },
    {
      "id": "51bf77b0",
      "bank_id": "100fab00",
      "text": "Elimden kaçamazsın!"
    },
    {
      "id": "51bf77b3",
      "bank_id": "100fab00",
      "text": "Kaçmaktan vazgeç!"
    },
    {
      "id": "522cb960",
      "bank_id": "100fab00",
      "text": "İki katım kadar iri ve üç katım kadar çirkin olsan bile olmaz."
    },
    {
      "id": "522cb961",
      "bank_id": "100fab00",
      "text": "Unut bunu."
    },
    {
      "id": "522cb964",
      "bank_id": "100fab00",
      "text": "Gözümü korkutamazsın. Çekil git."
    },
    {
      "id": "522cb966",
      "bank_id": "100fab00",
      "text": "Senin zorbalığına boyun eğecek değilim."
    },
    {
      "id": "522cb967",
      "bank_id": "100fab00",
      "text": "Gözümü korkutmayı istediğin kadar deneyebilirsin. İşe yaramaz."
    },
    {
      "id": "572cc100",
      "bank_id": "100fab00",
      "text": "Vazgeç artık, he?"
    },
    {
      "id": "572cc101",
      "bank_id": "100fab00",
      "text": "Onun yerine sana defolup gitmeni söylesem nasıl olur?"
    },
    {
      "id": "572cc105",
      "bank_id": "100fab00",
      "text": "Yaşlı bir kadından bile altın koparamazsın sen, beni geç."
    },
    {
      "id": "572cc106",
      "bank_id": "100fab00",
      "text": "İyi deneme ama öyle kolay korkmam ben."
    },
    {
      "id": "572cc107",
      "bank_id": "100fab00",
      "text": "Böyle yaparak benden hiçbir şey koparamazsın."
    },
    {
      "id": "58a5ee58",
      "bank_id": "100fab00",
      "text": "Kanunda istisna yoktur."
    },
    {
      "id": "58a5ee59",
      "bank_id": "100fab00",
      "text": "Kimse adaletten muaf değildir."
    },
    {
      "id": "58a5ee5a",
      "bank_id": "100fab00",
      "text": "Evet evet, git de muhafızlara anlat."
    },
    {
      "id": "58a5ee5b",
      "bank_id": "100fab00",
      "text": "İstediğin kadar yalvar, hiçbir şeyi değiştirmeyecek."
    },
    {
      "id": "58a5ee5c",
      "bank_id": "100fab00",
      "text": "Kendini kanunun üstünde mi sanıyorsun?"
    },
    {
      "id": "58a5ee5d",
      "bank_id": "100fab00",
      "text": "Bağışlayıcı biri olabilirim ama aptal değilim."
    },
    {
      "id": "58a5ee5f",
      "bank_id": "100fab00",
      "text": "Seni neden affedeyim ki?"
    },
    {
      "id": "60566f20",
      "bank_id": "100fab00",
      "text": "Bunu yapmaya devam edebileceğin anlamına geldiğini sanma sakın."
    },
    {
      "id": "60566f21",
      "bank_id": "100fab00",
      "text": "Seni bir daha aynı şeyi yaparken yakalamayayım yeter."
    },
    {
      "id": "60566f22",
      "bank_id": "100fab00",
      "text": "Pekala öyleyse. Bu seferlik muhafızlara haber verilmeyecek."
    },
    {
      "id": "60566f23",
      "bank_id": "100fab00",
      "text": "Belki de masum bir hataydı."
    },
    {
      "id": "60566f24",
      "bank_id": "100fab00",
      "text": "Pekala. Çok yufka yürekliyim ben, bütün sorunum bu."
    },
    {
      "id": "60566f26",
      "bank_id": "100fab00",
      "text": "Bu seferlik görmezden gelebilirim sanırım."
    },
    {
      "id": "60566f27",
      "bank_id": "100fab00",
      "text": "Seni bu seferlik affediyorum."
    },
    {
      "id": "60c50cb4",
      "bank_id": "100fab00",
      "text": "Dur! Emrediyorum!"
    },
    {
      "id": "60c50cb7",
      "bank_id": "100fab00",
      "text": "Dur! Dur!"
    },
    {
      "id": "61a1018d",
      "bank_id": "100fab00",
      "text": "<giggles> Hiç de korkutucu değilsin."
    },
    {
      "id": "655676c3",
      "bank_id": "100fab00",
      "text": "Samimi görünüyorsun. Pekala öyleyse."
    },
    {
      "id": "6ca1133c",
      "bank_id": "100fab00",
      "text": "Aynen, ben de sana harçlığımı verecektim zaten..."
    },
    {
      "id": "74052ca8",
      "bank_id": "100fab00",
      "text": "Onları buldum!"
    },
    {
      "id": "74052cab",
      "bank_id": "100fab00",
      "text": "Suçluyu tespit ettim!"
    },
    {
      "id": "764e34a5",
      "bank_id": "100fab00",
      "text": "Elimizde canlı biri var!"
    },
    {
      "id": "764e34a6",
      "bank_id": "100fab00",
      "text": "Demek oyunun bu ha?"
    },
    {
      "id": "79ea1b45",
      "bank_id": "100fab00",
      "text": "Her yeri arayın!"
    },
    {
      "id": "79ea1b46",
      "bank_id": "100fab00",
      "text": "Şu suçluyu bulmalıyız!"
    },
    {
      "id": "79fd929c",
      "bank_id": "100fab00",
      "text": "Dur! Kanun emrediyor!"
    },
    {
      "id": "79fd929f",
      "bank_id": "100fab00",
      "text": "Gel buraya hırsız!"
    },
    {
      "id": "8230598c",
      "bank_id": "100fab00",
      "text": "Orada dur saldırgan!"
    },
    {
      "id": "8230598f",
      "bank_id": "100fab00",
      "text": "Dur! Saldırgan! Dur!"
    },
    {
      "id": "83dda203",
      "bank_id": "100fab00",
      "text": "Hayır! Seni affetmiyorum."
    },
    {
      "id": "889b2ec0",
      "bank_id": "100fab00",
      "text": "Tabii. Bulutun tepesine bir kese altın saklamıştım. Alabilirsin onu."
    },
    {
      "id": "889b2ec1",
      "bank_id": "100fab00",
      "text": "Oradan bakınca aptal gibi mi görünüyorum? Yıkıl karşımdan."
    },
    {
      "id": "889b2ec2",
      "bank_id": "100fab00",
      "text": "Demek numaran haraç kesmek ha? Ne yazık ki ben kazandım."
    },
    {
      "id": "889b2ec4",
      "bank_id": "100fab00",
      "text": "Belki bir muhafız bu talebinizle ilgilenebilir."
    },
    {
      "id": "889b2ec5",
      "bank_id": "100fab00",
      "text": "Benden hiçbir şey alamayacaksın suçlu."
    },
    {
      "id": "889b2ec6",
      "bank_id": "100fab00",
      "text": "Hadi oradan, haracın kitabını ben yazdım be. Bana sökmez o."
    },
    {
      "id": "889b2ec7",
      "bank_id": "100fab00",
      "text": "Beni korkutabileceğini mi sanıyorsun?"
    },
    {
      "id": "8addad06",
      "bank_id": "100fab00",
      "text": "Beni aptal falan mı sanıyorsun sen?"
    },
    {
      "id": "8c15c398",
      "bank_id": "100fab00",
      "text": "O suçlu kaçmamalı."
    },
    {
      "id": "8c15c39b",
      "bank_id": "100fab00",
      "text": "O hırsızın bulunmasını istiyorum!"
    },
    {
      "id": "919b3d28",
      "bank_id": "100fab00",
      "text": "Sana altınımı vermeye hiç niyetim yok."
    },
    {
      "id": "919b3d29",
      "bank_id": "100fab00",
      "text": "Bu nafile girişimden vazgeçsen iyi edersin."
    },
    {
      "id": "919b3d2a",
      "bank_id": "100fab00",
      "text": "Altın mı istiyorsun? Git çalış da kazan."
    },
    {
      "id": "919b3d2b",
      "bank_id": "100fab00",
      "text": "Benden tek kuruş bile alamazsın."
    },
    {
      "id": "919b3d2c",
      "bank_id": "100fab00",
      "text": "Beni korkutamazsın. Git başkasını rahatsız et."
    },
    {
      "id": "919b3d2d",
      "bank_id": "100fab00",
      "text": "Gözümü korkutmaya çalışma."
    },
    {
      "id": "919b3d2f",
      "bank_id": "100fab00",
      "text": "Sana hiçbir şey vermiyorum."
    },
    {
      "id": "92a504f8",
      "bank_id": "100fab00",
      "text": "Dur! Tam orada dur!"
    },
    {
      "id": "92a504fb",
      "bank_id": "100fab00",
      "text": "Bunu sen istedin!"
    },
    {
      "id": "94aaca21",
      "bank_id": "100fab00",
      "text": "Seni affetmemin imkânı yok!"
    },
    {
      "id": "95d7c744",
      "bank_id": "100fab00",
      "text": "Muhafızlar! Muhafızlar!"
    },
    {
      "id": "96474b3e",
      "bank_id": "100fab00",
      "text": "Bu bir cinayete teşebbüs!"
    },
    {
      "id": "967229d9",
      "bank_id": "100fab00",
      "text": "Suçlu kaçıyor!"
    },
    {
      "id": "967229da",
      "bank_id": "100fab00",
      "text": "Kanun tanımaz!"
    },
    {
      "id": "9ad7cf65",
      "bank_id": "100fab00",
      "text": "Muhafızlar! Muhafızlar!"
    },
    {
      "id": "9c15ede5",
      "bank_id": "100fab00",
      "text": "Kamu hizmeti kendi kendine yapılmayacak, bilesin."
    },
    {
      "id": "9c15ede6",
      "bank_id": "100fab00",
      "text": "Kamu hizmetinizi yapmayı unutmayın."
    },
    {
      "id": "9f47590b",
      "bank_id": "100fab00",
      "text": "Biri bir şey yapsın! Az kalsın bir cinayet işleniyordu!"
    },
    {
      "id": "9faadb50",
      "bank_id": "100fab00",
      "text": "Gerçekten pişman değilsin, anlayabiliyorum."
    },
    {
      "id": "a1cc01f4",
      "bank_id": "100fab00",
      "text": "Yakalandın."
    },
    {
      "id": "a1cc01f7",
      "bank_id": "100fab00",
      "text": "Tutuklusunuz."
    },
    {
      "id": "a8647700",
      "bank_id": "100fab00",
      "text": "Tamam ama bitene kadar şartlı tahliyelisin."
    },
    {
      "id": "a8647703",
      "bank_id": "100fab00",
      "text": "Pekala, yaptığından emin ol."
    },
    {
      "id": "b005a671",
      "bank_id": "100fab00",
      "text": "Dur! Kanun namına!"
    },
    {
      "id": "b005a672",
      "bank_id": "100fab00",
      "text": "Orada dur seni suçlu!"
    },
    {
      "id": "b185420c",
      "bank_id": "100fab00",
      "text": "Benimsin artık."
    },
    {
      "id": "b185420f",
      "bank_id": "100fab00",
      "text": "Seni gözaltına alıyorum."
    },
    {
      "id": "b217f349",
      "bank_id": "100fab00",
      "text": "Altın olmadan bu işten para vererek sıyrılamazsın."
    },
    {
      "id": "b217f34a",
      "bank_id": "100fab00",
      "text": "Ne yapmaya çalışıyorsun sen? Cep tozuyla ödeme yapamazsın."
    },
    {
      "id": "b2cbd1d0",
      "bank_id": "100fab00",
      "text": "Muhafızlaaaaaaaaaaaar!"
    },
    {
      "id": "b2cbd1d1",
      "bank_id": "100fab00",
      "text": "Muhafızlaaaaaaaaaaaar!"
