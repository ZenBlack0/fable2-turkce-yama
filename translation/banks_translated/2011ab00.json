{
  "bank_id": "2011ab00",
  "total_strings": 235,
  "strings": [
    {
      "id": "010ad517",
      "bank_id": "2011ab00",
      "text": "Bunu bıraksan iyi olur. Eşyaları kırdığımda bana hep kızarlar."
    },
    {
      "id": "041aada8",
      "bank_id": "2011ab00",
      "text": "Kimmiş iyi köpek?"
    },
    {
      "id": "041aada9",
      "bank_id": "2011ab00",
      "text": "Beni ısırmak istemezsin, vallahi istemezsin. Tadım berbattır."
    },
    {
      "id": "041aadaa",
      "bank_id": "2011ab00",
      "text": "Isırmaya hiç gerek yok kuçu kuçu."
    },
    {
      "id": "041aadab",
      "bank_id": "2011ab00",
      "text": "Boğazımı parçalamayacaksın değil mi?"
    },
    {
      "id": "041aadac",
      "bank_id": "2011ab00",
      "text": "A, selam köpek. Ben sadece kendi işime bakıyorum."
    },
    {
      "id": "041aadae",
      "bank_id": "2011ab00",
      "text": "Ne kadar iri, güçlü bir köpeksin sen öyle."
    },
    {
      "id": "041aadaf",
      "bank_id": "2011ab00",
      "text": "Şey... cici köpek... güzel köpek... eveeeet."
    },
    {
      "id": "080ae01a",
      "bank_id": "2011ab00",
      "text": "Hey, o senin kıracağın bir şey değil!"
    },
    {
      "id": "0e2eac8e",
      "bank_id": "2011ab00",
      "text": "Ha ha! Bir daha yap! Bir daha yap!"
    },
    {
      "id": "100c7ea8",
      "bank_id": "2011ab00",
      "text": "Hey! Kırma onu! O benim!"
    },
    {
      "id": "100c7eaa",
      "bank_id": "2011ab00",
      "text": "Eşyalarımı parçalamayı kes!"
    },
    {
      "id": "100c7eab",
      "bank_id": "2011ab00",
      "text": "Bütün eşyalarımı mahvediyorsun!"
    },
    {
      "id": "100c7eac",
      "bank_id": "2011ab00",
      "text": "Seni vandal! Eşyalarıma ne yapıyorsun öyle?"
    },
    {
      "id": "100c7ead",
      "bank_id": "2011ab00",
      "text": "Eşyalarımı rahat bırak!"
    },
    {
      "id": "100c7eae",
      "bank_id": "2011ab00",
      "text": "Eşyalarımı yağmalamayı kes!"
    },
    {
      "id": "100c7eaf",
      "bank_id": "2011ab00",
      "text": "Seni yağmacı! Eşyalarımı rahat bırak!"
    },
    {
      "id": "150c8649",
      "bank_id": "2011ab00",
      "text": "Eşyalarımı yok etmeyi kes!"
    },
    {
      "id": "150c864a",
      "bank_id": "2011ab00",
      "text": "Hayır! Eşyalarımı darmadağın ediyorsun!"
    },
    {
      "id": "150c864b",
      "bank_id": "2011ab00",
      "text": "Hey, o benim! Kırma onu!"
    },
    {
      "id": "150c864c",
      "bank_id": "2011ab00",
      "text": "Vandal! Eşyalarımdan uzak dur!"
    },
    {
      "id": "150c864d",
      "bank_id": "2011ab00",
      "text": "Eşyalarım! Onları yok ediyorsun!"
    },
    {
      "id": "150c864e",
      "bank_id": "2011ab00",
      "text": "Seni cahil holigan! Benim eşyalarım onlar!"
    },
    {
      "id": "150c864f",
      "bank_id": "2011ab00",
      "text": "Mülküme zarar veriyorsun!"
    },
    {
      "id": "15f34674",
      "bank_id": "2011ab00",
      "text": "Bu vandallıktır!"
    },
    {
      "id": "15f34677",
      "bank_id": "2011ab00",
      "text": "Dur, bu vandallık!"
    },
    {
      "id": "172ebadb",
      "bank_id": "2011ab00",
      "text": "Hi hi! Çok komiksin!"
    },
    {
      "id": "20165cb2",
      "bank_id": "2011ab00",
      "text": "B-b-bu köpeği hiç sevmedim. Buaaaaaa!"
    },
    {
      "id": "24b5cdd2",
      "bank_id": "2011ab00",
      "text": "*hıçkırır* Bana ters davranma. *hıçkırır* Ben köpekleri severim!"
    },
    {
      "id": "25ce727d",
      "bank_id": "2011ab00",
      "text": "Ayy, ne kadar da akıllı bir çocuksun sen!"
    },
    {
      "id": "29166a9f",
      "bank_id": "2011ab00",
      "text": "S-s-sen cici bir köpek değilsin, d-d-değil mi?"
    },
    {
      "id": "2db5dc3f",
      "bank_id": "2011ab00",
      "text": "Beni yiyecek bu!"
    },
    {
      "id": "30ce83ac",
      "bank_id": "2011ab00",
      "text": "Vay canına! Gördün mü şunu?!"
    },
    {
      "id": "342e1a40",
      "bank_id": "2011ab00",
      "text": "Hey! Öyle kafana eseni kıramazsın!"
    },
    {
      "id": "342e1a41",
      "bank_id": "2011ab00",
      "text": "Sen! Vandallığına son ver!"
    },
    {
      "id": "342e1a43",
      "bank_id": "2011ab00",
      "text": "Vandal!"
    },
    {
      "id": "342e1a44",
      "bank_id": "2011ab00",
      "text": "Ömrümde gördüğüm en bariz vandallık eylemi!"
    },
    {
      "id": "342e1a45",
      "bank_id": "2011ab00",
      "text": "Vandal!"
    },
    {
      "id": "342e1a46",
      "bank_id": "2011ab00",
      "text": "Şuna bak, aptal bir hobbe gibi eşyaları kırıp döküyor."
    },
    {
      "id": "342e1a47",
      "bank_id": "2011ab00",
      "text": "Vandal!"
    },
    {
      "id": "3acb3938",
      "bank_id": "2011ab00",
      "text": "Öğk! Kimse bunu görmek istemiyor!"
    },
    {
      "id": "3acb393a",
      "bank_id": "2011ab00",
      "text": "Senden bu kadar yeter seni sersem kırma."
    },
    {
      "id": "3acb393b",
      "bank_id": "2011ab00",
      "text": "Bu köpeğin aptal numaralarını izlemekten bıktım!"
    },
    {
      "id": "3acb393c",
      "bank_id": "2011ab00",
      "text": "Lanet itler en iyi zamanlarında bile baş belasıdır. O yüzden yapma şunu!"
    },
    {
      "id": "3acb393d",
      "bank_id": "2011ab00",
      "text": "Bunu bir daha yap da kellenin derisini yüzeyim senin!"
    },
    {
      "id": "3acb393e",
      "bank_id": "2011ab00",
      "text": "Ah! O pis hayvan şimdi ne yapıyor öyle?"
    },
    {
      "id": "3acb393f",
      "bank_id": "2011ab00",
      "text": "Ne kadar aşağılık ve iğrenç!"
    },
    {
      "id": "3b2e2540",
      "bank_id": "2011ab00",
      "text": "Sadece mala değil, toplumumuzun temel dokusuna da zarar veriyorsun!"
    },
    {
      "id": "3b2e2541",
      "bank_id": "2011ab00",
      "text": "Vandal!"
    },
    {
      "id": "3b2e2542",
      "bank_id": "2011ab00",
      "text": "Onu kırmaman gerekiyordu!"
    },
    {
      "id": "3b2e2543",
      "bank_id": "2011ab00",
      "text": "Düpedüz vandallık!"
    },
    {
      "id": "3b2e2544",
      "bank_id": "2011ab00",
      "text": "Bu mala zarar vermektir."
    },
    {
      "id": "3b2e2545",
      "bank_id": "2011ab00",
      "text": "Onu kırmayı kes! Kafana eseni yapamazsın!"
    },
    {
      "id": "3b2e2546",
      "bank_id": "2011ab00",
      "text": "Vandal!"
    },
    {
      "id": "3e65e3a8",
      "bank_id": "2011ab00",
      "text": "Ayy! Bütün dünyadaki en komik köpeksin sen!"
    },
    {
      "id": "3fcb40d9",
      "bank_id": "2011ab00",
      "text": "Öğk! Seni pis hayvan."
    },
    {
      "id": "3fcb40da",
      "bank_id": "2011ab00",
      "text": "Öff! Kes şunu!"
    },
    {
      "id": "3fcb40db",
      "bank_id": "2011ab00",
      "text": "Bu köpeğe gerçekten hiç katlanamıyorum!"
    },
    {
      "id": "3fcb40dc",
      "bank_id": "2011ab00",
      "text": "Biri şu aptal iti durdursun!"
    },
    {
      "id": "3fcb40dd",
      "bank_id": "2011ab00",
      "text": "Çok mu akıllı sanıyorsun kendini seni uyuz it?"
    },
    {
      "id": "3fcb40de",
      "bank_id": "2011ab00",
      "text": "Senin zavallı numaralarını görmeye hiç niyetim yok!"
    },
    {
      "id": "3fcb40df",
      "bank_id": "2011ab00",
      "text": "Köpeklerin böyle şeyler yapmasına izin verilmemeli!"
    },
    {
      "id": "4365eb49",
      "bank_id": "2011ab00",
      "text": "Ha! Keşke senin gibi bir köpeğim olsaydı!"
    },
    {
      "id": "485f0868",
      "bank_id": "2011ab00",
      "text": "İyi misin köpek?"
    },
    {
      "id": "485f0869",
      "bank_id": "2011ab00",
      "text": "Nasıl gidiyor dostum?"
    },
    {
      "id": "485f086a",
      "bank_id": "2011ab00",
      "text": "Ah, seni ham yapıp yerim ben. Mecazi anlamda tabii."
    },
    {
      "id": "485f086b",
      "bank_id": "2011ab00",
      "text": "Gördüğüm en tatlı köpeksin neredeyse."
    },
    {
      "id": "485f086d",
      "bank_id": "2011ab00",
      "text": "Selam oğlum."
    },
    {
      "id": "485f086e",
      "bank_id": "2011ab00",
      "text": "Çok tatlı bir şeysin sen öyle değil mi?"
    },
    {
      "id": "485f086f",
      "bank_id": "2011ab00",
      "text": "Kimmiş uslu çocuk?"
    },
    {
      "id": "4b1b054d",
      "bank_id": "2011ab00",
      "text": "Vandallık kanuna aykırıdır!"
    },
    {
      "id": "4b1b054e",
      "bank_id": "2011ab00",
      "text": "Hey! Mala zarar vermek kanuna aykırıdır!"
    },
    {
      "id": "4c7885b1",
      "bank_id": "2011ab00",
      "text": "Boğazımı parçalamayacaksın değil mi?"
    },
    {
      "id": "4e4d7148",
      "bank_id": "2011ab00",
      "text": "Gördüğüm en berbat köpek."
    },
    {
      "id": "4e4d7149",
      "bank_id": "2011ab00",
      "text": "Ne berbat bir hayvan."
    },
    {
      "id": "4e4d714a",
      "bank_id": "2011ab00",
      "text": "Seni pis yavru!"
    },
    {
      "id": "4e4d714b",
      "bank_id": "2011ab00",
      "text": "Ne pasaklı bir canavar."
    },
    {
      "id": "4e4d714d",
      "bank_id": "2011ab00",
      "text": "Seni tüylü haydut."
    },
    {
      "id": "4e4d714e",
      "bank_id": "2011ab00",
      "text": "Ne berbat küçük bir pire torbası!"
    },
    {
      "id": "4e4d714f",
      "bank_id": "2011ab00",
      "text": "Köpekleri severim ama sen midemi bulandırıyorsun."
    },
    {
      "id": "4f5192f6",
      "bank_id": "2011ab00",
      "text": "Isırmaya hiç gerek yok kuçu kuçu."
    },
    {
      "id": "51fc6d78",
      "bank_id": "2011ab00",
      "text": "Canımdan endişe etmeye başlıyorum."
    },
    {
      "id": "51fc6d79",
      "bank_id": "2011ab00",
      "text": "K-kes şunu seni korkunç yaratık."
    },
    {
      "id": "51fc6d7a",
      "bank_id": "2011ab00",
      "text": "Sadece kendi işime bakıyorum efendim, şey... köpek."
    },
    {
      "id": "51fc6d7b",
      "bank_id": "2011ab00",
      "text": "Sakin ol oğlum. Ben hiçbir şey yapmıyorum."
    },
    {
      "id": "51fc6d7c",
      "bank_id": "2011ab00",
      "text": "Sakin ol oğlum... sakin ol..."
    },
    {
      "id": "51fc6d7d",
      "bank_id": "2011ab00",
      "text": "O köpekte tam bir katilin donuk gözleri var. Ve bana bakıyorlar!"
    },
    {
      "id": "51fc6d7e",
      "bank_id": "2011ab00",
      "text": "Neden bana sürekli öyle dik dik bakıyor?"
    },
    {
      "id": "535f199c",
      "bank_id": "2011ab00",
      "text": "Nasılsın bakalım oğlum?"
    },
    {
      "id": "535f199f",
      "bank_id": "2011ab00",
      "text": "Kut kut kut!"
    },
    {
      "id": "580fdb78",
      "bank_id": "2011ab00",
      "text": "Vandal! Vandal!"
    },
    {
      "id": "580fdb7a",
      "bank_id": "2011ab00",
      "text": "Bu vandallık!"
    },
    {
      "id": "580fdb7b",
      "bank_id": "2011ab00",
      "text": "Hey. Kes şunu! O senin değil biliyorsun."
    },
    {
      "id": "580fdb7c",
      "bank_id": "2011ab00",
      "text": "Muhafızlar! Vandal var! İmdat!"
    },
    {
      "id": "580fdb7d",
      "bank_id": "2011ab00",
      "text": "İşe yaramaz bir vandalsın sen! Nesin başka!"
    },
    {
      "id": "580fdb7e",
      "bank_id": "2011ab00",
      "text": "Biri şu vandalı durdurmayacak mı?"
    },
    {
      "id": "580fdb7f",
      "bank_id": "2011ab00",
      "text": "Eşyaları kırmayı kes seni serseri!"
    },
    {
      "id": "594d82f8",
      "bank_id": "2011ab00",
      "text": "Yıkıl karşımdan seni sokak köpeği."
    },
    {
      "id": "594d82f9",
      "bank_id": "2011ab00",
      "text": "Git bir trolün arkasını kokla seni pire torbası."
    },
    {
      "id": "594d82fa",
      "bank_id": "2011ab00",
      "text": "Ne pis, iğrenç bir yaratık."
    },
    {
      "id": "594d82fb",
      "bank_id": "2011ab00",
      "text": "Böyle hayvanlar topraklarımızdan sürülmeli."
    },
    {
      "id": "594d82fc",
      "bank_id": "2011ab00",
      "text": "Seni korkunç köpek."
    },
    {
      "id": "594d82fe",
      "bank_id": "2011ab00",
      "text": "Aşağılık yaratık."
    },
    {
      "id": "594d82ff",
      "bank_id": "2011ab00",
      "text": "Gördüğün en pis hayvan bu değil de ne."
    },
    {
      "id": "5afc7b48",
      "bank_id": "2011ab00",
      "text": "*yutkunur* Şu dişlere bak!"
    },
    {
      "id": "5afc7b49",
      "bank_id": "2011ab00",
      "text": "Bu köpek bana kafayı takmış!"
    },
    {
      "id": "5afc7b4b",
      "bank_id": "2011ab00",
      "text": "Hadi ama oğlum, öyle yapmana hiç gerek yok..."
    },
    {
      "id": "5afc7b4c",
      "bank_id": "2011ab00",
      "text": "N-neden öyle yapıyorsun seni k-korkunç yaratık?"
    },
    {
      "id": "5afc7b4d",
      "bank_id": "2011ab00",
      "text": "Her an üstüme at-atlayacak gibi duruyor."
    },
    {
      "id": "5afc7b4e",
      "bank_id": "2011ab00",
      "text": "Öldürmeye hazır görünüyor..."
    },
    {
      "id": "5afc7b4f",
      "bank_id": "2011ab00",
      "text": "Böyle canavarların aramızda dolaşmasına nasıl izin veriyorlar. Şuna baksana!"
    },
    {
      "id": "5d0fe319",
      "bank_id": "2011ab00",
      "text": "Aman.... muhafızlar! Bir vandal var!"
    },
    {
      "id": "5d0fe31a",
      "bank_id": "2011ab00",
      "text": "Hey, vandal var! Bakın ahali!"
    },
    {
      "id": "5d0fe31b",
      "bank_id": "2011ab00",
      "text": "Bana bak sen! Eşyaları kırmayı kes!"
    },
    {
      "id": "5d0fe31c",
      "bank_id": "2011ab00",
      "text": "Eşyaları kırmayı kesin!"
    },
    {
      "id": "5d0fe31d",
      "bank_id": "2011ab00",
      "text": "Vandallığı görsem tanırım ben!"
    },
    {
      "id": "5d0fe31e",
      "bank_id": "2011ab00",
      "text": "Böylesini de görmedim! Ne kaba bir vandallık. Biri muhafızları çağırsın!"
    },
    {
      "id": "5d0fe31f",
      "bank_id": "2011ab00",
      "text": "Bakar mısınız! Bir vandal!"
    },
    {
      "id": "60ca51c8",
      "bank_id": "2011ab00",
      "text": "Ne kadar da sevimli ama."
    },
    {
      "id": "60ca51c9",
      "bank_id": "2011ab00",
      "text": "Bir köpeğin böyle numaralar yaptığını hiç görmemiştim."
    },
    {
      "id": "60ca51ca",
      "bank_id": "2011ab00",
      "text": "E, pek akıllı bir itsin sen."
    },
    {
      "id": "60ca51cb",
      "bank_id": "2011ab00",
      "text": "Amma da numaraymış ha!"
    },
    {
      "id": "60ca51cc",
      "bank_id": "2011ab00",
      "text": "Bunu yapmayı nereden öğrendin oğlum?"
    },
    {
      "id": "60ca51cd",
      "bank_id": "2011ab00",
      "text": "Ha, harika bir köpek!"
    },
    {
      "id": "60ca51ce",
      "bank_id": "2011ab00",
      "text": "Ayy, ne kadar akıllıca değil mi?"
    },
    {
      "id": "6323f9d8",
      "bank_id": "2011ab00",
      "text": "Hiç de cici bir köpek değilsin sen!"
    },
    {
      "id": "6761a6c2",
      "bank_id": "2011ab00",
      "text": "Ha ha! Bu komik hareketlerle bütün dişi köpekleri çıldırtıyorsundur kesin!"
    },
    {
      "id": "6761a6c3",
      "bank_id": "2011ab00",
      "text": "Ha ha! Cici bir çocuksun sen!"
    },
    {
      "id": "6761a6c4",
      "bank_id": "2011ab00",
      "text": "Bir köpek için bayağı komik bir zamanlama!"
    },
    {
      "id": "6761a6c5",
      "bank_id": "2011ab00",
      "text": "Heh heh! Bunu sana sahibin mi öğretti?"
    },
    {
      "id": "6761a6c7",
      "bank_id": "2011ab00",
      "text": "Ho ho! Bu komik numaraları nereden öğrendin?"
    },
    {
      "id": "682401f9",
      "bank_id": "2011ab00",
      "text": "Aman! Seninle oynamak istemiyorum ben!"
    },
    {
      "id": "68ecd1b0",
      "bank_id": "2011ab00",
      "text": "Hi hi! Köpek mizahı bir numara."
    },
    {
      "id": "69ca6018",
      "bank_id": "2011ab00",
      "text": "Bunu sana sahibin mi öğretti?"
    },
    {
      "id": "69ca6019",
      "bank_id": "2011ab00",
      "text": "Ah, bu iyiydi işte!"
    },
    {
      "id": "69ca601b",
      "bank_id": "2011ab00",
      "text": "Aferin köpek!"
    },
    {
      "id": "69ca601c",
      "bank_id": "2011ab00",
      "text": "Ha! Bir hayvan için oldukça etkileyici."
    },
    {
      "id": "69ca601d",
      "bank_id": "2011ab00",
      "text": "Kürklü bir yaratık için güzel bir numara."
    },
    {
      "id": "69ca601e",
      "bank_id": "2011ab00",
      "text": "Aferin sana it."
    },
    {
      "id": "69ca601f",
      "bank_id": "2011ab00",
      "text": "Ah, eski köpeğim de öyle yapardı!"
    },
    {
      "id": "6e61b1c8",
      "bank_id": "2011ab00",
      "text": "Bu numaralara bilet kesmelisin sen!"
    },
    {
      "id": "6e61b1c9",
      "bank_id": "2011ab00",
      "text": "Ayy, ha ha, çok sevimli değil mi ama?"
    },
    {
      "id": "6e61b1ca",
      "bank_id": "2011ab00",
      "text": "Hi hi! Köpeğin ne yaptığını gördün mü?"
    },
    {
      "id": "6e61b1ce",
      "bank_id": "2011ab00",
      "text": "Kes şunu köpek! Gülmekten kırıp geçireceksin beni!"
    },
    {
      "id": "6e61b1cf",
      "bank_id": "2011ab00",
      "text": "Ho ho! Genelde dilsiz hayvanlara gülmem! Kocam hariç tabii. Ha!"
    },
    {
      "id": "777414f4",
      "bank_id": "2011ab00",
      "text": "*kıkırdar* Hav!"
    },
    {
      "id": "7c741c95",
      "bank_id": "2011ab00",
      "text": "*kıkırdar* Ne kadar da mutlu bir köpeksin sen öyle!"
    },
    {
      "id": "7e566f81",
      "bank_id": "2011ab00",
      "text": "Başkalarının eşyalarını öylece kıramazsın!"
    },
    {
      "id": "8949511e",
      "bank_id": "2011ab00",
      "text": "Yaramaz köpek! Neden öyle yapıyorsun?"
    },
    {
      "id": "89568130",
      "bank_id": "2011ab00",
      "text": "Vandallık yapıyorsun, bilesin."
    },
    {
      "id": "8c1fbd70",
      "bank_id": "2011ab00",
      "text": "Aman! Başımıza bir köpek belası musallat oldu!"
    },
    {
      "id": "8c1fbd71",
      "bank_id": "2011ab00",
      "text": "Seni aşağılık it!"
    },
    {
      "id": "8c1fbd72",
      "bank_id": "2011ab00",
      "text": "Kokuşmuş hayvan!"
    },
    {
      "id": "8c1fbd73",
      "bank_id": "2011ab00",
      "text": "Bağırsaklarını deşmem lazım senin seni tüylü it!"
    },
    {
      "id": "8c1fbd74",
      "bank_id": "2011ab00",
      "text": "Pis hayvan!"
    },
    {
      "id": "8c1fbd75",
      "bank_id": "2011ab00",
      "text": "Uzak dur benden seni uyuz köpek!"
    },
    {
      "id": "8c1fbd77",
      "bank_id": "2011ab00",
      "text": "Pis küçük kırma seni."
    },
    {
      "id": "92495f6b",
      "bank_id": "2011ab00",
      "text": "Bunu yapmaman gerekiyordu şapşal köpek."
    },
    {
      "id": "931fc878",
      "bank_id": "2011ab00",
      "text": "Ah seni küçük afacan!"
    },
    {
      "id": "931fc879",
      "bank_id": "2011ab00",
      "text": "Ne canavar ama!"
    },
    {
      "id": "931fc87a",
      "bank_id": "2011ab00",
      "text": "Hemen şimdi kes şunu seni pis köpek!"
    },
    {
      "id": "931fc87c",
      "bank_id": "2011ab00",
      "text": "Ne tiksinç küçük bir canavar!"
    },
    {
      "id": "931fc87d",
      "bank_id": "2011ab00",
      "text": "Seni uyuz it!"
    },
    {
      "id": "931fc87e",
      "bank_id": "2011ab00",
      "text": "Seni küçük pislik!"
    },
    {
      "id": "931fc87f",
      "bank_id": "2011ab00",
      "text": "Seni pasaklı it."
    },
    {
      "id": "960155b8",
      "bank_id": "2011ab00",
      "text": "*hıçkırır* Böyle yapmasından hiç hoşlanmıyorum!"
    },
    {
      "id": "9b015d59",
      "bank_id": "2011ab00",
      "text": "N-neden bana öyle b-bakıyorsun kuçu kuçu?"
    },
    {
      "id": "ac6e5830",
      "bank_id": "2011ab00",
      "text": "Hi hi! Soytarı köpeği misin sen?"
    },
    {
      "id": "ac6e5831",
      "bank_id": "2011ab00",
      "text": "Hakikaten eğlenceli bir yaratık."
    },
    {
      "id": "ac6e5832",
      "bank_id": "2011ab00",
      "text": "Ha! Bu köpek çok sevimli sahiden."
    },
    {
      "id": "ac6e5833",
      "bank_id": "2011ab00",
      "text": "Şu kırma tam bir komedyen."
    },
    {
      "id": "ac6e5834",
      "bank_id": "2011ab00",
      "text": "Hi hi! Hayvanların bu kadar eğlenceli olabileceğini hiç bilmezdim!"
    },
    {
      "id": "ac6e5835",
      "bank_id": "2011ab00",
      "text": "Ha ha, şu köpeğe bakın!"
    },
    {
      "id": "ac6e5837",
      "bank_id": "2011ab00",
      "text": "Ha ha ha! Komik köpek."
    },
    {
      "id": "b36e6338",
      "bank_id": "2011ab00",
      "text": "Bu komik numaraları nereden öğrendin?"
    },
    {
      "id": "b36e6339",
      "bank_id": "2011ab00",
      "text": "*kıkırdar* Ne kadar da mutlu bir köpeksin sen öyle!"
    },
    {
      "id": "b36e633a",
      "bank_id": "2011ab00",
      "text": "Ha! İşte bu komik bir hayvan."
    },
    {
      "id": "b36e633c",
      "bank_id": "2011ab00",
      "text": "Hi hi! Köpek mizahı bir numara."
    },
    {
      "id": "b36e633d",
      "bank_id": "2011ab00",
      "text": "Ho ho! Ne oyuncu bir yaratık."
    },
    {
      "id": "b36e633e",
      "bank_id": "2011ab00",
      "text": "Ha ha! Pire torbalarının bu kadar eğlenceli olabileceğini kim bilebilirdi ki?"
    },
    {
      "id": "b36e633f",
      "bank_id": "2011ab00",
      "text": "Ha ha, komiksin doğrusu seni it."
    },
    {
      "id": "b8384360",
      "bank_id": "2011ab00",
      "text": "Mülküme ne yapıyorsun öyle?!"
    },
    {
      "id": "b8384361",
      "bank_id": "2011ab00",
      "text": "Eşyalarımı tahrip ediyorsun!"
    },
    {
      "id": "b8384362",
      "bank_id": "2011ab00",
      "text": "Kendi eşyalarını kır!"
    },
    {
      "id": "b8384363",
      "bank_id": "2011ab00",
      "text": "Eşyalarımı mahvediyorsun!"
    },
    {
      "id": "be525770",
      "bank_id": "2011ab00",
      "text": "Başkasının mülküne zarar veriyorsun!"
    },
    {
      "id": "be525771",
      "bank_id": "2011ab00",
      "text": "Onu kırarak ne yapıyorsun sen?"
    },
    {
      "id": "be525773",
      "bank_id": "2011ab00",
      "text": "Hey! Eşyaları yok etmeyi kesin!"
    },
    {
      "id": "be525774",
      "bank_id": "2011ab00",
      "text": "O zarar verebileceğin bir mülkün değil!"
    },
    {
      "id": "be525775",
      "bank_id": "2011ab00",
      "text": "Aman Tanrım, ne büyük bir vandallık!"
    },
    {
      "id": "be525776",
      "bank_id": "2011ab00",
      "text": "Bırak şunu seni vandal!"
    },
    {
      "id": "be525777",
      "bank_id": "2011ab00",
      "text": "Eşyaları parçalamayı seviyorsun ha? Holigan!"
    },
    {
      "id": "c5526270",
      "bank_id": "2011ab00",
      "text": "Bakın ahali! Mala zarar veren bir kaba saba!"
    },
    {
      "id": "c5526271",
      "bank_id": "2011ab00",
      "text": "Başkalarının mülkünü yağmalıyorsun!"
    },
    {
      "id": "c5526272",
      "bank_id": "2011ab00",
      "text": "Hey sen! Vandal!"
    },
    {
      "id": "c5526273",
      "bank_id": "2011ab00",
      "text": "Başkalarının eşyalarını kırmayı seviyorsun demek, he?"
    },
    {
      "id": "c5526274",
      "bank_id": "2011ab00",
      "text": "Hey, onun bir sahibi var!"
    },
    {
      "id": "c5526275",
      "bank_id": "2011ab00",
      "text": "O senin kıracağın bir şey değil!"
    },
    {
      "id": "c5526276",
      "bank_id": "2011ab00",
      "text": "Hey sen. Ortalığı kırmayı kes!"
    },
    {
      "id": "d2345e48",
      "bank_id": "2011ab00",
      "text": "Ha ha! Ne şapşal bir hayvan!"
    },
    {
      "id": "d2345e4a",
      "bank_id": "2011ab00",
      "text": "Ha ha! Ne akıllı köpek ama!"
    },
    {
      "id": "d2345e4b",
      "bank_id": "2011ab00",
      "text": "Ho ho! Sirke katılmalısın sen!"
    },
    {
      "id": "d2345e4c",
      "bank_id": "2011ab00",
      "text": "İt tam bir komedyen!"
    },
    {
      "id": "d2345e4d",
      "bank_id": "2011ab00",
      "text": "Ha! Tam bir soytarı köpeğisin sen."
    },
    {
      "id": "d2345e4e",
      "bank_id": "2011ab00",
      "text": "Ha! Köpek türünün bu kadar eğlenceli olabileceği aklımın ucundan geçmezdi!"
    },
    {
      "id": "d2345e4f",
      "bank_id": "2011ab00",
      "text": "Ah, paha biçilemez!"
    },
    {
      "id": "d7346669",
      "bank_id": "2011ab00",
      "text": "Ha ha! Komik köpek!"
    },
    {
      "id": "d734666a",
      "bank_id": "2011ab00",
      "text": "Hi hi! Ne şapşal bir köpek!"
    },
    {
      "id": "d734666b",
      "bank_id": "2011ab00",
      "text": "Ha, bir çeşit gösteri köpeği bu!"
    },
    {
      "id": "d734666c",
      "bank_id": "2011ab00",
      "text": "Ha! Seni sersem it!"
    },
    {
      "id": "d734666d",
      "bank_id": "2011ab00",
      "text": "Ho ho, koca bir yufka yüreklisin sen, değil mi?"
    },
    {
      "id": "d734666e",
      "bank_id": "2011ab00",
      "text": "A, şu ufaklığa bakın, ne kadar da eğlenceli!"
    },
    {
      "id": "d734666f",
      "bank_id": "2011ab00",
      "text": "Ha ha! Ne kadar hoş! Köpeğin ne yaptığını gördün mü?"
    },
    {
      "id": "e751c20b",
      "bank_id": "2011ab00",
      "text": "Ho ho! Ne oyuncu bir yaratık."
    },
    {
      "id": "e9b9ee01",
      "bank_id": "2011ab00",
      "text": "Bana dik dik bakıyor! Gözlerine baksanıza!"
    },
    {
      "id": "e9b9ee02",
      "bank_id": "2011ab00",
      "text": "En karanlık uçurumdan çıkma bir av köpeği bu!"
    },
    {
      "id": "e9b9ee03",
      "bank_id": "2011ab00",
      "text": "Cici köpek... Güzel köpek."
    },
    {
      "id": "e9b9ee04",
      "bank_id": "2011ab00",
      "text": "Şimdi o pis dişlerini bana geçirmeye kalkma sakın."
    },
    {
      "id": "e9b9ee05",
      "bank_id": "2011ab00",
      "text": "Bir katilin soğuk ve donuk gözlerine sahip bu. Baksanıza şuna."
    },
    {
      "id": "f4b9ffb0",
      "bank_id": "2011ab00",
      "text": "K-k-koşmamalıyım... sadece peşimden gelmesine yol açar..."
    },
    {
      "id": "f4b9ffb2",
      "bank_id": "2011ab00",
      "text": "Tamam tamam. Beni ısırmana hiç gerek yok..."
    },
    {
      "id": "f4b9ffb3",
      "bank_id": "2011ab00",
      "text": "U-uslu oğlum."
    },
    {
      "id": "f4b9ffb4",
      "bank_id": "2011ab00",
      "text": "Beni ısırmayacaksın değil mi?"
    },
    {
      "id": "f4b9ffb5",
      "bank_id": "2011ab00",
      "text": "Cici köpek. Ciiici köpek."
    },
    {
      "id": "f6c650fe",
      "bank_id": "2011ab00",
      "text": "Öğk! İğrenç bir şey bu!"
    },
    {
      "id": "f7231a49",
      "bank_id": "2011ab00",
      "text": "Kes şunu seni vandal!"
    },
    {
      "id": "f7231a4a",
      "bank_id": "2011ab00",
      "text": "Dur seni vandal!"
    },
    {
      "id": "f91a9c78",
      "bank_id": "2011ab00",
      "text": "Şimdi bana saldırmana hiç lüzum yok."
    },
    {
      "id": "f91a9c79",
      "bank_id": "2011ab00",
      "text": "Sakin ol kuçu kuçu, aferin sana."
    },
    {
      "id": "f91a9c7a",
      "bank_id": "2011ab00",
      "text": "A, şey, cici köpek. Çok cici köpek..."
    },
    {
      "id": "f91a9c7b",
      "bank_id": "2011ab00",
      "text": "Uslu bir çocuk ol şimdi... aferin, evet."
    },
    {
      "id": "f91a9c7d",
      "bank_id": "2011ab00",
      "text": "Ah, cici köpek, evet..."
    },
    {
      "id": "f91a9c7e",
      "bank_id": "2011ab00",
      "text": "Şimdi heyecanlanmaya hiç gerek yok. Ha *yutkunur*"
    },
    {
      "id": "f91a9c7f",
      "bank_id": "2011ab00",
      "text": "Kızma oğlum."
    },
    {
      "id": "ffc65ecb",
      "bank_id": "2011ab00",
      "text": "Neden yaptın bunu?? Yaramaz köpek!"
    }
  ]
}