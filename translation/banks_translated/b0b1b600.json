    {
      "id": "cc19b93d",
      "bank_id": "b0b1b600",
      "text": "Efsanevi statüsüne ulaştın."
    },
    {
      "id": "d319d343",
      "bank_id": "b0b1b600",
      "text": "Kahraman, Brightwood'daki kulesinde Garth ile buluşacaktı."
