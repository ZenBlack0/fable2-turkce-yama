    {
      "id": "c919b464",
      "bank_id": "b0b1b600",
      "text": "Ünlü statüsüne ulaştın."
    },
    {
      "id": "c99a2353",
      "bank_id": "b0b1b600",
      "text": "Daha yüksek bir dövüş çarpanı, daha fazla deneyim demektir. Bakalım ne kadar yükseltebileceksin."
    },
    {
      "id": "ca19b5d7",
      "bank_id": "b0b1b600",
      "text": "Şanlı statüsüne ulaştın."
    },
    {
      "id": "cb19b74a",
      "bank_id": "b0b1b600",
      "text": "Önder statüsüne ulaştın."
    },
    {
      "id": "cb9a26b9",
      "bank_id": "b0b1b600",
      "text": "Dövüş çarpanını daha da yükseltmeye çalış."
