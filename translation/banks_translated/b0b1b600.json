    {
      "id": "c2e8ca33",
      "bank_id": "b0b1b600",
      "text": "Merhaba çocuklar."
    },
    {
      "id": "c2f07742",
      "bank_id": "b0b1b600",
      "text": "Pekala, hikâyeye daha sonra devam edeceğiz."
    },
    {
      "id": "c31a88d4",
      "bank_id": "b0b1b600",
      "text": "Kahraman, Bower Gölü'nün altındaki mezarda kendisini büyük bir gücün beklediğini biliyordu."
    },
    {
      "id": "c31a88df",
      "bank_id": "b0b1b600",
      "text": "Kahraman, Bower Gölü'nün altındaki mezarda kendisini büyük bir gücün beklediğini biliyordu."
    },
    {
      "id": "c3e8cba6",
      "bank_id": "b0b1b600",
      "text": "Merhaba, müzik kutusunu almaya geldik."
