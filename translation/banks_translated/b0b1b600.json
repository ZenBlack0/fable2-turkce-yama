    {
      "id": "e66f9ca1",
      "bank_id": "b0b1b600",
      "text": "Merhaba genç hanımlar."
    },
    {
      "id": "e66f9caa",
      "bank_id": "b0b1b600",
      "text": "Merhaba genç efendiler."
    },
    {
      "id": "e6e66b0f",
      "bank_id": "b0b1b600",
      "text": "Çoğunlukla tarihi. Lord Lucien her türlü antikaya pek meraklıdır ama esasen Eski Krallık ile ilgili şeylerle ilgilenir."
