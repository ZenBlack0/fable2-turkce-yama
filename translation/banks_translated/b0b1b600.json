    {
      "id": "c819b2f1",
      "bank_id": "b0b1b600",
      "text": "Meşhur statüsüne ulaştın."
    },
    {
      "id": "c88f0129",
      "bank_id": "b0b1b600",
      "text": "Kahramanın, Lucien'in Garth'ı tuttuğu Kule'ye giden bir yol bulması gerekiyordu."
