  "strings": [
    {
      "id": "05d4ff67",
      "bank_id": "d0bdb600",
      "text": "Bloodstone Meyve ve Sebze Tezgâhı"
    },
    {
      "id": "060e86a9",
      "bank_id": "d0bdb600",
      "text": "Çingeneler dövmeciliği bir sanat mertebesine yükselttiler. Vücudu süslemek için buradan daha iyi çok az yer vardır."
    },
    {
      "id": "0ac4db5a",
      "bank_id": "d0bdb600",
      "text": "Bu ev kendine göre sevimli. Sevimlilik ise Bloodstone'da nadir bulunur."
    },
    {
      "id": "0bf9e041",
      "bank_id": "d0bdb600",
      "text": "Bu karavan yeni amortisörlerden ve belki bir rüzgârlıktan fayda görebilir."
    },
    {
      "id": "0bfa3add",
      "bank_id": "d0bdb600",
      "text": "Yüzlerce yıldır sıradan eşyaların tedarikçisi."
    },
    {
      "id": "0c75001a",
      "bank_id": "d0bdb600",
