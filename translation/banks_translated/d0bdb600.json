    {
      "id": "384b1e34",
      "bank_id": "d0bdb600",
      "text": "Bower Gölü sakinlerine uzun süredir kök söktüren bir haydut olan namlı Sabırsız Thag'ın evi. Söylenenlere göre annesi onu hiç sevmemiş."
    },
    {
      "id": "3b04e7f4",
      "bank_id": "d0bdb600",
      "text": "Taştan Kan"
    },
    {
      "id": "3c437424",
      "bank_id": "d0bdb600",
      "text": "Burada her türlü silah dövülür ve satılır."
    },
    {
      "id": "3e4da7bc",
      "bank_id": "d0bdb600",
      "text": "Albion'un dört bir yanından toplanan eşyalar burada bulunabilir."
