      "text": "Pazar Meydanı No: 3, Bowerstone Pazarı"
    },
    {
      "id": "b36ebd62",
      "bank_id": "d0bdb600",
      "text": "Bower Gölü"
    },
    {
      "id": "b7521f09",
      "bank_id": "d0bdb600",
      "text": "Brightwood Kulesi Bahçesi"
    },
    {
      "id": "b808d107",
      "bank_id": "d0bdb600",
      "text": "Çingene Karavanı"
    },
    {
      "id": "b84ffcf8",
      "bank_id": "d0bdb600",
      "text": "Bloodstone'da alabileceğiniz gerçekten taze olan tek ürün."
