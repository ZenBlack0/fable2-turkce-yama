    {
      "id": "2fe771a8",
      "bank_id": "0010ab00",
      "text": "Doğrusunu söylemek gerekirse küçük dilimi yuttum!"
    },
    {
      "id": "2fe771a9",
      "bank_id": "0010ab00",
      "text": "Körleşmiş duyularımın bugüne kadar şahit olduğu en muhteşem şey bu!"
    },
    {
      "id": "2fe771aa",
      "bank_id": "0010ab00",
      "text": "Hazine! Safi hazine valla!"
