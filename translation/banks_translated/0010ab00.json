    {
      "id": "3d80f03a",
      "bank_id": "0010ab00",
      "text": "Ooff, bu tek kelimeyle korkunç."
    },
    {
      "id": "3d80f03b",
      "bank_id": "0010ab00",
      "text": "Evde kalmam gerektiğini biliyordum!"
    },
    {
      "id": "3d80f03c",
      "bank_id": "0010ab00",
      "text": "Bu gün gittikçe daha da kötüleşiyor."
    },
    {
      "id": "3d80f03d",
      "bank_id": "0010ab00",
      "text": "Dur! Korktuğumu görmüyor musun?"
    },
    {
      "id": "3d80f03e",
      "bank_id": "0010ab00",
      "text": "Dünya neden beni korkutmak için birlik olmuş gibi."
    },
    {
      "id": "3d80f03f",
      "bank_id": "0010ab00",
      "text": "Aman tanrım. Olamaz. Vah vah."
    },
    {
      "id": "3d9686c0",
      "bank_id": "0010ab00",
      "text": "Demek ünlüler bile berbat olabiliyormuş."
    },
    {
      "id": "3d9686c1",
      "bank_id": "0010ab00",
      "text": "Aptal şöhretin senin olsun."
    },
    {
      "id": "3d9686c3",
      "bank_id": "0010ab00",
      "text": "Bir başka iğrenç ünlü maceracı daha."
    },
    {
      "id": "3d9686c4",
      "bank_id": "0010ab00",
      "text": "Senin gibi birinin ünlü olabildiği bu dünya nereye gidiyor böyle?"
    },
    {
      "id": "3d9686c5",
      "bank_id": "0010ab00",
      "text": "Eskiden ünlü olmanın bir anlamı vardı. Hareketlerine bakılırsa artık bu doğru değil."
    },
    {
      "id": "3d9686c6",
      "bank_id": "0010ab00",
      "text": "Bu kadar ünlü biri için pek de iyi sayılmaz."
    },
    {
      "id": "3d9686c7",
      "bank_id": "0010ab00",
      "text": "İstediğin kadar meşhur ol, yaptığın yine de rezaletti."
    },
    {
      "id": "4280f7d9",
      "bank_id": "0010ab00",
      "text": "Ah, hepsi çok korkunç."
    },
    {
      "id": "4280f7da",
      "bank_id": "0010ab00",
      "text": "Hayır! Lütfen! Dur artık!"
    },
    {
      "id": "4280f7db",
      "bank_id": "0010ab00",
      "text": "Bütün bunlar ne zaman bitecek?"
    },
    {
      "id": "4280f7dc",
      "bank_id": "0010ab00",
      "text": "Zaten yeterince korktum."
    },
    {
      "id": "4280f7dd",
      "bank_id": "0010ab00",
      "text": "Buna daha fazla dayanamayacağım."
    },
    {
      "id": "4280f7de",
      "bank_id": "0010ab00",
      "text": "Bundan sonra kendimi bir dolaba kilitleyeceğim."
    },
    {
      "id": "4280f7df",
      "bank_id": "0010ab00",
      "text": "Bu zavallı kalbimin kaldırabileceğinden çok daha fazlası."
    },
    {
      "id": "449691c0",
      "bank_id": "0010ab00",
      "text": "Namını böyle mi kazandın yani?"
    },
    {
      "id": "449691c1",
      "bank_id": "0010ab00",
      "text": "Görünüşe göre haksız yere ünlenmişsin."
    },
    {
      "id": "449691c2",
      "bank_id": "0010ab00",
      "text": "Bize pislik izleten bir başka lanet olası ünlü daha."
    },
    {
      "id": "449691c3",
      "bank_id": "0010ab00",
      "text": "Bu lanet ünlüler her türlü saçmalığı yapabileceklerini sanıyor."
    },
    {
      "id": "449691c4",
      "bank_id": "0010ab00",
      "text": "Nasıl oluyor da herkes senden bahsederken beş para etmez olduğunu söylemiyor?"
    },
    {
      "id": "449691c5",
      "bank_id": "0010ab00",
      "text": "Ne kadar ünlü olduğun umurumda değil. Bu berbattı."
    },
    {
      "id": "449691c6",
      "bank_id": "0010ab00",
      "text": "Bir de ozanlar senin için şarkılar yazıyor öyle mi? Peh."
    },
    {
      "id": "477e0d30",
      "bank_id": "0010ab00",
      "text": "Şatona geri dön seni \"ünlü\" maceracı."
    },
    {
      "id": "477e0d32",
      "bank_id": "0010ab00",
      "text": "Şu ünlülerden çektiğimiz nedir bizim."
    },
    {
      "id": "477e0d33",
      "bank_id": "0010ab00",
      "text": "Peh! Ünlü insanlarmış!"
    },
    {
      "id": "477e0d34",
      "bank_id": "0010ab00",
      "text": "Kokuşmuş şöhretin senin olsun."
    },
    {
      "id": "477e0d35",
      "bank_id": "0010ab00",
      "text": "Bütün bu ünlü aptalları bir yere kilitlemeliyiz."
    },
    {
      "id": "48422600",
      "bank_id": "0010ab00",
      "text": "Dahdahdah."
    },
    {
      "id": "48422602",
      "bank_id": "0010ab00",
      "text": "Ah, beş para etmez."
    },
    {
      "id": "48422603",
      "bank_id": "0010ab00",
      "text": "Sıkıcı, sıkıcı, sıkıcı!"
    },
    {
      "id": "48422604",
      "bank_id": "0010ab00",
      "text": "Horrr!"
    },
    {
      "id": "48422605",
      "bank_id": "0010ab00",
      "text": "Pöh!"
    },
    {
      "id": "48422606",
      "bank_id": "0010ab00",
      "text": "Esniyorum!"
    },
    {
      "id": "48422607",
      "bank_id": "0010ab00",
      "text": "Uyku getirici!"
    },
    {
      "id": "495aaca0",
      "bank_id": "0010ab00",
      "text": "Ünlü insanlarla tanışmanın sorunu da bu işte. Berbatlar."
    },
    {
      "id": "495aaca1",
      "bank_id": "0010ab00",
      "text": "Peh! Senden harika bir şeyler bekliyordum."
    },
    {
      "id": "495aaca4",
      "bank_id": "0010ab00",
      "text": "Ünlü mü? Kötü şöhretli desen daha doğru."
    },
    {
      "id": "495aaca6",
      "bank_id": "0010ab00",
      "text": "Ulu bildiklerimiz bizi nasıl da hayal kırıklığına uğratıyor."
    },
    {
      "id": "495aaca7",
      "bank_id": "0010ab00",
      "text": "Siz ünlüler canınızın istediği her şeyi yapabileceğinizi sanıyorsunuz!"
    },
    {
      "id": "4be55f5e",
      "bank_id": "0010ab00",
      "text": "Dur. Sadece dur."
    },
    {
      "id": "4e5ab440",
      "bank_id": "0010ab00",
      "text": "Senden daha ünlü olmam gerekirdi."
    },
    {
      "id": "4e5ab441",
      "bank_id": "0010ab00",
      "text": "Bugünlerde önüne gelene ünlü diyorlar zaten."
    },
    {
      "id": "4e5ab445",
      "bank_id": "0010ab00",
      "text": "Görünüşe göre bu devirde herkes üne kavuşabiliyor."
    },
    {
      "id": "4e5ab446",
      "bank_id": "0010ab00",
      "text": "Böyle ünlü olmuş olamazsın!"
    },
    {
      "id": "4e5ab447",
      "bank_id": "0010ab00",
      "text": "Herkesin senden bahsettiğine inanamıyorum. Abartılacak neyin var ki?"
    },
    {
      "id": "5e055570",
      "bank_id": "0010ab00",
      "text": "Bunu nasıl yapabildin? Seni canavar."
    },
    {
      "id": "5e055572",
      "bank_id": "0010ab00",
      "text": "Bu resmen düpedüz kötülük."
    },
    {
      "id": "5e055573",
      "bank_id": "0010ab00",
      "text": "Hayatımda daha kötü niyetli hareketler gördüğümü sanmıyorum."
    },
    {
      "id": "5e055574",
      "bank_id": "0010ab00",
      "text": "Seni içeri tıkıp anahtarı da çöpe atmalılar."
    },
    {
      "id": "5e055575",
      "bank_id": "0010ab00",
      "text": "Bayağı canavar bir şeysin sen öyle değil mi."
    },
    {
      "id": "5e055576",
      "bank_id": "0010ab00",
      "text": "Sen bir alçak ve lanet olası bir mahluksun."
    },
    {
      "id": "5e055577",
      "bank_id": "0010ab00",
      "text": "Böylesi menfur hareketlerin bizim ömrümüzde yaşanması..."
    },
    {
      "id": "95dc6797",
      "bank_id": "0010ab00",
      "text": "Hayır hayır hayır! Herkesin seni duymuş olmasının sebebi bu olamaz..."
    },
    {
      "id": "9cdc729a",
      "bank_id": "0010ab00",
      "text": "Peh! Ünlü insanlar da geri kalanlar kadar beş para etmez işte!"
    },
    {
      "id": "aac01418",
      "bank_id": "0010ab00",
      "text": "Senden hiç haz etmedim. Duydun mu?!"
    },
    {
      "id": "aac0141a",
      "bank_id": "0010ab00",
      "text": "Ne? Yıkıl karşımdan!"
    },
    {
      "id": "aac0141b",
      "bank_id": "0010ab00",
      "text": "Dünyada boş yere yer kaplıyorsun!"
    },
    {
      "id": "aac0141c",
      "bank_id": "0010ab00",
      "text": "Ciğerine bir yumruk ister misin ha?!"
    },
    {
      "id": "aac0141d",
      "bank_id": "0010ab00",
      "text": "Defol git buradan!"
    },
    {
      "id": "aac0141e",
      "bank_id": "0010ab00",
      "text": "Peh! Sakın öyle bir şey yapma!"
    },
    {
      "id": "aac0141f",
      "bank_id": "0010ab00",
      "text": "Sana bir şey söyleyeyim mi. İğrençsin!"
    },
    {
      "id": "ae94b2d1",
      "bank_id": "0010ab00",
      "text": "Evet, harikasın sen harika! Ha ha!"
    },
    {
      "id": "ae94b2d2",
      "bank_id": "0010ab00",
      "text": "Senden daha iyisi yok, vallahi yok, billahi yok!"
    },
    {
      "id": "ae94b2d3",
      "bank_id": "0010ab00",
      "text": "Oley be! Mükemmel numara! Süper ötesi!"
    },
    {
      "id": "ae94b2d4",
      "bank_id": "0010ab00",
      "text": "Ah, tatlılığın ta kendisi, evet, heh heh..."
    },
    {
      "id": "ae94b2d5",
      "bank_id": "0010ab00",
      "text": "Hey! Dostum benim! Harika şeyler bunlar!"
    },
    {
      "id": "afc01c39",
      "bank_id": "0010ab00",
      "text": "Ne?! Bir derdin mi var?!"
    },
    {
      "id": "afc01c3a",
      "bank_id": "0010ab00",
      "text": "Gah! Utanmalısın kendinden. Utanmalısın!"
    },
    {
      "id": "afc01c3b",
      "bank_id": "0010ab00",
      "text": "Sen. Midemi. Bulandırıyorsun. Tamam mı?"
    },
    {
      "id": "afc01c3c",
      "bank_id": "0010ab00",
      "text": "Peh! Vah bah rah gah dah!"
    },
    {
      "id": "afc01c3d",
      "bank_id": "0010ab00",
      "text": "Git de kafanı kapıya vur gah rah!"
    },
    {
      "id": "afc01c3e",
      "bank_id": "0010ab00",
      "text": "Kaval kemiğine bir tekme basmalıyım senin. Evet aynen öyle! Hah!"
    },
    {
      "id": "b05f8728",
      "bank_id": "0010ab00",
      "text": "Bunun için ciğerine bir tekme basmalıyım seni hobbe yalakası."
    },
    {
      "id": "b05f8729",
      "bank_id": "0010ab00",
      "text": "Gel buraya da burnuna çatal sokayım!"
    },
    {
      "id": "b05f872d",
      "bank_id": "0010ab00",
      "text": "Ayakkabımı çıkarıp kafana fırlatmam lazım!"
    },
    {
      "id": "b05f872e",
      "bank_id": "0010ab00",
      "text": "Sana gününü gösterirdim! Önümü düzgün görebilseydim eğer! Evet yapardım!"
    },
    {
      "id": "b05f872f",
      "bank_id": "0010ab00",
      "text": "Bunu bir daha yaparsan gözlerimi oyarım. Duydun mu beni?"
    },
    {
      "id": "b67aeb28",
      "bank_id": "0010ab00",
      "text": "Bu sadece, sadece, yani bilmiyorum işte! Rezillik!"
    },
    {
      "id": "b67aeb29",
      "bank_id": "0010ab00",
      "text": "Demek öyle ha?! Suratına bir çuval kurbağa ve bit yağsın da gör!"
    },
    {
      "id": "b67aeb2a",
      "bank_id": "0010ab00",
      "text": "Kusmamı falan mı istiyorsun ne, ha?"
    },
    {
      "id": "b67aeb2b",
      "bank_id": "0010ab00",
      "text": "Neeee? Öğğk!"
    },
    {
      "id": "b67aeb2c",
      "bank_id": "0010ab00",
      "text": "Bunun komik olduğunu sanıyorsun değil mi? Peh!"
    },
    {
      "id": "b67aeb2d",
      "bank_id": "0010ab00",
      "text": "Bu tek kelimeyle... İğrenç! Ahh, sanırım midem bulanıyor."
    },
    {
      "id": "b67aeb2e",
      "bank_id": "0010ab00",
      "text": "Öğk! Midemi bulandırıyorsun!"
    },
    {
      "id": "b994c400",
      "bank_id": "0010ab00",
      "text": "Seni şeri, krema ve altın kaplı çikolatadan bile çok seviyorum!"
    },
    {
      "id": "b994c402",
      "bank_id": "0010ab00",
      "text": "Çok çok çok iyisin. Gerçekten, yani en iyisi!"
    },
    {
      "id": "b994c403",
      "bank_id": "0010ab00",
      "text": "Sana resmen bayılıyorum. Seviyorum işte. Seviyorum."
