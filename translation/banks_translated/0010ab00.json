      "text": "Peh! Ünlü insanlarmış!"
    },
    {
      "id": "3c7dfb83",
      "bank_id": "0010ab00",
      "text": "Bir başka beş para etmez ünlü daha."
    },
    {
      "id": "3c7dfb84",
      "bank_id": "0010ab00",
      "text": "Ünlü mü? Dünyada fazlalık desen daha doğru."
    },
    {
      "id": "3c7dfb85",
      "bank_id": "0010ab00",
      "text": "Peh! Şöhret beş para etmez."
