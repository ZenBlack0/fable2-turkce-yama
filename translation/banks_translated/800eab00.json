{
  "bank_id": "800eab00",
  "total_strings": 222,
  "strings": [
    {
      "id": "004ddd3b",
      "bank_id": "800eab00",
      "text": "Piyuv! Piyuv! Nasıl ama? He?"
    },
    {
      "id": "03efc0df",
      "bank_id": "800eab00",
      "text": "Bak, Aşağılık Yalnızlık Çizmeleri'ni buldum! Ne işe yarıyorlar?"
    },
    {
      "id": "0400b5aa",
      "bank_id": "800eab00",
      "text": "<blows raspberry>"
    },
    {
      "id": "0550aef6",
      "bank_id": "800eab00",
      "text": "Grrr!"
    },
    {
      "id": "0577d6ed",
      "bank_id": "800eab00",
      "text": "Gla gla gla!"
    },
    {
      "id": "060fb5ca",
      "bank_id": "800eab00",
      "text": "Silahlardan nefret ediyorum. Ben büyü yapmak istiyorum!"
    },
    {
      "id": "0730c29b",
      "bank_id": "800eab00",
      "text": "Ooo, teşekkürler!"
    },
    {
      "id": "0a5da122",
      "bank_id": "800eab00",
      "text": "<roars>"
    },
    {
      "id": "0cbdc7f8",
      "bank_id": "800eab00",
      "text": "Kayıp timsah halkının hazinesini buldum!"
    },
    {
      "id": "0ce50fe2",
      "bank_id": "800eab00",
      "text": "<shooting sounds>"
    },
    {
      "id": "0d0fd1f3",
      "bank_id": "800eab00",
      "text": "Bütün canavarları öldürdüm ve bir sürü altın kazandım!"
    },
    {
      "id": "0d7446d8",
      "bank_id": "800eab00",
      "text": "Ben tatlı mı tatlı, küçücük bi oğlanım."
    },
    {
      "id": "10098aad",
      "bank_id": "800eab00",
      "text": "Eşinizin vefatının ardından, bir çocuk esirgeme kurumu çocuğunuzun velayetini üstlendi."
    },
    {
      "id": "1077e81c",
      "bank_id": "800eab00",
      "text": "Gla gla gla!"
    },
    {
      "id": "110c2e5e",
      "bank_id": "800eab00",
      "text": "Senin gibi büyük kahramanların imzalarını topluyorum. Bir imzanı alabilir miyim?"
    },
    {
      "id": "11bdcf99",
      "bank_id": "800eab00",
      "text": "Dünyayı sonsuza dek mutlu ve huzurlu kılan altın lavtayı buldum!"
    },
    {
      "id": "123074b1",
      "bank_id": "800eab00",
      "text": "Bu sadece bir iş bulana kadar. Valla bak."
    },
    {
      "id": "12744ef9",
      "bank_id": "800eab00",
      "text": "Ben tatlı mı tatlı, küçücük bi pwenşesim."
    },
    {
      "id": "135daf0f",
      "bank_id": "800eab00",
      "text": "<roars>"
    },
    {
      "id": "140fdcf6",
      "bank_id": "800eab00",
      "text": "Şimdi eve dönüp prensesle evleniyorum!"
    },
    {
      "id": "15d273c3",
      "bank_id": "800eab00",
      "text": "Ben İrade'nin efendisiyim!"
    },
    {
      "id": "15e51dcf",
      "bank_id": "800eab00",
      "text": "<shooting sounds>"
    },
    {
      "id": "19a15774",
      "bank_id": "800eab00",
      "text": "Dinle! <giggles>"
    },
    {
      "id": "1a0c3cab",
      "bank_id": "800eab00",
      "text": "Lütfen bir imza rica edebilir miyim?"
    },
    {
      "id": "1a95004d",
      "bank_id": "800eab00",
      "text": "<blows raspberry>"
    },
    {
      "id": "1baaae5e",
      "bank_id": "800eab00",
      "text": "Babamı bu kadar mutlu görmek hoşuma gidiyor."
    },
    {
      "id": "1bce79d3",
      "bank_id": "800eab00",
      "text": "Kızı kapıyorum ve sonsuza dek mutlu yaşıyoruz!"
    },
    {
      "id": "1cd27ec6",
      "bank_id": "800eab00",
      "text": "Gücümü İrade'den alıyorum."
    },
    {
      "id": "1ea15f15",
      "bank_id": "800eab00",
      "text": "Dinle! <giggles>"
    },
    {
      "id": "22ce84d6",
      "bank_id": "800eab00",
      "text": "Ve bir prensle tanışıyorum, sonsuza dek mutlu yaşıyoruz!"
    },
    {
      "id": "24aabcab",
      "bank_id": "800eab00",
      "text": "Babamın neşesi yerinde, değil mi?"
    },
    {
      "id": "259511fc",
      "bank_id": "800eab00",
      "text": "<blows raspberry>"
    },
    {
      "id": "25f1ed03",
      "bank_id": "800eab00",
      "text": "Nasıl yani, neden sadece on deneyim alıyorum?"
    },
    {
      "id": "26ab9322",
      "bank_id": "800eab00",
      "text": "Seninle annem nasıl tanıştınız?"
    },
    {
      "id": "26baa828",
      "bank_id": "800eab00",
      "text": "Öff! Canım azaldı. Hiç iksirim ya da yiyeceğim var mı?"
    },
    {
      "id": "277648be",
      "bank_id": "800eab00",
      "text": "Ha, babam çok mutlu görünüyor. Kesin bu gece bana uyku masalı okur."
    },
    {
      "id": "27b9a2e3",
      "bank_id": "800eab00",
      "text": "Hepinizi kurbağaya çevirebilirim!"
    },
    {
      "id": "28376742",
      "bank_id": "800eab00",
      "text": "Bu bir dev! O benim!"
    },
    {
      "id": "2bbaafc9",
      "bank_id": "800eab00",
      "text": "Bir can iksiri içiyorum. Tadı kiraz gibi."
    },
    {
      "id": "2cf1f806",
      "bank_id": "800eab00",
      "text": "Harika! On üç deneyim kazandım!"
    },
    {
      "id": "2d219de4",
      "bank_id": "800eab00",
      "text": "Kızlar da dövüşçü olabilir, biliyorsun değil mi."
    },
    {
      "id": "2e950437",
      "bank_id": "800eab00",
      "text": "Annem çok mutsuz. Çok üzücü..."
    },
    {
      "id": "2eb9ade6",
      "bank_id": "800eab00",
      "text": "Ben bir nekromansırım!"
    },
    {
      "id": "2f449913",
      "bank_id": "800eab00",
      "text": "Sanırım babam alışverişe gitmek istiyor."
    },
    {
      "id": "2faba10f",
      "bank_id": "800eab00",
      "text": "Annemle nasıl tanıştın?"
    },
    {
      "id": "3076568b",
      "bank_id": "800eab00",
      "text": "Babamın ne kadar mutlu olduğunu fark ettin mi? Umarım hep böyle kalır."
    },
    {
      "id": "313775af",
      "bank_id": "800eab00",
      "text": "Şu canavar kocaman! Hazır olun!"
    },
    {
      "id": "3221a585",
      "bank_id": "800eab00",
      "text": "Kudretli yakın dövüş yeteneklerimden korkun!"
    },
    {
      "id": "35950f3a",
      "bank_id": "800eab00",
      "text": "Annem pek mutlu görünmüyor."
    },
    {
      "id": "3644a416",
      "bank_id": "800eab00",
      "text": "Babam bu gece bana masal okuyabilir mi?"
    },
    {
      "id": "36565a02",
      "bank_id": "800eab00",
      "text": "Kurşunları ye bakalım! Barut iç!"
    },
    {
      "id": "399c1514",
      "bank_id": "800eab00",
      "text": "Silah konusunda benden iyisi yok!"
    },
    {
      "id": "3be27543",
      "bank_id": "800eab00",
      "text": "Seninle babam nasıl tanıştınız?"
    },
    {
      "id": "3de9f772",
      "bank_id": "800eab00",
      "text": "Annem bu gece bana masal okuyacağını söyledi."
    },
    {
      "id": "3e9c1d35",
      "bank_id": "800eab00",
      "text": "Albion'daki en iyi tüfek nişancısı benim!"
    },
    {
      "id": "3f56686f",
      "bank_id": "800eab00",
      "text": "Bam bam!"
    },
    {
      "id": "40d02717",
      "bank_id": "800eab00",
      "text": "<blows raspberry>"
    },
    {
      "id": "42e28046",
      "bank_id": "800eab00",
      "text": "Babamla nasıl tanıştın?"
    },
    {
      "id": "44525763",
      "bank_id": "800eab00",
      "text": "Hav! Gezintiye çıkmam lazım!"
    },
    {
      "id": "46ea055f",
      "bank_id": "800eab00",
      "text": "Uslu bir kız olursam annem bana yeni bir oyuncak bebek alabileceğini söyledi."
    },
    {
      "id": "47d0321a",
      "bank_id": "800eab00",
      "text": "<blows raspberry>"
    },
    {
      "id": "4916f9e8",
      "bank_id": "800eab00",
      "text": "Raaaaaaarghhhh!"
    },
    {
      "id": "4961ddd7",
      "bank_id": "800eab00",
      "text": "Eşinizin vefatının ardından, bir çocuk esirgeme kurumu çocuklarınızın velayetini üstlendi."
    },
    {
      "id": "4a96d427",
      "bank_id": "800eab00",
      "text": "Seninle annem kavga mı ettiniz? Çok mutsuz görünüyor..."
    },
    {
      "id": "4b526266",
      "bank_id": "800eab00",
      "text": "Mık mık."
    },
    {
      "id": "4e170189",
      "bank_id": "800eab00",
      "text": "Raaaaaaarghhhh!"
    },
    {
      "id": "4e9e2228",
      "bank_id": "800eab00",
      "text": "Bir imzanı çok isterim!"
    },
    {
      "id": "5196df2a",
      "bank_id": "800eab00",
      "text": "Anneme neden bu kadar kaba davranıyorsun? Onu mutsuz görmekten nefret ediyorum..."
    },
    {
      "id": "539e29c9",
      "bank_id": "800eab00",
      "text": "Bir imza alabilseydim ne güzel olurdu."
    },
    {
      "id": "55afcbc4",
      "bank_id": "800eab00",
      "text": "Canavarlarla savaşmak için dev bir balta kullanıyorum!"
    },
    {
      "id": "55b5a003",
      "bank_id": "800eab00",
      "text": "*kıkırdar*"
    },
    {
      "id": "56b5e0a1",
      "bank_id": "800eab00",
      "text": "Ben kılıç ustasıyım!"
    },
    {
      "id": "58b067cd",
      "bank_id": "800eab00",
      "text": "Çok fazla dehşete tanık oldum, bu yüzden emekli olup dağlarda yaşıyorum."
    },
    {
      "id": "5aafd3e5",
      "bank_id": "800eab00",
      "text": "Göğüs göğüse çarpışma eğitimi aldım ben!"
    },
    {
      "id": "5cb5ab06",
      "bank_id": "800eab00",
      "text": "*kıkırdar*"
    },
    {
      "id": "5df0a211",
      "bank_id": "800eab00",
      "text": "Bir haydut! Yakalayın onu!"
    },
    {
      "id": "5eb99287",
      "bank_id": "800eab00",
      "text": "Babam pek mutlu görünmüyor."
    },
    {
      "id": "60000ed7",
      "bank_id": "800eab00",
      "text": "Babam pek mutlu gibi durmuyor."
    },
    {
      "id": "61b5f1d0",
      "bank_id": "800eab00",
      "text": "Kaslarıma bakın! Dünyanın en güçlü adamıyım!"
    },
    {
      "id": "6219b707",
      "bank_id": "800eab00",
      "text": "Aman be! Zaten senden çok daha iyi maceracılar olduğuna eminim."
    },
    {
      "id": "6221edbd",
      "bank_id": "800eab00",
      "text": "Lütfen, hatıra defterimi imzalar mısın?"
    },
    {
      "id": "63b0797c",
      "bank_id": "800eab00",
      "text": "Köylüler tezahürat yapıp beni kraliçe ilan ediyor!"
    },
    {
      "id": "65b99d8a",
      "bank_id": "800eab00",
      "text": "Babam neden bu kadar üzgün?"
    },
    {
      "id": "670019da",
      "bank_id": "800eab00",
      "text": "Babam çok mutsuz. Çok üzücü..."
    },
    {
      "id": "67a8a231",
      "bank_id": "800eab00",
      "text": "Ben bir korucuyum! Oklarımdan korkun!"
    },
    {
      "id": "68f0b340",
      "bank_id": "800eab00",
      "text": "Şu hayduta bir ders verelim!"
    },
    {
      "id": "6919c20a",
      "bank_id": "800eab00",
      "text": "Hayranlarına böyle davranıyorsan kalsın, istemez."
    },
    {
      "id": "692b205a",
      "bank_id": "800eab00",
      "text": "Eşinizin vefatının ardından, bir çocuk esirgeme kurumu kızınızın velayetini üstlendi."
    },
    {
      "id": "696ebb62",
      "bank_id": "800eab00",
      "text": "Hav!"
    },
    {
      "id": "6d21feec",
      "bank_id": "800eab00",
      "text": "Gerçekten çok büyük bir hayranınım. Bana imza verir misin?"
    },
    {
      "id": "6dd1b901",
      "bank_id": "800eab00",
      "text": "Bodoslama dalmayın hemen, bir strateji lazım! Siz erkekler hep aynısınız..."
    },
    {
      "id": "6e886ad1",
      "bank_id": "800eab00",
      "text": "Güm! Bu fena acıtmış olmalı!"
    },
    {
      "id": "6f0492d3",
      "bank_id": "800eab00",
      "text": "Yay kullanmada uzmanım!"
    },
    {
      "id": "707fea98",
      "bank_id": "800eab00",
      "text": "Pppprrrrrrrttt!"
    },
    {
      "id": "70f31f64",
      "bank_id": "800eab00",
      "text": "Hav hav!"
    },
    {
      "id": "71f5e724",
      "bank_id": "800eab00",
      "text": "Uslu bir kız olursam babam beni hobbe avına götüreceğini söyledi."
    },
    {
      "id": "722d7cf2",
      "bank_id": "800eab00",
      "text": "Eşinizin vefatının ardından, bir çocuk esirgeme kurumu oğlunuzun velayetini üstlendi."
    },
    {
      "id": "726ec94f",
      "bank_id": "800eab00",
      "text": "Hav! Hav!"
    },
    {
      "id": "72a8b360",
      "bank_id": "800eab00",
      "text": "Menzilli dövüşün ustasıyım!"
    },
    {
      "id": "757ff2b9",
      "bank_id": "800eab00",
      "text": "Pppprrrrrrrttt!"
    },
    {
      "id": "75f32705",
      "bank_id": "800eab00",
      "text": "Hav hav!"
    },
    {
      "id": "76049dd6",
      "bank_id": "800eab00",
      "text": "Menzilli dövüş kılıçlardan kat kat daha havalı."
    },
    {
      "id": "763f2e81",
      "bank_id": "800eab00",
      "text": "Annemi bu kadar mutlu görmek çok güzel. Hem daha çok şeker yememe de izin veriyor!"
    },
    {
      "id": "76a57af8",
      "bank_id": "800eab00",
      "text": "<roars>"
    },
    {
      "id": "76f5eec5",
      "bank_id": "800eab00",
      "text": "Babam bu hafta beni balığa götüreceğini söyledi."
    },
    {
      "id": "78d1cab0",
      "bank_id": "800eab00",
      "text": "Çifte hasar için zayıf noktasına vurun!"
    },
    {
      "id": "792ab6c1",
      "bank_id": "800eab00",
      "text": "Gökyüzünden gelen yeşil canavarlar dev tabaklara iniyor. Onlarla savaşmalıyız!"
    },
    {
      "id": "79887c00",
      "bank_id": "800eab00",
      "text": "Vurdum onu! Vurdum!"
    },
    {
      "id": "7a43db31",
      "bank_id": "800eab00",
      "text": "Kocanızın vefatının ardından, bir çocuk esirgeme kurumu çocuklarınızın velayetini üstlendi."
    },
    {
      "id": "7ba58299",
      "bank_id": "800eab00",
      "text": "<roars>"
    },
    {
      "id": "7e6b14c1",
      "bank_id": "800eab00",
      "text": "Hey! Senin ölmen gerekiyordu!"
    },
    {
      "id": "7f6762f8",
      "bank_id": "800eab00",
      "text": "Artık imzanı falan istemiyorum."
    },
    {
      "id": "7fcb2c51",
      "bank_id": "800eab00",
      "text": "<blows raspberry>"
    },
    {
      "id": "7fd3d153",
      "bank_id": "800eab00",
      "text": "Dünyayı kurtarmak için tatar yayı kullanıyorum!"
    },
    {
      "id": "813f4030",
      "bank_id": "800eab00",
      "text": "Annemin hep gülümsediğini fark ettin mi? Onu bu kadar mutlu görmek çok güzel."
    },
    {
      "id": "82eb94c3",
      "bank_id": "800eab00",
      "text": "Bütün kötüleri yendim. Hükümdar benim!"
    },
    {
      "id": "83b3e6ce",
      "bank_id": "800eab00",
      "text": "Biri arkadaşlarımı kaçırmış! Onları kurtarmam lazım!"
    },
    {
      "id": "842ac870",
      "bank_id": "800eab00",
      "text": "Yolkesenler kervanımıza saldırdı! Püskürtün şunları!"
    },
    {
      "id": "84676a99",
      "bank_id": "800eab00",
      "text": "Senin o aptal imzanı kim ne yapsın zaten?"
    },
    {
      "id": "86d3dc56",
      "bank_id": "800eab00",
      "text": "Hiç kimse benim gibi tatar yayı atamaz!"
    },
    {
      "id": "896b2670",
      "bank_id": "800eab00",
      "text": "Güm güm! Nifgumar'ın zırhı bile sizi silahımdan koruyamaz!"
    },
    {
      "id": "89c27f81",
      "bank_id": "800eab00",
      "text": "Canavarı tam gözünden vurdum!"
    },
    {
      "id": "89eb9fc6",
      "bank_id": "800eab00",
      "text": "Eve dönüyorum ve en iyisi olduğum için herkes tezahürat yapıyor!"
    },
    {
      "id": "8a3f3e66",
      "bank_id": "800eab00",
      "text": "Ölmüş olamazsın! Olamazsın! Baba!"
    },
    {
      "id": "8acb3d80",
      "bank_id": "800eab00",
      "text": "<blows raspberry>"
    },
    {
      "id": "8cb3f51b",
      "bank_id": "800eab00",
      "text": "Kayıp bir hazinenin haritasını bulduk! Hadi bulalım onu!"
    },
    {
      "id": "8cbfe4a8",
      "bank_id": "800eab00",
      "text": "Meyabaaa."
    },
    {
      "id": "91bfec49",
      "bank_id": "800eab00",
      "text": "Oyuncaklarımla oynamayı seviyorum..."
    },
    {
      "id": "91c414d3",
      "bank_id": "800eab00",
      "text": "Canavarları kesmek için baltamı kullanıyorum!"
    },
    {
      "id": "94c29130",
      "bank_id": "800eab00",
      "text": "Kötü adamın silahını elinden vurup düşürdüm!"
    },
    {
      "id": "95ac697e",
      "bank_id": "800eab00",
      "text": "Lütfen bir imzanı alabilir miyim?"
    },
    {
      "id": "98c41fd6",
      "bank_id": "800eab00",
      "text": "Kötüleri sadece bıçaklarımı kullanarak öldürüyorum!"
    },
    {
      "id": "9be78803",
      "bank_id": "800eab00",
      "text": "Ben Güçlü Kız'ım, bütün erkeklerden daha güçlüyüm!"
    },
    {
      "id": "9dfbddd2",
      "bank_id": "800eab00",
      "text": "Annemin son zamanlarda keyfi çok yerinde."
    },
    {
      "id": "9eac774b",
      "bank_id": "800eab00",
      "text": "Bir imzanı alabilir miyim?"
    },
    {
      "id": "a04ae97e",
      "bank_id": "800eab00",
      "text": "Babamı gülümserken görmek çok güzel."
    },
    {
      "id": "a0c21d68",
      "bank_id": "800eab00",
      "text": "Ga ga ga!"
    },
    {
      "id": "a1f0b381",
      "bank_id": "800eab00",
      "text": "Baba! Baba! Hayııır!"
    },
    {
      "id": "a2e79306",
      "bank_id": "800eab00",
      "text": "Ben kocaman, güçlü bir savaşçıyım!"
    },
    {
      "id": "a2f33d52",
      "bank_id": "800eab00",
      "text": "Ben annemin uslu oğluyum."
    },
    {
      "id": "a5c22509",
      "bank_id": "800eab00",
      "text": "Ga ga ga!"
    },
    {
      "id": "a6fbec3f",
      "bank_id": "800eab00",
      "text": "Annemi gülümserken görmek çok güzel."
    },
    {
      "id": "a8161508",
      "bank_id": "800eab00",
      "text": "Seviye atladım! Yaşasııın!"
    },
    {
      "id": "a94af74b",
      "bank_id": "800eab00",
      "text": "Babam son zamanlarda gerçekten çok mutlu görünüyor."
    },
    {
      "id": "aa3c8a33",
      "bank_id": "800eab00",
      "text": "Ben bir büyücüyüm!"
    },
    {
      "id": "abf34bbf",
      "bank_id": "800eab00",
      "text": "Lütfen bana altın çikolata alır mısın, lütfeeeen?"
    },
    {
      "id": "acf0c530",
      "bank_id": "800eab00",
      "text": "Hayır! Baba! Babacığım!"
    },
    {
      "id": "ad161d29",
      "bank_id": "800eab00",
      "text": "Seviye atladım! Yaşasın be!"
    },
    {
      "id": "adf26702",
      "bank_id": "800eab00",
      "text": "Kötü kraliçenin dünyayı ele geçirmesini engellemeliyiz!"
    },
    {
      "id": "ae03abf2",
      "bank_id": "800eab00",
      "text": "Annemin neşesi yerinde, değil mi?"
    },
    {
      "id": "b0ff318e",
      "bank_id": "800eab00",
      "text": "Vay canına, çok teşekkürler!"
    },
    {
      "id": "b13c9536",
      "bank_id": "800eab00",
      "text": "Albion'daki en güçlü büyücü benim!"
    },
    {
      "id": "b2fb0b72",
      "bank_id": "800eab00",
      "text": "A-fe-der-sin, bana bi lolipop veyiy misin?"
    },
    {
      "id": "b66586e8",
      "bank_id": "800eab00",
      "text": "Arkadaşım sandığım kişi meğer kötüymüş. Savaşmalıyız!"
    },
    {
      "id": "b6f2756f",
      "bank_id": "800eab00",
      "text": "Kaleye sızıp prensesi kurtarmalıyız!"
    },
    {
      "id": "b703b9df",
      "bank_id": "800eab00",
      "text": "Annemi bu kadar mutlu görmek hoşuma gidiyor."
    },
    {
      "id": "b9ff3fdb",
      "bank_id": "800eab00",
      "text": "Harika! Teşekkürler!"
    },
    {
      "id": "bb658e89",
      "bank_id": "800eab00",
      "text": "Üç başlı bir ejderha anne babamı yemiş! Onu öldürmem lazım!"
    },
    {
      "id": "bbfb195f",
      "bank_id": "800eab00",
      "text": "Neredeyse dokuz yaşındayım."
    },
    {
      "id": "bc2eee8d",
      "bank_id": "800eab00",
      "text": "Hi hi hi!"
    },
    {
      "id": "c2708cfd",
      "bank_id": "800eab00",
      "text": "Grrr!"
    },
    {
      "id": "c374a2fd",
      "bank_id": "800eab00",
      "text": "Hobbe'ler köyün bütün çocuklarını kaçırmış! Onları geri almalıyız!"
    },
    {
      "id": "c5ce15f4",
      "bank_id": "800eab00",
      "text": "Arkadaşım olur musun?"
    },
    {
      "id": "c6fd4432",
      "bank_id": "800eab00",
      "text": "Vuvu bu vaa!"
    },
    {
      "id": "c72f003c",
      "bank_id": "800eab00",
      "text": "Hi hi hi!"
    },
    {
      "id": "c7aead91",
      "bank_id": "800eab00",
      "text": "<giggles>"
    },
    {
      "id": "cace1d95",
      "bank_id": "800eab00",
      "text": "En sevdiğim renk köpek rengi."
    },
    {
      "id": "cc5bb7f8",
      "bank_id": "800eab00",
      "text": "Babamda bir gariplik var. Çok mutsuz görünüyor..."
    },
    {
      "id": "cd709e2c",
      "bank_id": "800eab00",
      "text": "Grrr!"
    },
    {
      "id": "cdc62f12",
      "bank_id": "800eab00",
      "text": "Na bla gaaaa!"
    },
    {
      "id": "ce74b42c",
      "bank_id": "800eab00",
      "text": "Ustâm bana ihanet etti! Şimdi onunla dövüşmeliyim!"
    },
    {
      "id": "cfe3ba2e",
      "bank_id": "800eab00",
      "text": "Adam bir balverine'e dönüştü!"
    },
    {
      "id": "cffd521f",
      "bank_id": "800eab00",
      "text": "Vuvu bu vaa!"
    },
    {
      "id": "d15bbf99",
      "bank_id": "800eab00",
      "text": "Babamın pek mutlu olduğunu sanmıyorum. Bir şey mi oldu?"
    },
    {
      "id": "d19395bd",
      "bank_id": "800eab00",
      "text": "Okum kötüyü tam burnundan vuruyor!"
    },
    {
      "id": "d2aebec0",
      "bank_id": "800eab00",
      "text": "<giggles>"
    },
    {
      "id": "d508ea81",
      "bank_id": "800eab00",
      "text": "Bir Kahraman gibi biçip doğruyorum!"
    },
    {
      "id": "d5510902",
      "bank_id": "800eab00",
      "text": "Grrrrooooaarrr!"
    },
    {
      "id": "d6c63d7f",
      "bank_id": "800eab00",
      "text": "Na bla gaaaa!"
    },
    {
      "id": "d7d6e4c2",
      "bank_id": "800eab00",
      "text": "<shooting sounds>"
    },
    {
      "id": "d8e3c87b",
      "bank_id": "800eab00",
      "text": "Bir balverine! Isırmasına izin verme!"
    },
    {
      "id": "d9cebbb4",
      "bank_id": "800eab00",
      "text": "Ga ga ga!"
    },
    {
      "id": "dbb8f442",
      "bank_id": "800eab00",
      "text": "Sanırım annem alışverişe gitmek istiyor."
    },
    {
      "id": "dc93a6ec",
      "bank_id": "800eab00",
      "text": "Vurdum seni! Öldün işte!"
    },
    {
      "id": "dd4b91b7",
      "bank_id": "800eab00",
      "text": "Gördün mü bak? Bir de onu öldüremeyeceğimi söylüyordun. Ne anlarsın ki sen."
    },
    {
      "id": "de51176f",
      "bank_id": "800eab00",
      "text": "Grrrrooooaarrr!"
    },
    {
      "id": "decec355",
      "bank_id": "800eab00",
      "text": "Ga ga ga!"
    },
    {
      "id": "e008fc30",
      "bank_id": "800eab00",
      "text": "Hobbe'nin kafasını uçuruyorum!"
    },
    {
      "id": "e0d6f32f",
      "bank_id": "800eab00",
      "text": "<shooting sounds>"
    },
    {
      "id": "e1e59ba4",
      "bank_id": "800eab00",
      "text": "Arkadaşlarımı kurtarmak için kılıcımı kullanıyorum!"
    },
    {
      "id": "e252b333",
      "bank_id": "800eab00",
      "text": "Hahaha!"
    },
    {
      "id": "e2feff22",
      "bank_id": "800eab00",
      "text": "Katil sincaplardan oluşan koca bir ordu kasabaya saldırıyor!"
    },
    {
      "id": "e44b9cba",
      "bank_id": "800eab00",
      "text": "Öldürdüm onu! Gördün mü? Geberip gitti işte!"
    },
    {
      "id": "e4b902af",
      "bank_id": "800eab00",
      "text": "Annem bu gece bana masal okuyabilir mi?"
    },
    {
      "id": "e7cccf23",
      "bank_id": "800eab00",
      "text": "Dünyanın en iyi nişancısı benim!"
    },
    {
      "id": "e92ac8be",
      "bank_id": "800eab00",
      "text": "Lütfen, ne olursun büyük Kahraman! Bir imzanı alabilir miyim? Lütfen?"
    },
    {
      "id": "e952be36",
      "bank_id": "800eab00",
      "text": "Hahaha!"
    },
    {
      "id": "e95fb504",
      "bank_id": "800eab00",
      "text": "<roars>"
    },
    {
      "id": "e98852c7",
      "bank_id": "800eab00",
      "text": "Annem neden bu kadar üzgün?"
    },
    {
      "id": "ebff0d0f",
      "bank_id": "800eab00",
      "text": "Aptal balçık canavarları kütüphanedeki bütün kitapları çalmış!"
    },
    {
      "id": "edf1ea81",
      "bank_id": "800eab00",
      "text": "Ben bir cadıyım ve bir sürü büyü biliyorum!"
    },
    {
      "id": "ee5fbd25",
      "bank_id": "800eab00",
      "text": "<roars>"
    },
    {
      "id": "eeccda26",
      "bank_id": "800eab00",
      "text": "Uzak mesafeden her şeyi vurabilirim!"
    },
    {
      "id": "ef722534",
      "bank_id": "800eab00",
      "text": "Kaybolan sihirli şeyi bulmak için bir maceraya atılıyoruz!"
    },
    {
      "id": "f0885dca",
      "bank_id": "800eab00",
      "text": "Annem pek mutlu görünmüyor."
    },
    {
      "id": "f0f0b807",
      "bank_id": "800eab00",
      "text": "Bir hobbe! Al bakalım seni küçük iblis!"
    },
    {
      "id": "f2219d04",
      "bank_id": "800eab00",
      "text": "İyi, ne halin varsa gör."
    },
    {
      "id": "f22ad68b",
      "bank_id": "800eab00",
      "text": "İmzanı almayı çok isterim. Büyük bir hayranınım."
    },
    {
      "id": "f3f877e0",
      "bank_id": "800eab00",
      "text": "Kocanızın vefatının ardından, bir çocuk esirgeme kurumu kızınızın velayetini üstlendi."
    },
    {
      "id": "f4722cd5",
      "bank_id": "800eab00",
      "text": "Zindanın girişine ulaşıp içeri giriyorum!"
    },
    {
      "id": "f721a525",
      "bank_id": "800eab00",
      "text": "Bir daha asla imza istemeyeceğim."
    },
    {
      "id": "f74dceee",
      "bank_id": "800eab00",
      "text": "Güm!"
    },
    {
      "id": "f7f0c30a",
      "bank_id": "800eab00",
      "text": "Öğk! Pis kokulu bir hobbe. Burnunuzu tutun!"
    },
    {
      "id": "f8f1fc30",
      "bank_id": "800eab00",
      "text": "İrade'ye hükmediyorum!"
    },
    {
      "id": "face9ba4",
      "bank_id": "800eab00",
      "text": "Şimşek çaktırabiliyorum!"
    },
    {
      "id": "faefb2f2",
      "bank_id": "800eab00",
      "text": "A, canavardan dev bir elmas düştü. Yok dur, yakut. Fikrimi değiştirdim, tamam mı?!"
    },
    {
      "id": "fcc35520",
      "bank_id": "800eab00",
      "text": "Kocanızın vefatının ardından, bir çocuk esirgeme kurumu oğlunuzun velayetini üstlendi."
    },
    {
      "id": "fd00aaa7",
      "bank_id": "800eab00",
      "text": "<blows raspberry>"
    },
    {
      "id": "fe30b44e",
      "bank_id": "800eab00",
      "text": "Harika! Çok sağ ol!"
    },
    {
      "id": "fe50a3f3",
      "bank_id": "800eab00",
      "text": "Grrr!"
    },
    {
      "id": "ff0faac7",
      "bank_id": "800eab00",
      "text": "Sen buna silah mı diyorsun? Silah dediğin böyle olur!! Çuf! Çuf!"
    },
    {
      "id": "ffcea345",
      "bank_id": "800eab00",
      "text": "Büyü yapmayı biliyorum!"
    }
  ]
}