{
  "bank_id": "7012ab00",
  "total_strings": 219,
  "strings": [
    {
      "id": "18abc110",
      "bank_id": "7012ab00",
      "text": "Ah, yeniden genç olabilseydim."
    },
    {
      "id": "18abc111",
      "bank_id": "7012ab00",
      "text": "Keşke yine o yaşta olsaydım."
    },
    {
      "id": "18abc112",
      "bank_id": "7012ab00",
      "text": "Hayat dolular."
    },
    {
      "id": "18abc116",
      "bank_id": "7012ab00",
      "text": "Bu küçüklerin enerjisi hiç bitmiyor maşallah."
    },
    {
      "id": "18abc117",
      "bank_id": "7012ab00",
      "text": "Küçük bir afacan olduğum günleri hatırlıyorum da. Ah..."
    },
    {
      "id": "1bb85db1",
      "bank_id": "7012ab00",
      "text": "Çok etkileyici."
    },
    {
      "id": "1bb85db2",
      "bank_id": "7012ab00",
      "text": "Tehlikedeyken seni çağırırım, olur mu?"
    },
    {
      "id": "1bb85db3",
      "bank_id": "7012ab00",
      "text": "Kahraman mısın sen şimdi?"
    },
    {
      "id": "1bb85db4",
      "bank_id": "7012ab00",
      "text": "Fiyakalı hareketlerin var ha?"
    },
    {
      "id": "1bb85db5",
      "bank_id": "7012ab00",
      "text": "Trolleri öldürme alıştırması mı yapıyorsun?"
    },
    {
      "id": "21abcf7a",
      "bank_id": "7012ab00",
      "text": "Dünya umurlarında değil, ne güzel."
    },
    {
      "id": "21abcf7b",
      "bank_id": "7012ab00",
      "text": "En güzel yaşlar onlar."
    },
    {
      "id": "21abcf7c",
      "bank_id": "7012ab00",
      "text": "Ha ha, gerçekten çok eğleniyor gibi görünüyorlar."
    },
    {
      "id": "21abcf7d",
      "bank_id": "7012ab00",
      "text": "Şimdilerde etrafta görülen o küçük vahşilerden değiller en azından."
    },
    {
      "id": "21abcf7f",
      "bank_id": "7012ab00",
      "text": "Sevimli görünen çocuklar."
    },
    {
      "id": "26b86ee0",
      "bank_id": "7012ab00",
      "text": "Teslim oluyorum. Teslim oluyorum."
    },
    {
      "id": "26b86ee2",
      "bank_id": "7012ab00",
      "text": "Kaç tane canavar öldürdün bakalım?"
    },
    {
      "id": "26b86ee3",
      "bank_id": "7012ab00",
      "text": "Benim için fazla güçlüsünüz, küçük Kahramanlar!"
    },
    {
      "id": "26b86ee4",
      "bank_id": "7012ab00",
      "text": "Yaman kahramanlarsınız doğrusu."
    },
    {
      "id": "26b86ee5",
      "bank_id": "7012ab00",
      "text": "Yendin beni. Ahh."
    },
    {
      "id": "27011250",
      "bank_id": "7012ab00",
      "text": "Lütfen, hayır. Bu tam anlamıyla vasat!"
    },
    {
      "id": "27011251",
      "bank_id": "7012ab00",
      "text": "Bu apaçık kalitesiz bir ürün."
    },
    {
      "id": "27011252",
      "bank_id": "7012ab00",
      "text": "Üç beş kuruş tasarruf etmeye çalışıyorsun ha?"
    },
    {
      "id": "27011253",
      "bank_id": "7012ab00",
      "text": "Burayı yeniden ahıra çeviriyorsun yani, öyle mi?"
    },
    {
      "id": "27011254",
      "bank_id": "7012ab00",
      "text": "Eskisi kadar güzel görünmüyor."
    },
    {
      "id": "27011255",
      "bank_id": "7012ab00",
      "text": "O güzelim eşya nereye gitti??"
    },
    {
      "id": "27011257",
      "bank_id": "7012ab00",
      "text": "O güzel şeyden neden kurtuldun ki?"
    },
    {
      "id": "2e011d58",
      "bank_id": "7012ab00",
      "text": "Eskisi kadar güzel değil sanki."
    },
    {
      "id": "2e011d59",
      "bank_id": "7012ab00",
      "text": "Eski halini daha çok seviyordum."
    },
    {
      "id": "2e011d5a",
      "bank_id": "7012ab00",
      "text": "Ötekini tercih ederdim."
    },
    {
      "id": "2e011d5c",
      "bank_id": "7012ab00",
      "text": "Ne kadar da bayağı."
    },
    {
      "id": "2e011d5d",
      "bank_id": "7012ab00",
      "text": "Burayı gecekonduya çevirmeye mi çalışıyorsun?"
    },
    {
      "id": "2e011d5e",
      "bank_id": "7012ab00",
      "text": "Eski haline getir şunu!"
    },
    {
      "id": "2e011d5f",
      "bank_id": "7012ab00",
      "text": "Bunu niye yaptın ki şimdi?"
    },
    {
      "id": "33014948",
      "bank_id": "7012ab00",
      "text": "Siz çocuklardan artık gına geldi."
    },
    {
      "id": "33014949",
      "bank_id": "7012ab00",
      "text": "Aptal aptal koşturmayı kesin."
    },
    {
      "id": "3301494d",
      "bank_id": "7012ab00",
      "text": "Böyle koşturarak hayatta hiçbir yere varamazsınız."
    },
    {
      "id": "3301494e",
      "bank_id": "7012ab00",
      "text": "Bu çocuklar hiç okula gitmez mi yahu!"
    },
    {
      "id": "3301494f",
      "bank_id": "7012ab00",
      "text": "Şimdiki nesil tam bir rezalet."
    },
    {
      "id": "35963221",
      "bank_id": "7012ab00",
      "text": "Bu lanet çocuklar sinirimi bozuyor."
    },
    {
      "id": "35963222",
      "bank_id": "7012ab00",
      "text": "Bu çocuklardan bıktım usandım artık!"
    },
    {
      "id": "35963223",
      "bank_id": "7012ab00",
      "text": "Okulunuza dönseniz ya siz!"
    },
    {
      "id": "35963224",
      "bank_id": "7012ab00",
      "text": "Hiç terbiye yok, bu veletlerin sorunu bu işte."
    },
    {
      "id": "35963225",
      "bank_id": "7012ab00",
      "text": "Yoldan çekilin bakalım ufaklıklar."
    },
    {
      "id": "3ad13160",
      "bank_id": "7012ab00",
      "text": "Bu kadar zalim olmaya gerek yok."
    },
    {
      "id": "3ad13161",
      "bank_id": "7012ab00",
      "text": "Tavuklarla bir alıp veremediğin mi var?"
    },
    {
      "id": "3ad13162",
      "bank_id": "7012ab00",
      "text": "Tavukları rahat bırakır mısın."
    },
    {
      "id": "3ad13166",
      "bank_id": "7012ab00",
      "text": "Yumurta öyle elde edilmez."
    },
    {
      "id": "3ad13167",
      "bank_id": "7012ab00",
      "text": "Bir tavuğa gücün yetiyor diye kendini sert biri mi sanıyorsun? Peh."
    },
    {
      "id": "3d3e0868",
      "bank_id": "7012ab00",
      "text": "Ha ha! En azından babamdan daha iyi dans ediyorsun!"
    },
    {
      "id": "3e015af8",
      "bank_id": "7012ab00",
      "text": "Sizi küçük holiganlar sizi."
    },
    {
      "id": "3e015af9",
      "bank_id": "7012ab00",
      "text": "Bir avuç afacan çocuk kadar gününü berbat eden bir şey yoktur."
    },
    {
      "id": "3e015afc",
      "bank_id": "7012ab00",
      "text": "Sizi şımarık yaramazlar. Uslu durun."
    },
    {
      "id": "3e015afe",
      "bank_id": "7012ab00",
      "text": "Büyükleri rahatsız etmekten başka yapacak işiniz yok mu sizin?"
    },
    {
      "id": "3e015aff",
      "bank_id": "7012ab00",
      "text": "Lanet çocuklar, habire koşturup duruyorlar!"
    },
    {
      "id": "3ee2c068",
      "bank_id": "7012ab00",
      "text": "Şimdi hiç hoşuma gitmedi."
    },
    {
      "id": "3ee2c06a",
      "bank_id": "7012ab00",
      "text": "Sırada ne var? Duvarları da mı yıkacaksın?"
    },
    {
      "id": "3ee2c06b",
      "bank_id": "7012ab00",
      "text": "Neden değiştirdin ki bunu?!"
    },
    {
      "id": "3ee2c06c",
      "bank_id": "7012ab00",
      "text": "Her şeyi olduğu gibi bırakamaz mısın?"
    },
    {
      "id": "3ee2c06d",
      "bank_id": "7012ab00",
      "text": "El atmışken çatıyı da sök bari."
    },
    {
      "id": "40964350",
      "bank_id": "7012ab00",
      "text": "Sizi sümüklü veletler sizi."
    },
    {
      "id": "40964352",
      "bank_id": "7012ab00",
      "text": "Anne babanız utanmalı."
    },
    {
      "id": "40964353",
      "bank_id": "7012ab00",
      "text": "Büyüyüp aptallar gibi davranmayı ne zaman keseceksiniz!"
    },
    {
      "id": "40964354",
      "bank_id": "7012ab00",
      "text": "Ne yaramaz veletler sürüsü."
    },
    {
      "id": "40964355",
      "bank_id": "7012ab00",
      "text": "Gençliğinizi böyle mi heba edeceksiniz?"
    },
    {
      "id": "423e1009",
      "bank_id": "7012ab00",
      "text": "Ne? Dans etmek ezikler içindir!"
    },
    {
      "id": "43d13f4a",
      "bank_id": "7012ab00",
      "text": "Tavuklara öyle yapmayı çocukken bırakmıştım ben."
    },
    {
      "id": "43d13f4b",
      "bank_id": "7012ab00",
      "text": "Tavuk gibi davrandın resmen. Ha ha! Ne var? Birinin söylemesi lazımdı!"
    },
    {
      "id": "43d13f4c",
      "bank_id": "7012ab00",
      "text": "O tavuk sana ne yaptı ki?"
    },
    {
      "id": "43d13f4d",
      "bank_id": "7012ab00",
      "text": "Hayvanlar bundan daha iyisini hak ediyor."
    },
    {
      "id": "43d13f4f",
      "bank_id": "7012ab00",
      "text": "Seni pis tavuk düşmanı."
    },
    {
      "id": "43e2c809",
      "bank_id": "7012ab00",
      "text": "Burayı viraneye çeviriyorsun."
    },
    {
      "id": "43e2c80a",
      "bank_id": "7012ab00",
      "text": "Olduğu gibi bırakamaz mıydın sanki?!"
    },
    {
      "id": "43e2c80b",
      "bank_id": "7012ab00",
      "text": "Burayı gecekonduya çevirme."
    },
    {
      "id": "43e2c80c",
      "bank_id": "7012ab00",
      "text": "Daha önce gayet iyiydi."
    },
    {
      "id": "43e2c80d",
      "bank_id": "7012ab00",
      "text": "Bundan daha iyisini hak ediyoruz."
    },
    {
      "id": "4663b0b2",
      "bank_id": "7012ab00",
      "text": "Hav hav!"
    },
    {
      "id": "4adcc762",
      "bank_id": "7012ab00",
      "text": "Buna alışabilirim bak."
    },
    {
      "id": "4adcc763",
      "bank_id": "7012ab00",
      "text": "Fıstık gibi görünüyor."
    },
    {
      "id": "4adcc764",
      "bank_id": "7012ab00",
      "text": "Çok daha iyi!"
    },
    {
      "id": "4adcc765",
      "bank_id": "7012ab00",
      "text": "Çok daha güzel görünüyor."
    },
    {
      "id": "4adcc767",
      "bank_id": "7012ab00",
      "text": "Teşekkürler! Harika görünüyor şimdi."
    },
    {
      "id": "4b0a83d8",
      "bank_id": "7012ab00",
      "text": "Çok aptal bir çocuksun."
    },
    {
      "id": "4ef720b0",
      "bank_id": "7012ab00",
      "text": "Kendi küçük dünyalarına dalmışlar, ne hoş."
    },
    {
      "id": "4ef720b1",
      "bank_id": "7012ab00",
      "text": "Ne kadar tatlı küçük çocuklar."
    },
    {
      "id": "4ef720b2",
      "bank_id": "7012ab00",
      "text": "Fırsatınız varken tadını çıkarın çocuklar. Uzun sürmez."
    },
    {
      "id": "500a8bf9",
      "bank_id": "7012ab00",
      "text": "Senin gibi çocukları hiç sevmem."
    },
    {
      "id": "5163c1e3",
      "bank_id": "7012ab00",
      "text": "Hav hav hav!"
    },
    {
      "id": "5163c1e5",
      "bank_id": "7012ab00",
      "text": "Hav hav hav!"
    },
    {
      "id": "51dcd268",
      "bank_id": "7012ab00",
      "text": "Burası artık harika görünüyor."
    },
    {
      "id": "51dcd269",
      "bank_id": "7012ab00",
      "text": "Ah evet, büyük bir gelişme!"
    },
    {
      "id": "51dcd26a",
      "bank_id": "7012ab00",
      "text": "Burayı gerçekten çok güzelleştirmişsin."
    },
    {
      "id": "51dcd26e",
      "bank_id": "7012ab00",
      "text": "Ah evet, bu çok güzelmiş."
    },
    {
      "id": "51dcd26f",
      "bank_id": "7012ab00",
      "text": "Bu öncekinden katbekat daha iyi."
    },
    {
      "id": "57f72e9c",
      "bank_id": "7012ab00",
      "text": "Kendi çocuklarımın olmasını düşündürtüyor bana..."
    },
    {
      "id": "57f72e9d",
      "bank_id": "7012ab00",
      "text": "Çok tatlı bir afacan grubu."
    },
    {
      "id": "57f72e9f",
      "bank_id": "7012ab00",
      "text": "Ne kadar hoş çocuklar."
    },
    {
      "id": "66383882",
      "bank_id": "7012ab00",
      "text": "Dans edecek vaktim yok benim."
    },
    {
      "id": "66383883",
      "bank_id": "7012ab00",
      "text": "Bloodstone Sakarlık Dansı'nı yapabilir misin?"
    },
    {
      "id": "66383884",
      "bank_id": "7012ab00",
      "text": "İşte ben buna dans derim!"
    },
    {
      "id": "66383885",
      "bank_id": "7012ab00",
      "text": "Pek alışılmadık bir dövüş tarzı."
    },
    {
      "id": "66383887",
      "bank_id": "7012ab00",
      "text": "Dans eden bir kaçıksın sen."
    },
    {
      "id": "6d384388",
      "bank_id": "7012ab00",
      "text": "Şuna bak hele."
    },
    {
      "id": "6d384389",
      "bank_id": "7012ab00",
      "text": "Güzel hareketler!"
    },
    {
      "id": "6d38438a",
      "bank_id": "7012ab00",
      "text": "Ritim duygun harika."
    },
    {
      "id": "6d38438e",
      "bank_id": "7012ab00",
      "text": "Kıvır bakalım!"
    },
    {
      "id": "6d38438f",
      "bank_id": "7012ab00",
      "text": "Böyle dans etmeyi nereden öğrendin?"
    },
    {
      "id": "74a80c8a",
      "bank_id": "7012ab00",
      "text": "Dünya kötü durumda olabilir ama onların umurunda bile değil."
    },
    {
      "id": "74a80c8b",
      "bank_id": "7012ab00",
      "text": "Onları oynarken görmek insanın yüzünü güldürüyor."
    },
    {
      "id": "74a80c8c",
      "bank_id": "7012ab00",
      "text": "Nasıl eğleneceklerini gerçekten biliyorlar, değil mi?"
    },
    {
      "id": "74a80c8d",
      "bank_id": "7012ab00",
      "text": "Ahh, benim de böyle koşturup durduğum günleri hatırlıyorum..."
    },
    {
      "id": "74a80c8e",
      "bank_id": "7012ab00",
      "text": "Tam da en tatlı çağlarındalar. Bir de ergenliklerine gelene kadar bekle..."
    },
    {
      "id": "77eb5c41",
      "bank_id": "7012ab00",
      "text": "Bana vuramazsın ki, sihirli güç kalkanım var benim."
    },
    {
      "id": "7da81ad8",
      "bank_id": "7012ab00",
      "text": "Bu çocuklar çok sevimli."
    },
    {
      "id": "7da81ad9",
      "bank_id": "7012ab00",
      "text": "İyi çocuklar bunlar aslında."
    },
    {
      "id": "7da81adb",
      "bank_id": "7012ab00",
      "text": "Onlar koşturup durmasa sokakların tadı çıkmazdı."
    },
    {
      "id": "7da81ade",
      "bank_id": "7012ab00",
      "text": "Bazı çocuklara hiç katlanamam ama bunlar pek tatlı."
    },
    {
      "id": "7da81adf",
      "bank_id": "7012ab00",
      "text": "Sevimli bir afacan çetesi doğrusu."
    },
    {
      "id": "7fd61b11",
      "bank_id": "7012ab00",
      "text": "Vay canına! Şunun uçuşuna bak!"
    },
    {
      "id": "817e75b6",
      "bank_id": "7012ab00",
      "text": "Bu çocuklar çok tatlı değil mi?"
    },
    {
      "id": "817e75b7",
      "bank_id": "7012ab00",
      "text": "Ne tatlı bir çocuk. Yetim misin yoksa? Seni evlat edinebilir miyim?"
    },
    {
      "id": "818ce760",
      "bank_id": "7012ab00",
      "text": "Bugün maaşı aldım, biraz neşe dağıtayım bari."
    },
    {
      "id": "818ce761",
      "bank_id": "7012ab00",
      "text": "Aman neyse ne. Al bakalım."
    },
    {
      "id": "818ce766",
      "bank_id": "7012ab00",
      "text": "Al bakalım ama daha fazlası yok."
    },
    {
      "id": "818ce767",
      "bank_id": "7012ab00",
      "text": "Bütün param bu kadar."
    },
    {
      "id": "82eb6df0",
      "bank_id": "7012ab00",
      "text": "Ben de sersemletme büyüsüyle karşılık veriyorum!"
    },
    {
      "id": "865f9823",
      "bank_id": "7012ab00",
      "text": "Hav hav hav!"
    },
    {
      "id": "87066518",
      "bank_id": "7012ab00",
      "text": "Ne iğrenç veletler."
    },
    {
      "id": "87066519",
      "bank_id": "7012ab00",
      "text": "Bana kalırsa bu çocukların uyanık oldukları her an bir akademide eğitim görmeleri gerekirdi."
    },
    {
      "id": "8ad560b8",
      "bank_id": "7012ab00",
      "text": "Eski haline mi döndü? Sırf dalga geçiyorsun, değil mi?"
    },
    {
      "id": "8ad560b9",
      "bank_id": "7012ab00",
      "text": "Büyüdüğüm yeri hatırlatmaya başladı..."
    },
    {
      "id": "8ad560ba",
      "bank_id": "7012ab00",
      "text": "Ne korkunç bir ucube! Eski haline döndür şunu!"
    },
    {
      "id": "8ad560bb",
      "bank_id": "7012ab00",
      "text": "Yok, bu hiç olmadı."
    },
    {
      "id": "8ad560bd",
      "bank_id": "7012ab00",
      "text": "Eski halinin nesi vardı ki sanki!"
    },
    {
      "id": "8ad560be",
      "bank_id": "7012ab00",
      "text": "Eski hali gayet iyiydi."
    },
    {
      "id": "8ad560bf",
      "bank_id": "7012ab00",
      "text": "Kesenin ağzını sıkıyoruz bakıyorum?"
    },
    {
      "id": "8ad62c40",
      "bank_id": "7012ab00",
      "text": "Hey, çok zalimce! Zavallı tavuk."
    },
    {
      "id": "8c7e86e6",
      "bank_id": "7012ab00",
      "text": "Ne kadar da efendi bir çocuk."
    },
    {
      "id": "8c7e86e7",
      "bank_id": "7012ab00",
      "text": "Zarar vermek istemediğim bir çocuk görmek ne kadar nadir bir şey."
    },
    {
      "id": "8d5fa326",
      "bank_id": "7012ab00",
      "text": "Hav hav hav!"
    },
    {
      "id": "9006736c",
      "bank_id": "7012ab00",
      "text": "Bu çocuksu yaratıklara hiç tahammülüm yok."
    },
    {
      "id": "9006736d",
      "bank_id": "7012ab00",
      "text": "Ne aşağılık bir cüce."
    },
    {
      "id": "91283fd0",
      "bank_id": "7012ab00",
      "text": "Dekorun gittikçe güzelleştiğini görüyorum."
    },
    {
      "id": "91283fd1",
      "bank_id": "7012ab00",
      "text": "Estetik zevkine diyecek yok doğrusu."
    },
    {
      "id": "91283fd2",
      "bank_id": "7012ab00",
      "text": "Vay! Eski eşyalara ne oldu?!"
    },
    {
      "id": "91283fd3",
      "bank_id": "7012ab00",
      "text": "İşte bu çok fiyakalı!"
    },
    {
      "id": "91283fd4",
      "bank_id": "7012ab00",
      "text": "Bu fersah fersah daha iyi."
    },
    {
      "id": "91283fd5",
      "bank_id": "7012ab00",
      "text": "Buraya gerçekten çok yakıştı!"
    },
    {
      "id": "91283fd7",
      "bank_id": "7012ab00",
      "text": "Ah evet, bu çok daha asil duruyor."
    },
    {
      "id": "95d571e8",
      "bank_id": "7012ab00",
      "text": "Ne? Köpeğinin pisliğini her yere sıvasan da aynı şeydi..."
    },
    {
      "id": "95d571e9",
      "bank_id": "7012ab00",
      "text": "Buna dekorasyon mu diyorsun sen? Ben ortalığı batırmak derim."
    },
    {
      "id": "95d571ea",
      "bank_id": "7012ab00",
      "text": "Bu değişiklik zarafetle resmen alay etmek demek!"
    },
    {
      "id": "95d571eb",
      "bank_id": "7012ab00",
      "text": "Bana sorarsan son derece tatminsiz bir yenileme olmuş."
    },
    {
      "id": "95d571ec",
      "bank_id": "7012ab00",
      "text": "Eskisinin nesi vardı? O daha iyiydi!"
    },
    {
      "id": "95d571ee",
      "bank_id": "7012ab00",
      "text": "Eskisine göre çok daha ucuz hissettiriyor."
    },
    {
      "id": "95d571ef",
      "bank_id": "7012ab00",
      "text": "Burası gittikçe gözden düşüyor galiba."
    },
    {
      "id": "98284ad8",
      "bank_id": "7012ab00",
      "text": "Vay canına, çok güzel!"
    },
    {
      "id": "98284ad9",
      "bank_id": "7012ab00",
      "text": "Buraya gerçekten yepyeni bir hava katmış."
    },
    {
      "id": "98284ada",
      "bank_id": "7012ab00",
      "text": "Harika görünüyor."
    },
    {
      "id": "98284adc",
      "bank_id": "7012ab00",
      "text": "Harika bir ekleme olmuş."
    },
    {
      "id": "98284add",
      "bank_id": "7012ab00",
      "text": "Gerçekten çok hoş olmuş."
    },
    {
      "id": "98284ade",
      "bank_id": "7012ab00",
      "text": "Burayı saraya çevireceksin galiba, değil mi?"
    },
    {
      "id": "98284adf",
      "bank_id": "7012ab00",
      "text": "İşte şimdi oldu."
    },
    {
      "id": "99744ad4",
      "bank_id": "7012ab00",
      "text": "Prensesi mi kurtarıyorsun?"
    },
    {
      "id": "99744ad6",
      "bank_id": "7012ab00",
      "text": "Bizi tüm canavarlardan korumak için burada olmana sevindim."
    },
    {
      "id": "99744ad7",
      "bank_id": "7012ab00",
      "text": "Kahramanların da ders çalışması gerekir, biliyorsun değil mi?"
    },
    {
      "id": "9e7452f5",
      "bank_id": "7012ab00",
      "text": "Birinin gözünü çıkarmamaya dikkat edin."
    },
    {
      "id": "9e7452f6",
      "bank_id": "7012ab00",
      "text": "Dünyayı mı kurtarıyorsunuz ufaklıklar?"
    },
    {
      "id": "9e7452f7",
      "bank_id": "7012ab00",
      "text": "Kötü Kahramanlar mısınız yoksa iyi Kahramanlar mı?"
    },
    {
      "id": "a153ca60",
      "bank_id": "7012ab00",
      "text": "Vay canına! Teslim oluyorum yüce maceracılar!"
    },
    {
      "id": "a153ca61",
      "bank_id": "7012ab00",
      "text": "Ününüz sizden önce geldi küçük kahramanlar."
    },
    {
      "id": "a153ca63",
      "bank_id": "7012ab00",
      "text": "Sen de kim oluyorsun bakalım? Bir balverine avcısı mı?"
    },
    {
      "id": "a153ca66",
      "bank_id": "7012ab00",
      "text": "Öldürme beni. Ben dost canlısı bir trolüm."
    },
    {
      "id": "a153ca67",
      "bank_id": "7012ab00",
      "text": "Bana büyü yapma."
    },
    {
      "id": "a853d562",
      "bank_id": "7012ab00",
      "text": "Kaleye mi baskın yapıyorsunuz?"
    },
    {
      "id": "a853d563",
      "bank_id": "7012ab00",
      "text": "Albion o minik ellerinizde güvende."
    },
    {
      "id": "a853d564",
      "bank_id": "7012ab00",
      "text": "Buralarda bir zindanda hazine olduğunu duydum."
    },
    {
      "id": "a853d565",
      "bank_id": "7012ab00",
      "text": "Evet tamam, öldüm ben şimdi."
    },
    {
      "id": "a853d566",
      "bank_id": "7012ab00",
      "text": "Tüm haydutları yakaladınız mı bari?"
    },
    {
      "id": "b2e5a914",
      "bank_id": "7012ab00",
      "text": "Bana saldıracağına beni esir tutanlardan kurtarman gerekirdi."
    },
    {
      "id": "b2e5a915",
      "bank_id": "7012ab00",
      "text": "Başka yerde oyna çocuk."
    },
    {
      "id": "b98dba1d",
      "bank_id": "7012ab00",
      "text": "Başka yerde oynayın, olur mu?"
    },
    {
      "id": "b98dba1e",
      "bank_id": "7012ab00",
      "text": "Siz çocuklar beni delirteceksiniz!"
    },
    {
      "id": "b98dba1f",
      "bank_id": "7012ab00",
      "text": "İki dakika uslu duramaz mısınız siz?"
    },
    {
      "id": "bbe5b778",
      "bank_id": "7012ab00",
      "text": "Oyunlarına ayıracak vaktim yok benim, çocuk."
    },
    {
      "id": "bbe5b779",
      "bank_id": "7012ab00",
      "text": "Merhametinize sığınıyorum, minik savaşçılar."
    },
    {
      "id": "c17a5d23",
      "bank_id": "7012ab00",
      "text": "Hey, sonra oynamak ister misin?"
    },
    {
      "id": "c48dcb4c",
      "bank_id": "7012ab00",
      "text": "Bu çocuklar çok gürültücü."
    },
    {
      "id": "c48dcb4e",
      "bank_id": "7012ab00",
      "text": "Gidip bir kitap falan okusanıza?"
    },
    {
      "id": "c48dcb4f",
      "bank_id": "7012ab00",
      "text": "Aptal çocuklar!"
    },
    {
      "id": "c5cfad0e",
      "bank_id": "7012ab00",
      "text": "Eski hali daha çok hoşuma gidiyordu benim."
    },
    {
      "id": "c87a6826",
      "bank_id": "7012ab00",
      "text": "Sonra birlikte muziplik yapalım mı?"
    },
    {
      "id": "ccd89722",
      "bank_id": "7012ab00",
      "text": "O hayvana eziyet etmeyi kes!"
    },
    {
      "id": "ccd89723",
      "bank_id": "7012ab00",
      "text": "O köpeği rahat bırak!"
    },
    {
      "id": "ccd89724",
      "bank_id": "7012ab00",
      "text": "O zavallı hayvana öyle davranamazsın! Neyin var senin?"
    },
    {
      "id": "ccd89725",
      "bank_id": "7012ab00",
      "text": "Kes şunu!"
    },
    {
      "id": "ccd89727",
      "bank_id": "7012ab00",
      "text": "O zavallı hayvana ne yapıyorsun sen öyle?!"
    },
    {
      "id": "cecfbb5b",
      "bank_id": "7012ab00",
      "text": "Şimdi bayağı berbat görünüyor."
    },
    {
      "id": "d3d8a228",
      "bank_id": "7012ab00",
      "text": "Yapma şunu! Nasıl bu kadar zalim olabiliyorsun?"
    },
    {
      "id": "d3d8a229",
      "bank_id": "7012ab00",
      "text": "Nasıl bu kadar zalim olabiliyorsun? Zavallı köpek."
    },
    {
      "id": "d3d8a22a",
      "bank_id": "7012ab00",
      "text": "Zavallı köpeği rahat bırak!"
    },
    {
      "id": "d3d8a22e",
      "bank_id": "7012ab00",
      "text": "O zavallı köpeğe ne yapıyorsun sen öyle?"
    },
    {
      "id": "d3d8a22f",
      "bank_id": "7012ab00",
      "text": "Bırak onu, seni koca zorba!"
    },
    {
      "id": "dc2d3314",
      "bank_id": "7012ab00",
      "text": "Harika. Çok güzel görünüyor!"
    },
    {
      "id": "e12d3b35",
      "bank_id": "7012ab00",
      "text": "Şimdi harika görünüyor."
    },
    {
      "id": "f4fc8e38",
      "bank_id": "7012ab00",
      "text": "Vay, burayı gerçekten çok güzelleştirmişsin, değil mi?"
    },
    {
      "id": "f4fc8e39",
      "bank_id": "7012ab00",
      "text": "O pasaklı çöplerden kurtuldun demek ha? Zamanı gelmişti zaten."
    },
    {
      "id": "f4fc8e3a",
      "bank_id": "7012ab00",
      "text": "Ah evet, enfes bir zevkin var."
    },
    {
      "id": "f4fc8e3b",
      "bank_id": "7012ab00",
      "text": "İç mimar olmalıymışsın vallahi!"
    },
    {
      "id": "f4fc8e3d",
      "bank_id": "7012ab00",
      "text": "Burası artık çok daha güzel oldu!"
    },
    {
      "id": "f4fc8e3e",
      "bank_id": "7012ab00",
      "text": "Burası harika görünüyor."
    },
    {
      "id": "f4fc8e3f",
      "bank_id": "7012ab00",
      "text": "Biraz yenileme mi yaptın sen? Güzel görünüyor."
    },
    {
      "id": "fffc9f68",
      "bank_id": "7012ab00",
      "text": "Evet, bu kesinlikle daha iyi."
    },
    {
      "id": "fffc9f69",
      "bank_id": "7012ab00",
      "text": "Eskiden orada duran çöpten katbekat iyi olduğu kesin."
    },
    {
      "id": "fffc9f6a",
      "bank_id": "7012ab00",
      "text": "Bu ufak tadilatlarını gerçekten beğeniyorum."
    },
    {
      "id": "fffc9f6b",
      "bank_id": "7012ab00",
      "text": "Belirgin bir gelişme!"
    },
    {
      "id": "fffc9f6c",
      "bank_id": "7012ab00",
      "text": "Ah evet, çok daha iyi görünüyor."
    },
    {
      "id": "fffc9f6e",
      "bank_id": "7012ab00",
      "text": "Hâlâ aynı yerde olduğuma inanamıyorum!"
    },
    {
      "id": "fffc9f6f",
      "bank_id": "7012ab00",
      "text": "Gerçekten fark yaratmış!"
    }
  ]
}