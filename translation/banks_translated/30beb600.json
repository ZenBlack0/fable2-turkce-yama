{
  "bank_id": "30beb600",
  "total_strings": 244,
  "strings": [
    {
      "id": "021ff9b3",
      "bank_id": "30beb600",
      "text": "Bloodstone"
    },
    {
      "id": "0366a63b",
      "bank_id": "30beb600",
      "text": "Güzel."
    },
    {
      "id": "04728c5b",
      "bank_id": "30beb600",
      "text": "Peh."
    },
    {
      "id": "048fa27d",
      "bank_id": "30beb600",
      "text": "İsteğe bağlı işkence eklentileriyle, enfes bir mobilya seçkisi."
    },
    {
      "id": "05728dce",
      "bank_id": "30beb600",
      "text": "Dürüst olmak gerekirse..."
    },
    {
      "id": "078c5b4f",
      "bank_id": "30beb600",
      "text": "Bu mağaranın gizemleri gün yüzüne çıkarılmalı!"
    },
    {
      "id": "07b75d34",
      "bank_id": "30beb600",
      "text": "Ne kadar da harika."
    },
    {
      "id": "08b41de7",
      "bank_id": "30beb600",
      "text": "Böyle devam edersen Lucien çoktan kazanmış demektir."
    },
    {
      "id": "09b41f5a",
      "bank_id": "30beb600",
      "text": "Sana hayatta ikinci bir şans verildi. Bunun kıymetini bil."
    },
    {
      "id": "09b7601a",
      "bank_id": "30beb600",
      "text": "Bu Meatbane'i maymun gibi geveze etmekten bile daha iyi."
    },
    {
      "id": "0a581fd5",
      "bank_id": "30beb600",
      "text": "Kanca"
    },
    {
      "id": "0ab7618d",
      "bank_id": "30beb600",
      "text": "Buranın iç karartıcı bir yer olacağını sanmıştım. Ne kadar da yanılmışım."
    },
    {
      "id": "0bd6907e",
      "bank_id": "30beb600",
      "text": "<laughs> Çok eğlenceli."
    },
    {
      "id": "0cadb0b4",
      "bank_id": "30beb600",
      "text": "Kayık Evi"
    },
    {
      "id": "1511fc6f",
      "bank_id": "30beb600",
      "text": "İmkânı yok yapamam."
    },
    {
      "id": "1611fdc2",
      "bank_id": "30beb600",
      "text": "Çok meşgulüm maalesef."
    },
    {
      "id": "168b0dc8",
      "bank_id": "30beb600",
      "text": "Beni kızdırmaya mı çalışıyorsun?!"
    },
    {
      "id": "1ae95c76",
      "bank_id": "30beb600",
      "text": "Bloodstone Mezarları"
    },
    {
      "id": "1b3dab01",
      "bank_id": "30beb600",
      "text": "Hahaha!"
    },
    {
      "id": "1c7454d3",
      "bank_id": "30beb600",
      "text": "<whimpers>"
    },
    {
      "id": "1cf1607e",
      "bank_id": "30beb600",
      "text": "Döndün demek. Harika!"
    },
    {
      "id": "1f19f907",
      "bank_id": "30beb600",
      "text": "<whimpers>"
    },
    {
      "id": "20f6cace",
      "bank_id": "30beb600",
      "text": "Bloodstone Tepesi No: 4, Bloodstone"
    },
    {
      "id": "21f9649b",
      "bank_id": "30beb600",
      "text": "Evet!"
    },
    {
      "id": "2417c0fc",
      "bank_id": "30beb600",
      "text": "Harika."
    },
    {
      "id": "260856a9",
      "bank_id": "30beb600",
      "text": "Aagh!"
    },
    {
      "id": "270a5b74",
      "bank_id": "30beb600",
      "text": "Vay canına, amma şey ha!"
    },
    {
      "id": "2717c5b5",
      "bank_id": "30beb600",
      "text": "Bu gerçekten fevkalade."
    },
    {
      "id": "2768b594",
      "bank_id": "30beb600",
      "text": "Mobilya Mezarlığı"
    },
    {
      "id": "28c6dce1",
      "bank_id": "30beb600",
      "text": "Döneceğini biliyordum. Ne diyordum..."
    },
    {
      "id": "290a5e5a",
      "bank_id": "30beb600",
      "text": "Harika bir şey bu!"
    },
    {
      "id": "2a0a5fcd",
      "bank_id": "30beb600",
      "text": "Harika şeyler."
    },
    {
      "id": "2c700cf3",
      "bank_id": "30beb600",
      "text": "Bahr!"
    },
    {
      "id": "2e72303d",
      "bank_id": "30beb600",
      "text": "Ah! Neden vurdun bana?!"
    },
    {
      "id": "2e754afa",
      "bank_id": "30beb600",
      "text": "Güzel."
    },
    {
      "id": "2fcb8b58",
      "bank_id": "30beb600",
      "text": "Ah! Neden yaptın bunu?! Ben barışçıl bir keşişim!"
    },
    {
      "id": "2ff122e8",
      "bank_id": "30beb600",
      "text": "Vaktini boşa harcıyorsun. Aslında benim vaktimi."
    },
    {
      "id": "30f1245b",
      "bank_id": "30beb600",
      "text": "Bilemiyorum. Aslında biliyorum."
    },
    {
      "id": "31f125ce",
      "bank_id": "30beb600",
      "text": "Şu anda olmaz. Ve 'şu anda' derken 'asla' demek istiyorum."
    },
    {
      "id": "36d5f2f0",
      "bank_id": "30beb600",
      "text": "Bloodstone Evi"
    },
    {
      "id": "37da3ce8",
      "bank_id": "30beb600",
      "text": "Hep böyle şeyler mi yaparsın?"
    },
    {
      "id": "38da3e5b",
      "bank_id": "30beb600",
      "text": "Pek hoşuma gitmedi doğrusu."
    },
    {
      "id": "39da3fce",
      "bank_id": "30beb600",
      "text": "Peh, tam bir saçmalık."
    },
    {
      "id": "3b7748b7",
      "bank_id": "30beb600",
      "text": "Pöh!"
    },
    {
      "id": "3d4d5d6c",
      "bank_id": "30beb600",
      "text": "Şu kasvetli duvarlardan uzaklaşıp açık havaya çıktığımızda tekrar sor bana."
    },
    {
      "id": "3eb104c8",
      "bank_id": "30beb600",
      "text": "<laughs>"
    },
    {
      "id": "3f305137",
      "bank_id": "30beb600",
      "text": "Benden öylece çekip gidemezsin; ben senden çekip giderim."
    },
    {
      "id": "403052aa",
      "bank_id": "30beb600",
      "text": "İmkânsız bir kusursuzluğun huzurunda bulunmak bu kadar mı dayanılmaz?"
    },
    {
      "id": "404d6225",
      "bank_id": "30beb600",
      "text": "Sorman çok nazikçe ama hazırlanmamız gereken bir Çile müsabakası var."
    },
    {
      "id": "407007ef",
      "bank_id": "30beb600",
      "text": "Bloodstone Tersanesi"
    },
    {
      "id": "4130541d",
      "bank_id": "30beb600",
      "text": "Gidiyor musun? Şey, bana dönerken bir... Şey... Bekle aslında, her şeyim var."
    },
    {
      "id": "421c6c07",
      "bank_id": "30beb600",
      "text": "<laughs>"
    },
    {
      "id": "427d6eca",
      "bank_id": "30beb600",
      "text": "<laughs>"
    },
    {
      "id": "434fa100",
      "bank_id": "30beb600",
      "text": "Hammer'ı korumasız bırakamazsınız!"
    },
    {
      "id": "434fa103",
      "bank_id": "30beb600",
      "text": "Hammer'ı korumasız bırakamazsınız!"
    },
    {
      "id": "43f94dc8",
      "bank_id": "30beb600",
      "text": "Harika bir şey bu!"
    },
    {
      "id": "4434731d",
      "bank_id": "30beb600",
      "text": "*sızlanır*"
    },
    {
      "id": "46f95281",
      "bank_id": "30beb600",
      "text": "Güzel!"
    },
    {
      "id": "4a5387d6",
      "bank_id": "30beb600",
      "text": "Saldırıların hiçbir işe yaramayacak. Kendine gel."
    },
    {
      "id": "4a57b2e5",
      "bank_id": "30beb600",
      "text": "Ah!"
    },
    {
      "id": "4bdc9990",
      "bank_id": "30beb600",
      "text": "Ha ha! Evet, çok güzel!"
    },
    {
      "id": "4eaf4e78",
      "bank_id": "30beb600",
      "text": "Ün: %1 / %2"
    },
    {
      "id": "4edc9e69",
      "bank_id": "30beb600",
      "text": "Hohaho!"
    },
    {
      "id": "4ee606c3",
      "bank_id": "30beb600",
      "text": "Bir keşiş böyle şeylere maruz bırakılmamalıdır."
    },
    {
      "id": "4efa2820",
      "bank_id": "30beb600",
      "text": "Aagh!"
    },
    {
      "id": "4fe608b6",
      "bank_id": "30beb600",
      "text": "Bu herhangi bir Gölge kadar iğrenç!"
    },
    {
      "id": "4ffa2993",
      "bank_id": "30beb600",
      "text": "Aagh!"
    },
    {
      "id": "507b389f",
      "bank_id": "30beb600",
      "text": "Beni böyle önemsiz meselelerle rahatsız etmemelisin."
    },
    {
      "id": "50fa2b06",
      "bank_id": "30beb600",
      "text": "Aagh!"
    },
    {
      "id": "5117b23e",
      "bank_id": "30beb600",
      "text": "<whimpers>"
    },
    {
      "id": "512e5346",
      "bank_id": "30beb600",
      "text": "Öff!"
    },
    {
      "id": "51368813",
      "bank_id": "30beb600",
      "text": "Reaver'ın görevini sonuna kadar götürmelisiniz. Geri dönüş yok!"
    },
    {
      "id": "514f2adb",
      "bank_id": "30beb600",
      "text": "Döndün demek?"
    },
    {
      "id": "517b3a72",
      "bank_id": "30beb600",
      "text": "Uğraşacak başka işlerin var, Kahraman."
    },
    {
      "id": "51fa2cf9",
      "bank_id": "30beb600",
      "text": "Aagh!"
    },
    {
      "id": "527b3be5",
      "bank_id": "30beb600",
      "text": "Belki de enerjini elindeki göreve yönlendirmelisin."
    },
    {
      "id": "52fa2e6c",
      "bank_id": "30beb600",
      "text": "Yaaaah!"
    },
    {
      "id": "53368b79",
      "bank_id": "30beb600",
      "text": "Ritüeli tamamlamalısınız!"
    },
    {
      "id": "538a128b",
      "bank_id": "30beb600",
      "text": "Şu an biraz meşgulüm."
    },
    {
      "id": "53fa2fdf",
      "bank_id": "30beb600",
      "text": "Raaarh!"
    },
    {
      "id": "548a147e",
      "bank_id": "30beb600",
      "text": "İşletmem gereken bir dükkân var, biliyorsun."
    },
    {
      "id": "55368e5f",
      "bank_id": "30beb600",
      "text": "Kule'den kaçış yok!"
    },
    {
      "id": "55fa3325",
      "bank_id": "30beb600",
      "text": "Yah!"
    },
    {
      "id": "5822b4ad",
      "bank_id": "30beb600",
      "text": "Hahaha!"
    },
    {
      "id": "5920111c",
      "bank_id": "30beb600",
      "text": "Gidiyor musun?"
    },
    {
      "id": "5983cb10",
      "bank_id": "30beb600",
      "text": "Artık gerçekten bu kadarı da fazla!"
    },
    {
      "id": "5cfa3e2a",
      "bank_id": "30beb600",
      "text": "Aagh!"
    },
    {
      "id": "5d099830",
      "bank_id": "30beb600",
      "text": "Hey!"
    },
    {
      "id": "5dfa3f9d",
      "bank_id": "30beb600",
      "text": "Aagh!"
    },
    {
      "id": "5e691b88",
      "bank_id": "30beb600",
      "text": "Sabrımı taşıracaksın!"
    },
    {
      "id": "61692041",
      "bank_id": "30beb600",
      "text": "Lütfen! Büyümü senin üzerinde harcamak istemiyorum!"
    },
    {
      "id": "6215f63f",
      "bank_id": "30beb600",
      "text": "<laughs>"
    },
    {
      "id": "62397d6e",
      "bank_id": "30beb600",
      "text": "Gidiyor musun? Sen bilirsin."
    },
    {
      "id": "62c15734",
      "bank_id": "30beb600",
      "text": "Korkunç."
    },
    {
      "id": "64750079",
      "bank_id": "30beb600",
      "text": "Bu Bloodstone'da bir evdir."
    },
    {
      "id": "64c5e7c4",
      "bank_id": "30beb600",
      "text": "Pöh!"
    },
    {
      "id": "64df0223",
      "bank_id": "30beb600",
      "text": "Umarım yakında dönersin!"
    },
    {
      "id": "65c15b8d",
      "bank_id": "30beb600",
      "text": "Kimin umurunda?"
    },
    {
      "id": "684d97b6",
      "bank_id": "30beb600",
      "text": "Ah!"
    },
    {
      "id": "6a680afb",
      "bank_id": "30beb600",
      "text": "Aman, bu son derece harika!"
    },
    {
      "id": "6b680c6e",
      "bank_id": "30beb600",
      "text": "Böyle mucizelere tanık olmak için insanın defalarca yaşaması gerekir. Neyse, yine de iyi geliyor."
    },
    {
      "id": "6c680dc1",
      "bank_id": "30beb600",
      "text": "'Harika' kelimesi tam anlamını karşılıyor."
    },
    {
      "id": "6d680fb4",
      "bank_id": "30beb600",
      "text": "Ben de hayal kırıklığına uğramayı bekliyordum."
    },
    {
      "id": "6d778298",
      "bank_id": "30beb600",
      "text": "Hahaha!"
    },
    {
      "id": "6e681127",
      "bank_id": "30beb600",
      "text": "İtiraf etmeliyim ki etkilenmedim değil."
    },
    {
      "id": "6edea758",
      "bank_id": "30beb600",
      "text": "Kafa mı buluyorsun sen?"
    },
    {
      "id": "6f69f2e4",
      "bank_id": "30beb600",
      "text": "<laughs>"
    },
    {
      "id": "70f327f5",
      "bank_id": "30beb600",
      "text": "Böyle devam edersen gerçekten kızacağım."
    },
    {
      "id": "70f33921",
      "bank_id": "30beb600",
      "text": "Döndün demek."
    },
    {
      "id": "713fe8a8",
      "bank_id": "30beb600",
      "text": "Keşke bunu yapmanı engelleyecek gücüm olsaydı."
    },
    {
      "id": "71deac11",
      "bank_id": "30beb600",
      "text": "Sinirime dokunuyorsun."
    },
    {
      "id": "7214762e",
      "bank_id": "30beb600",
      "text": "Tatlı Dilli Büyücü'ye sırtını mı dönüyorsun? Söylediğim bir şey yüzünden mi?"
    },
    {
      "id": "723fea1b",
      "bank_id": "30beb600",
      "text": "Hakkındaki fikrim hızla aşağılara iniyor."
    },
    {
      "id": "733feb8e",
      "bank_id": "30beb600",
      "text": "Hayır, hayır, bu hiç ama hiç olmaz."
    },
    {
      "id": "73eca14f",
      "bank_id": "30beb600",
      "text": "Bloodstone Tepesi No: 8, Bloodstone"
    },
    {
      "id": "75f95d1b",
      "bank_id": "30beb600",
      "text": "Hiç etkilenmedim. Hatta tam otuz fersah uzağım etkilenmekten."
    },
    {
      "id": "77a093b2",
      "bank_id": "30beb600",
      "text": "Dash ile işinizi bitirmeden Rookridge'den ayrılamazsınız."
    },
    {
      "id": "783cc08a",
      "bank_id": "30beb600",
      "text": "Evet, fena değil."
    },
    {
      "id": "7dde830f",
      "bank_id": "30beb600",
      "text": "Aagh!"
    },
    {
      "id": "7e7db03b",
      "bank_id": "30beb600",
      "text": "Buna hiç gerek yok."
    },
    {
      "id": "7f7bcfc9",
      "bank_id": "30beb600",
      "text": "Davetsiz misafirleri alt etmelisiniz yoksa her şeyi çalacaklar!"
    },
    {
      "id": "7f7bcfca",
      "bank_id": "30beb600",
      "text": "Bu zindanı temizlemezseniz o hırsızların ardı arkası asla kesilmez!"
    },
    {
      "id": "7f7db1ae",
      "bank_id": "30beb600",
      "text": "Vah vah. Bu hiç iyi değil."
    },
    {
      "id": "7fa51d78",
      "bank_id": "30beb600",
      "text": "Bu yolkesenlerin icabına şimdi bakmazsanız onları bir daha asla bulamayabilirsiniz!"
    },
    {
      "id": "8193d77d",
      "bank_id": "30beb600",
      "text": "Büyük deneyi sonuna kadar götürmeniz gerekiyor!"
    },
    {
      "id": "819615d4",
      "bank_id": "30beb600",
      "text": "Son çiftçiyi ve keşişi öldürene kadar ayrılamazsınız!"
    },
    {
      "id": "82961747",
      "bank_id": "30beb600",
      "text": "Çok geç olmadan Gölgeler Tapınağı'nı durdurmalısınız!"
    },
    {
      "id": "8296a09f",
      "bank_id": "30beb600",
      "text": "<whimpers>"
    },
    {
      "id": "8426120c",
      "bank_id": "30beb600",
      "text": "[Sızlanır] Olamaz..."
    },
    {
      "id": "851c7d14",
      "bank_id": "30beb600",
      "text": "Şu an olmaz."
    },
    {
      "id": "861c7e87",
      "bank_id": "30beb600",
      "text": "Nazik bir teklif ama geri çevirmek zorundayım."
    },
    {
      "id": "872ef553",
      "bank_id": "30beb600",
      "text": "ORMAN TROLÜ"
    },
    {
      "id": "87a38eab",
      "bank_id": "30beb600",
      "text": "<whimpers>"
    },
    {
      "id": "881c81ed",
      "bank_id": "30beb600",
      "text": "İhtiyacım olan tek şey Işık, teşekkürler."
    },
    {
      "id": "8864f9e7",
      "bank_id": "30beb600",
      "text": "Bu hiç uygun değil."
    },
    {
      "id": "89367982",
      "bank_id": "30beb600",
      "text": "Burası, ilk yağmalarından birinde ganimet olarak aldığı tükenmez sağlık iksirleri sayesinde doksanlı yaşlarına kadar gemilere bordalamaya devam eden Kaptan Sorrow'un eviydi. Ondan daha acımasız tek korsanın Kaptan Dread olduğu söylenir."
    },
    {
      "id": "8964fb5a",
      "bank_id": "30beb600",
      "text": "Acınası."
    },
    {
      "id": "8abce729",
      "bank_id": "30beb600",
      "text": "Ah, ne diyordum..."
    },
    {
      "id": "8e473581",
      "bank_id": "30beb600",
      "text": "Bloodstone Sahili No: 4, Bloodstone"
    },
    {
      "id": "90d8d9f8",
      "bank_id": "30beb600",
      "text": "Şimdi nereye gidiyorsun?"
    },
    {
      "id": "9408f5d0",
      "bank_id": "30beb600",
      "text": "Hahaha!"
    },
    {
      "id": "97872f5c",
      "bank_id": "30beb600",
      "text": "Bloodstone Tepesi No: 10, Bloodstone"
    },
    {
      "id": "9b055663",
      "bank_id": "30beb600",
      "text": "Kendi kanınızdan bir gölün içinde boğularak mı uyanıyorsunuz sık sık? İksirlerimiz yardımcı olabilir."
    },
    {
      "id": "9bb07cde",
      "bank_id": "30beb600",
      "text": "Hey, kes şunu!"
    },
    {
      "id": "9d7c90a1",
      "bank_id": "30beb600",
      "text": "<laughs>"
    },
    {
      "id": "a129cce7",
      "bank_id": "30beb600",
      "text": "Ah!"
    },
    {
      "id": "a1eb5bda",
      "bank_id": "30beb600",
      "text": "<whimper>"
    },
    {
      "id": "a272f969",
      "bank_id": "30beb600",
      "text": "Bloodstone"
    },
    {
      "id": "a308c0f2",
      "bank_id": "30beb600",
      "text": "Bloodstone Tepesi No: 9, Bloodstone"
    },
    {
      "id": "a4236eac",
      "bank_id": "30beb600",
      "text": "Sorun değil."
    },
    {
      "id": "a523701f",
      "bank_id": "30beb600",
      "text": "Tam burada beni meşgul edecek çok işim var."
    },
    {
      "id": "a5bedf5b",
      "bank_id": "30beb600",
      "text": "Oldukça iyi, itiraf ediyorum."
    },
    {
      "id": "a661cb33",
      "bank_id": "30beb600",
      "text": "Güzel iş!"
    },
    {
      "id": "a6bee0ce",
      "bank_id": "30beb600",
      "text": "Pek harikulade."
    },
    {
      "id": "a7237365",
      "bank_id": "30beb600",
      "text": "Ne? Ah, hayır, hiç sanmıyorum."
    },
    {
      "id": "a761cca6",
      "bank_id": "30beb600",
      "text": "Fena değil, evet."
    },
    {
      "id": "a824f5ec",
      "bank_id": "30beb600",
      "text": "<whimpers>"
    },
    {
      "id": "a8a4dd62",
      "bank_id": "30beb600",
      "text": "Hahaha!"
    },
    {
      "id": "a953cff0",
      "bank_id": "30beb600",
      "text": "Fevkalade!"
    },
    {
      "id": "aae796a1",
      "bank_id": "30beb600",
      "text": "Benden uzak dur."
    },
    {
      "id": "ab53d2d6",
      "bank_id": "30beb600",
      "text": "Harika!"
    },
    {
      "id": "ac53d449",
      "bank_id": "30beb600",
      "text": "Tepeden tırnağa Hayırsever bir Köylüsün."
    },
    {
      "id": "adb9f9dd",
      "bank_id": "30beb600",
      "text": "Bu gemiler sizi gitmek istediğiniz yere götürecektir."
    },
    {
      "id": "ae7a2a30",
      "bank_id": "30beb600",
      "text": "Ah! Kes şunu! İkimize de yetecek kadar var!"
    },
    {
      "id": "b01e8754",
      "bank_id": "30beb600",
      "text": "Mağaradan dövüşerek çıkmak zorundasınız."
    },
    {
      "id": "b01e8755",
      "bank_id": "30beb600",
      "text": "Ayrılmadan önce Büyükanne Miggins ile konuşmalısınız."
    },
    {
      "id": "b01e8757",
      "bank_id": "30beb600",
      "text": "Charlie'yi kurtarmadan nasıl gidebilirsiniz?!"
    },
    {
      "id": "b356b492",
      "bank_id": "30beb600",
      "text": "Hahaha!"
    },
    {
      "id": "b5b30d8d",
      "bank_id": "30beb600",
      "text": "Banshee kasabalıları daha fazla mahvetmeden onu yenmelisiniz!"
    },
    {
      "id": "b5b30d8e",
      "bank_id": "30beb600",
      "text": "Max ve Sam hiç şüphesiz tehlikede. Onları bırakamazsınız!"
    },
    {
      "id": "b5fd7897",
      "bank_id": "30beb600",
      "text": "Pöh!"
    },
    {
      "id": "b7ecef6f",
      "bank_id": "30beb600",
      "text": "Dönüşünü bekliyordum."
    },
    {
      "id": "bde28cfd",
      "bank_id": "30beb600",
      "text": "Çocuğunuzu geride bırakamazsınız!"
    },
    {
      "id": "bde28cfe",
      "bank_id": "30beb600",
      "text": "Şimdi ayrılamazsınız yoksa çocuğunuz bu korkunç hobbe'lerin elinde can verir!"
    },
    {
      "id": "c2368ea0",
      "bank_id": "30beb600",
      "text": "Ne kadar da zekisin öyle."
    },
    {
      "id": "c3369013",
      "bank_id": "30beb600",
      "text": "Daha azı için de adam öldürdüm. Daha fazlası için de. Ve yeri geldiğinde aynısı için de."
    },
    {
      "id": "c5369379",
      "bank_id": "30beb600",
      "text": "Bana vurmaya nasıl cüret edersin?!"
    },
    {
      "id": "c61f2589",
      "bank_id": "30beb600",
      "text": "Ah!"
    },
    {
      "id": "c65ae762",
      "bank_id": "30beb600",
      "text": "Canınız Azaldı"
    },
    {
      "id": "c841efc6",
      "bank_id": "30beb600",
      "text": "Aa, gidiyor musun?"
    },
    {
      "id": "cc05ae9e",
      "bank_id": "30beb600",
      "text": "Adadan yürüyerek ayrılamazsınız."
    },
    {
      "id": "cc7fe400",
      "bank_id": "30beb600",
      "text": "*sızlanır*"
    },
    {
      "id": "cd098c6c",
      "bank_id": "30beb600",
      "text": "Güzel bir sürpriz için mağaradan dışarı adım atın!"
    },
    {
      "id": "cd098c6f",
      "bank_id": "30beb600",
      "text": "Tommy bütün hobbe'leri temizlemeniz için size güveniyor!"
    },
    {
      "id": "cf3ed8d4",
      "bank_id": "30beb600",
      "text": "Vaktimi boşa harcama."
    },
    {
      "id": "d2ebc7f0",
      "bank_id": "30beb600",
      "text": "Argh! Enerjini Çile'ye saklasana be!"
    },
    {
      "id": "d31410bf",
      "bank_id": "30beb600",
      "text": "Ah, bu harika, gerçekten."
    },
    {
      "id": "d389a24c",
      "bank_id": "30beb600",
      "text": "Ah! Bu hiç de hayırseverce değil!"
    },
    {
      "id": "d4141212",
      "bank_id": "30beb600",
      "text": "Ne kadar da sevimli."
    },
    {
      "id": "d637f380",
      "bank_id": "30beb600",
      "text": "Başaracak bu kadar çok şeyimiz varken nasıl böyle davranabilirsin?"
    },
    {
      "id": "d642952a",
      "bank_id": "30beb600",
      "text": "Demek bana sürünerek geri geldin..."
    },
    {
      "id": "d681c717",
      "bank_id": "30beb600",
      "text": "<whimper>"
    },
    {
      "id": "d72f0c60",
      "bank_id": "30beb600",
      "text": "Reaver'ın sınavını geçmeden ayrılamazsınız."
    },
    {
      "id": "d72f0c65",
      "bank_id": "30beb600",
      "text": "Reaver şimdi ayrılmanıza izin vermez."
    },
    {
      "id": "d737f573",
      "bank_id": "30beb600",
      "text": "Umarım sana olan güvenim boşa çıkmaz."
    },
    {
      "id": "d7e48493",
      "bank_id": "30beb600",
      "text": "Aman tanrım... Olamaz...."
    },
    {
      "id": "d8579990",
      "bank_id": "30beb600",
      "text": "Seni paramparça edeceğim!"
    },
    {
      "id": "d8787bdc",
      "bank_id": "30beb600",
      "text": "Aagh!"
    },
    {
      "id": "d8e4a532",
      "bank_id": "30beb600",
      "text": "Ah! Dikkat etsene! Poligondan menederim seni!"
    },
    {
      "id": "d9579b03",
      "bank_id": "30beb600",
      "text": "Ufgh!"
    },
    {
      "id": "d9787d4f",
      "bank_id": "30beb600",
      "text": "Aagh!"
    },
    {
      "id": "da37f9cc",
      "bank_id": "30beb600",
      "text": "Değerli vaktimi boşa harcamaktan başka bir şey yapmıyorsun."
    },
    {
      "id": "da851ad3",
      "bank_id": "30beb600",
      "text": "<whimpers>"
    },
    {
      "id": "db579e69",
      "bank_id": "30beb600",
      "text": "Buraya gel seni!"
    },
    {
      "id": "db63cb25",
      "bank_id": "30beb600",
      "text": "<laughs>"
    },
    {
      "id": "db788095",
      "bank_id": "30beb600",
      "text": "Aagh!"
    },
    {
      "id": "dc3152f6",
      "bank_id": "30beb600",
      "text": "Önce Garth'a ulaşmadan ayrılamazsınız."
    },
    {
      "id": "dc37fd12",
      "bank_id": "30beb600",
      "text": "Bu gerçekten gerekli mi?"
    },
    {
      "id": "dceb8bd4",
      "bank_id": "30beb600",
      "text": "Bloodstone yerlisi olmadığına emin misin?"
    },
    {
      "id": "dd315469",
      "bank_id": "30beb600",
      "text": "Hammer'ı korumasız bırakamazsınız!"
    },
    {
      "id": "dd37fe85",
      "bank_id": "30beb600",
      "text": "Bunlar bir Kahramanın yapacağı hareketler değil."
    },
    {
      "id": "ddeb8d47",
      "bank_id": "30beb600",
      "text": "Pöh!"
    },
    {
      "id": "de57a322",
      "bank_id": "30beb600",
      "text": "Aagh!"
    },
    {
      "id": "deeb8f3a",
      "bank_id": "30beb600",
      "text": "Şey... T.O.B.Y. bununla ilgili değil."
    },
    {
      "id": "e02f1a4b",
      "bank_id": "30beb600",
      "text": "Hammer'ı geride bırakıp gidemezsiniz."
    },
    {
      "id": "e12f1c3e",
      "bank_id": "30beb600",
      "text": "İçeri bir kez girdiniz mi kaçamazsınız. Sona kadar savaşın!"
    },
    {
      "id": "e22f1d91",
      "bank_id": "30beb600",
      "text": "Kule'den kaçış yok!"
    },
    {
      "id": "e2be701e",
      "bank_id": "30beb600",
      "text": "<whimpers>"
    },
    {
      "id": "e32f1f04",
      "bank_id": "30beb600",
      "text": "Kule'den kaçmak için bir gemi bulmalısınız!"
    },
    {
      "id": "e52f226a",
      "bank_id": "30beb600",
      "text": "Garth'ı korumalısınız!"
    },
    {
      "id": "e52f226f",
      "bank_id": "30beb600",
      "text": "Garth ve Hammer ile Bower Gölü yolunda buluşmalısınız."
    },
    {
      "id": "e62f23dd",
      "bank_id": "30beb600",
      "text": "Cullis Geçidi devre dışı. Kuzeye geri dönüş yolu yok."
    },
    {
      "id": "e63162b1",
      "bank_id": "30beb600",
      "text": "Bowerstone köprüsü çöktü. Güneye gidebilmeniz için önce onarılması gerekiyor."
    },
    {
      "id": "e63162b4",
      "bank_id": "30beb600",
      "text": "Thag Bower Gölü'nden çıkan yolları kontrol ettiği sürece seyahat edemezsiniz."
    },
    {
      "id": "e7316427",
      "bank_id": "30beb600",
      "text": "Mağaradan çıkış yolunu bulana kadar ayrılamazsınız."
    },
    {
      "id": "eb701b5c",
      "bank_id": "30beb600",
      "text": "Sonunda ölüm ve yıkım seferlerine çıkacak olan güzel tekneler burada inşa edilir."
    },
    {
      "id": "ecb1395a",
      "bank_id": "30beb600",
      "text": "<whimpers>"
    },
    {
      "id": "ed9b3d26",
      "bank_id": "30beb600",
      "text": "T.O.B.Y. ile olan meseleyi çözmeden ayrılamazsınız."
    },
    {
      "id": "f09d8056",
      "bank_id": "30beb600",
      "text": "Şimdi ayrılırsanız hortlaklar tüm bölgeyi istila edecek!"
    },
    {
      "id": "f19d81c9",
      "bank_id": "30beb600",
      "text": "Bu mağaradan çıkmak için başka bir yol bulmalısınız!"
    },
    {
      "id": "f29d83bc",
      "bank_id": "30beb600",
      "text": "Ayrılırsanız Çiftçi Giles savunmasız kalacak."
    },
    {
      "id": "f2d48574",
      "bank_id": "30beb600",
      "text": "Bu harika."
    },
    {
      "id": "f39d852f",
      "bank_id": "30beb600",
      "text": "Ripper ile yaptığınız anlaşma yerine getirilene kadar ayrılamazsınız."
    },
    {
      "id": "f5d489cd",
      "bank_id": "30beb600",
      "text": "Mükemmel."
    },
    {
      "id": "f7b10df7",
      "bank_id": "30beb600",
      "text": "Ahhr!"
    },
    {
      "id": "f83a572f",
      "bank_id": "30beb600",
      "text": "Bloodstone Sahili No: 5, Bloodstone"
    },
    {
      "id": "f9875f8e",
      "bank_id": "30beb600",
      "text": "Etkilendim doğrusu."
    },
    {
      "id": "fa876161",
      "bank_id": "30beb600",
      "text": "Mükemmel."
    },
    {
      "id": "fa9d9014",
      "bank_id": "30beb600",
      "text": "İçeri bir kez girdiniz mi kaçamazsınız. Sona kadar savaşın!"
    },
    {
      "id": "fb8762d4",
      "bank_id": "30beb600",
      "text": "Bu dünyanın kurtarılmaya değer olduğunu hatırlamak güzel."
    },
    {
      "id": "fc876447",
      "bank_id": "30beb600",
      "text": "Bana bir zamanlar tanıdığım birini hatırlatıyorsun. Çok, çok uzun zaman önce."
    },
    {
      "id": "fd87663a",
      "bank_id": "30beb600",
      "text": "Evet, çok güzel, Kahraman."
    },
    {
      "id": "fe593299",
      "bank_id": "30beb600",
      "text": "Ah! Nasıl cüret edersin?"
    },
    {
      "id": "fe9d5270",
      "bank_id": "30beb600",
      "text": "Bir zamanlar Albion'daki en güzel kadınların birçoğuna ev sahipliği yapmıştı. Korsanlığın altın çağında, Bloodstone'un muazzam zenginlikleri onları buraya çekmişti."
    }
  ]
}