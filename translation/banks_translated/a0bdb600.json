    {
      "id": "a6b7273e",
      "bank_id": "a0bdb600",
      "text": "Hayatımda hiç bu kadar rahatlamamıştım."
    },
    {
      "id": "a6b7273f",
      "bank_id": "a0bdb600",
      "text": "Yürekten şükranlarımı sunarım."
    },
    {
      "id": "a8d0b370",
      "bank_id": "a0bdb600",
      "text": "Çıkarın beni buradan!"
    },
    {
      "id": "a8d0b371",
      "bank_id": "a0bdb600",
      "text": "Kurtarın beni buradan!"
    },
    {
      "id": "a8d0b372",
      "bank_id": "a0bdb600",
      "text": "Ah, kurtarıcım! Kurtar beni bu melun kafesten."
    },
    {
      "id": "a8d0b373",
      "bank_id": "a0bdb600",
      "text": "Yalvarırım size! Salın beni!"
    },
    {
      "id": "a8d0b374",
      "bank_id": "a0bdb600",
      "text": "Beni zorla kaçırdılar! İmdat!"
    },
    {
      "id": "a8d0b376",
      "bank_id": "a0bdb600",
      "text": "Kurtarın beni, lütfen!"
    },
    {
      "id": "a8d0b377",
      "bank_id": "a0bdb600",
      "text": "Çıkarın bizi buradan!"
    },
    {
      "id": "abb72ed9",
      "bank_id": "a0bdb600",
      "text": "Teşekkürler, çok teşekkürler!"
    },
    {
      "id": "abb72eda",
      "bank_id": "a0bdb600",
      "text": "Ah, beni kurtardınız! Çok teşekkür ederim!"
    },
    {
      "id": "abb72edb",
      "bank_id": "a0bdb600",
      "text": "Çok sağ olun!"
    },
    {
      "id": "abb72edc",
      "bank_id": "a0bdb600",
      "text": "Hayatımı kurtardın be!"
    },
    {
      "id": "abb72edd",
      "bank_id": "a0bdb600",
      "text": "Ha, sağ olasın! Borcum olsun!"
    },
    {
      "id": "abb72ede",
      "bank_id": "a0bdb600",
      "text": "Ah, yıldızlara şükürler olsun!"
    },
    {
      "id": "abb72edf",
      "bank_id": "a0bdb600",
      "text": "Gerçek bir kahramansınız."
    },
    {
      "id": "ac33d533",
      "bank_id": "a0bdb600",
      "text": "Ah! Neyin nesiydi bu şimdi?!"
    },
    {
      "id": "add0bb10",
      "bank_id": "a0bdb600",
      "text": "İmdat! Köle olmak istemiyorum ben!"
    },
    {
      "id": "add0bb11",
      "bank_id": "a0bdb600",
      "text": "Çıkarın beni! Çıkarın beni!"
    },
    {
      "id": "add0bb12",
      "bank_id": "a0bdb600",
      "text": "Yalvarırım, açın şu kafesi!"
    },
    {
      "id": "add0bb13",
      "bank_id": "a0bdb600",
      "text": "Ben köle olmak için doğmadım. Yardım edin ne olur!"
    },
    {
      "id": "add0bb15",
      "bank_id": "a0bdb600",
      "text": "Çıkarın beni! Lütfen!"
    },
    {
      "id": "add0bb16",
      "bank_id": "a0bdb600",
      "text": "Beni kurtarmak zorundasınız!"
    },
    {
      "id": "add0bb17",
      "bank_id": "a0bdb600",
      "text": "Lütfen! İmdat! Salın beni!"
    },
    {
      "id": "b77e0798",
      "bank_id": "a0bdb600",
      "text": "Hahaha! Harika be!"
    },
    {
      "id": "ba7e0c51",
      "bank_id": "a0bdb600",
      "text": "Hahaha!"
    },
    {
      "id": "bc588c67",
      "bank_id": "a0bdb600",
      "text": "*sızlanır*"
    },
    {
      "id": "bd588dda",
      "bank_id": "a0bdb600",
      "text": "Aaaah! Hayır, lütfen..."
    },
    {
      "id": "bddb6582",
      "bank_id": "a0bdb600",
      "text": "A, şimdiden gidiyor musunuz?"
    },
    {
      "id": "be7c7750",
      "bank_id": "a0bdb600",
      "text": "Evet, evet, mükemmel."
    },
    {
      "id": "c07c7ab6",
      "bank_id": "a0bdb600",
      "text": "Hakikaten enfes."
    },
    {
      "id": "c17c7c29",
      "bank_id": "a0bdb600",
      "text": "Pek güzel. Keşke acil işlerle bu denli meşgul olmasaydım."
    },
    {
      "id": "c27c7d9c",
      "bank_id": "a0bdb600",
      "text": "Bunu keşişler bile takdir eder doğrusu."
    },
    {
      "id": "c37c7f0f",
      "bank_id": "a0bdb600",
      "text": "Bu sahiden pek harikulade."
    },
    {
      "id": "c3fb5c14",
      "bank_id": "a0bdb600",
      "text": "Harika!"
    },
    {
      "id": "c4fb5d87",
      "bank_id": "a0bdb600",
      "text": "Evet, ne kadar güzel."
    },
    {
      "id": "c51119ce",
      "bank_id": "a0bdb600",
      "text": "Umarım vaktinde yetişirsin dostum. Detaylar notta yazıyor."
    },
    {
      "id": "c6df6e8e",
      "bank_id": "a0bdb600",
      "text": "Sohbetin ortasında çekip gitmenin kabalık olduğunu kimse öğretmedi mi sana?"
    },
    {
      "id": "c6fb60ed",
      "bank_id": "a0bdb600",
      "text": "Ne kadar da harika, değil mi?"
    },
    {
      "id": "c7d4030f",
      "bank_id": "a0bdb600",
      "text": "Köleleri kurtaracak mısınız?"
    },
    {
      "id": "caec864f",
      "bank_id": "a0bdb600",
      "text": "Suikast Kontratı"
    },
    {
      "id": "caef64dc",
      "bank_id": "a0bdb600",
      "text": "Tepemin tası atmak üzere bak!"
    },
    {
      "id": "cdef6995",
      "bank_id": "a0bdb600",
      "text": "Din adamı olabilirim ama sabrımı fena sınıyorsun!"
    },
    {
      "id": "d1640f44",
      "bank_id": "a0bdb600",
      "text": "Vay seni gidi mendebur dilenci..."
    },
    {
      "id": "d1aa13ab",
      "bank_id": "a0bdb600",
      "text": "Ooo! Hayııır, lütfen."
    },
    {
      "id": "d217ee50",
      "bank_id": "a0bdb600",
      "text": "Umrumda değil!"
    },
    {
      "id": "d2641137",
      "bank_id": "a0bdb600",
      "text": "Buna katlanacak değilim!"
    },
    {
      "id": "d2aa151e",
      "bank_id": "a0bdb600",
      "text": "Vah vah, vah başıma gelenler."
    },
    {
      "id": "d36412aa",
      "bank_id": "a0bdb600",
      "text": "Şu pisliğini git başkasına göster!"
    },
    {
      "id": "d4c36c29",
      "bank_id": "a0bdb600",
      "text": "Döndün ha? Ne diycektim ben ya? Hah, tamam."
    },
    {
      "id": "d6296450",
      "bank_id": "a0bdb600",
      "text": "Bunu yapanın böğrüne bıçağı saplarım normalde."
    },
    {
      "id": "d72965c3",
      "bank_id": "a0bdb600",
      "text": "Defol git buradan!"
    },
    {
      "id": "d7c6b6d2",
      "bank_id": "a0bdb600",
      "text": "Hop, nereye gidiyon öyle?"
    },
    {
      "id": "d82967b6",
      "bank_id": "a0bdb600",
      "text": "Beni gıcık etmeye mi çalışıyon sen?"
    },
    {
      "id": "d8d55248",
      "bank_id": "a0bdb600",
      "text": "Ben... Hiç sırası olduğunu sanmıyorum cidden."
    },
    {
      "id": "dad555ae",
      "bank_id": "a0bdb600",
      "text": "Tek istediğim Monty'm benim."
    },
    {
      "id": "db313f6c",
      "bank_id": "a0bdb600",
      "text": "Bu mühürlü parşömen \"ağır iş\" kampının yerini açığa çıkaracaktır. İçeriğini öğrenmek için <dpad.img> ile kullanın."
    },
    {
      "id": "dbd55701",
      "bank_id": "a0bdb600",
      "text": "Kusura bakmayın, yapacak o kadar çok işim var ki..."
    },
    {
      "id": "dc073e93",
      "bank_id": "a0bdb600",
      "text": "Ve unutmayın..."
    },
    {
      "id": "dc296de2",
      "bank_id": "a0bdb600",
      "text": "Kes şunu."
    },
    {
      "id": "dd296f55",
      "bank_id": "a0bdb600",
      "text": "Git başkasının canını sık."
    },
    {
      "id": "e4ef87e0",
      "bank_id": "a0bdb600",
      "text": "Ne diyordum ben? Hah, evet..."
    },
    {
      "id": "e623687f",
      "bank_id": "a0bdb600",
      "text": "Tepem atıyor artık!"
    },
    {
      "id": "e6ee23ae",
      "bank_id": "a0bdb600",
      "text": "Şunu derhâl kesmenizi rica ediyorum."
    },
    {
      "id": "e7ee2501",
      "bank_id": "a0bdb600",
      "text": "Işığın yolunu benimsemediğiniz gün gibi aşikâr."
    },
    {
      "id": "e8ee26f4",
      "bank_id": "a0bdb600",
      "text": "Işık ve saf olan her şey adına, durun!"
    },
    {
      "id": "e9ee2867",
      "bank_id": "a0bdb600",
      "text": "Eylemleriniz tapınağımızın üzerine şer gölgeleri düşürüyor."
    },
    {
      "id": "eaee29da",
      "bank_id": "a0bdb600",
      "text": "Ne demek oluyor bu şimdi?!"
    },
    {
      "id": "eafe1e30",
      "bank_id": "a0bdb600",
      "text": "Köle tacirleri türedi! Namuslu ahaliyi kaçırıp duruyolar valla. Başımıza dert oldular."
    },
    {
      "id": "eda777b0",
      "bank_id": "a0bdb600",
      "text": "Bundan iyisi can sağlığı valla."
    },
    {
      "id": "edc66781",
      "bank_id": "a0bdb600",
      "text": "Hahaha!"
    },
    {
      "id": "edd3e36f",
      "bank_id": "a0bdb600",
      "text": "Kafesin kilidini açın."
    },
    {
      "id": "edfe2289",
      "bank_id": "a0bdb600",
      "text": "Hey, baksana bi! Vatandaşlarına yardım eli uzatmak ister misin?"
    },
    {
      "id": "ee05e6f4",
      "bank_id": "a0bdb600",
      "text": "Ağır iş kampına gidin ve köleleri serbest bırakın."
    },
    {
      "id": "ee9b8ef5",
      "bank_id": "a0bdb600",
      "text": "Bilinen Son Konumu:"
    },
    {
      "id": "eea77923",
      "bank_id": "a0bdb600",
      "text": "Pek bi güzel oldu bu ya."
    },
    {
      "id": "f1a77dfc",
      "bank_id": "a0bdb600",
      "text": "A, ne hoş."
    },
    {
      "id": "f2ca5210",
      "bank_id": "a0bdb600",
      "text": "Bundan daha azı için adam öldürdüm ben!"
    },
    {
      "id": "f3a780c2",
      "bank_id": "a0bdb600",
      "text": "Vay vay, pek bi yakışıklı oldu bu."
    },
    {
      "id": "f4a782b5",
      "bank_id": "a0bdb600",
      "text": "Evet, evet, sevdim bunu."
    },
    {
      "id": "f4e801bf",
      "bank_id": "a0bdb600",
      "text": "Tamam, yetti dedim sana!"
    },
    {
      "id": "f5ca56e9",
      "bank_id": "a0bdb600",
      "text": "Beni kızdırmak istemezsin bak!"
    },
    {
      "id": "f5e80312",
      "bank_id": "a0bdb600",
      "text": "Pek öfkeli bir şarkı yazmanın eşiğindeyim doğrusu!"
    },
    {
      "id": "f8c6da14",
      "bank_id": "a0bdb600",
      "text": "Şu saçmalıklarla canımı sıkma benim."
    },
    {
      "id": "f9c6db87",
      "bank_id": "a0bdb600",
      "text": "İlgileniyor gibi bir halim mi var?"
    },
    {
      "id": "fbc6deed",
      "bank_id": "a0bdb600",
      "text": "Kendine sakla."
    },
    {
      "id": "fbd17a73",
      "bank_id": "a0bdb600",
      "text": "*sızlanır* Ooooff..."
    },
    {
      "id": "fc6a5265",
      "bank_id": "a0bdb600",
      "text": "Gidiyorsunuz demek, öyle mi?"
    },
    {
      "id": "fcd17be6",
      "bank_id": "a0bdb600",
      "text": "Aah! Hayır! Lütfen!"
    },
    {
      "id": "ffeb14f7",
      "bank_id": "a0bdb600",
      "text": "Aah! Hayııır, lütfen..."
    }
  ]
}