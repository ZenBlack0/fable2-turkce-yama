    },
    {
      "id": "140ea90d",
      "bank_id": "a0bdb600",
      "text": "Belki vaktimi harcamayı bırakıp arkeoloji davasına hizmet edersiniz."
    },
    {
      "id": "14177f2a",
      "bank_id": "a0bdb600",
      "text": "Ruhu nasıl neşelendireceğinizi iyi biliyorsunuz doğrusu."
    },
    {
      "id": "1517809d",
      "bank_id": "a0bdb600",
      "text": "Hem eğlendim hem feyzaldım valla."
    },
    {
      "id": "16e31158",
      "bank_id": "a0bdb600",
      "text": "Sivil Sürgün Detayları"
    },
    {
      "id": "18210897",
      "bank_id": "a0bdb600",
      "text": "İsim:"
