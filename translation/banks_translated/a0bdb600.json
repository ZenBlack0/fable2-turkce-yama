    {
      "id": "0d0e9e08",
      "bank_id": "a0bdb600",
      "text": "Seni izleyeceğime kendimi toprağa gömer bir milyon yıl bulunmamayı yeğlerim."
    },
    {
      "id": "0e0e9ffb",
      "bank_id": "a0bdb600",
      "text": "Antik çağları kimsenin umursamamasına şaşmamalı. Dünya ahmaklarla dolu."
