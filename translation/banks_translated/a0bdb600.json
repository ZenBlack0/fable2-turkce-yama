    {
      "id": "0ef962bc",
      "bank_id": "a0bdb600",
      "text": "Ah! Seni gidi velet!"
    },
    {
      "id": "0f0ea16e",
      "bank_id": "a0bdb600",
      "text": "Bu hiç ama hiç hoş değil."
    },
    {
      "id": "0f17770b",
      "bank_id": "a0bdb600",
      "text": "Bunu insanlara paralı izletebilseydik keşke. Zengin olurduk!"
