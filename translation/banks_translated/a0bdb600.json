    {
      "id": "069382e0",
      "bank_id": "a0bdb600",
      "text": "Sivil Sürgün Emri Detayları"
    },
    {
      "id": "070849ea",
      "bank_id": "a0bdb600",
      "text": "Pek güzel tabii de, bana göre değil hiç."
