{
  "bank_id": "d00cab00",
  "total_strings": 220,
  "strings": [
    {
      "id": "02ad1804",
      "bank_id": "d00cab00",
      "text": "Kenara ayıracak bir şeylerin olmalı."
    },
    {
      "id": "02ad1805",
      "bank_id": "d00cab00",
      "text": "Açım ve üşüyorum."
    },
    {
      "id": "04384792",
      "bank_id": "d00cab00",
      "text": "Aç kalmamı mı istiyorsun?"
    },
    {
      "id": "04384793",
      "bank_id": "d00cab00",
      "text": "Bize biraz altın versene, he?"
    },
    {
      "id": "04fccdbf",
      "bank_id": "d00cab00",
      "text": "Agu agu ha ha."
    },
    {
      "id": "0ab8da51",
      "bank_id": "d00cab00",
      "text": "HEMEN gitmezsen fena sinirleneceğim!"
    },
    {
      "id": "0b38529e",
      "bank_id": "d00cab00",
      "text": "Hadi be eli sıkı cimriler."
    },
    {
      "id": "0b38529f",
      "bank_id": "d00cab00",
      "text": "Burada açlıktan ölüyorum. Biraz merhamet gösterin."
    },
    {
      "id": "0dad29b4",
      "bank_id": "d00cab00",
      "text": "Ben de bir zamanlar hanımefendiydim, bilesin."
    },
    {
      "id": "0dad29b5",
      "bank_id": "d00cab00",
      "text": "Şu ceplerini bir yokla da bana ufak bir şeyler bul, olur mu?"
    },
    {
      "id": "120dc678",
      "bank_id": "d00cab00",
      "text": "Zavallı bir kadının ayağa kalkmasına yardım edin."
    },
    {
      "id": "120dc679",
      "bank_id": "d00cab00",
      "text": "Zavallı bir kadına yardım için sadece bir iki bozukluk."
    },
    {
      "id": "123074b0",
      "bank_id": "d00cab00",
      "text": "Ben de bir zamanlar senin gibiydim, karnımı doyurabiliyordum. Şimdiki halime bak."
    },
    {
      "id": "123074b3",
      "bank_id": "d00cab00",
      "text": "Bana kol kanat germek isteyen var mı?"
    },
    {
      "id": "14dca419",
      "bank_id": "d00cab00",
      "text": "Ühüüü vaaa!"
    },
    {
      "id": "19307fb4",
      "bank_id": "d00cab00",
      "text": "Yardımlarınız çok şeyi değiştirecek."
    },
    {
      "id": "19307fb5",
      "bank_id": "d00cab00",
      "text": "Öyle açım ki midem kendi kendini yemeye başladı."
    },
    {
      "id": "19307fb6",
      "bank_id": "d00cab00",
      "text": "Cimri olma. İyiliksever ol."
    },
    {
      "id": "1c96c9a8",
      "bank_id": "d00cab00",
      "text": "Hadi bakalım, buralarda oyalanmaya gerek yok."
    },
    {
      "id": "1c96c9ab",
      "bank_id": "d00cab00",
      "text": "Yoluna devam et şimdi."
    },
    {
      "id": "1d0dd7a8",
      "bank_id": "d00cab00",
      "text": "Geri öderim valla."
    },
    {
      "id": "1d0dd7a9",
      "bank_id": "d00cab00",
      "text": "Uyuyacak hiçbir yerim yok. Sence bu adil mi?"
    },
    {
      "id": "24e5dd59",
      "bank_id": "d00cab00",
      "text": "Vaaaa! Mık mık.... Vaaaa!"
    },
    {
      "id": "289327f8",
      "bank_id": "d00cab00",
      "text": "Agu hi hi!"
    },
    {
      "id": "2ba98e42",
      "bank_id": "d00cab00",
      "text": "Vaa! Vaa! Vaaaaaaaaaaa!"
    },
    {
      "id": "2c18dd18",
      "bank_id": "d00cab00",
      "text": "Bela mı istiyorsun? Al sana bela! Muhafızlaaaar!"
    },
    {
      "id": "2c18dd19",
      "bank_id": "d00cab00",
      "text": "Senin gibilerle başa çıkmanın tek yolu var! Muhafızlar!"
    },
    {
      "id": "2c18dd1a",
      "bank_id": "d00cab00",
      "text": "Sabrımı yeterince sınadın! Muhafızlar!"
    },
    {
      "id": "2c18dd1b",
      "bank_id": "d00cab00",
      "text": "Seni uyarmıştım, değil mi? Muhafızlar!"
    },
    {
      "id": "2c18dd1d",
      "bank_id": "d00cab00",
      "text": "Hâlâ burada mısın?! Muhafızlar hakkından gelir senin!"
    },
    {
      "id": "2c18dd1e",
      "bank_id": "d00cab00",
      "text": "Korkarım artık muhafızları çağırmak zorundayım.... Muhafızlaaaaaaaaaaaaaaaaaaaar!"
    },
    {
      "id": "2c18dd1f",
      "bank_id": "d00cab00",
      "text": "Bu kadar yeter, seninle muhafızlar ilgilenecek!"
    },
    {
      "id": "2ea22275",
      "bank_id": "d00cab00",
      "text": "Agu agu ha ha."
    },
    {
      "id": "325b0b32",
      "bank_id": "d00cab00",
      "text": "Vaaaa! Mık mık.... Vaaaa!"
    },
    {
      "id": "34446fc4",
      "bank_id": "d00cab00",
      "text": "Agu agu."
    },
    {
      "id": "34532e9f",
      "bank_id": "d00cab00",
      "text": "Vaa! Vaa! Vaaaaaaaaaaa!"
    },
    {
      "id": "349b5358",
      "bank_id": "d00cab00",
      "text": "Agu agu."
    },
    {
      "id": "34ab1451",
      "bank_id": "d00cab00",
      "text": "Rica etsem gider misiniz lütfen?"
    },
    {
      "id": "34ab1452",
      "bank_id": "d00cab00",
      "text": "Sanırım gitme vaktiniz geldi."
    },
    {
      "id": "34ab1453",
      "bank_id": "d00cab00",
      "text": "Buranın sizin eviniz olmadığının farkındasınız, değil mi?"
    },
    {
      "id": "34ab1454",
      "bank_id": "d00cab00",
      "text": "Evime izinsiz girilmesinden hiç hoşlanmam, o yüzden neden çekip gitmiyorsunuz?"
    },
    {
      "id": "34ab1455",
      "bank_id": "d00cab00",
      "text": "En son baktığımda bu ev hâlâ benimdi... O yüzden çık dışarı."
    },
    {
      "id": "34ab1456",
      "bank_id": "d00cab00",
      "text": "Evimden çıkmanızı kibarca rica ediyorum."
    },
    {
      "id": "34ab1457",
      "bank_id": "d00cab00",
      "text": "Şimdi giderseniz çok memnun olurum. Teşekkürler."
    },
    {
      "id": "3718ee48",
      "bank_id": "d00cab00",
      "text": "O zaman muhafızlar gelsin bakalım!"
    },
    {
      "id": "3718ee49",
      "bank_id": "d00cab00",
      "text": "Bu kadar yeter, muhafızları çağırıyorum!"
    },
    {
      "id": "3718ee4a",
      "bank_id": "d00cab00",
      "text": "Pekala, buna daha fazla katlanmayacağım. Muhafızlar!"
    },
    {
      "id": "3718ee4b",
      "bank_id": "d00cab00",
      "text": "Uyarılarıma kulak asmalıydın. Muhafızlar!"
    },
    {
      "id": "3718ee4c",
      "bank_id": "d00cab00",
      "text": "Bu kadar yeter, muhafızları çağırıyorum!"
    },
    {
      "id": "3718ee4e",
      "bank_id": "d00cab00",
      "text": "Bana başka seçenek bırakmadın, muhafızları çağırıyorum!"
    },
    {
      "id": "3718ee4f",
      "bank_id": "d00cab00",
      "text": "Çok sabırlı davrandım... Şu ana kadar. Muhafızlar!"
    },
    {
      "id": "377997c4",
      "bank_id": "d00cab00",
      "text": "Ühüüü vaaa!"
    },
    {
      "id": "3b9e34b0",
      "bank_id": "d00cab00",
      "text": "Bu bardağı taşırdı! Muhafızlar!"
    },
    {
      "id": "3b9e34b1",
      "bank_id": "d00cab00",
      "text": "Seni uyarmıştım! Muhafızlaaaar!"
    },
    {
      "id": "3b9e34b2",
      "bank_id": "d00cab00",
      "text": "Canıma tak etti. Muhafızları çağırıyorum!"
    },
    {
      "id": "3b9e34b3",
      "bank_id": "d00cab00",
      "text": "Muhafızları üstüne salacağım senin!"
    },
    {
      "id": "3b9e34b4",
      "bank_id": "d00cab00",
      "text": "Ha! Bunun yanına kâr kalacağını mı sanıyorsun? Muhafızlaaaaaaar, çabuk!"
    },
    {
      "id": "3b9e34b5",
      "bank_id": "d00cab00",
      "text": "Seni uyarmıştım! Muhafızlaaaar!"
    },
    {
      "id": "3b9e34b7",
      "bank_id": "d00cab00",
      "text": "Yetti artık! Muhafızlar!"
    },
    {
      "id": "3fab2580",
      "bank_id": "d00cab00",
      "text": "Burası pansiyon değil. Korkarım gitmek zorundasınız."
    },
    {
      "id": "3fab2582",
      "bank_id": "d00cab00",
      "text": "Burada yatak kiralamıyoruz. Başka yere gitmeniz gerek."
    },
    {
      "id": "3fab2583",
      "bank_id": "d00cab00",
      "text": "Aradığınız yer genelevse yanlış yere geldiniz. Lütfen gidin."
    },
    {
      "id": "3fab2584",
      "bank_id": "d00cab00",
      "text": "Neden kendi evinize gitmiyorsunuz?"
    },
    {
      "id": "3fab2585",
      "bank_id": "d00cab00",
      "text": "Bizi hanla veya genelevle karıştırdın herhalde. Her halükarda yanlış yerdesin."
    },
    {
      "id": "3fab2586",
      "bank_id": "d00cab00",
      "text": "Bizi bir hanla karıştırdınız galiba. Lütfen şimdi gidin."
    },
    {
      "id": "3fab2587",
      "bank_id": "d00cab00",
      "text": "Korkarım yanlış evdesiniz. Lütfen şimdi ayrılabilir misiniz?"
    },
    {
      "id": "3fd58413",
      "bank_id": "d00cab00",
      "text": "Vaaaa! Mık mık.... Vaaaa!"
    },
    {
      "id": "429e3fb8",
      "bank_id": "d00cab00",
      "text": "Bu kadar yeter! Muhafızlaaaar!"
    },
    {
      "id": "429e3fb9",
      "bank_id": "d00cab00",
      "text": "Muhafızlar! Muhafızlar!"
    },
    {
      "id": "429e3fba",
      "bank_id": "d00cab00",
      "text": "Seni uyarmıştım! Muhafızlar!"
    },
    {
      "id": "429e3fbc",
      "bank_id": "d00cab00",
      "text": "Pekala öyleyse! Muhafızlar!"
    },
    {
      "id": "429e3fbd",
      "bank_id": "d00cab00",
      "text": "Buna daha fazla katlanmayacağım! Muhafızlar!"
    },
    {
      "id": "429e3fbe",
      "bank_id": "d00cab00",
      "text": "Muhafızlar senin hakkından gelecek!"
    },
    {
      "id": "429e3fbf",
      "bank_id": "d00cab00",
      "text": "Muhafızları çağırıyorum!"
    },
    {
      "id": "455f4b98",
      "bank_id": "d00cab00",
      "text": "Vaaaa! Mık mık.... Vaaaa!"
    },
    {
      "id": "45e56ad3",
      "bank_id": "d00cab00",
      "text": "Agu agu."
    },
    {
      "id": "46eb91b0",
      "bank_id": "d00cab00",
      "text": "Azı çoğu olmaz, her yardım makbule geçer."
    },
    {
      "id": "46eb91b1",
      "bank_id": "d00cab00",
      "text": "Fazladan yiyeceğin var mı?"
    },
    {
      "id": "46eb91b3",
      "bank_id": "d00cab00",
      "text": "Yıllardır sokaklarda yaşıyorum, biliyor musun?"
    },
    {
      "id": "48ad0ac3",
      "bank_id": "d00cab00",
      "text": "Agu agu ha ha."
    },
    {
      "id": "4b5bbaf2",
      "bank_id": "d00cab00",
      "text": "Agu agu."
    },
    {
      "id": "4deb9cb4",
      "bank_id": "d00cab00",
      "text": "İş yok, ev yok, umut yok."
    },
    {
      "id": "4deb9cb5",
      "bank_id": "d00cab00",
      "text": "Lütfen, bu garibana bir el uzatın."
    },
    {
      "id": "4deb9cb6",
      "bank_id": "d00cab00",
      "text": "Birazcık bozukluk ayırabilirsin herhalde."
    },
    {
      "id": "508a46e6",
      "bank_id": "d00cab00",
      "text": "Vaa! Vaa! Vaaaaaaaaaaa!"
    },
    {
      "id": "6026a6d6",
      "bank_id": "d00cab00",
      "text": "Ühüüü vaaa!"
    },
    {
      "id": "639a1749",
      "bank_id": "d00cab00",
      "text": "Ne verirseniz verin. Yemeğe harcayacağıma söz veriyorum."
    },
    {
      "id": "648fb28c",
      "bank_id": "d00cab00",
      "text": "Bir altın bozukluk veren yok mu?"
    },
    {
      "id": "648fb28d",
      "bank_id": "d00cab00",
      "text": "Doyurmam gereken on yedi çocuk var, ne bir yardım var ne nafaka."
    },
    {
      "id": "648fb28e",
      "bank_id": "d00cab00",
      "text": "Lütfen, fazladan neyiniz varsa."
    },
    {
      "id": "65396408",
      "bank_id": "d00cab00",
      "text": "Agu agu ha ha."
    },
    {
      "id": "68461076",
      "bank_id": "d00cab00",
      "text": "Agu hi hi!"
    },
    {
      "id": "6aef977a",
      "bank_id": "d00cab00",
      "text": "Varlığınızı paylaşın ey ahali."
    },
    {
      "id": "6aef977b",
      "bank_id": "d00cab00",
      "text": "Lütfen, biraz hayırsever olun."
    },
    {
      "id": "6d8fc0d8",
      "bank_id": "d00cab00",
      "text": "Biraz bozukluk var mı?"
    },
    {
      "id": "6d8fc0d9",
      "bank_id": "d00cab00",
      "text": "Evsiz birine yardım eder misiniz?"
    },
    {
      "id": "6d8fc0db",
      "bank_id": "d00cab00",
      "text": "Lütfen. Bir haftadır yemek yemedim."
    },
    {
      "id": "6f0848f1",
      "bank_id": "d00cab00",
      "text": "Evsizlik bir hastalık değildir."
    },
    {
      "id": "6f0848f2",
      "bank_id": "d00cab00",
      "text": "Sadece birazcık fazladan altına ihtiyacım var. Lütfen?"
    },
    {
      "id": "6f0848f3",
      "bank_id": "d00cab00",
      "text": "İyi niyetinize sığınıyorum."
    },
    {
      "id": "73efa54e",
      "bank_id": "d00cab00",
      "text": "Muhakkak kenara ayıracak bir şeyin vardır. Hadi ama!"
    },
    {
      "id": "73efa54f",
      "bank_id": "d00cab00",
      "text": "Bir zamanlar her şeyim vardı. Şimdi hiçbir şeyim yok."
    },
    {
      "id": "7a085a20",
      "bank_id": "d00cab00",
      "text": "Her türlü bağış makbule geçer."
    },
    {
      "id": "7a085a22",
      "bank_id": "d00cab00",
      "text": "Sadaka! Fakirlere sadaka!"
    },
    {
      "id": "7a085a23",
      "bank_id": "d00cab00",
      "text": "Lütfen, çocuklarım aç."
    },
    {
      "id": "81594af8",
      "bank_id": "d00cab00",
      "text": "Hadi ama, biraz mangır ver."
    },
    {
      "id": "81594af9",
      "bank_id": "d00cab00",
      "text": "Biraz altın sökül artık."
    },
    {
      "id": "83187b71",
      "bank_id": "d00cab00",
      "text": "Ufak bir şey ayırabilirsen ömrümün sonuna kadar minnettar kalırım."
    },
    {
      "id": "83187b72",
      "bank_id": "d00cab00",
      "text": "Sadece bir somun ekmek alacak kadar lazım."
    },
    {
      "id": "83187b73",
      "bank_id": "d00cab00",
      "text": "Bütün hafta kavrulmuş çakıl taşından başka bir şey yemedim."
    },
    {
      "id": "8ad0956f",
      "bank_id": "d00cab00",
      "text": "Agu hi hi!"
    },
    {
      "id": "8c44287c",
      "bank_id": "d00cab00",
      "text": "Bu senin de başına gelebilir."
    },
    {
      "id": "8c44287d",
      "bank_id": "d00cab00",
      "text": "Ah, bir de gerçek bir yatakta uyuyabilsem."
    },
    {
      "id": "8c44287e",
      "bank_id": "d00cab00",
      "text": "Ben sadece talihi yaver gitmemiş zavallı bir kadınım."
    },
    {
      "id": "8c595c28",
      "bank_id": "d00cab00",
      "text": "Hadi ama, cimrilik etme."
    },
    {
      "id": "8c595c29",
      "bank_id": "d00cab00",
      "text": "Bana biraz altın ver."
    },
    {
      "id": "8e188ca0",
      "bank_id": "d00cab00",
      "text": "Lütfen, haftayı çıkarmam için sadece birkaç bozukluk."
    },
    {
      "id": "8e188ca2",
      "bank_id": "d00cab00",
      "text": "Lütfen, bana verebileceğiniz bir şeyler mutlaka vardır."
    },
    {
      "id": "8e188ca3",
      "bank_id": "d00cab00",
      "text": "Ufacık bir yardım bile işe yarar."
    },
    {
      "id": "8eca19d0",
      "bank_id": "d00cab00",
      "text": "Artık gerçekten gitsen iyi olur."
    },
    {
      "id": "8eca19d1",
      "bank_id": "d00cab00",
      "text": "Giderseniz gerçekten çok memnun olurum."
    },
    {
      "id": "8eca19d2",
      "bank_id": "d00cab00",
      "text": "Gidecek başka bir yerin olmalı?"
    },
    {
      "id": "8eca19d6",
      "bank_id": "d00cab00",
      "text": "Gitme vaktin geldi artık, değil mi?"
    },
    {
      "id": "8eca19d7",
      "bank_id": "d00cab00",
      "text": "Rica etsem çıkar mısınız?"
    },
    {
      "id": "95443648",
      "bank_id": "d00cab00",
      "text": "Sadece bu gece kalacak bir sığınağa ihtiyacım var."
    },
    {
      "id": "95443649",
      "bank_id": "d00cab00",
      "text": "Lütfen, biraz merhamet gösterin."
    },
    {
      "id": "9544364b",
      "bank_id": "d00cab00",
      "text": "Ben dürüst bir vatandaşım. Sadece birazcık yardıma ihtiyacım var."
    },
    {
      "id": "97ca283a",
      "bank_id": "d00cab00",
      "text": "Gitsene artık, he?"
    },
    {
      "id": "97ca283b",
      "bank_id": "d00cab00",
      "text": "Ne diye buralarda oyalanıyorsun ki?"
    },
    {
      "id": "97ca283c",
      "bank_id": "d00cab00",
      "text": "Şimdi gitsen çok iyi olur."
    },
    {
      "id": "97ca283d",
      "bank_id": "d00cab00",
      "text": "Şimdi gitsen nasıl olur?"
    },
    {
      "id": "97ca283f",
      "bank_id": "d00cab00",
      "text": "Çekip gitsene sen ya?"
    },
    {
      "id": "97e0c1cd",
      "bank_id": "d00cab00",
      "text": "Lütfen, talihi yaver gitmemiş bir kadına yardım edin."
    },
    {
      "id": "97e0c1ce",
      "bank_id": "d00cab00",
      "text": "Yardımınızla yeniden ayağa kalkabilirim. Hayatımı geri kazanabilirim."
    },
    {
      "id": "97e0c1cf",
      "bank_id": "d00cab00",
      "text": "Yüreğinizde biraz merhamet bulun."
    },
    {
      "id": "9cfcd739",
      "bank_id": "d00cab00",
      "text": "Agu hi hi!"
    },
    {
      "id": "a2e0d37e",
      "bank_id": "d00cab00",
      "text": "Sokakta yaşamaktan zevk mi alıyorum sanıyorsun?"
    },
    {
      "id": "a2e0d37f",
      "bank_id": "d00cab00",
      "text": "Eskiden işim, evim, ailem vardı. Şimdi hiçbir şeyim kalmadı."
    },
    {
      "id": "a45d7228",
      "bank_id": "d00cab00",
      "text": "Tutuklusun, haneye tecavüzcü!"
    },
    {
      "id": "a45d722b",
      "bank_id": "d00cab00",
      "text": "Benim nöbetimde kimse haneye tecavüz edemez!"
    },
    {
      "id": "a6ed2604",
      "bank_id": "d00cab00",
      "text": "Yemeğin tadının nasıl olduğunu bile hatırlamıyorum."
    },
    {
      "id": "a6ed2605",
      "bank_id": "d00cab00",
      "text": "Hayırseverlik sokakta başlar."
    },
    {
      "id": "a6ed2607",
      "bank_id": "d00cab00",
      "text": "Lütfen, bir iş bulunca kime borcum varsa geri ödeyeceğim."
    },
    {
      "id": "adb3084f",
      "bank_id": "d00cab00",
      "text": "Ühüüü vaaa!"
    },
    {
      "id": "aded3108",
      "bank_id": "d00cab00",
      "text": "Dilencilik zor zanaat. Bir maaşı hak ediyorum."
    },
    {
      "id": "aded3109",
      "bank_id": "d00cab00",
      "text": "Şansı yaver gitmeyen birine bir şeyler var mı? Altın, koyun eti... bir şişe porto şarabı...?"
    },
    {
      "id": "aded310a",
      "bank_id": "d00cab00",
      "text": "Doyurmam gereken on iki çocuk var."
    },
    {
      "id": "b209a920",
      "bank_id": "d00cab00",
      "text": "Herkes bir gün benim durumuma düşebilir."
    },
    {
      "id": "b209a921",
      "bank_id": "d00cab00",
      "text": "Zavallı bir dilenciye biraz merhametiniz yok mu?"
    },
    {
      "id": "b209a922",
      "bank_id": "d00cab00",
      "text": "Bu sizin iyi bir insan olma şansınız."
    },
    {
      "id": "b61fd364",
      "bank_id": "d00cab00",
      "text": "Agu hi hi!"
    },
    {
      "id": "bb09b70c",
      "bank_id": "d00cab00",
      "text": "Sizden daha az şanslı birine yardım edin."
    },
    {
      "id": "bb09b70d",
      "bank_id": "d00cab00",
      "text": "Hayatta sadece bir şansa ihtiyacım var."
    },
    {
      "id": "bb09b70f",
      "bank_id": "d00cab00",
      "text": "Bir iyilik yapın. Bana altın verin."
    },
    {
      "id": "bf5534f1",
      "bank_id": "d00cab00",
      "text": "Bu kadar yeter, bittin sen!"
    },
    {
      "id": "bf5534f2",
      "bank_id": "d00cab00",
      "text": "Uyarılmıştın, davetsiz misafir!"
    },
    {
      "id": "c068cb22",
      "bank_id": "d00cab00",
      "text": "Üç haftadır boğazımdan bir damla geçmedi."
    },
    {
      "id": "c068cb23",
      "bank_id": "d00cab00",
      "text": "Talihi kara bir adama biraz altın verin."
    },
    {
      "id": "c198c560",
      "bank_id": "d00cab00",
      "text": "Lütfen. Ömrümün sonuna kadar minnettar kalırım."
    },
    {
      "id": "c198c561",
      "bank_id": "d00cab00",
      "text": "Sokaklarda yaşamak çok zor."
    },
    {
      "id": "c198c563",
      "bank_id": "d00cab00",
      "text": "Ufacık bir şey bile yok mu?"
    },
    {
      "id": "c4d8e09d",
      "bank_id": "d00cab00",
      "text": "Siz de bir zamanlar aç kalmış olmalısınız."
    },
    {
      "id": "c4d8e09e",
      "bank_id": "d00cab00",
      "text": "Fakir olmanın nasıl bir şey olduğunu hatırlıyor olmalısınız."
    },
    {
      "id": "c4d8e09f",
      "bank_id": "d00cab00",
      "text": "Sadece hayatta kalacak kadarına ihtiyacım var."
    },
    {
      "id": "c768d62e",
      "bank_id": "d00cab00",
      "text": "İnsafa gelin de bir el uzatın."
    },
    {
      "id": "c768d62f",
      "bank_id": "d00cab00",
      "text": "Bir şeyler içmem lazım. Hadi be, biraz para ver."
    },
    {
      "id": "c898d064",
      "bank_id": "d00cab00",
      "text": "Daha yeni işimi kaybettim."
    },
    {
      "id": "c898d065",
      "bank_id": "d00cab00",
      "text": "Sadece azıcık bir şey, ayağa kalkmama yardım edin."
    },
    {
      "id": "c898d066",
      "bank_id": "d00cab00",
      "text": "Sadece birazcık yardıma ihtiyacım var."
    },
    {
      "id": "cfd8f1cc",
      "bank_id": "d00cab00",
      "text": "Kenara ayırabileceğiniz bir şeyiniz mutlaka vardır."
    },
    {
      "id": "cfd8f1ce",
      "bank_id": "d00cab00",
      "text": "Şimdiden hepinize teşekkür ederim."
    },
    {
      "id": "cfd8f1cf",
      "bank_id": "d00cab00",
      "text": "Lütfen, ne olursa olsun. Ufacık bir kırıntı bile olur. Lütfen?"
    },
    {
      "id": "d9bcb8b0",
      "bank_id": "d00cab00",
      "text": "Gerçekten gitme vaktinizin geldiğini düşünüyorum."
    },
    {
      "id": "d9bcb8b1",
      "bank_id": "d00cab00",
      "text": "Benim evime girebileceğinizi size düşündüren neydi merak ediyorum... Çekip gidin lütfen, tamam mı?"
    },
    {
      "id": "d9bcb8b2",
      "bank_id": "d00cab00",
      "text": "Gitseniz daha iyi olmaz mıydı?"
    },
    {
      "id": "d9bcb8b4",
      "bank_id": "d00cab00",
      "text": "Burada olmamanız gerektiğine inanıyorum."
    },
    {
      "id": "d9bcb8b5",
      "bank_id": "d00cab00",
      "text": "Lütfen, mülkümden şimdi ayrılabilir misiniz?"
    },
    {
      "id": "d9bcb8b6",
      "bank_id": "d00cab00",
      "text": "Şimdi gidemez misiniz?"
    },
    {
      "id": "d9bcb8b7",
      "bank_id": "d00cab00",
      "text": "Başka evler de var biliyorsunuz, değil mi? Bu ev benim."
    },
    {
      "id": "dacb4862",
      "bank_id": "d00cab00",
      "text": "Agu agu ha ha."
    },
    {
      "id": "dbf872d5",
      "bank_id": "d00cab00",
      "text": "Artık gerçekten gitmelisiniz, vatandaş."
    },
    {
      "id": "dbf872d6",
      "bank_id": "d00cab00",
      "text": "Şimdi gitmeniz en iyisi olur, vatandaş."
    },
    {
      "id": "e2bcc698",
      "bank_id": "d00cab00",
      "text": "Lütfen en yakın çıkışa doğru ilerleyin."
    },
    {
      "id": "e2bcc699",
      "bank_id": "d00cab00",
      "text": "Şimdi giderseniz sevinirim."
    },
    {
      "id": "e2bcc69a",
      "bank_id": "d00cab00",
      "text": "Kendinize ait bir eviniz olmalı, değil mi?"
    },
    {
      "id": "e2bcc69b",
      "bank_id": "d00cab00",
      "text": "Kendi evinize gitmeniz gerekmez mi?"
    },
    {
      "id": "e2bcc69c",
      "bank_id": "d00cab00",
      "text": "Gerçekten gitmelisiniz."
    },
    {
      "id": "e2bcc69d",
      "bank_id": "d00cab00",
      "text": "Gidecek kendinize ait bir eviniz yok mu?"
    },
    {
      "id": "e2bcc69f",
      "bank_id": "d00cab00",
      "text": "Gitmenizi istemek zorunda kalacağım."
    },
    {
      "id": "e68cf369",
      "bank_id": "d00cab00",
      "text": "Vaa! Vaa! Vaaaaaaaaaaa!"
    },
    {
      "id": "eb03bada",
      "bank_id": "d00cab00",
      "text": "İzinsiz girenleri hiç sevmem! O yüzden hemen defol git!"
    },
    {
      "id": "eb03badb",
      "bank_id": "d00cab00",
      "text": "Ben senin viranenin etrafında öylece dikilsem hoşuna gider miydi?"
    },
    {
      "id": "eb03badc",
      "bank_id": "d00cab00",
      "text": "Gidecek misin yoksa muhafızları çağırmak zorunda mı kalayım?"
    },
    {
      "id": "eb03badd",
      "bank_id": "d00cab00",
      "text": "Hemen şimdi gitmezsen çığlığı basacağım!"
    },
    {
      "id": "eb03bade",
      "bank_id": "d00cab00",
      "text": "Ben seni kovdurtmadan önce çekil git!"
    },
    {
      "id": "f1e134d8",
      "bank_id": "d00cab00",
      "text": "Lütfen, bize biraz yardım edin."
    },
    {
      "id": "f1e134da",
      "bank_id": "d00cab00",
      "text": "Çok açım."
    },
    {
      "id": "f1e134db",
      "bank_id": "d00cab00",
      "text": "Fazladan birazcık altına gerçekten çok ihtiyacım var."
    },
    {
      "id": "f403c928",
      "bank_id": "d00cab00",
      "text": "Bir daha sormayacağım! Mülkümden defol git!"
    },
    {
      "id": "f403c929",
      "bank_id": "d00cab00",
      "text": "Hemen çık dışarı, yoksa kanun tepene biner!"
    },
    {
      "id": "f403c92b",
      "bank_id": "d00cab00",
      "text": "Çıkmazsan muhafızlar canına okur!"
    },
    {
      "id": "f403c92e",
      "bank_id": "d00cab00",
      "text": "Beni dinle sen: ŞİMDİ defol git buradan."
    },
    {
      "id": "f403c92f",
      "bank_id": "d00cab00",
      "text": "Defolup gitsen iyi edersin hobbe seni!"
    },
    {
      "id": "f6918342",
      "bank_id": "d00cab00",
      "text": "Sana bir ders vermek lazım. Muhafızlaaaaaaaaaaaaar!"
    },
    {
      "id": "f6918343",
      "bank_id": "d00cab00",
      "text": "Biliyor musun ne olacak? Muhafızlaaaar!"
    },
    {
      "id": "f6918344",
      "bank_id": "d00cab00",
      "text": "Sabrım tamamen tükendi! Muhafızlar hakkından gelecek!"
    },
    {
      "id": "f6918345",
      "bank_id": "d00cab00",
      "text": "Buna daha fazla katlanamayacağım! Muhafızlar!"
    },
    {
      "id": "f6918347",
      "bank_id": "d00cab00",
      "text": "Muhafızlar gelsin öyleyse!"
    },
    {
      "id": "f6b88905",
      "bank_id": "d00cab00",
      "text": "Vaaaa! Mık mık.... Vaaaa!"
    },
    {
      "id": "f6e13cf9",
      "bank_id": "d00cab00",
      "text": "Zavallı bir adama acıyın."
    },
    {
      "id": "f6e13cfa",
      "bank_id": "d00cab00",
      "text": "Bir garibana yardım edin, olur mu?"
    },
    {
      "id": "f6e13cfb",
      "bank_id": "d00cab00",
      "text": "Dilenciler de insan."
    },
    {
      "id": "fcc6dcc5",
      "bank_id": "d00cab00",
      "text": "Agu agu."
    },
    {
      "id": "fcdb5b54",
      "bank_id": "d00cab00",
      "text": "Vaa! Vaa! Vaaaaaaaaaaa!"
    },
    {
      "id": "fd918e48",
      "bank_id": "d00cab00",
      "text": "Yetti be! Muhafızlar!"
    },
    {
      "id": "fd918e49",
      "bank_id": "d00cab00",
      "text": "Sana fırsat vermiştim! Muhafızlar!"
    },
    {
      "id": "fd918e4a",
      "bank_id": "d00cab00",
      "text": "Canıma tak etti! Muhafızlar!"
    },
    {
      "id": "fd918e4e",
      "bank_id": "d00cab00",
      "text": "Çizmeyi aştın artık! Muhafızlar!"
    },
    {
      "id": "fd918e4f",
      "bank_id": "d00cab00",
      "text": "Muhafızlar!"
    },
    {
      "id": "fffc04c5",
      "bank_id": "d00cab00",
      "text": "Ühüüü vaaa!"
    }
  ]
}