    {
      "id": "e50e31da",
      "bank_id": "80359601",
      "text": "Ya yap ya da git!"
    },
    {
      "id": "e50e31db",
      "bank_id": "80359601",
      "text": "Bitir şunu artık! İçecek içkim var benim."
    },
    {
      "id": "e50e31dc",
      "bank_id": "80359601",
      "text": "Bunu neden görmek isteyeyim ki?"
    },
    {
      "id": "e50e31dd",
      "bank_id": "80359601",
      "text": "Vaktimi boşa harcayıp durma!"
    },
    {
      "id": "e50e31de",
      "bank_id": "80359601",
      "text": "Hadi gel bakalım o zaman!"
    },
    {
      "id": "e58369d8",
      "bank_id": "80359601",
      "text": "Selam."
    },
    {
      "id": "e58369d9",
      "bank_id": "80359601",
      "text": "Selam çocuk."
    },
    {
      "id": "e58369db",
      "bank_id": "80359601",
      "text": "Merhaba."
    },
    {
      "id": "ed1a36bb",
