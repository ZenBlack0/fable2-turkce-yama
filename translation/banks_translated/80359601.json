      "bank_id": "80359601",
      "text": "Nasılsın?"
    },
    {
      "id": "828535f0",
      "bank_id": "80359601",
      "text": "Ah canım benim. Her gülden daha güzelsin."
    },
    {
      "id": "828535f1",
      "bank_id": "80359601",
      "text": "Senin yanında altın bile parıltısını kaybeder."
    },
    {
      "id": "828535f2",
      "bank_id": "80359601",
      "text": "Merhabalar."
    },
    {
      "id": "828535f3",
      "bank_id": "80359601",
      "text": "Ah, benim tatlı çöreğim. Ne lezizsin öyle."
    },
    {
      "id": "828535f4",
      "bank_id": "80359601",
      "text": "Nihayet geldin demek."
    },
    {
      "id": "828535f5",
      "bank_id": "80359601",
      "text": "Nihayet sevgilim benim."
    },
    {
      "id": "828535f7",
      "bank_id": "80359601",
      "text": "Ah, tatlım benim."
    },
    {
      "id": "83ba0068",
      "bank_id": "80359601",
      "text": "Hey! Selam ünlü kişi!"
    },
    {
      "id": "83ba0069",
      "bank_id": "80359601",
      "text": "Vay canına, sen olduğuna inanamıyorum!"
    },
    {
      "id": "83ba006d",
      "bank_id": "80359601",
      "text": "Hey! Sensin!"
    },
    {
      "id": "83ba006e",
      "bank_id": "80359601",
      "text": "Ah! Sensin! Harika!"
    },
    {
      "id": "83ba006f",
      "bank_id": "80359601",
      "text": "Vay canına, çok ünlüsün sen! Selam!"
    },
    {
      "id": "898540f8",
      "bank_id": "80359601",
      "text": "Merhaba, sen küçük bir güneş ışığı mısın nesin öyle."
    },
    {
      "id": "898540f9",
      "bank_id": "80359601",
      "text": "Merhabalar efendim."
    },
    {
      "id": "898540fa",
      "bank_id": "80359601",
      "text": "Merhabalar canım."
    },
    {
      "id": "898540fc",
      "bank_id": "80359601",
      "text": "Her gittiğinde nefesimi kesiyorsun ama döndüğünde geri veriyorsun."
    },
    {
      "id": "898540fd",
      "bank_id": "80359601",
      "text": "Seni yeniden görmek ne kadar da büyüleyici."
    },
    {
      "id": "898540fe",
      "bank_id": "80359601",
      "text": "Meeeerhabaaaalar."
    },
    {
      "id": "898540ff",
      "bank_id": "80359601",
      "text": "Ah, içimi öyle aydınlatıyorsun ki."
    },
    {
      "id": "89e04511",
      "bank_id": "80359601",
      "text": "Ooo, döndün demek!"
    },
    {
      "id": "89e04512",
      "bank_id": "80359601",
      "text": "Ah, seni gördüğüme çok sevindim!"
    },
    {
      "id": "89e04513",
      "bank_id": "80359601",
      "text": "Ah, seni görmek yüreğimi kabartıyor!"
    },
    {
      "id": "89e04514",
      "bank_id": "80359601",
      "text": "Seni yeniden görmek ne hoş!"
    },
    {
      "id": "89e04515",
      "bank_id": "80359601",
      "text": "Ah, döndün demek?"
    },
    {
      "id": "89e04516",
      "bank_id": "80359601",
      "text": "Ah, seni görmek güneşi içine çekmek gibi bir şey!"
    },
    {
      "id": "89e04517",
      "bank_id": "80359601",
      "text": "Dönmüş olman ne harika canım benim."
    },
    {
      "id": "8ca8a922",
      "bank_id": "80359601",
      "text": "Selam tatlım."
    },
    {
      "id": "8ca8a923",
      "bank_id": "80359601",
      "text": "Selam, seni bekliyordum ben de..."
    },
    {
      "id": "8ca8a924",
      "bank_id": "80359601",
      "text": "Seni beklerdim ama dönmene bayılıyorum."
    },
    {
      "id": "8ca8a925",
      "bank_id": "80359601",
      "text": "Seni beklemek ızdırap ama görmek safi zevk."
    },
    {
      "id": "8ca8a927",
      "bank_id": "80359601",
      "text": "Seni bekliyordum ama buna o kadar değiyor ki."
    },
    {
      "id": "8eba1198",
      "bank_id": "80359601",
      "text": "Gözlerime inanamıyorum! Selam!"
    },
    {
      "id": "8eba1199",
      "bank_id": "80359601",
      "text": "Bayağı ünlüsün sen, değil mi?"
    },
    {
      "id": "8eba119c",
      "bank_id": "80359601",
      "text": "Ah! Selam! Sensin!"
    },
    {
      "id": "8eba119e",
      "bank_id": "80359601",
      "text": "İlk doğacak çocuğuma senin adını vereceğim!"
    },
    {
      "id": "8eba119f",
      "bank_id": "80359601",
      "text": "Selam! Hakkındaki her şeyi duydum!"
    },
    {
      "id": "912bac28",
      "bank_id": "80359601",
      "text": "Öğk! Bebekken seni yere falan mı düşürdüler?"
    },
    {
      "id": "912bac2a",
      "bank_id": "80359601",
      "text": "Böyle mi doğdun sen?"
    },
    {
      "id": "912bac2b",
      "bank_id": "80359601",
      "text": "Öğk! Bu... ilginç bir yüzmüş."
    },
    {
      "id": "912bac2c",
      "bank_id": "80359601",
      "text": "Selam. Bu tipe bir el atsan iyi edersin belki."
    },
    {
      "id": "912bac2d",
      "bank_id": "80359601",
      "text": "Dostum, talih sana fena kazık atmış."
    },
    {
      "id": "912bac2e",
      "bank_id": "80359601",
      "text": "Aman tanrım! İyi misiniz acaba?"
    },
    {
      "id": "912bac2f",
      "bank_id": "80359601",
      "text": "Ahh, hmm, esenlikler."
    },
    {
      "id": "92c208fc",
      "bank_id": "80359601",
      "text": "Zerre kadar ilgilenmiyorum."
    },
    {
      "id": "92c208ff",
      "bank_id": "80359601",
      "text": "Hoşuma gitmezse seni tutuklamaya hazırım."
    },
    {
      "id": "93a8b428",
      "bank_id": "80359601",
      "text": "Sevgilim. Beklemeyi bırakabilirim artık."
    },
    {
      "id": "93a8b429",
      "bank_id": "80359601",
      "text": "Harika. Çok uzun zaman olmuştu."
    },
    {
      "id": "93a8b42a",
      "bank_id": "80359601",
      "text": "Ah, beklemek o kadar uzun sürüyor ki canım."
    },
    {
      "id": "93a8b42e",
      "bank_id": "80359601",
      "text": "Gel buraya da sana bir bakayım!"
    },
    {
      "id": "93a8b42f",
      "bank_id": "80359601",
      "text": "Asırlardır bekliyorum. Seni çok özledim."
    },
    {
      "id": "94e05640",
      "bank_id": "80359601",
      "text": "Merhaba sen."
    },
    {
      "id": "94e05642",
      "bank_id": "80359601",
      "text": "Ah, merhaba!"
    },
    {
      "id": "94e05643",
      "bank_id": "80359601",
      "text": "Seni yeniden görmeyi umuyordum."
    },
    {
      "id": "94e05644",
      "bank_id": "80359601",
      "text": "Eee, her şey nasıl gidiyor bakalım?"
    },
    {
      "id": "94e05645",
      "bank_id": "80359601",
      "text": "Merhaba tatlım!"
    },
    {
      "id": "94e05646",
      "bank_id": "80359601",
      "text": "Seni yeniden görmek harika."
    },
    {
      "id": "94e05647",
      "bank_id": "80359601",
      "text": "Ah, seni görmek öyle güzel ki!"
    },
    {
      "id": "962bb3c9",
      "bank_id": "80359601",
      "text": "Şey... evet... merhaba."
    },
    {
      "id": "962bb3ca",
      "bank_id": "80359601",
      "text": "Aman tanrım. Yani, selamlar."
    },
    {
      "id": "962bb3cb",
      "bank_id": "80359601",
      "text": "Öğk! Neyin var senin?"
    },
    {
      "id": "962bb3cc",
      "bank_id": "80359601",
      "text": "Selam! Şey... o senin gerçek yüzün mü?"
    },
    {
      "id": "962bb3cd",
      "bank_id": "80359601",
      "text": "Evet, peki, merhaba falan filan."
    },
    {
      "id": "962bb3ce",
      "bank_id": "80359601",
      "text": "Öğk! Evet... Merhaba."
    },
    {
      "id": "962bb3cf",
      "bank_id": "80359601",
      "text": "Aman tanrım!"
    },
    {
      "id": "9a64be0e",
      "bank_id": "80359601",
      "text": "Öğğk! Şey, selam."
    },
    {
      "id": "9cb63df4",
      "bank_id": "80359601",
      "text": "Ne var yine?!"
    },
    {
      "id": "9cb63df6",
      "bank_id": "80359601",
      "text": "Beni yalnız bırak sokak faresi."
    },
    {
      "id": "9cb63df7",
      "bank_id": "80359601",
      "text": "Ne?!"
    },
    {
      "id": "a1b64595",
      "bank_id": "80359601",
      "text": "Sen. Evet, senin hakkındaki her şeyi biliyorum."
    },
    {
      "id": "a1b64596",
      "bank_id": "80359601",
      "text": "Senin gibilere ayıracak vaktim yok."
    },
    {
      "id": "a1b64597",
      "bank_id": "80359601",
      "text": "İlerle bakalım."
    },
    {
      "id": "a289b944",
      "bank_id": "80359601",
      "text": "Selamlar."
    },
    {
      "id": "a364cc5b",
      "bank_id": "80359601",
      "text": "Öğğk! Şey, selam."
    },
    {
      "id": "a789c165",
      "bank_id": "80359601",
      "text": "Selamlar."
    },
    {
      "id": "a913e398",
      "bank_id": "80359601",
      "text": "Yuh! Kimse bunu görmek istemiyor!"
    },
    {
      "id": "ae13ebb9",
      "bank_id": "80359601",
      "text": "Oh sanırım hepimizin izlemesini istiyorsun."
    },
    {
      "id": "c2ab00d0",
      "bank_id": "80359601",
      "text": "Sırada ne olduğunu görmek için sabırsızlanıyorum."
    },
    {
      "id": "c2ab00d1",
      "bank_id": "80359601",
      "text": "Ah, çok uzun zamandır bekliyordum."
    },
    {
      "id": "c2ab00d3",
      "bank_id": "80359601",
      "text": "Evet. Görelim o zaman."
    },
    {
      "id": "c2ab00d4",
      "bank_id": "80359601",
      "text": "Ah evet, her hareketin hipnotize edici."
    },
    {
      "id": "c2ab00d5",
      "bank_id": "80359601",
      "text": "Ne kadar keyifli. Gözlerimi senden alamıyorum."
    },
    {
      "id": "c2ab00d6",
      "bank_id": "80359601",
      "text": "Ooo evet. Göster marifetini! Vuhuuu!"
    },
    {
      "id": "c2ab00d7",
      "bank_id": "80359601",
      "text": "Ooo, ne yapacaksın bakalım?"
    },
    {
      "id": "c2e7de22",
      "bank_id": "80359601",
      "text": "Göster onlara baba!"
    },
    {
      "id": "c2e7de29",
      "bank_id": "80359601",
      "text": "Göster onlara anne!"
    },
    {
      "id": "c5b06e13",
      "bank_id": "80359601",
      "text": "Ne?!"
    },
    {
      "id": "c9ab0bd0",
      "bank_id": "80359601",
      "text": "Bunu görmeyi hayatım boyunca beklemiştim."
    },
    {
      "id": "c9ab0bd1",
      "bank_id": "80359601",
      "text": "Kendini tutma sakın. Can kulağıyla izliyorum."
    },
    {
      "id": "c9ab0bd2",
      "bank_id": "80359601",
      "text": "İşte bu tatlım. İşte bu!"
    },
    {
      "id": "c9ab0bd3",
      "bank_id": "80359601",
      "text": "Sana bakmaktan kendimi alamıyorum."
    },
    {
      "id": "c9ab0bd4",
      "bank_id": "80359601",
      "text": "Göster bize hünerlerini. Ooo evet."
    },
    {
      "id": "c9ab0bd5",
      "bank_id": "80359601",
      "text": "Göster marifetlerini bana."
    },
    {
      "id": "c9ab0bd6",
      "bank_id": "80359601",
      "text": "Mmm, evet. Devam et."
    },
    {
      "id": "cc76edb5",
      "bank_id": "80359601",
      "text": "Merhabalar!"
    },
    {
      "id": "cc76edb7",
      "bank_id": "80359601",
      "text": "İyi misin çocuk?"
    },
    {
      "id": "ccb07916",
      "bank_id": "80359601",
      "text": "Ne?!"
    },
    {
      "id": "ccecf3c2",
      "bank_id": "80359601",
      "text": "Vay, bakın millet. Bir ünlüye selam veriyorum!"
    },
    {
      "id": "ccecf3c3",
      "bank_id": "80359601",
      "text": "Hey! Sen! Gerçekten çok ünlüsün sen!"
    },
    {
      "id": "ccecf3c4",
      "bank_id": "80359601",
      "text": "Ah, ünlü bir maceracı! Merhabalar!"
    },
    {
      "id": "ccecf3c5",
      "bank_id": "80359601",
      "text": "Hey, gerçek bir ünlüsün sen!"
    },
    {
      "id": "ccecf3c7",
      "bank_id": "80359601",
      "text": "Ah, sensin! Merhabalar!"
    },
    {
      "id": "ce31dd10",
      "bank_id": "80359601",
      "text": "Ah, bir ünlü!"
    },
    {
      "id": "ce31dd11",
      "bank_id": "80359601",
      "text": "Sen olduğuna inanamıyorum! Merhaba!"
    },
    {
      "id": "ce31dd13",
      "bank_id": "80359601",
      "text": "Hey, sen ünlüsün!"
    },
    {
      "id": "d24e4a43",
      "bank_id": "80359601",
      "text": "Beni yalnız bırak."
    },
    {
      "id": "d2ecfc48",
      "bank_id": "80359601",
      "text": "Tam bir kalp hırsızısın sen değil mi?"
    },
    {
      "id": "d2ecfc49",
      "bank_id": "80359601",
      "text": "Ah, meeeerhaba. Hihihi."
    },
    {
      "id": "d2ecfc4a",
      "bank_id": "80359601",
      "text": "Merhaba sevgilim."
    },
    {
      "id": "d2ecfc4b",
      "bank_id": "80359601",
      "text": "Seni çok özledim tatlım benim."
    },
    {
      "id": "d2ecfc4d",
      "bank_id": "80359601",
      "text": "Hihihi. Tekrar merhaba."
    },
    {
      "id": "d2ecfc4e",
      "bank_id": "80359601",
      "text": "Selamlar. Ay yüzüm kızardı."
    },
    {
      "id": "d2ecfc4f",
      "bank_id": "80359601",
      "text": "Mmmm. Seni görmek ne güzel."
    },
    {
      "id": "d376f8b8",
      "bank_id": "80359601",
      "text": "Ah merhaba!"
    },
    {
      "id": "d376f8b9",
      "bank_id": "80359601",
      "text": "Selam! Nasıl gidiyor?"
    },
    {
      "id": "d3ecfec8",
      "bank_id": "80359601",
      "text": "Gerçekten sen olduğuna inanamıyorum."
    },
    {
      "id": "d3ecfec9",
      "bank_id": "80359601",
      "text": "Gözlerime inanamıyorum! Merhaba!"
    },
    {
      "id": "d3ecfeca",
      "bank_id": "80359601",
      "text": "Sahiden sen misin? Vay canına."
    },
    {
      "id": "d3ecfece",
      "bank_id": "80359601",
      "text": "Aman tanrım! Ne diyeceğimi bilemiyorum! Selam!"
    },
    {
      "id": "d3ecfecf",
      "bank_id": "80359601",
      "text": "Vay be, sensin! Selam!"
    },
    {
      "id": "d7963322",
      "bank_id": "80359601",
      "text": "Göster onlara anne!"
    },
    {
      "id": "d7963329",
      "bank_id": "80359601",
      "text": "Göster onlara baba!"
    },
    {
      "id": "d91166fe",
      "bank_id": "80359601",
      "text": "Selam."
    },
    {
      "id": "d94e5546",
      "bank_id": "80359601",
      "text": "Beni yalnız bırak."
    },
    {
      "id": "dc835b8c",
      "bank_id": "80359601",
      "text": "Merhaba genç adam."
    },
    {
      "id": "dc835b8d",
      "bank_id": "80359601",
      "text": "Merhabalar."
    },
    {
      "id": "dc835b8e",
      "bank_id": "80359601",
      "text": "Esenlikler dilerim."
    },
    {
      "id": "dded0df8",
      "bank_id": "80359601",
      "text": "Ah, merhabalar. Geleceğini bilseydim temiz gömleğimi giyerdim."
    },
    {
      "id": "dded0df9",
      "bank_id": "80359601",
      "text": "Beni liseli bir kız gibi kıkırdatıyorsun."
    },
    {
      "id": "dded0dfa",
      "bank_id": "80359601",
      "text": "Merhaba benim küçük kıymetli mücevherim."
    },
    {
      "id": "dded0dfb",
      "bank_id": "80359601",
      "text": "Haber verseydin uşağıma temiz gömleğimi getirtirdim."
    },
    {
      "id": "dded0dfc",
      "bank_id": "80359601",
      "text": "Ah, buradasın demek canım."
    },
    {
      "id": "dded0dfe",
      "bank_id": "80359601",
      "text": "Epey zaman oldu. Seni özledim."
    },
    {
      "id": "dded0dff",
      "bank_id": "80359601",
      "text": "Ah, döndün demek. *kıkırdar*"
    },
    {
      "id": "e21174cb",
      "bank_id": "80359601",
      "text": "Selam."
    },
    {
      "id": "e29ab9e3",
      "bank_id": "80359601",
      "text": "Evet, hadi göster günlerini baba!"
    },
    {
      "id": "e29ab9e8",
      "bank_id": "80359601",
      "text": "Evet, hadi göster günlerini anne!"
    },
    {
      "id": "e41a286e",
      "bank_id": "80359601",
      "text": "Şey, evet, merhaba."
    },
    {
      "id": "e50e31d8",
      "bank_id": "80359601",
      "text": "Vaktimizi boşa harcıyorsun."
    },
    {
      "id": "e50e31d9",
      "bank_id": "80359601",
      "text": "Yapacaksan yap da git artık!"
