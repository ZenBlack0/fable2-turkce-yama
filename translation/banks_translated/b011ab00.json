    {
      "id": "3a0a103b",
      "bank_id": "b011ab00",
      "text": "Şuna da bakın hele! Hık demiş babasının burnundan düşmüş, değil mi?"
    },
    {
      "id": "3e04fcd7",
      "bank_id": "b011ab00",
      "text": "Küçük bir canavar bu, değil mi? Annesine çekmiş."
    },
    {
      "id": "3e04fcdc",
      "bank_id": "b011ab00",
      "text": "Küçük bir canavar bu, değil mi? Babasına çekmiş."
    },
    {
      "id": "3efd01a4",
      "bank_id": "b011ab00",
      "text": "Bu tam bir rezillikti! O kız kesinlikle annesine çekmiş."
    },
    {
      "id": "3efd01af",
      "bank_id": "b011ab00",
      "text": "Bu tam bir rezillikti! O kız kesinlikle babasına çekmiş."
    },
    {
      "id": "406d03b3",
      "bank_id": "b011ab00",
      "text": "Bu çocuk tam bir bela, tıpkı annesi gibi."
    },
    {
      "id": "406d03b8",
      "bank_id": "b011ab00",
      "text": "Bu çocuk tam bir bela, tıpkı babası gibi."
    },
    {
      "id": "408a687a",
      "bank_id": "b011ab00",
      "text": "Ha ha! Pek komik bir şeysin sen çocuk."
    },
    {
      "id": "45f88687",
      "bank_id": "b011ab00",
      "text": "Korkuttun beni! Tıpkı babanın oğlusun."
    },
    {
      "id": "45f8868c",
      "bank_id": "b011ab00",
      "text": "Korkuttun beni! Tıpkı annenin oğlusun."
    },
    {
      "id": "471ca124",
      "bank_id": "b011ab00",
      "text": "Seni terbiyesiz çocuk. Uzak dur benden."
    },
    {
      "id": "471ca126",
      "bank_id": "b011ab00",
      "text": "Ne edepsiz bir çocuk. Baştan aşağı bir maceracı çocuğu işte."
    },
    {
      "id": "4f3a62c2",
      "bank_id": "b011ab00",
      "text": "Küçük bir canavar bu, değil mi? Babasına çekmiş."
    },
    {
      "id": "4f3a62c9",
      "bank_id": "b011ab00",
      "text": "Küçük bir canavar bu, değil mi? Annesine çekmiş."
    },
    {
      "id": "521cb254",
      "bank_id": "b011ab00",
      "text": "Maceracı çocuklarının hepsi küçük belalardır, sen de farklı değilsin çocuk."
    },
    {
      "id": "52dee3b7",
      "bank_id": "b011ab00",
      "text": "Neredeyse annesi kadar korkuttu beni! Ha ha!"
    },
    {
      "id": "52dee3bc",
      "bank_id": "b011ab00",
      "text": "Neredeyse babası kadar korkuttu beni! Ha ha!"
    },
    {
      "id": "550b632c",
      "bank_id": "b011ab00",
      "text": "Bir maceracının kızısın diye her istediğini yapabileceğini mi sanıyorsun seni aptal kız?"
    },
    {
      "id": "5a0b6acc",
      "bank_id": "b011ab00",
      "text": "Terbiyesiz bir kızsın sen. Seni kim böyle yetiştirdi?"
    },
    {
      "id": "5a0b6ace",
      "bank_id": "b011ab00",
      "text": "Gezgin bir maceracının kızından bekleneceği gibi berbat bir çocuk."
    },
    {
      "id": "649a8531",
      "bank_id": "b011ab00",
      "text": "Ne korkunç bir çocuk! Annesini hatırlatıyor bana."
    },
    {
      "id": "649a853a",
      "bank_id": "b011ab00",
      "text": "Ne korkunç bir çocuk! Babasını hatırlatıyor bana."
    },
    {
      "id": "67711f00",
      "bank_id": "b011ab00",
      "text": "Ha! Eline yüzüne bulaştırdın, değil mi?!"
    },
    {
      "id": "67711f01",
      "bank_id": "b011ab00",
      "text": "Daha çok çalışman lazım."
    },
    {
      "id": "67711f03",
      "bank_id": "b011ab00",
      "text": "Ne yapmaya çalışıyordun sen öyle?"
    },
    {
      "id": "67711f06",
      "bank_id": "b011ab00",
      "text": "Tam bir fiyasko."
    },
    {
      "id": "67711f07",
      "bank_id": "b011ab00",
      "text": "Bunu tamamen yanlış yaptın."
    },
    {
      "id": "6a6daec6",
      "bank_id": "b011ab00",
      "text": "Korkuttun beni çocuk! Bir an annen sandım seni."
    },
    {
      "id": "6a6daecd",
      "bank_id": "b011ab00",
      "text": "Korkuttun beni çocuk! Bir an baban sandım seni."
    },
    {
      "id": "6d2138f8",
      "bank_id": "b011ab00",
      "text": "Lanet bir çocukmuş sadece."
    },
    {
      "id": "6e712a02",
      "bank_id": "b011ab00",
      "text": "Bu işte hiç iyi değilsin."
    },
    {
      "id": "6e712a03",
      "bank_id": "b011ab00",
      "text": "Görünüşe göre eline yüzüne bulaştırdın."
    },
    {
      "id": "6e712a04",
      "bank_id": "b011ab00",
      "text": "Çalışmaya devam et."
    },
    {
      "id": "6e712a05",
      "bank_id": "b011ab00",
      "text": "Ha! İyice batırdın ortalığı!"
    },
    {
      "id": "6e712a06",
      "bank_id": "b011ab00",
      "text": "Tam bir fiyasko."
    },
    {
      "id": "6ef0a7e0",
      "bank_id": "b011ab00",
      "text": "Meşru müdafaaydı."
    },
    {
      "id": "6ef0a7e1",
      "bank_id": "b011ab00",
      "text": "Evet! Bunu kimse ondan fazla hak etmemişti!"
    },
    {
      "id": "6ef0a7e2",
      "bank_id": "b011ab00",
      "text": "Bazen sadece öldürmek zorunda kalırsın."
    },
    {
      "id": "6ef0a7e6",
      "bank_id": "b011ab00",
      "text": "Doğuştan hayatta kalansın sen."
    },
    {
      "id": "6ef0a7e7",
      "bank_id": "b011ab00",
      "text": "Tam bir ölüm makinesisin. İyi anlamda tabii."
    },
    {
      "id": "77f0b5ca",
      "bank_id": "b011ab00",
      "text": "Çok şükür kurtulduk."
    },
    {
      "id": "77f0b5cb",
      "bank_id": "b011ab00",
      "text": "Temelli gitti."
    },
    {
      "id": "77f0b5cc",
      "bank_id": "b011ab00",
      "text": "Öldü gitti! Kendi suçuydu gerçi."
    },
    {
      "id": "77f0b5cd",
      "bank_id": "b011ab00",
      "text": "Bununla gurur duymalısın."
    },
    {
      "id": "77f0b5cf",
      "bank_id": "b011ab00",
      "text": "Artık kimseyi rahatsız edemez."
    },
    {
      "id": "78214a28",
      "bank_id": "b011ab00",
      "text": "Ödümü kopardın çocuk!"
    },
    {
      "id": "7d9db146",
      "bank_id": "b011ab00",
      "text": "Annesinin yaptığı o korkunç şeylerin aynısı bu."
    },
    {
      "id": "7d9db14d",
      "bank_id": "b011ab00",
      "text": "Babasının yaptığı o korkunç şeylerin aynısı bu."
    },
    {
      "id": "808b8fa4",
      "bank_id": "b011ab00",
      "text": "Görüyorum ki tıpkı annen gibi eğitimsizsin çocuk."
    },
    {
      "id": "808b8faf",
      "bank_id": "b011ab00",
      "text": "Görüyorum ki tıpkı baban gibi eğitimsizsin çocuk."
    },
    {
      "id": "82c61922",
      "bank_id": "b011ab00",
      "text": "Ne berbat bir kız! Babasını hatırlatıyor bana."
