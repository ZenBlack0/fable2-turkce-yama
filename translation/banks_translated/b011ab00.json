      "text": "Evet, devam et!"
    },
    {
      "id": "8e7c5bce",
      "bank_id": "b011ab00",
      "text": "Güm! Ne vuruştu ama!"
    },
    {
      "id": "8e7c5bcf",
      "bank_id": "b011ab00",
      "text": "Patlat şu kafatasını!"
    },
    {
      "id": "9115c926",
      "bank_id": "b011ab00",
      "text": "Bayağı korkutucu. Kesin annesinden kapmıştır bunu."
    },
    {
      "id": "9115c92d",
      "bank_id": "b011ab00",
      "text": "Bayağı korkutucu. Kesin babasından kapmıştır bunu."
    },
    {
      "id": "93751946",
      "bank_id": "b011ab00",
      "text": "Ha ha! Tıpkı annen gibi komedyen kumaşın var, değil mi?"
    },
    {
      "id": "9375194d",
      "bank_id": "b011ab00",
      "text": "Ha ha! Tıpkı baban gibi komedyen kumaşın var, değil mi?"
