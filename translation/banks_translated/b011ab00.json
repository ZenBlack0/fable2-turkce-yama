    {
      "id": "82c61929",
      "bank_id": "b011ab00",
      "text": "Ne berbat bir kız! Annesini hatırlatıyor bana."
    },
    {
      "id": "857c4dfa",
      "bank_id": "b011ab00",
      "text": "Bunu nasıl buldun bakalım?"
    },
    {
      "id": "857c4dfb",
      "bank_id": "b011ab00",
      "text": "Vay, acısını buradan hissettim."
    },
    {
      "id": "857c4dfc",
      "bank_id": "b011ab00",
      "text": "Harika vuruş!"
    },
    {
      "id": "857c4dfd",
      "bank_id": "b011ab00",
      "text": "Evet, göster günlerini!"
    },
    {
      "id": "857c4dfe",
      "bank_id": "b011ab00",
      "text": "Durma sakın!"
    },
    {
      "id": "87181e21",
      "bank_id": "b011ab00",
      "text": "Ne kadar şirin değil mi? Annesi kadar korkutucu olmaya çalışıyor."
