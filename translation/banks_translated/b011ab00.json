    {
      "id": "94d9edd6",
      "bank_id": "b011ab00",
      "text": "İyi atış!"
    },
    {
      "id": "94f20126",
      "bank_id": "b011ab00",
      "text": "Peh! Annen kadar korkutucu değilsin seni küçük hobbe. Şey... Annesi burada değil, değil mi?"
