    {
      "id": "94d9edd4",
      "bank_id": "b011ab00",
      "text": "Hiç ıskalamıyorsun!"
    },
    {
      "id": "94d9edd5",
      "bank_id": "b011ab00",
      "text": "İyi nişan aldın!"
