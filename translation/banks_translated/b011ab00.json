    {
      "id": "a0795a81",
      "bank_id": "b011ab00",
      "text": "O kız beni korkutuyor. Tıpkı babası gibi."
    },
    {
      "id": "a0795a8a",
      "bank_id": "b011ab00",
      "text": "O kız beni korkutuyor. Tıpkı annesi gibi."
    },
    {
      "id": "a0c519f8",
      "bank_id": "b011ab00",
      "text": "Çok iyi!"
