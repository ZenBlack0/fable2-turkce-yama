  "strings": [
    {
      "id": "006bfa9a",
      "bank_id": "b011ab00",
      "text": "Ödümü mü koparmaya çalışıyorsun kızım sen?"
    },
    {
      "id": "04ea0c74",
      "bank_id": "b011ab00",
      "text": "Ne kadar şirin değil mi? Babası kadar korkutucu olmaya çalışıyor."
    },
    {
      "id": "04ea0c7f",
      "bank_id": "b011ab00",
      "text": "Ne kadar şirin değil mi? Annesi kadar korkutucu olmaya çalışıyor."
    },
    {
      "id": "05ef8a56",
      "bank_id": "b011ab00",
      "text": "Neredeyse babası kadar korkuttu beni! Ha ha!"
    },
    {
      "id": "05ef8a5d",
      "bank_id": "b011ab00",
      "text": "Neredeyse annesi kadar korkuttu beni! Ha ha!"
    },
    {
      "id": "096c08ee",
      "bank_id": "b011ab00",
      "text": "Böyle korkutmayı nereden öğrendin kızım sen?"
    },
    {
      "id": "1c9ebec0",
      "bank_id": "b011ab00",
      "text": "Bunu hak etmişlerdi!"
    },
    {
      "id": "1c9ebec1",
      "bank_id": "b011ab00",
      "text": "İyi zafer."
    },
    {
      "id": "1c9ebec3",
      "bank_id": "b011ab00",
      "text": "Bunun arkasından kimse gözyaşı dökmez."
    },
    {
      "id": "1c9ebec6",
      "bank_id": "b011ab00",
      "text": "Onları hakladığına sevindim."
    },
    {
      "id": "1c9ebec7",
      "bank_id": "b011ab00",
      "text": "İyi av."
    },
    {
      "id": "239ec9c2",
      "bank_id": "b011ab00",
      "text": "İyi dövüştü."
    },
    {
      "id": "239ec9c3",
      "bank_id": "b011ab00",
      "text": "Artık güvendeyiz."
    },
    {
      "id": "239ec9c4",
      "bank_id": "b011ab00",
      "text": "Aferin!"
    },
    {
      "id": "239ec9c5",
      "bank_id": "b011ab00",
      "text": "Evet, gittiklerine sevindim."
    },
    {
      "id": "239ec9c6",
      "bank_id": "b011ab00",
      "text": "Öldü ve gömüldü."
    },
    {
      "id": "2408d987",
      "bank_id": "b011ab00",
      "text": "Tıpkı baban gibi cazibeden yoksunsun küçük hanım."
    },
    {
      "id": "2408d98c",
      "bank_id": "b011ab00",
      "text": "Tıpkı annen gibi cazibeden yoksunsun küçük hanım."
    },
    {
      "id": "2777f4a1",
      "bank_id": "b011ab00",
      "text": "Çok komik bir çocuk, değil mi? Tıpkı babası gibi."
    },
    {
      "id": "2777f4aa",
      "bank_id": "b011ab00",
      "text": "Çok komik bir çocuk, değil mi? Tıpkı annesi gibi."
    },
    {
      "id": "2ad4fa57",
      "bank_id": "b011ab00",
      "text": "Aman tanrım! Ödümü kopardın çocuk. Kesinlikle annene çekmişsin."
    },
    {
      "id": "2ad4fa5c",
      "bank_id": "b011ab00",
      "text": "Aman tanrım! Ödümü kopardın çocuk. Kesinlikle babana çekmişsin."
