    {
      "id": "94f2012d",
      "bank_id": "b011ab00",
      "text": "Peh! Baban kadar korkutucu değilsin seni küçük hobbe. Şey... Babası burada değil, değil mi?"
    },
    {
      "id": "95c50848",
      "bank_id": "b011ab00",
      "text": "Daha sert! Daha sert!"
    },
    {
      "id": "95c50849",
      "bank_id": "b011ab00",
      "text": "Bırakma sakın!"
    },
    {
      "id": "95c5084d",
      "bank_id": "b011ab00",
      "text": "Ne güç ama!"
