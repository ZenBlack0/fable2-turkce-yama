    {
      "id": "a0c519f9",
      "bank_id": "b011ab00",
      "text": "İşte böyle!"
    },
    {
      "id": "a0c519fc",
      "bank_id": "b011ab00",
      "text": "Göster günlerini!"
    },
    {
      "id": "a0c519fe",
