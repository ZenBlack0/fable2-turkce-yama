    {
      "id": "cad447c1",
      "bank_id": "b04f2802",
      "text": "Her an canlanabilecek gibi duruyor."
    },
    {
      "id": "cad447c2",
      "bank_id": "b04f2802",
      "text": "Son derece canlı gibi, değil mi?"
    },
    {
      "id": "cad447c3",
      "bank_id": "b04f2802",
      "text": "Heykeltıraşlık ustalığının güzel bir örneği."
    },
    {
      "id": "cad447c5",
      "bank_id": "b04f2802",
      "text": "Güzel bir heykelmiş."
