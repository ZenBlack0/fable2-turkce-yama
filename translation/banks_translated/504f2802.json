      "text": "<screams> Bir ceset!"
    },
    {
      "id": "68674ff1",
      "bank_id": "504f2802",
      "text": "<screams> Ölmüşler! Ölü!"
    },
    {
      "id": "68674ff2",
      "bank_id": "504f2802",
      "text": "Gördüğüm ilk ceset değil doğrusu. Sonuncusu da olmayacak."
    },
    {
      "id": "68674ff3",
      "bank_id": "504f2802",
      "text": "Bir ceset daha, ha?"
    },
    {
      "id": "68674ff4",
      "bank_id": "504f2802",
      "text": "Ölü! Bu tek kelimeyle korkunç!"
    },
    {
      "id": "68674ff5",
      "bank_id": "504f2802",
      "text": "İnanamıyorum! Ölmüşler!"
    },
    {
      "id": "68674ff7",
      "bank_id": "504f2802",
      "text": "Aman Tanrım! Ölmüşler!"
    },
    {
      "id": "6a8ab4fc",
      "bank_id": "504f2802",
      "text": "Kimse seni sevmiyor!"
    },
    {
      "id": "6f675af8",
      "bank_id": "504f2802",
      "text": "Bunun bir ceset olduğundan oldukça eminim."
    },
    {
      "id": "6f675af9",
      "bank_id": "504f2802",
      "text": "Hayır! Bu korkunç! Hayatının baharında biçilmiş!"
    },
    {
      "id": "6f675afa",
      "bank_id": "504f2802",
      "text": "Ah bu korkunç. Bu kadar genç ölmek."
    },
    {
      "id": "6f675afc",
      "bank_id": "504f2802",
      "text": "Bu cansız bir beden!"
    },
    {
      "id": "6f675afd",
      "bank_id": "504f2802",
      "text": "Hayır! Bu korkunç! Hayatının baharında biçilmiş!"
    },
    {
      "id": "6f675afe",
      "bank_id": "504f2802",
      "text": "Bu bir ceset, orası kesin."
    },
    {
      "id": "6f675aff",
      "bank_id": "504f2802",
      "text": "O bir ceset mi? Öyle görünüyor."
    },
    {
      "id": "7ec3d300",
      "bank_id": "504f2802",
      "text": "Karanlık tarafa katıl bize, seni ışık delisi şapşal."
    },
    {
      "id": "8d852938",
