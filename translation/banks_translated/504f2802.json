      "text": "Ah, bakın! Bir ceset!"
    },
    {
      "id": "58e1f85e",
      "bank_id": "504f2802",
      "text": "Aman Tanrım, bu bir ceset!"
    },
    {
      "id": "58e1f85f",
      "bank_id": "504f2802",
      "text": "Ölmüşler!"
    },
    {
      "id": "5906eeb0",
      "bank_id": "504f2802",
      "text": "Seni görmek güzel."
    },
    {
      "id": "5906eeb3",
      "bank_id": "504f2802",
      "text": "İyi günler dilerim."
    },
    {
      "id": "5f06e77b",
      "bank_id": "504f2802",
      "text": "Senden zerre kadar hoşlanmıyorum. İşte o kadar."
    },
    {
      "id": "5f8aa34d",
      "bank_id": "504f2802",
      "text": "Umarım canavarlar seni yer."
    },
    {
      "id": "63e20988",
      "bank_id": "504f2802",
      "text": "Umarım kokmaya başlamadan önce biri şu cesedi kaldırır."
    },
    {
      "id": "63e20989",
      "bank_id": "504f2802",
      "text": "Şuna bakın, bir ceset. Bir tane daha."
    },
    {
      "id": "63e2098a",
      "bank_id": "504f2802",
      "text": "Ah, ne korkunç! Bir ceset!"
    },
    {
      "id": "63e2098b",
      "bank_id": "504f2802",
      "text": "Ceset! Ceset!"
    },
    {
      "id": "63e2098c",
