      "text": "Pöh!"
    },
    {
      "id": "9a86831b",
      "bank_id": "504f2802",
      "text": "Pöh!"
    },
    {
      "id": "9a86831c",
      "bank_id": "504f2802",
      "text": "Pöh!"
    },
    {
      "id": "9a86831d",
      "bank_id": "504f2802",
      "text": "Pöh!"
    },
    {
      "id": "9a86831e",
      "bank_id": "504f2802",
      "text": "Pöh!"
    },
    {
      "id": "9a9674e0",
      "bank_id": "504f2802",
      "text": "Anlatılanlara bakılırsa davranışlarınız örnek teşkil ediyor."
    },
    {
      "id": "9a9674e1",
      "bank_id": "504f2802",
      "text": "Ahlakınızdan ödün vermediğinizi görmek sevindirici."
    },
    {
      "id": "9a9674e2",
      "bank_id": "504f2802",
      "text": "Ahlaki değerlerine bağlı kalmayı sevenlerdensin, değil mi?"
    },
    {
      "id": "9a9674e3",
      "bank_id": "504f2802",
      "text": "Neyin nesisin sen, keşiş falan mı?"
    },
    {
      "id": "9a9674e4",
      "bank_id": "504f2802",
      "text": "Bütün iyi işlerinizi duydum!"
    },
    {
      "id": "9a9674e5",
      "bank_id": "504f2802",
      "text": "Samimi bir insan olduğunuzu anlayabiliyorum."
    },
    {
      "id": "9a9674e7",
      "bank_id": "504f2802",
      "text": "Sizin kadar erdemli olanı pek az bulunur!"
    },
    {
      "id": "9d726c76",
      "bank_id": "504f2802",
      "text": "Sürekli iyilik yapmak ve sevinç saçmak... Midemi fazlasıyla bulandırıyorsun."
    },
    {
      "id": "9d726c77",
      "bank_id": "504f2802",
      "text": "Azizlere karşı zerre hayranlığım yoktur."
    },
    {
      "id": "9f0bc909",
      "bank_id": "504f2802",
      "text": "Geldiğin yere geri dön!"
    },
    {
      "id": "9f0bc90a",
      "bank_id": "504f2802",
      "text": "Herkes senden nefret ediyor. Çek git artık!"
    },
    {
      "id": "9f0bc90b",
      "bank_id": "504f2802",
      "text": "Umarım boğularak geberirsin!"
    },
    {
      "id": "9f0bc90c",
      "bank_id": "504f2802",
      "text": "Seni trol pisliği!"
    },
    {
      "id": "9f0bc90d",
      "bank_id": "504f2802",
      "text": "Hâlâ ölmedin mi sen?!"
    },
    {
      "id": "9f0bc90e",
      "bank_id": "504f2802",
      "text": "O zehirli dilinle boğulmadın mı hâlâ?"
    },
    {
      "id": "9f0bc90f",
      "bank_id": "504f2802",
      "text": "Hor görülmek nasıl bir hismiş bakalım?"
    },
    {
      "id": "9f59c1e8",
      "bank_id": "504f2802",
      "text": "Hepimizi öldürecekler!"
    },
    {
      "id": "9f59c1e9",
      "bank_id": "504f2802",
      "text": "Başımız fena dertte!"
    },
    {
      "id": "9f59c1ed",
      "bank_id": "504f2802",
      "text": "Bizim için geliyorlar!"
    },
    {
      "id": "9f59c1ee",
      "bank_id": "504f2802",
      "text": "Geliyorlar! Geliyorlar!"
    },
    {
      "id": "9f59c1ef",
      "bank_id": "504f2802",
      "text": "Yardım edin!"
    },
    {
      "id": "a1967fe8",
      "bank_id": "504f2802",
      "text": "Sende saf bir şeyler var."
    },
    {
      "id": "a1967fe9",
      "bank_id": "504f2802",
      "text": "Dürüst birisin. Anlayabiliyorum."
    },
    {
      "id": "a1967fea",
      "bank_id": "504f2802",
      "text": "Güç karşısında yozlaşacak biri değilsin, değil mi?"
    },
    {
      "id": "a1967fec",
      "bank_id": "504f2802",
      "text": "Hepimiz sizin gibilerden ahlak dersi alabiliriz."
    },
    {
      "id": "a1967fed",
      "bank_id": "504f2802",
      "text": "İçinde hakiki bir ateş yanıyor. Ve hepimizi ısıtıyor."
    },
    {
      "id": "a1967fee",
      "bank_id": "504f2802",
      "text": "Ne oldu? Kötülük yapmaya miden mi kaldırmıyor?"
    },
    {
      "id": "a1967fef",
      "bank_id": "504f2802",
      "text": "Bahse girerim ortalıkta merhamet dağıtmak için sabırsızlanıyorsundur. Pöh!"
    },
    {
      "id": "a1d4aa82",
      "bank_id": "504f2802",
      "text": "O tiksinç derecede masum ruhunu benden uzak tut."
    },
    {
      "id": "a1d4aa83",
      "bank_id": "504f2802",
      "text": "Erdeme olan bağlılığına tüküreyim senin."
    },
    {
      "id": "a3869168",
      "bank_id": "504f2802",
      "text": "Pöh!"
    },
    {
      "id": "a3869169",
      "bank_id": "504f2802",
      "text": "Pöh!"
    },
    {
      "id": "a386916b",
      "bank_id": "504f2802",
      "text": "Pöh!"
    },
    {
      "id": "a386916e",
      "bank_id": "504f2802",
      "text": "Pöh!"
    },
    {
      "id": "a386916f",
      "bank_id": "504f2802",
      "text": "Pöh!"
    },
    {
      "id": "aa59d318",
      "bank_id": "504f2802",
      "text": "Böyle ölmek istemiyorum! Kurtarın beni!"
    },
    {
      "id": "aa59d319",
      "bank_id": "504f2802",
      "text": "Hepimizi boğazlayacaklar!"
    },
    {
      "id": "aa59d31c",
      "bank_id": "504f2802",
      "text": "Ölmek istemiyorum!"
    },
    {
      "id": "aa59d31e",
      "bank_id": "504f2802",
      "text": "Kurtarın beni!"
    },
    {
      "id": "aa59d31f",
      "bank_id": "504f2802",
      "text": "Çıkarın beni buradan! Aaaaaahhh!"
    },
    {
      "id": "b47f5672",
      "bank_id": "504f2802",
      "text": "Gidin buradan!"
    },
    {
      "id": "b7c50b48",
      "bank_id": "504f2802",
      "text": "Hepimizi öldürmek için buradalar!"
    },
    {
      "id": "b7c50b49",
      "bank_id": "504f2802",
      "text": "Hayır, lütfen, biri beni kurtarsın!"
    },
    {
      "id": "b7c50b4a",
      "bank_id": "504f2802",
      "text": "Hepimizi öldürmek için buradalar!"
    },
    {
      "id": "b7c50b4b",
      "bank_id": "504f2802",
      "text": "Öldürmeyin beni!"
    },
    {
      "id": "b7c50b4c",
      "bank_id": "504f2802",
      "text": "Biri kurtarsın beni!"
    },
    {
      "id": "b7c50b4d",
      "bank_id": "504f2802",
      "text": "Olamaz! Bizi öldürecekler!"
    },
    {
      "id": "b7c50b4e",
      "bank_id": "504f2802",
      "text": "İmdat! Lütfen! Biri yardım etsin!"
    },
    {
      "id": "bd7f645f",
      "bank_id": "504f2802",
      "text": "Beni rahat bırak!"
    },
    {
      "id": "c0c51998",
      "bank_id": "504f2802",
      "text": "Biri yardım etsin bana!"
    },
    {
      "id": "c0c51999",
      "bank_id": "504f2802",
      "text": "Hepimizi öldürecekler!"
    },
    {
      "id": "c0c5199b",
      "bank_id": "504f2802",
      "text": "İmdat! İmdat!"
    },
    {
      "id": "c0c5199c",
      "bank_id": "504f2802",
      "text": "Lütfen! Kimse yok mu! Yardım edin!"
    },
    {
      "id": "c0c5199d",
      "bank_id": "504f2802",
      "text": "Biri bana yardım etmeyecek mi? Lütfen!"
    },
    {
      "id": "c0c5199e",
      "bank_id": "504f2802",
      "text": "İmdat!"
    },
    {
      "id": "c0c5199f",
      "bank_id": "504f2802",
      "text": "İmdat! Beni öldürecekler!"
    },
    {
      "id": "c53c0336",
      "bank_id": "504f2802",
      "text": "Şu ideallerin ve yüksek ahlakınla midemi bulandırıyorsun. Senin güzel bir âleme ihtiyacın var tatlım!"
    },
    {
      "id": "c53c0337",
      "bank_id": "504f2802",
      "text": "Yozlaşmanın erdemden katbekat üstün olduğunu ne zaman öğreneceksin? Etrafına bir baksana!"
    },
    {
      "id": "cf931b3a",
      "bank_id": "504f2802",
      "text": "Sen!"
    },
    {
      "id": "cf931b3b",
      "bank_id": "504f2802",
      "text": "Sen!"
    },
    {
      "id": "cf931b3c",
      "bank_id": "504f2802",
      "text": "Sen!"
    },
    {
      "id": "cf931b3d",
      "bank_id": "504f2802",
      "text": "Sen!"
    },
    {
      "id": "cf931b3e",
      "bank_id": "504f2802",
      "text": "Sen!"
    },
    {
      "id": "d8932908",
      "bank_id": "504f2802",
      "text": "Sen!"
    },
    {
      "id": "d8932909",
      "bank_id": "504f2802",
      "text": "Sen!"
    },
    {
      "id": "d893290b",
      "bank_id": "504f2802",
      "text": "Sen!"
    },
    {
      "id": "d893290e",
      "bank_id": "504f2802",
      "text": "Sen!"
    },
    {
      "id": "d893290f",
      "bank_id": "504f2802",
      "text": "Sen!"
    },
    {
      "id": "d893a3e2",
      "bank_id": "504f2802",
      "text": "Gerçekten yaman bir Kahramansın."
    },
    {
      "id": "d893a3e3",
      "bank_id": "504f2802",
      "text": "Albion'un geri kalanından bir haber var mı?"
    },
    {
      "id": "d893a3e4",
      "bank_id": "504f2802",
      "text": "Seni görmek harika!"
    },
    {
      "id": "d893a3e5",
      "bank_id": "504f2802",
      "text": "İyi günler dilerim."
    },
    {
      "id": "d893a3e7",
      "bank_id": "504f2802",
      "text": "Buralarda olman çok güzel."
    },
    {
      "id": "df93aee8",
      "bank_id": "504f2802",
      "text": "Umarım Kahramanlık hayatı sana iyi geliyordur."
    },
    {
      "id": "df93aee9",
      "bank_id": "504f2802",
      "text": "İyi görünüyorsun."
    },
    {
      "id": "df93aeea",
      "bank_id": "504f2802",
      "text": "Her zaman bir zevk."
    },
    {
      "id": "df93aeec",
      "bank_id": "504f2802",
      "text": "Biliyor musun, bir gün Albion'daki en ünlü kişi olacağına inanıyorum."
    },
    {
      "id": "df93aeed",
      "bank_id": "504f2802",
      "text": "Komşu kasabalardan ne haberler getirdin?"
    },
    {
      "id": "df93aeee",
      "bank_id": "504f2802",
      "text": "Şu görevler seni meşgul ediyor mu?"
    },
    {
      "id": "df93aeef",
      "bank_id": "504f2802",
      "text": "Seni görmek bir zevk."
    },
    {
      "id": "e59b6824",
      "bank_id": "504f2802",
      "text": "Her zaman doğru olanı yapıyorsun, değil mi? Babam da hep öyle yapmamı söyler bana..."
    },
    {
      "id": "e5fe61b8",
      "bank_id": "504f2802",
      "text": "Umarım kahvaltında boğulursun."
    },
    {
      "id": "e5fe61b9",
      "bank_id": "504f2802",
      "text": "Bana bir iyilik yap ve kulağına bıçak sapla."
    },
    {
      "id": "e5fe61ba",
      "bank_id": "504f2802",
      "text": "Korkunç ve vahşi bir şekilde ölmeni canıgönülden dilerim."
    },
    {
      "id": "e5fe61bb",
      "bank_id": "504f2802",
      "text": "Midemi bulandırıyorsun!"
    },
    {
      "id": "e5fe61bd",
      "bank_id": "504f2802",
      "text": "Ciğerinden nefret ediyorum, pislik!"
    },
    {
      "id": "e5fe61be",
      "bank_id": "504f2802",
      "text": "Midemi bulandırıyorsun!"
    },
    {
      "id": "e5fe61bf",
      "bank_id": "504f2802",
      "text": "Geber inşallah."
    },
    {
      "id": "ea9b6fc5",
      "bank_id": "504f2802",
      "text": "Herkes ne kadar iyi olduğunu söylüyor. Ve bu doğru!"
    },
    {
      "id": "f0fe72e8",
      "bank_id": "504f2802",
      "text": "Bakalım anlayacak mısın: Senden nefret ediyorum!"
    },
    {
      "id": "f0fe72e9",
      "bank_id": "504f2802",
      "text": "Geber."
    },
    {
      "id": "f0fe72ea",
      "bank_id": "504f2802",
      "text": "Senden tiksiniyorum."
    },
    {
      "id": "f0fe72eb",
      "bank_id": "504f2802",
      "text": "Yavaş ve acı verici bir ölüm yaşamanı canıgönülden dilerim."
    },
    {
      "id": "f0fe72ec",
      "bank_id": "504f2802",
      "text": "Defolup gider misin lütfen?"
    },
    {
      "id": "f0fe72ee",
      "bank_id": "504f2802",
      "text": "Daha önce kimseden senden nefret ettiğim kadar nefret etmedim."
    },
    {
      "id": "f0fe72ef",
      "bank_id": "504f2802",
      "text": "Çekil karşımdan!"
    },
    {
      "id": "f2bbe22e",
      "bank_id": "504f2802",
      "text": "Havalı, sensin demek!"
    },
    {
      "id": "f63f3d12",
      "bank_id": "504f2802",
      "text": "Bu bir cesede benziyor. Öyle mi?"
    },
    {
      "id": "f63f3d13",
      "bank_id": "504f2802",
      "text": "Aman Tanrım, o bir ceset değil, değil mi?"
    },
    {
      "id": "fb19953e",
      "bank_id": "504f2802",
      "text": "Nasıl oluyor da hiç kötü şeyler yapmıyorsun?"
    },
    {
      "id": "fb3f4530",
      "bank_id": "504f2802",
      "text": "Hey, uyuyor musun yoksa ne?"
    },
    {
      "id": "fb3f4531",
      "bank_id": "504f2802",
      "text": "Muhtemelen sadece uyuyorlardır."
    },
    {
      "id": "fb3f4532",
      "bank_id": "504f2802",
      "text": "Biri şu bedene tekme atsın da kımıldıyor mu baksın."
    },
    {
      "id": "fb3f4533",
      "bank_id": "504f2802",
      "text": "Şu kişi... ölmüş olamaz herhalde."
    },
    {
      "id": "fb3f4535",
      "bank_id": "504f2802",
      "text": "Aman Tanrım, ölmemişlerdir değil mi?"
    },
    {
      "id": "fb3f4536",
      "bank_id": "504f2802",
      "text": "Şu kişi... ölü mü?"
    },
    {
      "id": "fb3f4537",
      "bank_id": "504f2802",
      "text": "Affedersiniz, iyi misiniz?"
    },
    {
      "id": "fbbbf07b",
      "bank_id": "504f2802",
      "text": "Selam, seni görmeyi her zaman severim."
    }
  ]
}