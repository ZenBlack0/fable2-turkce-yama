      "text": "Uza bakalım!"
    },
    {
      "id": "9a0bc168",
      "bank_id": "504f2802",
      "text": "Kaybolur musun lütfen?"
    },
    {
      "id": "9a0bc16a",
      "bank_id": "504f2802",
      "text": "Grrrrr! Defol!"
    },
    {
      "id": "9a0bc16b",
      "bank_id": "504f2802",
      "text": "Tam bir gereksiz yer kaplayıcısın."
    },
    {
      "id": "9a0bc16c",
      "bank_id": "504f2802",
      "text": "Git de cam ye!"
    },
    {
      "id": "9a0bc16d",
      "bank_id": "504f2802",
      "text": "Kahraman kılıklı domuz!"
    },
    {
      "id": "9a0bc16e",
      "bank_id": "504f2802",
      "text": "Tüh! Keşke sana hiç gözüm değmeseydi!"
    },
    {
      "id": "9a0bc16f",
      "bank_id": "504f2802",
      "text": "Seni görmekten bile nefret ediyorum!"
    },
    {
