{
  "bank_id": "504f2802",
  "total_strings": 256,
  "strings": [
    {
      "id": "0419a30b",
      "bank_id": "504f2802",
      "text": "Çok iyi bir insansın."
    },
    {
      "id": "12e46a48",
      "bank_id": "504f2802",
      "text": "Pöh!"
    },
    {
      "id": "13980378",
      "bank_id": "504f2802",
      "text": "Senden o kadar nefret ediyorum ki."
    },
    {
      "id": "13dd0eae",
      "bank_id": "504f2802",
      "text": "<yelps> Ölmüşler!"
    },
    {
      "id": "17e47269",
      "bank_id": "504f2802",
      "text": "Pöh!"
    },
    {
      "id": "18980b19",
      "bank_id": "504f2802",
      "text": "Sen gelmiş geçmiş en aşağılık insansın."
    },
    {
      "id": "1cdd1cfb",
      "bank_id": "504f2802",
      "text": "O gerçek bir ceset mi? Vay canına..."
    },
    {
      "id": "20f8ae0e",
      "bank_id": "504f2802",
      "text": "Senden nefret ediyorum, nefret ediyorum, nefret ediyorum!"
    },
    {
      "id": "23590b82",
      "bank_id": "504f2802",
      "text": "Bir ölü daha."
    },
    {
      "id": "23590b83",
      "bank_id": "504f2802",
      "text": "Bahse girerim bu eceliyle ölmemiştir."
    },
    {
      "id": "23590b84",
      "bank_id": "504f2802",
      "text": "Bakın! Bir ceset! Hayatım boyunca unutamayacağım bunu!"
    },
    {
      "id": "23590b85",
      "bank_id": "504f2802",
      "text": "Bir ceset!"
    },
    {
      "id": "23590b87",
      "bank_id": "504f2802",
      "text": "Ne kadar korkunç. Yine de gördüğüm ilk ceset değil."
    },
    {
      "id": "29f8bc5b",
      "bank_id": "504f2802",
      "text": "Dünyadaki en berbat aptalsın sen!"
    },
    {
      "id": "2a3349f0",
      "bank_id": "504f2802",
      "text": "Biri şu kişiye bakmalı."
    },
    {
      "id": "2a3349f1",
      "bank_id": "504f2802",
      "text": "İyi misiniz orada? Ölmediniz, değil mi?"
    },
    {
      "id": "2a3349f2",
      "bank_id": "504f2802",
      "text": "Bakın. Umarım sadece uyuyordur."
    },
    {
      "id": "2a3349f4",
      "bank_id": "504f2802",
      "text": "Kalkın bakalım derhâl. Tabii mevtayı boylamadıysanız."
    },
    {
      "id": "2a3349f5",
      "bank_id": "504f2802",
      "text": "İyi misiniz orada? Ölmediniz, değil mi?"
    },
    {
      "id": "2a3349f6",
      "bank_id": "504f2802",
      "text": "Hey, ölmedin değil mi?"
    },
    {
      "id": "2a3349f7",
      "bank_id": "504f2802",
      "text": "Yok canım, ölmemişlerdir."
    },
    {
      "id": "2a591688",
      "bank_id": "504f2802",
      "text": "<screams> Ölü! Bakın!"
    },
    {
      "id": "2a591689",
      "bank_id": "504f2802",
      "text": "Aman Tanrım! Bir ceset!"
    },
    {
      "id": "2a59168a",
      "bank_id": "504f2802",
      "text": "Olamaz! Bir ceset!"
    },
    {
      "id": "2a59168e",
      "bank_id": "504f2802",
      "text": "Ölmüşler, orası kesin."
    },
    {
      "id": "2a59168f",
      "bank_id": "504f2802",
      "text": "Ölü bedenler görmekten nefret ediyorum. Bütün iştahım kaçıyor."
    },
    {
      "id": "32b58414",
      "bank_id": "504f2802",
      "text": "Biz bu dünyaya kötülük yapmaya gönderildik, iyilik yapmaya değil."
    },
    {
      "id": "32b58415",
      "bank_id": "504f2802",
      "text": "Siz evliya tipler ne kaçırdığınızı bilmiyorsunuz. Kötü olmak çok daha eğlenceli."
    },
    {
      "id": "333357d8",
      "bank_id": "504f2802",
      "text": "Belki de biri doktor çağırmalıdır."
    },
    {
      "id": "333357d9",
      "bank_id": "504f2802",
      "text": "Biri şu kişinin nabzına bakmalı."
    },
    {
      "id": "333357da",
      "bank_id": "504f2802",
      "text": "Bunun gerçekten ölüp ölmediğine bakan oldu mu?"
    },
    {
      "id": "333357db",
      "bank_id": "504f2802",
      "text": "Ölmediklerinden emin olmak için biri kontrol etti mi?"
    },
    {
      "id": "333357dc",
      "bank_id": "504f2802",
      "text": "Hâlâ nefes alıp almadığına bakmak için kimsede ayna var mı?"
    },
    {
      "id": "333357dd",
      "bank_id": "504f2802",
      "text": "Umarım sadece uyuyan biridir."
    },
    {
      "id": "333357df",
      "bank_id": "504f2802",
      "text": "O bir ceset değil, değil mi?"
    },
    {
      "id": "36c0ca68",
      "bank_id": "504f2802",
      "text": "Sizi görmek çok güzel."
    },
    {
      "id": "36c0ca6a",
      "bank_id": "504f2802",
      "text": "Her şey yolunda mı?"
    },
    {
      "id": "36c0ca6b",
      "bank_id": "504f2802",
      "text": "Sizi görmek her zaman güzel."
    },
    {
      "id": "36c0ca6c",
      "bank_id": "504f2802",
      "text": "Umarım her şey yolunda gidiyordur."
    },
    {
      "id": "36c0ca6d",
      "bank_id": "504f2802",
      "text": "Nefis bir gün, değil mi."
    },
    {
      "id": "36c0ca6e",
      "bank_id": "504f2802",
      "text": "Buralarda olmanız bir zevk."
    },
    {
      "id": "36c0ca6f",
      "bank_id": "504f2802",
      "text": "Ahh, umarım her şey yolundadır."
    },
    {
      "id": "36db2a88",
      "bank_id": "504f2802",
      "text": "Buralarda evliya tiplere ihtiyacımız yok bizim."
    },
    {
      "id": "36db2a89",
      "bank_id": "504f2802",
      "text": "Değişiklik olsun diye kötü bir şey yapmayı dene. Hadi ama! Hoşuna gidecek."
    },
    {
      "id": "36db2a8d",
      "bank_id": "504f2802",
      "text": "Keşke bütün maceracılar sizin gibi dürüst olsa."
    },
    {
      "id": "36db2a8e",
      "bank_id": "504f2802",
      "text": "Çoğu savaşçıya merhamet konusunda ders verebilirsiniz."
    },
    {
      "id": "36db2a8f",
      "bank_id": "504f2802",
      "text": "Hepimiz sizin kadar dürüst olsaydık dünya çok daha iyi bir yer olurdu."
    },
    {
      "id": "3bc0d209",
      "bank_id": "504f2802",
      "text": "Oh, sizi görmek güzel, Kahraman."
    },
    {
      "id": "3bc0d20a",
      "bank_id": "504f2802",
      "text": "Umarım her şey yolundadır, Kahraman."
    },
    {
      "id": "3bc0d20b",
      "bank_id": "504f2802",
      "text": "Nasıl gidiyor bakalım?"
    },
    {
      "id": "3bc0d20c",
      "bank_id": "504f2802",
      "text": "Umarım iyisindir."
    },
    {
      "id": "3bc0d20d",
      "bank_id": "504f2802",
      "text": "Seni görmek ne güzel."
    },
    {
      "id": "3bc0d20e",
      "bank_id": "504f2802",
      "text": "Hayırlı günler dilerim."
    },
    {
      "id": "3bc0d20f",
      "bank_id": "504f2802",
      "text": "Umarım afiyettesinizdir."
    },
    {
      "id": "3bde9ae0",
      "bank_id": "504f2802",
      "text": "Adalet tanrıları belanı versin!"
    },
    {
      "id": "3bde9ae1",
      "bank_id": "504f2802",
      "text": "Senin gibi biriyle asla konuşmam."
    },
    {
      "id": "3bde9ae2",
      "bank_id": "504f2802",
      "text": "Defol git başımdan be!"
    },
    {
      "id": "3bde9ae3",
      "bank_id": "504f2802",
      "text": "Uzak dur benden!"
    },
    {
      "id": "3bde9ae4",
      "bank_id": "504f2802",
      "text": "Kimse seni burada istemiyor."
    },
    {
      "id": "3bde9ae5",
      "bank_id": "504f2802",
      "text": "Tufanlar kopsun üzerine!"
    },
    {
      "id": "3bde9ae7",
      "bank_id": "504f2802",
      "text": "Neden sadece evine gitmiyorsun?"
    },
    {
      "id": "3f1e7d78",
      "bank_id": "504f2802",
      "text": "Çok temiz bir kalbin var."
    },
    {
      "id": "3f1e7d7a",
      "bank_id": "504f2802",
      "text": "O kadar çok erdemin var ki havaya uçup gitmemene şaşmalı."
    },
    {
      "id": "3f1e7d7b",
      "bank_id": "504f2802",
      "text": "Ne kadar doğru ve ahlaklı biri olduğunu herkes biliyor."
    },
    {
      "id": "3f1e7d7c",
      "bank_id": "504f2802",
      "text": "Tam bir hanım evladısın, değil mi?"
    },
    {
      "id": "3f1e7d7d",
      "bank_id": "504f2802",
      "text": "Her zaman doğru olanı yapmak zorundasın, değil mi? Gösteriş meraklısı."
    },
    {
      "id": "3f1e7d7e",
      "bank_id": "504f2802",
      "text": "Gerçekten çok erdemli bir insansın."
    },
    {
      "id": "3f1e7d7f",
      "bank_id": "504f2802",
      "text": "Ne kadar doğru ve ahlaklı biri olduğunu herkes biliyor."
    },
    {
      "id": "41db3c38",
      "bank_id": "504f2802",
      "text": "Kıçından bir çiçek fışkırıyor senin."
    },
    {
      "id": "41db3c39",
      "bank_id": "504f2802",
      "text": "Bizden daha üstün olduğunu sanıyorsun, değil mi?"
    },
    {
      "id": "41db3c3c",
      "bank_id": "504f2802",
      "text": "Hoş bir insansınız."
    },
    {
      "id": "41db3c3e",
      "bank_id": "504f2802",
      "text": "Büyükannemin \"has insan\" dediği tiptensiniz."
    },
    {
      "id": "41db3c3f",
      "bank_id": "504f2802",
      "text": "Bu ay kaç tane iyilik yaptınız bakalım?"
    },
    {
      "id": "42dea5e8",
      "bank_id": "504f2802",
      "text": "Bizi rahat bırak."
    },
    {
      "id": "42dea5e9",
      "bank_id": "504f2802",
      "text": "Seni görmeye tahammülüm yok."
    },
    {
      "id": "42dea5ea",
      "bank_id": "504f2802",
      "text": "Burada ne işin var?"
    },
    {
      "id": "42dea5ec",
      "bank_id": "504f2802",
      "text": "Gidecek başka bir yerin yok mu senin?!"
    },
    {
      "id": "42dea5ed",
      "bank_id": "504f2802",
      "text": "Ah, umarım keskin bir parmaklığa denk gelirsin!"
    },
    {
      "id": "42dea5ee",
      "bank_id": "504f2802",
      "text": "Geber git!"
    },
    {
      "id": "42dea5ef",
      "bank_id": "504f2802",
      "text": "Yıkıl karşımdan!"
    },
    {
      "id": "441e8519",
      "bank_id": "504f2802",
      "text": "Bir çeşit aziz gibisin."
    },
    {
      "id": "441e851a",
      "bank_id": "504f2802",
      "text": "Hepimize bir örneksin."
    },
    {
      "id": "441e851b",
      "bank_id": "504f2802",
      "text": "Kimse senin kadar iyi değil."
    },
    {
      "id": "441e851c",
      "bank_id": "504f2802",
      "text": "Sürekli bu kadar iyi olmaktan bıkmıyor musun?"
    },
    {
      "id": "441e851d",
      "bank_id": "504f2802",
      "text": "İyilik yapmayı pek bir seviyorsun, değil mi?"
    },
    {
      "id": "441e851e",
      "bank_id": "504f2802",
      "text": "Sen bir erdem timsalisin."
    },
    {
      "id": "441e851f",
      "bank_id": "504f2802",
      "text": "Ahlaki duruşuna hayranım."
    },
    {
      "id": "491a2180",
      "bank_id": "504f2802",
      "text": "Birileri fena çekmiş kafayı! Ha ha!"
    },
    {
      "id": "491a2187",
      "bank_id": "504f2802",
      "text": "Küp gibi içmişsin değil mi? Kokun buraya kadar geliyor."
    },
    {
      "id": "4e1a29a0",
      "bank_id": "504f2802",
      "text": "Kendinden geçmişsin resmen, değil mi?"
    },
    {
      "id": "4e1a29a7",
      "bank_id": "504f2802",
      "text": "Birileri kafayı fazla çekmiş!"
    },
    {
      "id": "5606d92e",
      "bank_id": "504f2802",
      "text": "Hiçbir işe yaramaz aptalın tekisin sen."
    },
    {
      "id": "58e1f858",
      "bank_id": "504f2802",
      "text": "Hey, bakın, bir ceset."
    },
    {
      "id": "58e1f859",
      "bank_id": "504f2802",
      "text": "Şuna da bir bakın hele. Ölmüş."
    },
    {
      "id": "58e1f85a",
      "bank_id": "504f2802",
      "text": "Aman Tanrım, bu bir ceset!"
    },
    {
      "id": "58e1f85b",
      "bank_id": "504f2802",
      "text": "Bir kadavra!"
    },
    {
      "id": "58e1f85d",
