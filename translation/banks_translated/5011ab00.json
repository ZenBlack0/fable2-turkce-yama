    {
      "id": "6dd752e1",
      "bank_id": "5011ab00",
      "text": "Şöhret möhret dinlemem, burada uyuya kalacağım valla."
    },
    {
      "id": "6dd752e4",
      "bank_id": "5011ab00",
      "text": "Ünlü insanlar ne kadar da sıkıcı olabiliyor."
    },
    {
      "id": "6dd752e6",
      "bank_id": "5011ab00",
      "text": "Sıkıcı bir ünlüden daha beter bir şey var mıdır?"
    },
    {
      "id": "6dd752e7",
      "bank_id": "5011ab00",
      "text": "Şöhreti kadar sıkıcı."
    },
    {
      "id": "6e751c70",
      "bank_id": "5011ab00",
      "text": "Buna daha fazla katlanabileceğimi sanmıyorum. Yeni bir numarayla gel koca patron."
    },
    {
      "id": "6e751c73",
      "bank_id": "5011ab00",
      "text": "Senin gibi üne sahip birini kırmak istemem ama bu artık kabak tadı vermeye başladı."
    },
    {
      "id": "6e751c74",
      "bank_id": "5011ab00",
      "text": "Ünlüymüş pöh. İçimi baydın."
    },
    {
      "id": "6e751c76",
      "bank_id": "5011ab00",
      "text": "Büyük üne kavuşanların bile insanı canından bezdirebileceğinin kanıtısın."
    },
    {
      "id": "6e751c77",
      "bank_id": "5011ab00",
      "text": "Şöhretin büyük olabilir ama hayal gücün sınıfta kalmış."
    },
    {
      "id": "70d5a890",
      "bank_id": "5011ab00",
      "text": "Bütün numaran bu mu?"
    },
    {
      "id": "70d5a891",
      "bank_id": "5011ab00",
      "text": "Evet, her neyse."
    },
    {
      "id": "70d5a892",
      "bank_id": "5011ab00",
      "text": "Bunu zaten gördüm."
    },
    {
      "id": "70d5a894",
      "bank_id": "5011ab00",
      "text": "Ne kadar bayat."
    },
    {
      "id": "70d5a895",
      "bank_id": "5011ab00",
      "text": "Feci sıkıcı."
    },
    {
      "id": "70d5a896",
      "bank_id": "5011ab00",
      "text": "Gördük bunu!"
    },
    {
      "id": "70d5a897",
      "bank_id": "5011ab00",
      "text": "Bütün numaran bu mu?"
    },
    {
      "id": "79d5b6f8",
      "bank_id": "5011ab00",
      "text": "Ah, ne yavanlık ama."
    },
    {
      "id": "79d5b6f9",
      "bank_id": "5011ab00",
      "text": "Resmen tekdüze."
    },
    {
      "id": "79d5b6fa",
      "bank_id": "5011ab00",
      "text": "Sıkıldım!"
    },
    {
      "id": "79d5b6fb",
      "bank_id": "5011ab00",
      "text": "Bu kadar mı yani?!"
