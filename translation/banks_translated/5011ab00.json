    {
      "id": "9ecf6924",
      "bank_id": "5011ab00",
      "text": "Mmmm, ekmek arası yapıp yerim seni."
    },
    {
      "id": "9ecf6925",
      "bank_id": "5011ab00",
      "text": "Vay be, öyle leziz görünüyorsun ki."
    },
    {
      "id": "9ecf6926",
      "bank_id": "5011ab00",
      "text": "Hayvansı çekiciliğin müthiş bir güçle kendine çekiyor."
    },
    {
      "id": "9ecf6927",
      "bank_id": "5011ab00",
      "text": "Daha önce hiç bu kadar dizginsiz bir çekim hissetmemiştim."
    },
    {
      "id": "a36f5fb3",
      "bank_id": "5011ab00",
      "text": "Yetişkinler neden bu kadar sıkıcı? Ünlü olanları bile."
    },
    {
      "id": "a3fd47e8",
      "bank_id": "5011ab00",
      "text": "Her zamanki haline kıyasla pek de o kadar çirkin sayılmazsın."
    },
    {
      "id": "a3fd47e9",
      "bank_id": "5011ab00",
      "text": "Bir dakika, senin korkunç çirkin olman gerekmiyor muydu?"
    },
    {
      "id": "a3fd47eb",
      "bank_id": "5011ab00",
      "text": "İmajını düzeltmeye çalışıyorsun ha?"
    },
    {
      "id": "a3fd47ec",
      "bank_id": "5011ab00",
      "text": "Eh, çirkinler güruhundan kurtulmak adına doğru yönde atılmış küçük bir adım."
    },
    {
      "id": "a3fd47ed",
      "bank_id": "5011ab00",
      "text": "Halkın gözündeki imajını düzeltmeye çalışmanın vakti gelmişti zaten."
    },
    {
      "id": "a3fd47ee",
      "bank_id": "5011ab00",
      "text": "Ayna kıran birinden bekleyeceğim türden bir şey değil doğrusu."
    },
    {
      "id": "a3fd47ef",
      "bank_id": "5011ab00",
      "text": "Peh, çirkinliğini gizlemeye çalışıyorsun değil mi?"
    },
    {
      "id": "a5e49980",
      "bank_id": "5011ab00",
      "text": "Ben yalnızca belirli türdeki hayat kadınlarından hoşlanırım."
    },
    {
      "id": "a5e49981",
      "bank_id": "5011ab00",
      "text": "Hmm, benim ilgi alanlarım başka yerde."
    },
    {
      "id": "a5e49982",
      "bank_id": "5011ab00",
      "text": "Ne?! Hayır, kesinlikle benim tipim değilsin."
    },
    {
      "id": "a5e49984",
      "bank_id": "5011ab00",
      "text": "Etrafta farklı cinsiyetten bir yoldaşın yok mu acaba?"
    },
    {
      "id": "a5e49985",
      "bank_id": "5011ab00",
      "text": "Resmen şaşkına döndüm! Senin gibilerle bu tür işlere kalkışmam ben. Artık olmaz."
    },
    {
      "id": "a5e49986",
      "bank_id": "5011ab00",
      "text": "O tarafa yelken açmam ben!"
    },
    {
      "id": "a5e49987",
      "bank_id": "5011ab00",
      "text": "Ben başka tür bir sevgiden hoşlanırım."
    },
    {
      "id": "aa6f6ab6",
      "bank_id": "5011ab00",
      "text": "Ünlü olabilirsin ama yine de sıkıcısın."
    },
    {
      "id": "aee4a7e8",
      "bank_id": "5011ab00",
      "text": "Üzülerek söylüyorum ki tercih ettiğim cinsiyet kesinlikle sen değilsin."
    },
    {
      "id": "aee4a7e9",
      "bank_id": "5011ab00",
      "text": "İltifatına teşekkürler ama beni senin türünden hoşlanan biriyle karıştırdın."
    },
    {
      "id": "aee4a7ea",
      "bank_id": "5011ab00",
      "text": "İtiraf etmeliyim ki biraz merak etmedim değil. Ama yok, kalsın."
    },
    {
      "id": "aee4a7eb",
      "bank_id": "5011ab00",
      "text": "Senin gibileri bilirim! Hobbe'lerden bir farkın yok değil mi?"
    },
    {
      "id": "aee4a7ec",
      "bank_id": "5011ab00",
      "text": "Hayır teşekkürler, pek benim tipim değilsin."
    },
    {
      "id": "aee4a7ed",
      "bank_id": "5011ab00",
      "text": "Ben sevgi satın almam. Hele senden asla!"
    },
    {
      "id": "aee4a7ef",
      "bank_id": "5011ab00",
      "text": "Ne? Seninle mi? Hiç sanmıyorum."
    },
    {
      "id": "b1a08d88",
      "bank_id": "5011ab00",
      "text": "Çekici biri olma yolunda ilerliyorsun."
    },
    {
      "id": "b1a08d8a",
      "bank_id": "5011ab00",
      "text": "Kesinlikle her zamankinden daha az çirkinsin."
    },
    {
      "id": "b1a08d8b",
      "bank_id": "5011ab00",
      "text": "Doğrusu her zamankinden daha hoş görünüyorsun."
    },
    {
      "id": "b1a08d8c",
      "bank_id": "5011ab00",
      "text": "Çirkin olmaktan bıktın ha?"
    },
    {
      "id": "b1a08d8d",
      "bank_id": "5011ab00",
      "text": "Ne oldu? Çirkin olmak yetmedi mi sana?"
    },
    {
      "id": "b44f2960",
      "bank_id": "5011ab00",
      "text": "Son yirmi seferde bu çok daha etkileyiciydi..."
    },
    {
      "id": "b44f2961",
      "bank_id": "5011ab00",
      "text": "Ah! Vay canına! Yine mi..."
    },
    {
      "id": "b44f2962",
      "bank_id": "5011ab00",
      "text": "Ünlü ve harika olduğunu falan biliyorum ama hep aynı şeyi görmekten gına geldi."
    },
    {
      "id": "b44f2964",
      "bank_id": "5011ab00",
      "text": "Bu özgünlük eksikliği senin gibi büyük şöhretli birine hiç yakışmıyor."
    },
    {
      "id": "b44f2965",
      "bank_id": "5011ab00",
      "text": "Ah evet, ama senin gibi üne sahip birinin yenin içinde daha fazla numara olmalı..."
    },
    {
      "id": "b44f2966",
      "bank_id": "5011ab00",
      "text": "Eeeeesneeediiim! İşte koca Kahraman mısın nesin, senin hakkında tam da bunu düşünüyorum."
    },
    {
      "id": "b44f2967",
      "bank_id": "5011ab00",
      "text": "Nesin sen böyle? Tek bir numarası olan cambaz mı?"
    },
    {
      "id": "b6a095a9",
      "bank_id": "5011ab00",
      "text": "Daha az çirkin olmaya çalışıyorsun ha?"
    },
    {
      "id": "b6a095aa",
      "bank_id": "5011ab00",
      "text": "Görünüşünü düzeltiyorsun demek?"
    },
    {
      "id": "b6a095ab",
      "bank_id": "5011ab00",
      "text": "Eh, bu biraz olsun gelişme sayılır."
    },
    {
      "id": "b6a095ac",
      "bank_id": "5011ab00",
      "text": "Bir nebze daha az çirkinsin herhalde."
    },
    {
      "id": "b6a095ad",
      "bank_id": "5011ab00",
      "text": "Bu kadar çirkin biri için fena sayılmaz."
    },
    {
      "id": "bd4f3748",
      "bank_id": "5011ab00",
      "text": "Artık bundan gına geldi. Senin gibi ünlü bir maceracı daha fazlasını yapabilir herhalde."
    },
    {
      "id": "bd4f3749",
      "bank_id": "5011ab00",
      "text": "Bir ünlü için bile gereğinden fazla tekrara düşüyorsun doğrusu."
    },
    {
      "id": "bd4f374a",
      "bank_id": "5011ab00",
      "text": "Bu kadar ünlü olmanın sebebi bu mu? İnsanları sıkıntıdan öldürmek mi?"
    },
    {
      "id": "bd4f374b",
      "bank_id": "5011ab00",
      "text": "Gördüm, gördüm, gördüm. Ne kadar meşhur olduğun umrumda değil, *hâlâ* gördüm bunu."
    },
    {
      "id": "bd4f374c",
      "bank_id": "5011ab00",
      "text": "Çok fazla kez gördüm zaten ulu maceracı."
    },
    {
      "id": "bd4f374d",
      "bank_id": "5011ab00",
      "text": "Ünlüler bile sıkıcı olabiliyormuş meğer."
    },
    {
      "id": "bd4f374f",
