    {
      "id": "63750ac2",
      "bank_id": "5011ab00",
      "text": "Yine mi bu! Yani... harika, ey ulu kişi..."
    },
    {
      "id": "63750ac3",
      "bank_id": "5011ab00",
      "text": "Ünlülerden bıkabileceğimi hiç sanmazdım ama işte oluyor."
    },
    {
      "id": "63750ac6",
      "bank_id": "5011ab00",
      "text": "Ne kadar feci usandırıcı. Şöhretin böylesi bir tekdüzeliği haklı çıkarmaz."
    },
    {
      "id": "63750ac7",
      "bank_id": "5011ab00",
      "text": "Şöhretini böyle mi kazandın yani? Yaman bir sıkıcılık abidesi olarak mı?"
    },
    {
      "id": "6807eef8",
      "bank_id": "5011ab00",
      "text": "Bayağı hoşuma gittin."
