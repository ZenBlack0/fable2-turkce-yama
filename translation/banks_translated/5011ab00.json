    {
      "id": "79d5b6fc",
      "bank_id": "5011ab00",
      "text": "Bu tanıdık geldi."
    },
    {
      "id": "79d5b6fd",
      "bank_id": "5011ab00",
      "text": "Yeni bir şey yok mu yani?"
    },
    {
      "id": "79d5b6ff",
      "bank_id": "5011ab00",
      "text": "Ah, yine mi bu."
    },
    {
      "id": "80600df3",
      "bank_id": "5011ab00",
      "text": "Tam bir can sıkıntısısın."
    },
    {
      "id": "876018f6",
      "bank_id": "5011ab00",
      "text": "Ah, bu resmen sıkıcı."
    },
    {
      "id": "8b1b85a0",
      "bank_id": "5011ab00",
      "text": "Benim zevklerim biraz daha farklıdır..."
    },
    {
      "id": "8b1b85a1",
      "bank_id": "5011ab00",
      "text": "Senin tipinle gerçekten ilgilenmiyorum."
    },
    {
      "id": "8b1b85a3",
      "bank_id": "5011ab00",
      "text": "Kusura bakma ama ekmeğimin o tarafına yağ sürmem ben. Başka hiçbir şeyin de öyle."
    },
    {
      "id": "8b1b85a6",
      "bank_id": "5011ab00",
      "text": "Kusura bakma, o tarafa meyilli değilim."
    },
    {
      "id": "8b1b85a7",
      "bank_id": "5011ab00",
      "text": "Ne?! Hayır! Uzak dur benden!"
    },
    {
      "id": "921b90a2",
      "bank_id": "5011ab00",
      "text": "Ben öyle şeylere gelemem."
    },
    {
      "id": "93cf57f1",
      "bank_id": "5011ab00",
      "text": "Nefesimi kesiyorsun."
    },
    {
      "id": "93cf57f2",
      "bank_id": "5011ab00",
      "text": "Bütün gün sana bakabilirim."
    },
    {
      "id": "93cf57f3",
      "bank_id": "5011ab00",
      "text": "Cidden bir harikasın!"
    },
    {
      "id": "93cf57f4",
      "bank_id": "5011ab00",
      "text": "Tam bir afetmişsin hani!"
    },
    {
      "id": "93cf57f5",
      "bank_id": "5011ab00",
      "text": "Vay canına! Şuna da bakın!"
    },
    {
      "id": "93cf57f6",
      "bank_id": "5011ab00",
      "text": "Güzelliğin karşısında büyülendim."
    },
    {
      "id": "93cf57f7",
      "bank_id": "5011ab00",
      "text": "Böylesi bir zarafeti daha önce hiç görmemiştim."
    },
    {
      "id": "9afd3998",
      "bank_id": "5011ab00",
      "text": "Doğrusu, her zamanki görünüşüne kıyasla ufak bir gelişme."
    },
    {
      "id": "9afd3999",
      "bank_id": "5011ab00",
      "text": "Eh, bu o çirkinliği biraz olsun hafifletmiş."
    },
    {
      "id": "9afd399a",
      "bank_id": "5011ab00",
      "text": "Kimseyi kandıramazsın; yüzünü hâlâ görebiliyorum."
    },
    {
      "id": "9afd399b",
      "bank_id": "5011ab00",
      "text": "Peh, çirkin olmadığını kanıtlamaya çalışmanın alemi yok."
    },
    {
      "id": "9afd399c",
      "bank_id": "5011ab00",
      "text": "İmajını düzeltmek için tam da böyle bir şeye ihtiyacın vardı."
    },
    {
      "id": "9afd399d",
      "bank_id": "5011ab00",
      "text": "Düşündüğüm kadar çirkin değilmişsin meğer."
    },
    {
      "id": "9afd399e",
      "bank_id": "5011ab00",
      "text": "Biraz imaj yenilemeye kalkıştın herhalde?"
