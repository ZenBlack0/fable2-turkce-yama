  "strings": [
    {
      "id": "04542440",
      "bank_id": "5011ab00",
      "text": "Sıkıldığımı söylersem kırılmazsın değil mi koca Kahraman?"
    },
    {
      "id": "08c9ef23",
      "bank_id": "5011ab00",
      "text": "Güzel."
    },
    {
      "id": "0b215655",
      "bank_id": "5011ab00",
      "text": "Uykumu getirdin yahu. Hep aynı terane. Yeni bir şeyler bulsana ünlü oğlan."
    },
    {
      "id": "0b21565e",
      "bank_id": "5011ab00",
      "text": "Uykumu getirdin yahu. Hep aynı terane. Yeni bir şeyler bulsana ünlü kız."
    },
    {
      "id": "0c7da2ae",
      "bank_id": "5011ab00",
      "text": "Fena bir tarz değil."
    },
    {
      "id": "0fc9fa26",
      "bank_id": "5011ab00",
      "text": "Harika."
    },
    {
      "id": "157db0fb",
      "bank_id": "5011ab00",
      "text": "Fena görünmüyorsun herhalde."
    },
    {
      "id": "19a444a3",
      "bank_id": "5011ab00",
      "text": "Sıkıcı, sıkıcı, sıkıcı."
    },
    {
      "id": "20a44fa6",
      "bank_id": "5011ab00",
      "text": "Bu çooook sıkıcı."
    },
    {
      "id": "25010641",
      "bank_id": "5011ab00",
      "text": "Vay canına."
    },
    {
      "id": "26c87728",
      "bank_id": "5011ab00",
      "text": "Harika bir tarz!"
    },
    {
      "id": "2bc87ec9",
      "bank_id": "5011ab00",
      "text": "Gerçekten çok havalı görünüyorsun."
    },
    {
      "id": "2c0c0db4",
      "bank_id": "5011ab00",
      "text": "Fena sayılmaz bir tarzın var."
    },
    {
      "id": "300117f0",
      "bank_id": "5011ab00",
      "text": "Vay canına."
    },
    {
      "id": "310c1555",
      "bank_id": "5011ab00",
      "text": "Bu tarz bayağı havalıymış."
    },
    {
      "id": "35db5bc1",
      "bank_id": "5011ab00",
      "text": "Bu hayatımda gördüğüm en sıkıcı şey olabilir."
    },
    {
      "id": "40db6d70",
      "bank_id": "5011ab00",
      "text": "Hep aynı numaraları yapıyorsun."
    },
    {
      "id": "51828c58",
      "bank_id": "5011ab00",
      "text": "Çok daha çirkinlerini gördüm. Sevdim bunu!"
    },
    {
      "id": "51828c59",
      "bank_id": "5011ab00",
      "text": "Hayır demezdim hani."
    },
    {
      "id": "51828c5a",
      "bank_id": "5011ab00",
      "text": "Bana kalırsa oldukça çekici."
    },
    {
      "id": "51828c5b",
      "bank_id": "5011ab00",
      "text": "Hiç fena değil."
    },
    {
      "id": "51828c5d",
      "bank_id": "5011ab00",
      "text": "Bayağı güzelsin."
    },
    {
      "id": "51828c5e",
      "bank_id": "5011ab00",
      "text": "Daha güzellerini gördüm ama çok daha çirkinlerini de gördüm."
    },
    {
      "id": "51828c5f",
      "bank_id": "5011ab00",
      "text": "Yatağımdan kovmazdım doğrusu."
    },
    {
      "id": "52cb12b1",
      "bank_id": "5011ab00",
      "text": "Tek kelimeyle harikaydı hayatım!"
    },
    {
      "id": "52cb12b2",
      "bank_id": "5011ab00",
      "text": "Ah tatlım, çok harikasın!"
    },
    {
      "id": "52cb12b3",
      "bank_id": "5011ab00",
      "text": "Vay be, inanılmazdı canım!"
    },
    {
      "id": "52cb12b4",
      "bank_id": "5011ab00",
      "text": "Aklımı başımdan alıyorsun sevgilim!"
    },
    {
      "id": "52cb12b5",
      "bank_id": "5011ab00",
      "text": "Bir tanesin canım benim!"
    },
    {
      "id": "52cb12b6",
      "bank_id": "5011ab00",
      "text": "Beni şaşırtmaktan hiç geri kalmıyorsun tatlım!"
