{
  "bank_id": "3013ab00",
  "total_strings": 223,
  "strings": [
    {
      "id": "01aac8df",
      "bank_id": "3013ab00",
      "text": "Ha ha, diğer tüm anne babalardan daha komiksin."
    },
    {
      "id": "060d52ef",
      "bank_id": "3013ab00",
      "text": "Bunu bir gün bana da öğretmelisin."
    },
    {
      "id": "0b7dc574",
      "bank_id": "3013ab00",
      "text": "Ha ha, çok şapşalsın."
    },
    {
      "id": "0f592705",
      "bank_id": "3013ab00",
      "text": "Merak etme anneciğim, nasıl görünürsen görün seni çok seviyorum."
    },
    {
      "id": "0f59270e",
      "bank_id": "3013ab00",
      "text": "Merak etme babacığım, nasıl görünürsen görün seni çok seviyorum."
    },
    {
      "id": "107dcd15",
      "bank_id": "3013ab00",
      "text": "Ha ha, çok şapşalsın."
    },
    {
      "id": "111bf084",
      "bank_id": "3013ab00",
      "text": "Bunu yapmana bayılıyorum."
    },
    {
      "id": "11e82a12",
      "bank_id": "3013ab00",
      "text": "Harika bu, baba!"
    },
    {
      "id": "11e82a19",
      "bank_id": "3013ab00",
      "text": "Harika bu, anne!"
    },
    {
      "id": "121f79c4",
      "bank_id": "3013ab00",
      "text": "İyi iş çıkardın, Baba."
    },
    {
      "id": "121f79cf",
      "bank_id": "3013ab00",
      "text": "Bunu nasıl yapacağımı bana da öğretmelisin, Anne."
    },
    {
      "id": "161bf8a5",
      "bank_id": "3013ab00",
      "text": "Seni başka hiçbir ebeveyne değişmem."
    },
    {
      "id": "18b3e633",
      "bank_id": "3013ab00",
      "text": "Iyy, hiç hoş değil."
    },
    {
      "id": "1cdf6fb0",
      "bank_id": "3013ab00",
      "text": "Keyfim yerinde ve öyle de kalacak, ne yaptığın umurumda değil."
    },
    {
      "id": "1cdf6fb1",
      "bank_id": "3013ab00",
      "text": "Keyfimi kaçırmana izin vermeyeceğim."
    },
    {
      "id": "1cdf6fb2",
      "bank_id": "3013ab00",
      "text": "Az önceye kadar neşem gayet yerindeydi."
    },
    {
      "id": "1cdf6fb3",
      "bank_id": "3013ab00",
      "text": "Neden güzel havamı bozmakta bu kadar ısrarcısın?"
    },
    {
      "id": "1cdf6fb4",
      "bank_id": "3013ab00",
      "text": "Keyfimi kaçırmana izin vermiyorum."
    },
    {
      "id": "1cdf6fb6",
      "bank_id": "3013ab00",
      "text": "Hey, keyfim yerinde, o yüzden bu konuda ne düşündüğümü söylemeye bile tenezzül etmeyeceğim."
    },
    {
      "id": "1cdf6fb7",
      "bank_id": "3013ab00",
      "text": "Pöh! Gün şu ana kadar o kadar iyi gidiyordu ki."
    },
    {
      "id": "1fb3f136",
      "bank_id": "3013ab00",
      "text": "Öff. Bu şeyleri yapmak zorunda mısın?"
    },
    {
      "id": "21df7750",
      "bank_id": "3013ab00",
      "text": "Herkesin keyfini kaçırmak zorundasın, değil mi?"
    },
    {
      "id": "21df7751",
      "bank_id": "3013ab00",
      "text": "Neden herkesin gününü berbat etmek zorundasın?"
    },
    {
      "id": "21df7752",
      "bank_id": "3013ab00",
      "text": "Güneşli neşemi neden bulutlu çamura bulamak zorundasın ki?"
    },
    {
      "id": "21df7753",
      "bank_id": "3013ab00",
      "text": "Bir zamanlar pırıl pırıl olan günümü kararttın."
    },
    {
      "id": "21df7755",
      "bank_id": "3013ab00",
      "text": "Tam her şey iyi gidiyorken çıkageldin."
    },
    {
      "id": "21df7756",
      "bank_id": "3013ab00",
      "text": "Ne? Güzel havamı bozmaya mı çalışıyorsun?"
    },
    {
      "id": "21df7757",
      "bank_id": "3013ab00",
      "text": "Sen bunu yapana kadar harika bir ruh halindeydim."
    },
    {
      "id": "27c26121",
      "bank_id": "3013ab00",
      "text": "Uğraşmaya ne gerek var ki?"
    },
    {
      "id": "27c26122",
      "bank_id": "3013ab00",
      "text": "Ve bir şekilde hayat daha da anlamsızlaşıyor..."
    },
    {
      "id": "27c26123",
      "bank_id": "3013ab00",
      "text": "Her şey karanlık bir uçurum..."
    },
    {
      "id": "27c26124",
      "bank_id": "3013ab00",
      "text": "Hayatımı boşa harcıyorum."
    },
    {
      "id": "27c26125",
      "bank_id": "3013ab00",
      "text": "Belki de ölürüm ve her şey biter..."
    },
    {
      "id": "2c03b8c0",
      "bank_id": "3013ab00",
      "text": "İyi ki keyfim yerinde."
    },
    {
      "id": "2c03b8c1",
      "bank_id": "3013ab00",
      "text": "Neden keyfimi kaçırmaya çalışıyorsun?"
    },
    {
      "id": "2c03b8c3",
      "bank_id": "3013ab00",
      "text": "Şanslısın ki iyi bir günümdeyim."
    },
    {
      "id": "2c03b8c6",
      "bank_id": "3013ab00",
      "text": "Bak, mutluydum. Beni öyle bırakamaz mısın?"
    },
    {
      "id": "2c03b8c7",
      "bank_id": "3013ab00",
      "text": "Mutluluğumu bozmaya çalışmaktan vazgeç."
    },
    {
      "id": "2c3183c8",
      "bank_id": "3013ab00",
      "text": "Ah, kes şunu."
    },
    {
      "id": "2c3183ca",
      "bank_id": "3013ab00",
      "text": "Burada dikilip bunu izleyecek değilim."
    },
    {
      "id": "2c3183cb",
      "bank_id": "3013ab00",
      "text": "Gerçekten, bazı insanların hayvanlardan farkı yok."
    },
    {
      "id": "2c3183cc",
      "bank_id": "3013ab00",
      "text": "Bunun adı tek kelimeyle rezalet."
    },
    {
      "id": "2c3183cd",
      "bank_id": "3013ab00",
      "text": "Artık buna katlanamayacağım."
    },
    {
      "id": "2c3183ce",
      "bank_id": "3013ab00",
      "text": "Korkunçluğun ta kendisi."
    },
    {
      "id": "2c3183cf",
      "bank_id": "3013ab00",
      "text": "Bu tarif edilemez derecede berbat!"
    },
    {
      "id": "31318be9",
      "bank_id": "3013ab00",
      "text": "Bugünlerde katlanmak zorunda kaldığımız şeylere bak."
    },
    {
      "id": "31318bea",
      "bank_id": "3013ab00",
      "text": "Bunu kim görmek ister ki?!"
    },
    {
      "id": "31318beb",
      "bank_id": "3013ab00",
      "text": "Bunun adı düpedüz rezalet."
    },
    {
      "id": "31318bec",
      "bank_id": "3013ab00",
      "text": "Kokuyor. Hobbe gibi leş kokuyor."
    },
    {
      "id": "31318bed",
      "bank_id": "3013ab00",
      "text": "Trol kusmuğundan beter."
    },
    {
      "id": "31318bee",
      "bank_id": "3013ab00",
      "text": "Ah, keşke merhametli kuzgunlar gözlerimi oysaydı."
    },
    {
      "id": "31318bef",
      "bank_id": "3013ab00",
      "text": "Bu narin duyularıma bir hakaret."
    },
    {
      "id": "3219dca2",
      "bank_id": "3013ab00",
      "text": "Her zaman harika şeyler yapıyorsun."
    },
    {
      "id": "32c27250",
      "bank_id": "3013ab00",
      "text": "Daha fazla depresyona giremem sanıyordum."
    },
    {
      "id": "32c27252",
      "bank_id": "3013ab00",
      "text": "Hayat uzun ve acı bir kâbustan ibaret, değil mi?"
    },
    {
      "id": "32c27253",
      "bank_id": "3013ab00",
      "text": "Beni daha da perişan etmeye çalışıyorsun, değil mi?"
    },
    {
      "id": "32c27254",
      "bank_id": "3013ab00",
      "text": "Tam moralimin daha fazla bozulmayacağını düşündüğüm anda."
    },
    {
      "id": "32c27255",
      "bank_id": "3013ab00",
      "text": "Herkesi intihara sürüklüyorsun."
    },
    {
      "id": "3303c3c2",
      "bank_id": "3013ab00",
      "text": "Neyse ki keyfim yerinde."
    },
    {
      "id": "3303c3c3",
      "bank_id": "3013ab00",
      "text": "Her şey çok iyi gidiyordu, şimdi de bu çıktı."
    },
    {
      "id": "3303c3c4",
      "bank_id": "3013ab00",
      "text": "Hep bir şeyleri bozmaya çalışıyorsun."
    },
    {
      "id": "3303c3c5",
      "bank_id": "3013ab00",
      "text": "Hmm, peki tamam, bunu görmezden geleceğim."
    },
    {
      "id": "3303c3c6",
      "bank_id": "3013ab00",
      "text": "Tamam, her neyse. Bunu yok saymayı seçiyorum."
    },
    {
      "id": "3341419e",
      "bank_id": "3013ab00",
      "text": "Bahse girerim başka hiçbir anne baba böyle havalı şeyler yapamaz."
    },
    {
      "id": "3393363d",
      "bank_id": "3013ab00",
      "text": "Ay, öyle çok tatlı görünüyorsun."
    },
    {
      "id": "3b19ea8f",
      "bank_id": "3013ab00",
      "text": "Bu muhteşemdi."
    },
    {
      "id": "3c414feb",
      "bank_id": "3013ab00",
      "text": "Bunu yapmana bayılıyorum."
    },
    {
      "id": "3d2a07a1",
      "bank_id": "3013ab00",
      "text": "Hayatımda bundan daha berbat bir şey görmedim."
    },
    {
      "id": "3d2a07a2",
      "bank_id": "3013ab00",
      "text": "Yapabileceğin onca şey varken en nefret ettiğimi yaptın!"
    },
    {
      "id": "3d2a07a3",
      "bank_id": "3013ab00",
      "text": "Bütün varlığımla bundan nefret ettiğimi nereden bildin?"
    },
    {
      "id": "3d2a07a4",
      "bank_id": "3013ab00",
      "text": "Leş gibi kokuyorsun! Şimdiye kadar kokmuş her şeyden daha beter."
    },
    {
      "id": "3d2a07a5",
      "bank_id": "3013ab00",
      "text": "Nefret ediyorum nefret ediyorum nefret ediyorum nefret ediyorum."
    },
    {
      "id": "3e8293e6",
      "bank_id": "3013ab00",
      "text": "Yapma babacığım, hoşuma gitmiyor!"
    },
    {
      "id": "3e8293ed",
      "bank_id": "3013ab00",
      "text": "Yapma anne, hoşuma gitmiyor!"
    },
    {
      "id": "3e93476c",
      "bank_id": "3013ab00",
      "text": "Ben de öyle yapacağım. Tabii pratik yaptıktan sonra."
    },
    {
      "id": "405fb59e",
      "bank_id": "3013ab00",
      "text": "Şunu yapmayı keser misin?"
    },
    {
      "id": "40b6e300",
      "bank_id": "3013ab00",
      "text": "Komik mi olması gerekiyordu?"
    },
    {
      "id": "40b6e301",
      "bank_id": "3013ab00",
      "text": "Korkunç. Tek kelimeyle korkunç."
    },
    {
      "id": "40b6e303",
      "bank_id": "3013ab00",
      "text": "Bu tek kelimeyle berbat."
    },
    {
      "id": "40b6e304",
      "bank_id": "3013ab00",
      "text": "Gerçekten iğrenç."
    },
    {
      "id": "40b6e305",
      "bank_id": "3013ab00",
      "text": "Şu an gerçekten epey canım sıkıldı."
    },
    {
      "id": "40b6e306",
      "bank_id": "3013ab00",
      "text": "İğrenç bu, resmen öyle."
    },
    {
      "id": "40b6e307",
      "bank_id": "3013ab00",
      "text": "Domuz gibi iğrenç."
    },
    {
      "id": "44e55452",
      "bank_id": "3013ab00",
      "text": "Artık dayanamıyorum!"
    },
    {
      "id": "44e55453",
      "bank_id": "3013ab00",
      "text": "Ahhhhh! İmdat!"
    },
    {
      "id": "44e55454",
      "bank_id": "3013ab00",
      "text": "Aaaaa!"
    },
    {
      "id": "44e55455",
      "bank_id": "3013ab00",
      "text": "Lütfen, yeter artık!"
    },
    {
      "id": "44e55457",
      "bank_id": "3013ab00",
      "text": "Ahhhhh! Hayır!"
    },
    {
      "id": "47b6ee00",
      "bank_id": "3013ab00",
      "text": "Ne kadar korkunç!"
    },
    {
      "id": "47b6ee01",
      "bank_id": "3013ab00",
      "text": "Bu düpedüz dehşet verici."
    },
    {
      "id": "47b6ee02",
      "bank_id": "3013ab00",
      "text": "Tam bir hobbe rezilliği."
    },
    {
      "id": "47b6ee03",
      "bank_id": "3013ab00",
      "text": "Çekil karşımdan!"
    },
    {
      "id": "47b6ee04",
      "bank_id": "3013ab00",
      "text": "Bu kadarı yeter!"
    },
    {
      "id": "47b6ee05",
      "bank_id": "3013ab00",
      "text": "Aman Tanrım!"
    },
    {
      "id": "47b6ee06",
      "bank_id": "3013ab00",
      "text": "Bu pek çok açıdan yanlış."
    },
    {
      "id": "482a18d0",
      "bank_id": "3013ab00",
      "text": "Kelimelerin kifayetsiz kaldığı bir felaket."
    },
    {
      "id": "482a18d2",
      "bank_id": "3013ab00",
      "text": "Menfur! Düpedüz menfur!"
    },
    {
      "id": "482a18d3",
      "bank_id": "3013ab00",
      "text": "Grrr, bundan gerçekten ama gerçekten nefret ediyorum!"
    },
    {
      "id": "482a18d4",
      "bank_id": "3013ab00",
      "text": "Bir şeyden bu kadar nefret edebileceğimi hiç düşünmezdim."
    },
    {
      "id": "482a18d5",
      "bank_id": "3013ab00",
      "text": "Ah, bunun bu kadar kötü olabileceğine inanamıyorum."
    },
    {
      "id": "495fc3eb",
      "bank_id": "3013ab00",
      "text": "Iyy, bunu yapmak zorunda mısın?"
    },
    {
      "id": "496c16c9",
      "bank_id": "3013ab00",
      "text": "Tüm insanlığa karşı bir yüz karası."
    },
    {
      "id": "49f16c71",
      "bank_id": "3013ab00",
      "text": "Grrrrr! Çok öfkeliyim!"
    },
    {
      "id": "49f16c72",
      "bank_id": "3013ab00",
      "text": "Pöh! Ben de moralim daha fazla bozulamaz sanıyordum!"
    },
    {
      "id": "49f16c73",
      "bank_id": "3013ab00",
      "text": "Şu an çok sinirliyim. Eskisinden bile daha fazla."
    },
    {
      "id": "49f16c74",
      "bank_id": "3013ab00",
      "text": "Sadece havamı daha da bozuyorsun."
    },
    {
      "id": "49f16c75",
      "bank_id": "3013ab00",
      "text": "Daha önce oldukça rahatsızdım. Şimdi resmen çileden çıktım!"
    },
    {
      "id": "49f16c76",
      "bank_id": "3013ab00",
      "text": "Beni daha da fazla öfkelendirdin."
    },
    {
      "id": "49f16c77",
      "bank_id": "3013ab00",
      "text": "Lütfen gazabımı daha fazla körüklemeyi bırak."
    },
    {
      "id": "4be55f58",
      "bank_id": "3013ab00",
      "text": "Dur. Yalvarırım, sadece dur."
    },
    {
      "id": "4be55f59",
      "bank_id": "3013ab00",
      "text": "Hayııır! Hoşuma gitmiyor! Lütfen, yapma!"
    },
    {
      "id": "4be55f5a",
      "bank_id": "3013ab00",
      "text": "Zaten yeterince korktum."
    },
    {
      "id": "4be55f5f",
      "bank_id": "3013ab00",
      "text": "Neden? Neden hayatımı zindan etmeye devam ediyorsun?"
    },
    {
      "id": "4d5a0c64",
      "bank_id": "3013ab00",
      "text": "Baba, kes şunu! Beni korkutuyorsun."
    },
    {
      "id": "4d5a0c6f",
      "bank_id": "3013ab00",
      "text": "Anne, kes şunu! Beni korkutuyorsun."
    },
    {
      "id": "51d84940",
      "bank_id": "3013ab00",
      "text": "Tam da en nefret ettiğim şey."
    },
    {
      "id": "51d84941",
      "bank_id": "3013ab00",
      "text": "Korkunç! İğrenç!"
    },
    {
      "id": "51d84942",
      "bank_id": "3013ab00",
      "text": "Şok edici! Vahşet!"
    },
    {
      "id": "51d84943",
      "bank_id": "3013ab00",
      "text": "Bütün fobilerim ve gıcık olduğum şeyler bir araya toplanmış sanki."
    },
    {
      "id": "51d84944",
      "bank_id": "3013ab00",
      "text": "Şimdiye kadar gördüğüm en berbat şey bu."
    },
    {
      "id": "51d84946",
      "bank_id": "3013ab00",
      "text": "Ah, hiç bu kadar tiksinmemiştim!"
    },
    {
      "id": "51d84947",
      "bank_id": "3013ab00",
      "text": "Şunu yapmayı keser misin?! Nefret ediyorum bundan!"
    },
    {
      "id": "54f17da0",
      "bank_id": "3013ab00",
      "text": "Ne kadar da çileden çıkarıcı!"
    },
    {
      "id": "54f17da2",
      "bank_id": "3013ab00",
      "text": "Eh, beni fena halde kızdırdın işte. Mutlu musun?"
    },
    {
      "id": "54f17da3",
      "bank_id": "3013ab00",
      "text": "Görmeye ihtiyacım olan tek şey buydu zaten! Grrrr!"
    },
    {
      "id": "54f17da4",
      "bank_id": "3013ab00",
      "text": "O kadar öfkeliyim ki patlayacağımı sanıyorum."
    },
    {
      "id": "54f17da5",
      "bank_id": "3013ab00",
      "text": "Damarıma nasıl basacağını gerçekten biliyorsun, değil mi?"
    },
    {
      "id": "54f17da6",
      "bank_id": "3013ab00",
      "text": "Öfkem normal sınırlarının ötesine taştı."
    },
    {
      "id": "54f17da7",
      "bank_id": "3013ab00",
      "text": "Şu an resmen burnumdan soluyorum."
    },
    {
      "id": "552bb467",
      "bank_id": "3013ab00",
      "text": "Böğğ. Berbatsın."
    },
    {
      "id": "56b60487",
      "bank_id": "3013ab00",
      "text": "Bunu nasıl yapacağımı bana da öğretmelisin, Baba."
    },
    {
      "id": "56b6048c",
      "bank_id": "3013ab00",
      "text": "İyi iş çıkardın, Baba."
    },
    {
      "id": "56d85160",
      "bank_id": "3013ab00",
      "text": "Uğraşsan bile daha pislik olamazdın."
    },
    {
      "id": "56d85161",
      "bank_id": "3013ab00",
      "text": "İliğine kadar çürümüş."
    },
    {
      "id": "56d85162",
      "bank_id": "3013ab00",
      "text": "Tatsızlığın zirvesi."
    },
    {
      "id": "56d85163",
      "bank_id": "3013ab00",
      "text": "Tüm insanlığa karşı bir yüz karası."
    },
    {
      "id": "56d85165",
      "bank_id": "3013ab00",
      "text": "Daha aşağılık bir şey yapamazdın."
    },
    {
      "id": "56d85166",
      "bank_id": "3013ab00",
      "text": "Bu benim en nefret ettiğim şeylerden biri! Dur!"
    },
    {
      "id": "56d85167",
      "bank_id": "3013ab00",
      "text": "Sen tek kelimeyle kınanacak birisin. İğrenç!"
    },
    {
      "id": "5c2bbf6a",
      "bank_id": "3013ab00",
      "text": "Hiç hoş değil."
    },
    {
      "id": "62d63a32",
      "bank_id": "3013ab00",
      "text": "Korkutma beni. Ben senin oğlunum!"
    },
    {
      "id": "6775ab52",
      "bank_id": "3013ab00",
      "text": "Korkutma beni, lütfen."
    },
    {
      "id": "6bd6481f",
      "bank_id": "3013ab00",
      "text": "Uslu bir kız olacağım, söz veriyorum."
    },
    {
      "id": "6dd752e0",
      "bank_id": "3013ab00",
      "text": "Vaktini ünlü olmak yerine daha ilginç şeylere harcasan nasıl olur?"
    },
    {
      "id": "7075b9bf",
      "bank_id": "3013ab00",
      "text": "Beni neden korkutuyorsun ki?"
    },
    {
      "id": "72d75a80",
      "bank_id": "3013ab00",
      "text": "Beni buradan çıkarın, bu ünlü çok sıkıcı."
    },
    {
      "id": "72d75a81",
      "bank_id": "3013ab00",
      "text": "İşin bittiğinde beni uyandır, ey yüce hazretleri."
    },
    {
      "id": "72d75a85",
      "bank_id": "3013ab00",
      "text": "Bu oyun da ne? Ünlü can sıkıntısı."
    },
    {
      "id": "72d75a86",
      "bank_id": "3013ab00",
      "text": "Ünlü olabilirsin ama yine de sıkıcısın."
    },
    {
      "id": "72d75a87",
      "bank_id": "3013ab00",
      "text": "Hiçbir şöhret bu kadar donuk olmayı mazur gösteremez."
    },
    {
      "id": "75628804",
      "bank_id": "3013ab00",
      "text": "Vah vah, vah vah."
    },
    {
      "id": "75628807",
      "bank_id": "3013ab00",
      "text": "Hadi ama, bu kadarı yeter."
    },
    {
      "id": "78b11d50",
      "bank_id": "3013ab00",
      "text": "Beni daha fazla kışkırtma!"
    },
    {
      "id": "78b11d51",
      "bank_id": "3013ab00",
      "text": "Beni daha da sinirlendirmeye çalışıyorsun, değil mi?"
    },
    {
      "id": "78b11d54",
      "bank_id": "3013ab00",
      "text": "Beni daha da öfkelendiriyorsun."
    },
    {
      "id": "78b11d56",
      "bank_id": "3013ab00",
      "text": "Tam daha fazla öfkelenemem derken."
    },
    {
      "id": "78b11d57",
      "bank_id": "3013ab00",
      "text": "Sanki yeterince kötü bir havada değilmişim gibi!"
    },
    {
      "id": "795237c8",
      "bank_id": "3013ab00",
      "text": "Eğer bu insanlar seni sevmezse beni de sevmezler, biliyorsun değil mi?"
    },
    {
      "id": "7ad279e3",
      "bank_id": "3013ab00",
      "text": "Şunu yapmayı kes! Çok korkunç!"
    },
    {
      "id": "7d531c02",
      "bank_id": "3013ab00",
      "text": "Ha ha ha! Sen gelmiş geçmiş en komik babasın!"
    },
    {
      "id": "7d531c09",
      "bank_id": "3013ab00",
      "text": "Ha ha ha! Sen gelmiş geçmiş en komik annesin!"
    },
    {
      "id": "7db12570",
      "bank_id": "3013ab00",
      "text": "Ben de daha önce öfkeliydim sanıyordum!"
    },
    {
      "id": "7db12571",
      "bank_id": "3013ab00",
      "text": "Beni fena halde zıvanadan çıkardın!"
    },
    {
      "id": "7db12575",
      "bank_id": "3013ab00",
      "text": "Şimdi gerçekten çok öfkeliyim!"
    },
    {
      "id": "7db12576",
      "bank_id": "3013ab00",
      "text": "Beni daha da öfkelendirmeye mi çalışıyorsun?!"
    },
    {
      "id": "7db12577",
      "bank_id": "3013ab00",
      "text": "Şimdi köpürüyorum işte. İstediğin bu muydu?"
    },
    {
      "id": "7e523fe9",
      "bank_id": "3013ab00",
      "text": "Böyle yapmaya devam edersen kimse seni sevmeyecek."
    },
    {
      "id": "80bbc511",
      "bank_id": "3013ab00",
      "text": "Bunu yaptığında kimsenin hoşuna gitmiyor."
    },
    {
      "id": "81d284e6",
      "bank_id": "3013ab00",
      "text": "Gördüğüm en aptalca şey bu!"
    },
    {
      "id": "8bbbd640",
      "bank_id": "3013ab00",
      "text": "Çok korkunç."
    },
    {
      "id": "9b772cd7",
      "bank_id": "3013ab00",
      "text": "Neden böyle şeyler yapıyorsun ki?"
    },
    {
      "id": "9e61b678",
      "bank_id": "3013ab00",
      "text": "Harika bir şey bu!"
    },
    {
      "id": "9e962827",
      "bank_id": "3013ab00",
      "text": "Aaa! Beni korkutuyorsun, babacığım!"
    },
    {
      "id": "9e96282c",
      "bank_id": "3013ab00",
      "text": "Aaa! Beni korkutuyorsun, anne!"
    },
    {
      "id": "9ea70202",
      "bank_id": "3013ab00",
      "text": "Ha ha ha! Çok komiksin anneciğim."
    },
    {
      "id": "9ea70209",
      "bank_id": "3013ab00",
      "text": "Ha ha ha! Çok komiksin baba."
    },
    {
      "id": "a27737da",
      "bank_id": "3013ab00",
      "text": "Sadece dur artık, olur mu?"
    },
    {
      "id": "a361be19",
      "bank_id": "3013ab00",
      "text": "Çok havalı!"
    },
    {
      "id": "a6974892",
      "bank_id": "3013ab00",
      "text": "İyiydi bu, anne!"
    },
    {
      "id": "a6974899",
      "bank_id": "3013ab00",
      "text": "İyiydi bu, baba!"
    },
    {
      "id": "addcb57e",
      "bank_id": "3013ab00",
      "text": "Yapma şunu artık!"
    },
    {
      "id": "b3317f86",
      "bank_id": "3013ab00",
      "text": "Şey, bundan pek hoşlandığımdan emin değilim anne."
    },
    {
      "id": "b3317f8d",
      "bank_id": "3013ab00",
      "text": "Şey, bundan pek hoşlandığımdan emin değilim baba."
    },
    {
      "id": "b6dcc34b",
      "bank_id": "3013ab00",
      "text": "Ben senin kızınım ve sana doğruyu söylemek zorundayım. Bu hiç hoş değil."
    },
    {
      "id": "bdd6ce9d",
      "bank_id": "3013ab00",
      "text": "Bunu zerre kadar eğlenceli bulmuyorum."
    },
    {
      "id": "bdd6ce9e",
      "bank_id": "3013ab00",
      "text": "Sabrımı zorlama evlat!"
    },
    {
      "id": "c139bb08",
      "bank_id": "3013ab00",
      "text": "Lütfen yapma, beni korkutuyorsun."
    },
    {
      "id": "c3f12385",
      "bank_id": "3013ab00",
      "text": "Büyüyünce sana benzemeyeceğim, değil mi baba?"
    },
    {
      "id": "c3f1238e",
      "bank_id": "3013ab00",
      "text": "Büyüyünce sana benzemeyeceğim, değil mi anne?"
    },
    {
      "id": "c639c329",
      "bank_id": "3013ab00",
      "text": "Tamam, uslu duracağım!"
    },
    {
      "id": "d26f9428",
      "bank_id": "3013ab00",
      "text": "Ha ha, umarım bir gün ben de senin kadar komik olurum."
    },
    {
      "id": "d76f9bc9",
      "bank_id": "3013ab00",
      "text": "Ha ha, umarım bir gün ben de senin kadar komik olurum."
    },
    {
      "id": "e4ba5590",
      "bank_id": "3013ab00",
      "text": "Ah, hayatım her geçen dakika daha da sefil bir hal alıyor!"
    },
    {
      "id": "e4ba5591",
      "bank_id": "3013ab00",
      "text": "Sanırım sadece ağlayıp bu işi bitireceğim."
    },
    {
      "id": "e4ba5593",
      "bank_id": "3013ab00",
      "text": "Sanırım gidip bir köşede kendime sarılacağım."
    },
    {
      "id": "e4ba5594",
      "bank_id": "3013ab00",
      "text": "Sayende kederimin sınırı kalmadı."
    },
    {
      "id": "e4ba5595",
      "bank_id": "3013ab00",
      "text": "Şu an gerçekten tesellisiz kaldım."
    },
    {
      "id": "e4ba5596",
      "bank_id": "3013ab00",
      "text": "Ah, vurun beni gitsin."
    },
    {
      "id": "e4ba5597",
      "bank_id": "3013ab00",
      "text": "Moralimi sıfıra indiriyorsun."
    },
    {
      "id": "e67c2010",
      "bank_id": "3013ab00",
      "text": "Ondan ne kadar nefret ettiğimi anlatamam."
    },
    {
      "id": "e67c2011",
      "bank_id": "3013ab00",
      "text": "Pöh! Midem bulandı resmen."
    },
    {
      "id": "e67c2012",
      "bank_id": "3013ab00",
      "text": "Korkunç. Tek kelimeyle korkunç."
    },
    {
      "id": "e67c2013",
      "bank_id": "3013ab00",
      "text": "Gerçekten içler acısı."
    },
    {
      "id": "e67c2014",
      "bank_id": "3013ab00",
      "text": "Bu düpedüz dehşet verici."
    },
    {
      "id": "e67c2016",
      "bank_id": "3013ab00",
      "text": "Bu çok iç karartıcı."
    },
    {
      "id": "e67c2017",
      "bank_id": "3013ab00",
      "text": "Ah, buna dayanamıyorum!"
    },
    {
      "id": "eb7c2830",
      "bank_id": "3013ab00",
      "text": "Olabileceğinin en kötüsü."
    },
    {
      "id": "eb7c2831",
      "bank_id": "3013ab00",
      "text": "Gözlerime başparmaklarını soksaydın daha iyiydi."
    },
    {
      "id": "eb7c2832",
      "bank_id": "3013ab00",
      "text": "Gerçekten oldukça iğrenç."
    },
    {
      "id": "eb7c2833",
      "bank_id": "3013ab00",
      "text": "Ne acı verici bir tecrübe."
    },
    {
      "id": "eb7c2835",
      "bank_id": "3013ab00",
      "text": "Bu tek kelimeyle berbat."
    },
    {
      "id": "eb7c2836",
      "bank_id": "3013ab00",
      "text": "Bu kötünün de ötesinde!"
    },
    {
      "id": "eb7c2837",
      "bank_id": "3013ab00",
      "text": "Buna tanık olmak zorunda kaldığıma inanamıyorum."
    },
    {
      "id": "ebba6090",
      "bank_id": "3013ab00",
      "text": "Beni kasvetin yepyeni diplerine sürüklüyorsun."
    },
    {
      "id": "ebba6091",
      "bank_id": "3013ab00",
      "text": "Zaten artmakta olan melankolimi iyice tırmandırdın."
    },
    {
      "id": "ebba6092",
      "bank_id": "3013ab00",
      "text": "Ben de günüm daha kötü olamaz sanıyordum."
    },
    {
      "id": "ebba6093",
      "bank_id": "3013ab00",
      "text": "Sanki yeterince bunalımda değilmişim gibi."
    },
    {
      "id": "ebba6094",
      "bank_id": "3013ab00",
      "text": "Şuna bak... Sabahları neden yataktan kalktığımı bile bilmiyorum."
    },
    {
      "id": "ebba6095",
      "bank_id": "3013ab00",
      "text": "Pöh! Hayatın yaşamaya pek değmediğini biliyordum. Artık kesin emin oldum."
    },
    {
      "id": "ebba6096",
      "bank_id": "3013ab00",
      "text": "Hiçbir şeyin ne anlamı var ki? Kesinlikle bunun da bir anlamı yok."
    },
    {
      "id": "ece3f0ee",
      "bank_id": "3013ab00",
      "text": "Tatsızlığın zirvesi."
    },
    {
      "id": "f8aabaf2",
      "bank_id": "3013ab00",
      "text": "Ha ha, diğer tüm anne babalardan daha komiksin."
    },
    {
      "id": "fd0d4482",
      "bank_id": "3013ab00",
      "text": "Bunu yapmayı bana da öğretir misin?"
    }
  ]
}